@model LifeOS.MVC.Models.StudySubject
@{
    var tasks = Model.Tasks.OrderBy(t => t.IsCompleted).ThenBy(t => t.DueDate ?? DateTime.MaxValue).ThenByDescending(t => t.CreatedAt).ToList();
    var done = tasks.Count(t => t.IsCompleted);
}
<section id="subjectTasks" class="db-card" aria-labelledby="subjectTasksTitle">
    <div class="db-card-head">
        <h2 id="subjectTasksTitle" class="db-h2">Subject tasks</h2>
        <span class="db-pill lo-num">@done / @tasks.Count done</span>
    </div>
    <form asp-action="AddTask" asp-controller="Study" method="post" class="db-task-add">
        <input type="hidden" name="StudySubjectId" value="@Model.Id" />
        <label for="subjectTaskTitle" class="lo-visually-hidden">New subject task</label>
        <input id="subjectTaskTitle" name="Title" required maxlength="200" placeholder="Read chapter 1 or practice five questions" />
        <label for="subjectTaskDue" class="lo-visually-hidden">Due date</label>
        <input id="subjectTaskDue" name="DueDate" type="date" class="lo-input lo-date-sm" />
        <button class="lo-btn lo-btn-primary" type="submit">Add</button>
    </form>
    <div class="db-task-list">
        @if (!tasks.Any()) { <p class="db-empty">Add a task to plan your next study session.</p> }
        @foreach (var task in tasks)
        {
            var overdue = !task.IsCompleted && task.DueDate?.Date < DateTime.Today;
            <div class="db-task @(task.IsCompleted ? "is-done" : "") @(overdue ? "is-overdue" : "")">
                <form asp-action="ToggleTask" asp-controller="Study" method="post">
                    <input name="id" value="@task.Id" type="hidden" />
                    <button type="submit" class="db-check @(task.IsCompleted ? "done" : "")" aria-label="@(task.IsCompleted ? "Mark as not done" : "Mark as done"): @task.Title">
                        @if (task.IsCompleted) { @await Html.PartialAsync("_Icon", "tick") }
                    </button>
                </form>
                <div class="db-task-body">
                    <div class="db-task-title">@task.Title</div>
                    <div class="db-task-meta">
                        @(task.IsCompleted ? "Completed " + task.CompletedAt?.ToString("d MMM") : task.DueDate.HasValue ? (overdue ? "Overdue · " : "Due ") + task.DueDate.Value.ToString("d MMM yyyy") : "No due date")@(string.IsNullOrWhiteSpace(task.Notes) ? "" : " · " + task.Notes)
                    </div>
                    <details class="lo-task-more">
                        <summary class="db-link">Edit or delete</summary>
                        <form asp-action="UpdateTask" asp-controller="Study" method="post" class="lo-form">
                            <input type="hidden" name="Id" value="@task.Id" />
                            <div class="lo-field"><label class="lo-label" for="editTaskTitle-@(task.Id)">Task name</label><input id="editTaskTitle-@(task.Id)" class="lo-input" name="Title" value="@task.Title" required maxlength="200" /></div>
                            <div class="lo-field"><label class="lo-label" for="editTaskDue-@(task.Id)">Due date</label><input id="editTaskDue-@(task.Id)" class="lo-input lo-input-short" name="DueDate" type="date" value="@task.DueDate?.ToString("yyyy-MM-dd")" /></div>
                            <div class="lo-field"><label class="lo-label" for="editTaskNotes-@(task.Id)">Notes</label><textarea id="editTaskNotes-@(task.Id)" class="lo-input lo-textarea" name="Notes" maxlength="1000">@task.Notes</textarea></div>
                            <div class="lo-form-actions"><button type="submit" class="lo-btn lo-btn-primary lo-btn-sm">Save task</button></div>
                        </form>
                        <form asp-action="DeleteTask" asp-controller="Study" method="post" class="lo-form-actions">
                            <input type="hidden" name="id" value="@task.Id" />
                            <button type="submit" class="lo-btn lo-btn-sm lo-btn-danger" data-confirm="Delete this subject task?">Delete task</button>
                        </form>
                    </details>
                </div>
            </div>
        }
    </div>
</section>
