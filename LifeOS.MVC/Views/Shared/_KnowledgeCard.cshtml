@model LifeOS.Models.KnowledgeEntry
@{
    string typeColor = Model.Type switch
    {
        "Note" => "var(--accent)",
        "Lesson" => "var(--teal)",
        "Quote" => "var(--amber)",
        "Summary" => "var(--sky)",
        "Idea" => "var(--violet)",
        "Framework" => "var(--green)",
        "Checklist" => "var(--rose)",
        _ => "var(--text-tertiary)"
    };
}

<div class="kb-card @(Model.IsPinned ? "pinned" : "") @(Model.IsFavorite ? "fav" : "")">

    <!-- Type + actions header -->
    <div style="display:flex; justify-content:space-between; align-items:flex-start;
        margin-bottom:8px;">
        <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
            <span style="font-size:0.65rem; font-weight:800; text-transform:uppercase;
                letter-spacing:.1em; color:@typeColor; padding:2px 7px;
                background:@typeColor + " 18"; border-radius:99px;
                  border:1px solid @typeColor + "30" ;">
                @Model.Type
            </span>
            <span class="badge badge-neutral">@Model.Category</span>
            @if (Model.IsPinned)
            {
                <span style="font-size:0.75rem;">📌</span>
            }
            @if (Model.IsFavorite)
            {
                <span style="font-size:0.75rem; color:var(--rose);">★</span>
            }
        </div>
        <div style="display:flex; gap:3px; flex-shrink:0;">
            <form method="post" asp-action="TogglePin" asp-controller="Knowledge">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn-los btn-ghost btn-icon-sm"
                        title="@(Model.IsPinned ? "Unpin" : "Pin")"
                        style="color:@(Model.IsPinned ? "var(--amber)" : "var(--text-disabled)")">
                    📌
                </button>
            </form>
            <button class="btn-los btn-ghost btn-icon-sm"
                    data-bs-toggle="modal" data-bs-target="#editKb@Model.Id"
                    title="Edit">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none">
                    <path d="M11 2l3 3-9 9H2v-3L11 2z" stroke="currentColor"
                          stroke-width="1.4" stroke-linejoin="round" />
                </svg>
            </button>
            <form method="post" asp-action="Delete" asp-controller="Knowledge">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn-los btn-ghost btn-icon-sm"
                        style="color:var(--rose);"
                        data-confirm="Delete '@Model.Title'?">
                    <svg width="12" height="12" viewBox="0 0 16 16" fill="none">
                        <path d="M3 4h10M5 4l1 9h4l1-9" stroke="currentColor"
                              stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
            </form>
        </div>
    </div>

    <!-- Title -->
    <div style="font-size:0.9rem; font-weight:700; color:var(--text-primary);
        margin-bottom:4px; line-height:1.4;">
        @Model.Title
    </div>

    <!-- Source -->
    @if (!string.IsNullOrEmpty(Model.Source))
    {
        <div style="font-size:0.7rem; color:var(--text-disabled); margin-bottom:6px;">
            📖 @Model.Source
        </div>
    }

    <!-- Content preview -->
    @if (!string.IsNullOrEmpty(Model.Content))
    {
        <div class="kb-content-preview">@Model.Content</div>
    }

    <!-- Tags -->
    @if (Model.TagList.Any())
    {
        <div style="display:flex; flex-wrap:wrap; gap:4px; margin-top:8px;">
            @foreach (var t in Model.TagList.Take(4))
            {
                <a href="/Knowledge?tag=@Uri.EscapeDataString(t)" class="kb-tag">@t</a>
            }
            @if (Model.TagList.Count > 4)
            {
                <span class="kb-tag">+@(Model.TagList.Count - 4)</span>
            }
        </div>
    }

    <!-- Footer -->
    <div style="margin-top:auto; padding-top:10px; font-size:0.68rem;
        color:var(--text-disabled);">
        @Model.UpdatedAt.ToString("MMM d, yyyy")
    </div>
</div>