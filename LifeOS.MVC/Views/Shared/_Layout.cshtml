<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <script>try { const saved = localStorage.getItem("lifeos-theme"); document.documentElement.dataset.theme = saved === "dark" || saved === "light" ? saved : (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"); } catch { document.documentElement.dataset.theme = "light"; }</script>
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0F766E" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Dashboard") — Life OS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/lifeos.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/workspace.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/lifeos-v2.css" asp-append-version="true" rel="stylesheet" />
</head>
<body>
    <a class="lo-skip" href="#main-content">Skip to main content</a>

    <!-- Mobile overlay -->
    <div id="navOverlay"></div>
    <!-- Timer backdrop -->
    <div id="timerBackdrop"
         style="display:none; position:fixed; inset:0; z-index:9998;"
         onclick="timerClose()"></div>
    <style>
        #timerBackdrop.active {
            display: block !important;
        }
    </style>

    <div class="los-shell">

        <!-- ══ SIDEBAR NAV ══════════════════════════════════════════ -->
        <nav class="los-nav" aria-label="Main">
            <div class="los-nav-brand">
                <div class="los-nav-logo" aria-hidden="true">L</div>
                <div class="los-nav-brand-text">
                    <div class="los-nav-brand-name">Life OS</div>
                    <div class="los-nav-brand-tag">Personal workspace</div>
                </div>
            </div>

            <div class="los-nav-items">@await Html.PartialAsync("_Navigation")</div>

            <div class="los-nav-footer">@DateTime.Now.ToString("dddd, d MMMM")</div>
        </nav>

        <!-- ══ MAIN ══════════════════════════════════════════════════ -->
        <div class="los-main">

            <header class="los-topbar">
                <button aria-label="Open navigation" aria-expanded="false" id="navToggle" type="button" class="lo-icon-btn">
                    @await Html.PartialAsync("_Icon", "menu")
                </button>

                <div class="los-topbar-title">@(ViewData["Title"] ?? "Dashboard")</div>

                <div class="los-topbar-right">
                    <form method="get" asp-action="Index" asp-controller="Search" role="search">
                        <div class="los-search-wrap">
                            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5" />
                                <path d="M11 11l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                            </svg>
                            <label for="globalSearch" class="lo-visually-hidden">Search Life OS</label>
                            <input name="q" id="globalSearch" type="search" class="los-search"
                                   placeholder="Search everything (Ctrl+K)" autocomplete="off" />
                        </div>
                    </form>

                    <button id="timerToggleBtn" type="button" class="los-timer-btn"
                            onclick="timerToggle()" title="Focus timer (Ctrl+Space)" aria-label="Open focus timer">
                        @await Html.PartialAsync("_Icon", "clock")
                        <span id="timerBtnLabel" class="lo-timer-label lo-num">Focus</span>
                    </button>

                    <button id="themeToggle" type="button" class="lo-icon-btn" aria-label="Switch to dark mode" aria-pressed="false">
                        <span class="lo-theme-moon">@await Html.PartialAsync("_Icon", "moon")</span>
                        <span class="lo-theme-sun">@await Html.PartialAsync("_Icon", "sun")</span>
                    </button>
                    <button id="installApp" type="button" class="lo-btn lo-btn-primary" hidden>Install app</button>
                </div>
            </header>

            <main class="los-content" id="main-content" tabindex="-1">
                @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
                @RenderBody()
            </main>

        </div>
    </div>

    <!-- ══ FOCUS TIMER (popup) ═══════════════════════════════════════ -->
    <div id="timerWidget" role="dialog" aria-label="Focus timer">
        <div style="display:flex; align-items:center; justify-content:space-between;
                padding:13px 16px 11px; border-bottom:1px solid var(--border);
                background:var(--bg-2);">
            <div style="display:flex; align-items:center; gap:8px; color:var(--indigo);">
                @await Html.PartialAsync("_Icon", "clock")
                <span style="font-size:0.75rem; font-weight:700; text-transform:uppercase;
                    letter-spacing:.1em; color:var(--text-3);">Focus timer</span>
            </div>
            <button type="button" onclick="timerClose()" aria-label="Close focus timer" class="lo-icon-btn" style="width:36px; height:36px;">
                @await Html.PartialAsync("_Icon", "close")
            </button>
        </div>

        <div style="padding:18px;">
            <div style="position:relative; width:140px; height:140px; margin:0 auto 16px;">
                <svg width="140" height="140" viewBox="0 0 140 140" style="position:absolute; top:0; left:0;" aria-hidden="true">
                    <circle cx="70" cy="70" r="58" fill="none" stroke="var(--bg-3)" stroke-width="8" class="ring-track" />
                    <circle id="tRing" cx="70" cy="70" r="58" fill="none" stroke="var(--indigo)"
                            stroke-width="8" stroke-linecap="round" class="t-ring-prog" />
                </svg>
                <div style="position:absolute; inset:0; display:flex; flex-direction:column;
                        align-items:center; justify-content:center; gap:3px;">
                    <div id="tDisplay" class="t-display" role="timer">25:00</div>
                    <div id="tStatus" aria-live="polite" style="font-size:0.7rem; font-weight:700; text-transform:uppercase;
                            letter-spacing:.1em; color:var(--text-3);">
                        Ready
                    </div>
                </div>
            </div>

            <div style="margin-bottom:13px;">
                <label for="tLabel" class="lo-visually-hidden">What are you focusing on?</label>
                <input id="tLabel" class="form-control form-control-sm"
                       placeholder="What are you focusing on?"
                       style="text-align:center; font-size:0.85rem; font-weight:500;" />
            </div>

            <div role="group" aria-label="Timer length" style="display:flex; gap:6px; justify-content:center; flex-wrap:wrap; margin-bottom:12px;">
                <button type="button" class="t-preset on" onclick="tSetPreset(25,this)">25m</button>
                <button type="button" class="t-preset" onclick="tSetPreset(50,this)">50m</button>
                <button type="button" class="t-preset" onclick="tSetPreset(90,this)">90m</button>
                <button type="button" class="t-preset" onclick="tSetPreset(5,this)">5m</button>
                <button type="button" class="t-preset" onclick="tSetPreset(15,this)">15m</button>
                <button type="button" class="t-preset" id="tCustomBtn" onclick="tShowCustom()">Custom</button>
            </div>

            <div id="tCustomWrap" style="display:none; margin-bottom:12px; text-align:center;">
                <div style="display:inline-flex; gap:6px; align-items:center;">
                    <label for="tCustomMin" class="lo-visually-hidden">Custom minutes</label>
                    <input id="tCustomMin" type="number" min="1" max="300" value="30"
                           class="form-control form-control-sm" style="width:80px; text-align:center;" />
                    <button type="button" class="btn btn-secondary btn-sm" onclick="tApplyCustom()">Set</button>
                </div>
            </div>

            <div style="display:flex; gap:7px; margin-bottom:10px;">
                <button type="button" id="tStartBtn" onclick="tStart()" class="btn btn-primary" style="flex:2;">▶ Start</button>
                <button type="button" onclick="tPause()" class="btn btn-secondary" style="flex:1;" aria-label="Pause">Pause</button>
                <button type="button" onclick="tReset()" class="btn btn-secondary" style="flex:1;" aria-label="Reset">Reset</button>
            </div>

            <div style="text-align:center; font-size:0.72rem; color:var(--text-3);">
                Ctrl+Space start/pause · Esc close
            </div>
        </div>
    </div>

    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/pwa.js" asp-append-version="true"></script>
    <script src="~/js/lifeos.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
