<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <script>try { const saved = localStorage.getItem("lifeos-theme"); document.documentElement.dataset.theme = saved === "dark" || saved === "light" ? saved : (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"); } catch { document.documentElement.dataset.theme = "light"; }</script>
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1c2c40" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Dashboard") — Life OS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/lifeos.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/workspace.css" asp-append-version="true" rel="stylesheet" />
</head>
<body>

    <!-- Mobile overlay -->
    <div id="navOverlay"></div>
    <!-- Timer backdrop -->
    <div id="timerBackdrop"
         style="display:none; position:fixed; inset:0; z-index:9998;
    background:rgba(0,0,0,0.2); backdrop-filter:blur(2px);"
         onclick="timerClose()"></div>
    <style>
            #timerBackdrop.active {
                display: block !important;
        }</style>

        <div class="los-shell">

            <!-- ══ SIDEBAR NAV ══════════════════════════════════════════ -->
            <nav class="los-nav">

                <!-- Brand -->
                <div class="los-nav-brand">
                    <div class="los-nav-logo">⬡</div>
                    <div class="los-nav-brand-text">
                        <div class="los-nav-brand-name">Life OS</div>
                        <div class="los-nav-brand-tag">Personal workspace</div>
                    </div>
                </div>

                <!-- Nav Items -->
                <div class="los-nav-items">@await Html.PartialAsync("_Navigation")</div>
                <!-- Footer -->
                <div class="los-nav-footer">
                    <div class="nav-note"><strong>One step at a time.</strong><span>A calmer place to organize your life.</span></div>
                    <div class="los-nav-group-label" style="padding-top:8px; font-size:0.58rem; color:var(--text-4); white-space:nowrap;">
                        @DateTime.Now.ToString("ddd, MMM d")
                    </div>
                </div>

            </nav>

            <!-- ══ MAIN ══════════════════════════════════════════════════ -->
            <div class="los-main">

                <!-- Topbar -->
                <header class="los-topbar">
                    <!-- Mobile hamburger -->
                    <button aria-label="Open navigation" aria-expanded="false" id="navToggle" class="btn btn-ghost btn-icon d-lg-none"
                            style="margin-left:-6px;">
                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                            <path d="M2 4.5h14M2 9h14M2 13.5h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                        </svg>
                    </button>

                    <!-- Page title -->
                    <div class="los-topbar-title">@(ViewData["Title"] ?? "Dashboard")</div>

                    <div class="los-topbar-right">

                        <!-- Global search -->
                        <form method="get" asp-action="Index" asp-controller="Search">
                            <div class="los-search-wrap">
                                <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                                    <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5" />
                                    <path d="M11 11l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                </svg>
                                <input name="q" id="globalSearch" class="los-search"
                                       placeholder="Search… (Ctrl+K)" autocomplete="off" />
                            </div>
                        </form>

                        <button id="themeToggle" type="button" class="btn btn-secondary btn-sm" aria-label="Switch color theme">Dark mode</button>
                        <button id="installApp" type="button" class="btn btn-primary btn-sm" hidden>Install app</button>
                        <!-- Date pill -->
                        <div class="los-topbar-pill d-none d-md-flex" id="topbarDate"></div>

                        <!-- Timer -->
                        <button id="timerToggleBtn" class="los-timer-btn"
                                onclick="timerToggle()" title="Focus Timer (Ctrl+Space)">
                            <svg width="13" height="13" viewBox="0 0 16 16" fill="none">
                                <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5" />
                                <path d="M8 5v3l2 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                            </svg>
                            <span id="timerBtnLabel">Focus</span>
                        </button>

                    </div>
                </header>

                <!-- Content -->
                <main class="los-content">
                    @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
                    @RenderBody()
                </main>

            </div>
        </div>

        <!-- ══ TIMER WIDGET ══════════════════════════════════════════════ -->
        <div id="timerWidget">
            <div style="display:flex; align-items:center; justify-content:space-between;
                padding:13px 16px 11px; border-bottom:1px solid var(--border);
                background:var(--bg-2);">
                <div style="display:flex; align-items:center; gap:8px;">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                        <circle cx="8" cy="8" r="6" stroke="var(--indigo)" stroke-width="1.5" />
                        <path d="M8 5v3l2 1.5" stroke="var(--indigo)" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                    <span style="font-size:0.7rem; font-weight:700; text-transform:uppercase;
                    letter-spacing:.12em; color:var(--text-3);">Focus Timer</span>
                </div>
                <button onclick="timerClose()"
                        style="background:none; border:none; cursor:pointer; padding:3px 6px;
                    color:var(--text-3); border-radius:var(--r-sm); font-size:1rem; line-height:1;">
                    ✕
                </button>
            </div>

            <div style="padding:18px;">
                <!-- Ring -->
                <div style="position:relative; width:140px; height:140px; margin:0 auto 16px;">
                    <svg width="140" height="140" viewBox="0 0 140 140" style="position:absolute; top:0; left:0;">
                        <circle cx="70" cy="70" r="58" fill="none" stroke="var(--bg-3)" stroke-width="8" class="ring-track" />
                        <circle id="tRing" cx="70" cy="70" r="58" fill="none" stroke="var(--indigo)"
                                stroke-width="8" stroke-linecap="round" class="t-ring-prog" />
                    </svg>
                    <div style="position:absolute; inset:0; display:flex; flex-direction:column;
                        align-items:center; justify-content:center; gap:3px;">
                        <div id="tDisplay" class="t-display">25:00</div>
                        <div id="tStatus" style="font-size:0.62rem; font-weight:700; text-transform:uppercase;
                            letter-spacing:.12em; color:var(--text-3);">
                            Ready
                        </div>
                    </div>
                </div>

                <!-- Label -->
                <div style="margin-bottom:13px;">
                    <input id="tLabel" class="form-control form-control-sm"
                           placeholder="What are you focusing on?"
                           style="text-align:center; font-size:0.78rem; color:var(--indigo); font-weight:500;
                    background:var(--indigo-soft); border-color:rgba(99,102,241,.2);" />
                </div>

                <!-- Presets -->
                <div style="display:flex; gap:5px; justify-content:center; flex-wrap:wrap; margin-bottom:12px;">
                    <button class="t-preset on" onclick="tSetPreset(25,this)">25m</button>
                    <button class="t-preset" onclick="tSetPreset(50,this)">50m</button>
                    <button class="t-preset" onclick="tSetPreset(90,this)">90m</button>
                    <button class="t-preset" onclick="tSetPreset(5,this)">5m</button>
                    <button class="t-preset" onclick="tSetPreset(15,this)">15m</button>
                    <button class="t-preset" id="tCustomBtn" onclick="tShowCustom()">Custom</button>
                </div>

                <!-- Custom -->
                <div id="tCustomWrap" style="display:none; margin-bottom:12px; text-align:center;">
                    <div style="display:inline-flex; gap:6px; align-items:center;">
                        <input id="tCustomMin" type="number" min="1" max="300" value="30"
                               class="form-control form-control-sm" style="width:72px; text-align:center;" placeholder="min" />
                        <button class="btn btn-secondary btn-sm" onclick="tApplyCustom()">Set</button>
                    </div>
                </div>

                <!-- Controls -->
                <div style="display:flex; gap:7px; margin-bottom:10px;">
                    <button id="tStartBtn" onclick="tStart()" class="btn btn-primary" style="flex:1;">▶ Start</button>
                    <button onclick="tPause()" class="btn btn-secondary" style="flex:1;">⏸</button>
                    <button onclick="tReset()" class="btn btn-ghost" style="flex:1;">↺</button>
                </div>

                <div style="text-align:center; font-size:0.62rem; color:var(--text-4);">
                    Ctrl+Space start/pause · Esc close
                </div>
            </div>
        </div>

        <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/pwa.js" asp-append-version="true"></script>
        <script src="~/js/lifeos.js" asp-append-version="true"></script>
        <script>
            // Topbar date
            const _d = new Date();
            document.getElementById('topbarDate').textContent =
            _d.toLocaleDateString('en-US', { weekday:'short', month:'short', day:'numeric' });
        </script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>


