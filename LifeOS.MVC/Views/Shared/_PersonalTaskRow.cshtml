@model LifeOS.MVC.Models.PersonalTask
<div class="task-entry @(Model.IsCompleted?"task-done":"")"><form asp-controller="PersonalTasks" asp-action="ToggleComplete" method="post"><input name="id" type="hidden" value="@Model.Id" /><button class="completion-button @(Model.IsCompleted?"complete":"")" aria-label="@(Model.IsCompleted?"Reopen":"Complete") @Model.Title">@(Model.IsCompleted?"✓":"")</button></form><div><h3>@Model.Title</h3><div class="task-entry-meta"><span class="badge-soft">@(Model.Priority=="A"?"High priority":Model.Priority=="C"?"Low priority":"Normal priority")</span><span>@(Model.IsCompleted?"Completed "+Model.CompletedAt?.ToString("dd MMM"):Model.DueDate==null?"No due date":(Model.DueDate.Value.Date<DateTime.Today?"Overdue · ":"Due ")+Model.DueDate.Value.ToString("dd MMM"))</span></div>@if(!string.IsNullOrWhiteSpace(Model.Description)){<p>@Model.Description</p>}</div><div class="task-entry-actions"><a asp-controller="PersonalTasks" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary btn-sm" aria-label="Edit @Model.Title">Edit</a><form asp-controller="PersonalTasks" asp-action="Delete" method="post"><input name="id" value="@Model.Id" type="hidden" /><button class="btn btn-ghost btn-sm" style="color:var(--rose)" aria-label="Delete @Model.Title" data-confirm="Delete this task?">Delete</button></form></div></div>
