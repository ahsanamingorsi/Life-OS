@model LifeOS.MVC.Models.StudySubject
@{
    int pct = Math.Clamp(Model.ProgressPercent, 0, 100);
    double hours = Model.StudySessions.Sum(s => s.DurationHours);
    var weekStart = LifeOS.MVC.Services.ProductivityService.WeekStart(DateTime.Today);
    double week = Model.StudySessions.Where(s => s.SessionDate >= weekStart).Sum(s => s.DurationHours);
}
<article class="db-card lo-project-card">
    <div class="db-card-head">
        <div style="min-width:0;">
            <div class="db-muted db-tiny">@Model.Category · @Model.Status</div>
            <h3 class="db-h2 lo-goal-title"><a class="lo-plain-link" href="/Study/Subject/@Model.Id">@Model.Name</a></h3>
        </div>
        <span class="db-level-pct lo-num">@pct%</span>
    </div>
    @if (!string.IsNullOrEmpty(Model.CurrentTopic)) { <div class="db-muted db-tiny">Now: @Model.CurrentTopic</div> }
    <div class="db-bar" role="progressbar" aria-label="Progress of @Model.Name" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@pct"><span class="@(pct < 40 ? "low" : "")" style="width:@pct%"></span></div>
    <div class="lo-card-foot db-tiny db-muted lo-num">
        <span>@hours.ToString("0.#")h@(Model.TargetHours > 0 ? $" of {Model.TargetHours}h" : "")</span>
        <span>@(Model.WeeklyTargetHours > 0 ? $"{week:0.#} / {Model.WeeklyTargetHours:0.#}h this week" : $"{week:0.#}h this week")</span>
    </div>
    <div class="lo-card-foot db-tiny db-muted lo-num">
        <span>@Model.StudySessions.Count sessions · @Model.StudyNotes.Count notes</span>
        <a class="db-link" href="/Study/Subject/@Model.Id">Open</a>
    </div>
</article>
