@{
 ViewData["Title"]="My day";
 var tasks=ViewBag.Tasks as List<LifeOS.MVC.Models.PersonalTask> ?? new();
 var habits=ViewBag.Habits as List<LifeOS.MVC.Models.Habit> ?? new();
 var projects=ViewBag.Projects as List<LifeOS.MVC.Models.Project> ?? new();
 var done=ViewBag.DoneToday as List<int> ?? new();
 var day=(DateTime)ViewBag.Today;
}
<div class="page-heading"><div><div class="eyebrow">PLAN WITH INTENTION</div><h1>Make today feel manageable.</h1><p>Choose your next step. Leave room to breathe.</p></div><a class="btn btn-secondary" href="/PersonalTasks">Manage all tasks ↗</a></div>
<nav class="week-strip" aria-label="Choose planning day">@for(int i=-3;i<=3;i++){var d=DateTime.Today.AddDays(i);<a class="day-choice @(d==day?"selected":"")" href="/Planner?date=@d.ToString("yyyy-MM-dd")"><span>@d.ToString("ddd")</span><strong>@d.Day</strong><small>@(d==DateTime.Today?"Today":d.ToString("MMM"))</small></a>}</nav>
<div class="workspace-grid"><div><section class="card card-p"><div class="section-heading"><h3>@day.ToString("dddd, dd MMMM")</h3><span class="badge-soft">@tasks.Count(t=>!t.IsCompleted) open tasks</span></div>
<form asp-controller="PersonalTasks" asp-action="Create" method="post" class="quick-add"><input type="hidden" name="DueDate" value="@day.ToString("yyyy-MM-dd")" /><input type="hidden" name="returnUrl" value="/Planner?date=@day.ToString("yyyy-MM-dd")" /><label class="visually-hidden" for="quickTask">New task</label><input id="quickTask" name="Title" maxlength="200" required class="form-control" placeholder="What needs your attention?" /><select name="Priority" class="form-select" aria-label="Task priority"><option value="B">Normal</option><option value="A">High</option><option value="C">Low</option></select><button class="btn btn-primary">Add task</button></form>
@if(!tasks.Any()){<div class="empty-state"><h4>A clear day ahead</h4><p>Add one meaningful task to get started.</p></div>}
@foreach(var task in tasks){<div class="work-row"><form asp-controller="PersonalTasks" asp-action="ToggleComplete" method="post"><input name="id" value="@task.Id" type="hidden" /><input name="returnUrl" value="/Planner?date=@day.ToString("yyyy-MM-dd")" type="hidden" /><button class="completion-button @(task.IsCompleted?"complete":"")" aria-label="@(task.IsCompleted?"Reopen":"Complete") @task.Title">@(task.IsCompleted?"✓":"")</button></form><div class="flex-grow-1"><strong class="@(task.IsCompleted?"completed-title":"")">@task.Title</strong><div class="small muted">@(task.DueDate==null?"No due date":task.DueDate.Value.Date<day?"Overdue · "+task.DueDate.Value.ToString("dd MMM"):"Due "+task.DueDate.Value.ToString("dd MMM"))</div></div><span class="badge-soft">@(task.Priority=="A"?"High":task.Priority=="C"?"Low":"Normal")</span><a href="/PersonalTasks/Edit/@task.Id" class="btn btn-ghost btn-sm">Edit</a></div>}
</section><section class="card card-p mt-4"><div class="section-heading"><h3>Projects in focus</h3><a href="/Projects">View all ↗</a></div>@if(!projects.Any()){<p class="muted">Your active projects will appear here.</p>}@foreach(var project in projects){<a class="work-row" href="/Projects/Detail/@project.Id"><div class="flex-grow-1"><strong>@project.Title</strong><div class="small muted">@(project.NextTask??"Set your next step")</div></div><span>@project.ProgressPercent% ↗</span></a>}</section></div>
<aside><section class="card card-p"><div class="section-heading"><h3>Daily routines</h3><a href="/Habits">Manage ↗</a></div>@if(day!=DateTime.Today){<p class="muted small">Completion history for @day.ToString("dd MMM"). Mark routines from today's plan.</p>}@if(!habits.Any()){<p class="muted">Start with one small daily habit.</p>}@foreach(var habit in habits){var complete=done.Contains(habit.Id);<div class="work-row">@if(day==DateTime.Today){<form asp-controller="Habits" asp-action="@(complete?"UnmarkComplete":"MarkComplete")" method="post"><input name="habitId" value="@habit.Id" type="hidden" /><input name="returnUrl" value="/Planner" type="hidden" /><button class="completion-button @(complete?"complete":"")" aria-label="Toggle @habit.Name">@(complete?"✓":"")</button></form>}else{<span class="completion-button @(complete?"complete":"")">@(complete?"✓":"")</span>}<div><strong>@habit.Name</strong><div class="small muted">@habit.Frequency · @(habit.Streak?.CurrentStreak??0) streak</div></div></div>}</section><section class="focus-card mt-4"><span class="eyebrow">ONE THING AT A TIME</span><h3 class="mt-3">Protect your focus.</h3><p>A short, uninterrupted session can move your day forward.</p><button class="btn btn-primary" onclick="timerToggle()">Open focus timer</button></section></aside></div>
