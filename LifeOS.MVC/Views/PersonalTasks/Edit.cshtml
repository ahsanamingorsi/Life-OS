@model LifeOS.MVC.Models.PersonalTask
@{ ViewData["Title"] = "Edit Task"; }

<div class="los-page-header">
    <div style="display:flex; align-items:center; gap:12px;">
        <a asp-action="Index" class="btn-los btn-secondary btn-sm">← Back</a>
        <div>
            <div class="los-page-title">Edit Task</div>
            <div class="los-page-subtitle">Created @Model.CreatedAt.ToString("MMMM d, yyyy")</div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="los-card">
            <div class="los-card-title-lg" style="margin-bottom:20px;">Task Details</div>
            <form method="post" asp-action="Edit" asp-controller="PersonalTasks">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Id" />
                <div class="row g-3">
                    <div class="col-12">
                        <div class="form-group">
                            <label class="form-label">Title *</label>
                            <input name="Title" class="form-control" value="@Model.Title" required maxlength="200" />
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">Priority</label>
                            <select name="Priority" class="form-control">
                                <option value="A" selected="@(Model.Priority == "A" ? true : null)">A — Critical</option>
                                <option value="B" selected="@(Model.Priority == "B" ? true : null)">B — Important</option>
                                <option value="C" selected="@(Model.Priority == "C" ? true : null)">C — Nice to have</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">Due Date</label>
                            <input name="DueDate" type="date" class="form-control"
                                   value="@(Model.DueDate?.ToString("yyyy-MM-dd") ?? "")" />
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            <label class="form-label">Description</label>
                            <textarea name="Description" class="form-control" maxlength="500">@Model.Description</textarea>
                        </div>
                    </div>
                    <div class="col-12 d-flex justify-content-end gap-2" style="margin-top:4px;">
                        <a asp-action="Index" class="btn-los btn-secondary">Cancel</a>
                        <button type="submit" class="btn-los btn-primary">Save Changes</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>