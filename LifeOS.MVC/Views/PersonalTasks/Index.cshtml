@model List<LifeOS.MVC.Models.PersonalTask>
@{ ViewData["Title"] = "Tasks"; var open=Model.Where(t=>!t.IsCompleted).ToList(); var completed=Model.Where(t=>t.IsCompleted).ToList(); }
@if(TempData["Success"] != null){<div class="los-alert los-alert-success">@TempData["Success"]</div>}
<div class="page-heading"><div><div class="eyebrow">CLEAR YOUR HEAD</div><h1>A place for every next step.</h1><p>Capture what matters, choose a priority, and move it forward.</p></div><div class="page-actions"><a href="/Planner" class="btn btn-secondary">My day ↗</a><button class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#addTaskPanel" aria-expanded="false" aria-controls="addTaskPanel">＋ New task</button></div></div>
<div class="collapse" id="addTaskPanel"><section class="los-panel"><h3>Add a task</h3><form asp-controller="PersonalTasks" asp-action="Create" method="post"><div class="row g-3"><div class="col-md-6"><label for="taskTitle">Task name</label><input id="taskTitle" name="Title" class="form-control" required maxlength="200" placeholder="What is your next step?" /></div><div class="col-md-3"><label for="taskPriority">Priority</label><select id="taskPriority" name="Priority" class="form-select"><option value="B">Normal</option><option value="A">High</option><option value="C">Low</option></select></div><div class="col-md-3"><label for="taskDate">Due date</label><input id="taskDate" name="DueDate" type="date" class="form-control" /></div><div class="col-12"><label for="taskDescription">Notes</label><textarea id="taskDescription" name="Description" maxlength="500" class="form-control" placeholder="Optional context"></textarea></div><div class="col-12 d-flex gap-2 justify-content-end"><button type="button" class="btn btn-secondary" data-bs-toggle="collapse" data-bs-target="#addTaskPanel">Cancel</button><button class="btn btn-primary">Save task</button></div></div></form></section></div>
<div class="metric-grid mb-4"><div class="card card-p"><span class="eyebrow">OPEN</span><h2>@open.Count</h2><small>Ready for your attention</small></div><div class="card card-p"><span class="eyebrow">HIGH PRIORITY</span><h2>@open.Count(t=>t.Priority=="A")</h2><small>Focus on these first</small></div><div class="card card-p"><span class="eyebrow">OVERDUE</span><h2>@open.Count(t=>t.DueDate?.Date < DateTime.Today)</h2><small>Reschedule or take a step</small></div><div class="card card-p"><span class="eyebrow">COMPLETED</span><h2>@completed.Count</h2><small>Progress worth noticing</small></div></div>
<section class="los-card task-list-card"><div class="section-heading mt-3"><h3>Your tasks</h3><span class="badge-soft">@open.Count open</span></div>@if(!open.Any()){<div class="empty-state"><h4>Nothing waiting on you</h4><p>Add a task when you have your next step in mind.</p></div>}@foreach(var task in open.OrderBy(t=>t.Priority).ThenBy(t=>t.DueDate)){@await Html.PartialAsync("_PersonalTaskRow",task)}</section>
@if(completed.Any()){<section class="los-card task-list-card mt-4"><div class="section-heading mt-3"><h3>Completed</h3><span class="badge-soft">@completed.Count tasks</span></div>@foreach(var task in completed.OrderByDescending(t=>t.CompletedAt)){@await Html.PartialAsync("_PersonalTaskRow",task)}</section>}
