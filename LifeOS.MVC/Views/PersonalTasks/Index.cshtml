@model List<LifeOS.MVC.Models.PersonalTask>
@{
    ViewData["Title"] = "Personal Tasks";
}

@if (TempData["Success"] != null)
{
    <div class="los-alert los-alert-success">✓ @TempData["Success"]</div>
}

<div class="los-page-header">
    <div>
        <div class="los-page-title">Personal Tasks</div>
        <div class="los-page-subtitle">Capture every action. Close every loop.</div>
    </div>
    <div class="los-page-actions">
        <button class="btn-los btn-primary" data-bs-toggle="collapse" data-bs-target="#addTaskPanel">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
            New Task
        </button>
    </div>
</div>

<!-- Add Task Panel -->
<div class="collapse" id="addTaskPanel">
    <div class="los-panel">
        <div class="los-panel-title">Create New Task</div>
        <form method="post" asp-action="Create" asp-controller="PersonalTasks">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-5">
                    <div class="form-group">
                        <label class="form-label">Title *</label>
                        <input name="Title" class="form-control" required maxlength="200" placeholder="What needs to be done?" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="form-label">Priority</label>
                        <select name="Priority" class="form-control">
                            <option value="A">A — Critical</option>
                            <option value="B" selected>B — Important</option>
                            <option value="C">C — Nice to have</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="form-label">Due Date</label>
                        <input name="DueDate" type="date" class="form-control" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Description</label>
                        <input name="Description" class="form-control" placeholder="Optional" maxlength="500" />
                    </div>
                </div>
                <div class="col-12 d-flex justify-content-end gap-2">
                    <button type="button" class="btn-los btn-secondary" data-bs-toggle="collapse" data-bs-target="#addTaskPanel">Cancel</button>
                    <button type="submit" class="btn-los btn-primary">Save Task</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Stats -->
@{
    int total = Model.Count;
    int done = Model.Count(t => t.IsCompleted);
    int open = total - done;
    int overdue = Model.Count(t => !t.IsCompleted && t.DueDate.HasValue && t.DueDate.Value.Date < DateTime.Today);
    int tPct = total > 0 ? (int)((double)done / total * 100) : 0;
}
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="los-kpi"><div class="los-kpi-icon icon-bg-sky"><svg width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="M3 4h10M3 8h7M3 12h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg></div><div class="los-kpi-value">@total</div><div class="los-kpi-label">Total Tasks</div></div></div>
    <div class="col-6 col-md-3"><div class="los-kpi"><div class="los-kpi-icon icon-bg-rose"><svg width="18" height="18" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5" /></svg></div><div class="los-kpi-value" style="color:var(--rose)">@open</div><div class="los-kpi-label">Open</div></div></div>
    <div class="col-6 col-md-3"><div class="los-kpi"><div class="los-kpi-icon icon-bg-green"><svg width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></div><div class="los-kpi-value" style="color:var(--green)">@done</div><div class="los-kpi-label">Completed</div></div></div>
    <div class="col-6 col-md-3"><div class="los-kpi"><div class="los-kpi-icon icon-bg-amber"><svg width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="M8 4v4M8 10v1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></div><div class="los-kpi-value" style="color:@(overdue > 0 ? "var(--rose)" : "var(--text-primary)")">@overdue</div><div class="los-kpi-label">Overdue</div></div></div>
</div>

<!-- Progress Bar -->
@if (total > 0)
{
    <div class="los-card mb-4" style="padding:14px 20px;">
        <div style="display:flex; align-items:center; gap:14px;">
            <span style="font-size:0.8rem; color:var(--text-tertiary); min-width:90px;">Overall progress</span>
            <div class="los-progress" style="flex:1;">
                <div class="los-progress-bar @(tPct >= 75 ? "green" : tPct >= 40 ? "sky" : "amber")" data-width="@tPct"></div>
            </div>
            <span style="font-size:0.85rem; font-weight:600; min-width:36px; text-align:right; color:var(--sky);">@tPct%</span>
        </div>
    </div>
}

<!-- Priority Sections: A, B, C then Completed -->
@foreach (var priority in new[] { "A", "B", "C" })
{
    var pTasks = Model.Where(t => !t.IsCompleted && t.Priority == priority)
                      .OrderBy(t => t.DueDate).ToList();
    if (!pTasks.Any()) continue;

    string pColor = priority == "A" ? "var(--rose)" : priority == "B" ? "var(--amber)" : "var(--text-tertiary)";
    string pLabel = priority == "A" ? "Critical" : priority == "B" ? "Important" : "Nice to have";

    <div class="los-section-label" style="margin-top:8px;">Priority @priority — @pLabel</div>
    <div class="d-flex flex-column gap-2 mb-4">
        @foreach (var t in pTasks)
        {
            bool isOverdue = t.DueDate.HasValue && t.DueDate.Value.Date < DateTime.Today;
            <div class="task-item @(isOverdue ? "style='border-color:rgba(220,38,38,0.3);'" : "")">
                <form method="post" asp-action="ToggleComplete" asp-controller="PersonalTasks" style="display:contents">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@t.Id" />
                    <button type="submit" class="task-check" title="Mark complete">
                        <svg width="10" height="8" viewBox="0 0 10 8" fill="none" style="display:none"><path d="M1 4l3 3 5-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </button>
                </form>
                <div style="flex:1; min-width:0;">
                    <div class="task-title">@t.Title</div>
                    @if (!string.IsNullOrEmpty(t.Description))
                    {
                        <div style="font-size:0.75rem; color:var(--text-tertiary); margin-top:1px;">@t.Description</div>
                    }
                </div>
                <span class="badge badge-priority-@priority.ToLower()">@priority</span>
                @if (t.DueDate.HasValue)
                {
                    <div class="task-meta @(isOverdue ? "task-overdue" : "")">
                        @(isOverdue ? "Overdue · " : "")@t.DueDate.Value.ToString("MMM d")
                    </div>
                }
                <div style="display:flex; gap:4px;">
                    <a asp-action="Edit" asp-route-id="@t.Id" class="btn-los btn-ghost btn-icon-sm" title="Edit">
                        <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M11 2l3 3-9 9H2v-3L11 2z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
                    </a>
                    <form method="post" asp-action="Delete" asp-controller="PersonalTasks">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@t.Id" />
                        <button type="submit" class="btn-los btn-ghost btn-icon-sm" style="color:var(--rose);" data-confirm="Delete '@t.Title'?" title="Delete">
                            <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M3 4h10M6 4V2h4v2M5 4l1 9h4l1-9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}

<!-- Completed Tasks (collapsible) -->
@{
    var completedTasks = Model.Where(t => t.IsCompleted).OrderByDescending(t => t.CompletedAt).ToList();
}
@if (completedTasks.Any())
{
    <div class="los-section-label" style="margin-top:8px;">
        <button class="btn-los btn-ghost btn-xs" style="font-size:0.65rem; text-transform:uppercase; letter-spacing:.14em; font-weight:700; color:var(--text-tertiary); padding:0;" data-bs-toggle="collapse" data-bs-target="#completedTasks">
            Completed (@completedTasks.Count) ▾
        </button>
    </div>
    <div class="collapse" id="completedTasks">
        <div class="d-flex flex-column gap-2">
            @foreach (var t in completedTasks)
            {
                <div class="task-item task-done">
                    <form method="post" asp-action="ToggleComplete" asp-controller="PersonalTasks" style="display:contents">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@t.Id" />
                        <button type="submit" class="task-check">
                            <svg width="10" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4l3 3 5-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </button>
                    </form>
                    <div class="task-title">@t.Title</div>
                    <div class="task-meta">@(t.CompletedAt?.ToString("MMM d") ?? "")</div>
                    <form method="post" asp-action="Delete" asp-controller="PersonalTasks">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@t.Id" />
                        <button type="submit" class="btn-los btn-ghost btn-icon-sm" style="color:var(--rose);" data-confirm="Delete?">
                            <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M3 4h10M5 4l1 9h4l1-9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="los-card">
        <div class="empty-state">
            <div class="empty-state-icon">✓</div>
            <div class="empty-state-title">No tasks yet</div>
            <div class="empty-state-desc">Capture every action item here. A clear task list means a clear mind.</div>
            <button class="btn-los btn-primary" data-bs-toggle="collapse" data-bs-target="#addTaskPanel">Add Your First Task</button>
        </div>
    </div>
}