@model LifeOS.MVC.Models.StudySubjectDetailViewModel
@{
    var s = Model.Subject;
    ViewData["Title"] = s.Name;
    var todayIso = DateTime.Today.ToString("yyyy-MM-dd");
    int pct = Math.Clamp(s.ProgressPercent, 0, 100);
    bool autoProgress = LifeOS.MVC.Controllers.StudyController.IsAutoProgress(s, s.Tasks.Count);
    bool resourceIsLink = Uri.TryCreate(s.ResourceUrl, UriKind.Absolute, out var resUri) && (resUri.Scheme == Uri.UriSchemeHttp || resUri.Scheme == Uri.UriSchemeHttps);
    string[] categories = { "Programming", "Math", "Language", "Religion", "Science", "Exam Prep", "History", "Business", "General" };
    double maxDay = Model.Last7Days.Values.DefaultIfEmpty(0).Max();
}

<div class="db">
    <div class="db-head">
        <div style="min-width:0;">
            <a class="db-link" href="/Study">← Studies</a>
            <h1 class="db-title lo-goal-title">@s.Name</h1>
            <div class="lo-chips">
                <span class="db-badge">@s.Category</span>
                <span class="db-badge">@s.Status</span>
                @if (!string.IsNullOrEmpty(s.CurrentTopic)) { <span class="db-badge">Now: @s.CurrentTopic</span> }
                @if (!string.IsNullOrWhiteSpace(s.ResourceUrl))
                {
                    if (resourceIsLink) { <a class="db-link" href="@resUri!.AbsoluteUri" target="_blank" rel="noopener noreferrer">Resource ↗</a> }
                    else { <span class="db-badge">Resource: @s.ResourceUrl</span> }
                }
            </div>
        </div>
        <div class="db-actions">
            <a class="lo-btn" href="#editSubject">Edit subject</a>
            <a class="lo-btn lo-btn-primary" href="#logSession">Log session</a>
        </div>
    </div>

    @if (TempData["Success"] is string ok) { <div class="lo-flash" role="status">@ok</div> }
    @if (TempData["Info"] is string info) { <div class="lo-flash" role="status">@info</div> }
    @if (!string.IsNullOrWhiteSpace(s.Description)) { <p class="db-muted db-small" style="margin:0;">@s.Description</p> }

    <div class="db-grid-levels">
        <div class="db-level"><span class="db-muted db-tiny">Progress @(autoProgress ? "(auto)" : "")</span><span class="db-level-pct lo-num">@pct%</span><div class="db-bar" role="presentation"><span class="@(pct < 40 ? "low" : "")" style="width:@pct%"></span></div></div>
        <div class="db-level"><span class="db-muted db-tiny">Total hours</span><span class="db-level-pct lo-num">@Model.TotalHours.ToString("0.#")h</span><span class="db-muted db-tiny">@(s.TargetHours > 0 ? $"of {s.TargetHours}h target" : "no target")</span></div>
        <div class="db-level"><span class="db-muted db-tiny">This week (since Monday)</span><span class="db-level-pct lo-num">@Model.WeekHours.ToString("0.#")h</span><span class="db-muted db-tiny">@(s.WeeklyTargetHours > 0 ? $"of {s.WeeklyTargetHours:0.#}h weekly target" : "no weekly target")</span></div>
        <div class="db-level"><span class="db-muted db-tiny">Sessions</span><span class="db-level-pct lo-num">@Model.TotalSessions</span><span class="db-muted db-tiny">average focus @Model.AvgFocusRating/10</span></div>
    </div>

    <section class="db-card" aria-labelledby="weekChart">
        <div class="db-card-head"><h2 id="weekChart" class="db-h2">Last 7 days</h2><span class="db-muted db-small lo-num">@Model.Last7Days.Values.Sum().ToString("0.#")h</span></div>
        <div class="db-chart" style="height:150px;" role="img" aria-label="Study hours, last 7 days: @string.Join(", ", Model.Last7Days.OrderBy(k => k.Key).Select(k => $"{k.Key:ddd} {k.Value:0.#} hours"))">
            @foreach (var kv in Model.Last7Days.OrderBy(k => k.Key))
            {
                int h = maxDay > 0 ? (int)Math.Round(kv.Value / maxDay * 100) : 0;
                <div class="db-chart-col">
                    <span class="db-chart-val lo-num">@(kv.Value > 0 ? kv.Value.ToString("0.#") : "–")</span>
                    <div class="db-chart-bar @(kv.Key == DateTime.Today ? "today" : "") @(kv.Value > 0 ? "" : "empty")" style="height:@(h + 4)px"></div>
                    <span class="db-chart-day">@(kv.Key == DateTime.Today ? "Today" : kv.Key.ToString("ddd"))</span>
                </div>
            }
        </div>
    </section>

    @await Html.PartialAsync("_SubjectTasks", s)

    <div class="db-grid-2">
        <section class="db-card" id="logSession" aria-labelledby="logTitle">
            <h2 id="logTitle" class="db-h2">Log a study session</h2>
            <form method="post" asp-action="LogSession" class="lo-form">
                <input type="hidden" name="StudySubjectId" value="@s.Id" />
                <div class="lo-form-grid">
                    <div class="lo-field"><label for="ssDate" class="lo-label">Date</label><input id="ssDate" name="SessionDate" type="date" class="lo-input" value="@todayIso" max="@todayIso" required /></div>
                    <div class="lo-field"><label for="ssHours" class="lo-label">Hours <span aria-hidden="true">*</span></label><input id="ssHours" name="DurationHours" type="number" step="0.25" min="0.25" max="24" class="lo-input" required placeholder="1.5" /></div>
                    <div class="lo-field"><label for="ssFocus" class="lo-label">Focus (1–10)</label><input id="ssFocus" name="FocusRating" type="number" min="1" max="10" value="7" class="lo-input" /></div>
                </div>
                <div class="lo-field"><label for="ssTopic" class="lo-label">Topic covered</label><input id="ssTopic" name="TopicCovered" class="lo-input" maxlength="200" placeholder="What did you study?" /></div>
                <div class="lo-field"><label for="ssNotes" class="lo-label">Notes <span class="db-muted">(optional)</span></label><input id="ssNotes" name="Notes" class="lo-input" maxlength="500" /></div>
                <div class="lo-form-actions"><button type="submit" class="lo-btn lo-btn-primary">Log session</button></div>
            </form>
        </section>

        <section class="db-card" aria-labelledby="sessionsTitle">
            <h2 id="sessionsTitle" class="db-h2">Recent sessions</h2>
            @if (!Model.Sessions.Any()) { <p class="db-empty">No sessions yet.</p> }
            @foreach (var x in Model.Sessions.Take(12))
            {
                <div class="db-activity">
                    <span><strong>@x.SessionDate.ToString("ddd d MMM")</strong> · @x.DurationHours.ToString("0.##")h · focus @x.FocusRating/10@(string.IsNullOrEmpty(x.TopicCovered) ? "" : " · " + x.TopicCovered)</span>
                    <form method="post" asp-action="DeleteSession">
                        <input type="hidden" name="sessionId" value="@x.Id" />
                        <input type="hidden" name="subjectId" value="@s.Id" />
                        <button type="submit" class="lo-btn lo-btn-sm lo-btn-danger" aria-label="Delete session of @x.SessionDate.ToString("d MMMM")" data-confirm="Delete this session?">Delete</button>
                    </form>
                </div>
            }
            @if (Model.Sessions.Count > 12) { <p class="db-muted db-tiny" style="margin:0;">Showing the latest 12 of @Model.Sessions.Count sessions.</p> }
        </section>
    </div>

    <section class="db-section" aria-labelledby="notesTitle">
        <div class="db-section-head"><h2 id="notesTitle" class="db-h2-lg">Notes</h2><span class="db-muted db-small lo-num">@Model.Notes.Count</span></div>
        <div class="db-grid-2">
            @foreach (var n in Model.Notes)
            {
                <article class="db-card lo-goal @(n.IsPinned ? "is-achieved" : "")">
                    <div class="db-card-head">
                        <div style="min-width:0;">
                            <div class="db-muted db-tiny">@(n.IsPinned ? "Pinned · " : "")@n.CreatedAt.ToString("d MMM yyyy")@(n.UpdatedAt > n.CreatedAt.AddMinutes(1) ? " · edited " + n.UpdatedAt.ToString("d MMM") : "")</div>
                            <h3 class="db-h2 lo-goal-title">@n.Title</h3>
                        </div>
                        <form method="post" asp-action="TogglePin">
                            <input type="hidden" name="noteId" value="@n.Id" />
                            <input type="hidden" name="subjectId" value="@s.Id" />
                            <button type="submit" class="lo-btn lo-btn-sm" aria-pressed="@(n.IsPinned ? "true" : "false")">@(n.IsPinned ? "Unpin" : "Pin")</button>
                        </form>
                    </div>
                    @if (!string.IsNullOrEmpty(n.Tags)) { <div class="lo-chips">@foreach (var tag in n.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries)) { <span class="db-badge">@tag.Trim()</span> }</div> }
                    @if (!string.IsNullOrEmpty(n.Content)) { <p class="db-small" style="margin:0; white-space:pre-wrap;">@n.Content</p> }
                    <details class="lo-goal-edit">
                        <summary class="db-link">Edit or delete note</summary>
                        <form method="post" asp-action="EditNote" class="lo-form">
                            <input type="hidden" name="Id" value="@n.Id" />
                            <input type="hidden" name="StudySubjectId" value="@s.Id" />
                            <div class="lo-field"><label class="lo-label" for="nT-@(n.Id)">Title</label><input id="nT-@(n.Id)" name="Title" class="lo-input" value="@n.Title" required maxlength="200" /></div>
                            <div class="lo-field"><label class="lo-label" for="nG-@(n.Id)">Tags</label><input id="nG-@(n.Id)" name="Tags" class="lo-input" value="@n.Tags" maxlength="200" /></div>
                            <div class="lo-field"><label class="lo-label" for="nC-@(n.Id)">Content</label><textarea id="nC-@(n.Id)" name="Content" class="lo-input lo-textarea" maxlength="4000">@n.Content</textarea></div>
                            <label class="lo-check-label"><input type="checkbox" name="IsPinned" value="true" checked="@n.IsPinned" /> Pinned</label>
                            <div class="lo-form-actions"><button type="submit" class="lo-btn lo-btn-primary lo-btn-sm">Save note</button></div>
                        </form>
                        <form method="post" asp-action="DeleteNote" class="lo-form-actions">
                            <input type="hidden" name="noteId" value="@n.Id" />
                            <input type="hidden" name="subjectId" value="@s.Id" />
                            <button type="submit" class="lo-btn lo-btn-sm lo-btn-danger" data-confirm="Delete the note '@n.Title'?">Delete note</button>
                        </form>
                    </details>
                </article>
            }
            <section class="db-card" aria-labelledby="addNoteTitle">
                <h3 id="addNoteTitle" class="db-h2">Add a note</h3>
                <form method="post" asp-action="AddNote" class="lo-form">
                    <input type="hidden" name="StudySubjectId" value="@s.Id" />
                    <div class="lo-field"><label for="anT" class="lo-label">Title <span aria-hidden="true">*</span></label><input id="anT" name="Title" class="lo-input" required maxlength="200" /></div>
                    <div class="lo-field"><label for="anG" class="lo-label">Tags <span class="db-muted">(comma separated)</span></label><input id="anG" name="Tags" class="lo-input" maxlength="200" /></div>
                    <div class="lo-field"><label for="anC" class="lo-label">Content</label><textarea id="anC" name="Content" class="lo-input lo-textarea" maxlength="4000"></textarea></div>
                    <label class="lo-check-label"><input type="checkbox" name="IsPinned" value="true" /> Pin this note</label>
                    <div class="lo-form-actions"><button type="submit" class="lo-btn lo-btn-primary">Save note</button></div>
                </form>
            </section>
        </div>
    </section>

    <section class="db-card" id="editSubject" aria-labelledby="editSubjectTitle">
        <h2 id="editSubjectTitle" class="db-h2">Edit subject</h2>
        <form method="post" asp-action="UpdateSubject" class="lo-form">
            <input type="hidden" name="Id" value="@s.Id" />
            <div class="lo-field"><label for="esName" class="lo-label">Name <span aria-hidden="true">*</span></label><input id="esName" name="Name" class="lo-input" value="@s.Name" required maxlength="150" /></div>
            <div class="lo-form-grid">
                <div class="lo-field"><label for="esCat" class="lo-label">Category</label><select id="esCat" name="Category" class="lo-select">@foreach (var c in categories.Union(new[] { s.Category })) { <option selected="@(s.Category == c)">@c</option> }</select></div>
                <div class="lo-field"><label for="esStatus" class="lo-label">Status</label><select id="esStatus" name="Status" class="lo-select"><option value="Active" selected="@(s.Status == "Active")">Active</option><option value="Paused" selected="@(s.Status == "Paused")">Paused</option><option value="Completed" selected="@(s.Status == "Completed")">Completed</option></select></div>
                <div class="lo-field"><label for="esTarget" class="lo-label">Target hours</label><input id="esTarget" name="TargetHours" type="number" min="0" max="100000" class="lo-input" value="@s.TargetHours" /></div>
                <div class="lo-field"><label for="esWeekly" class="lo-label">Weekly target (h)</label><input id="esWeekly" name="WeeklyTargetHours" type="number" step="0.5" min="0" max="168" class="lo-input" value="@s.WeeklyTargetHours.ToString(System.Globalization.CultureInfo.InvariantCulture)" /></div>
                <div class="lo-field">
                    <label for="esProgress" class="lo-label">Progress %</label>
                    @if (autoProgress)
                    {
                        <input type="hidden" name="ProgressPercent" value="@s.ProgressPercent" />
                        <input id="esProgress" class="lo-input" value="@s.ProgressPercent% (auto)" disabled title="Calculated from target hours and subject tasks" />
                    }
                    else { <input id="esProgress" name="ProgressPercent" type="number" min="0" max="100" class="lo-input" value="@s.ProgressPercent" /> }
                </div>
            </div>
            <div class="lo-form-grid">
                <div class="lo-field"><label for="esTopic" class="lo-label">Current topic</label><input id="esTopic" name="CurrentTopic" class="lo-input" maxlength="200" value="@s.CurrentTopic" /></div>
                <div class="lo-field"><label for="esRes" class="lo-label">Resource / link</label><input id="esRes" name="ResourceUrl" class="lo-input" maxlength="200" value="@s.ResourceUrl" /></div>
            </div>
            <div class="lo-field"><label for="esDesc" class="lo-label">Description</label><input id="esDesc" name="Description" class="lo-input" maxlength="300" value="@s.Description" /></div>
            <div class="lo-form-actions">
                <button type="submit" form="deleteSubjectForm" class="lo-btn lo-btn-danger" data-confirm="Delete '@s.Name' with all its sessions, tasks and notes?">Delete subject</button>
                <button type="submit" class="lo-btn lo-btn-primary">Save subject</button>
            </div>
        </form>
        <form id="deleteSubjectForm" method="post" asp-action="DeleteSubject"><input type="hidden" name="id" value="@s.Id" /></form>
    </section>
</div>
