@model LifeOS.MVC.Models.StudyDashboardViewModel
@{
    ViewData["Title"] = "Studies";
    var active = Model.Subjects.Where(s => s.Status == "Active").ToList();
    var others = Model.Subjects.Where(s => s.Status != "Active").ToList();
    double weekTarget = active.Sum(s => s.WeeklyTargetHours);
    string[] categories = { "Programming", "Math", "Language", "Religion", "Science", "Exam Prep", "History", "Business", "General" };
}

<div class="db">
    <div class="db-head">
        <div>
            <div class="db-date">Studies</div>
            <h1 class="db-title">Learn a little, every week.</h1>
        </div>
        <div class="db-actions">
            <a class="lo-btn lo-btn-primary" href="#newSubject">@await Html.PartialAsync("_Icon", "plus") New subject</a>
        </div>
    </div>

    @if (TempData["Success"] is string ok) { <div class="lo-flash" role="status">@ok</div> }
    @if (TempData["Info"] is string info) { <div class="lo-flash" role="status">@info</div> }

    <div class="db-grid-levels">
        <div class="db-level"><span class="db-muted db-tiny">Active subjects</span><span class="db-level-pct lo-num">@Model.ActiveSubjects</span><span class="db-muted db-tiny">@Model.CompletedSubjects completed</span></div>
        <div class="db-level"><span class="db-muted db-tiny">This week (since Monday)</span><span class="db-level-pct lo-num">@Model.ThisWeekHours.ToString("0.#")h</span><span class="db-muted db-tiny">@(weekTarget > 0 ? $"of {weekTarget:0.#}h weekly target" : "no weekly target set")</span></div>
        <div class="db-level"><span class="db-muted db-tiny">Today</span><span class="db-level-pct lo-num">@Model.TodayHours.ToString("0.#")h</span><span class="db-muted db-tiny">@Model.TodaySessions.Count sessions</span></div>
        <div class="db-level"><span class="db-muted db-tiny">All time</span><span class="db-level-pct lo-num">@Model.TotalHoursAllTime.ToString("0.#")h</span><span class="db-muted db-tiny">@Model.TotalNotes notes</span></div>
    </div>

    @if (!Model.Subjects.Any())
    {
        <section class="db-card"><p class="db-empty">No subjects yet. Add your first subject below to log study sessions and notes.</p></section>
    }

    @if (active.Any())
    {
        <section class="db-section" aria-labelledby="activeTitle">
            <div class="db-section-head"><h2 id="activeTitle" class="db-h2-lg">Active</h2><span class="db-muted db-small lo-num">@active.Count</span></div>
            <div class="db-grid-3">@foreach (var s in active) { @await Html.PartialAsync("_StudySubjectCard", s) }</div>
        </section>
    }
    @if (others.Any())
    {
        <section class="db-section" aria-labelledby="otherTitle">
            <div class="db-section-head"><h2 id="otherTitle" class="db-h2-lg">Paused and completed</h2><span class="db-muted db-small lo-num">@others.Count</span></div>
            <div class="db-grid-3">@foreach (var s in others) { @await Html.PartialAsync("_StudySubjectCard", s) }</div>
        </section>
    }

    @if (Model.ThisWeekSessions.Any() || Model.RecentNotes.Any())
    {
        <div class="db-grid-2">
            <section class="db-card" aria-labelledby="weekTitle">
                <h2 id="weekTitle" class="db-h2">Sessions this week</h2>
                @if (!Model.ThisWeekSessions.Any()) { <p class="db-empty">No sessions since Monday.</p> }
                @foreach (var s in Model.ThisWeekSessions.Take(8))
                {
                    <a class="db-activity lo-hist-row" href="/Study/Subject/@s.StudySubjectId"><span><strong>@s.StudySubject?.Name</strong>@(string.IsNullOrEmpty(s.TopicCovered) ? "" : " · " + s.TopicCovered)</span><span class="db-muted lo-num">@s.SessionDate.ToString("ddd") · @s.DurationHours.ToString("0.##")h</span></a>
                }
            </section>
            <section class="db-card" aria-labelledby="notesTitle">
                <h2 id="notesTitle" class="db-h2">Recent notes</h2>
                @if (!Model.RecentNotes.Any()) { <p class="db-empty">No notes yet.</p> }
                @foreach (var n in Model.RecentNotes)
                {
                    <a class="db-activity lo-hist-row" href="/Study/Subject/@n.StudySubjectId"><span>@(n.IsPinned ? "Pinned · " : "")<strong>@n.Title</strong> · @n.StudySubject?.Name</span><span class="db-muted lo-num">@n.CreatedAt.ToString("d MMM")</span></a>
                }
            </section>
        </div>
    }

    <section class="db-card" id="newSubject" aria-labelledby="newSubjectTitle">
        <h2 id="newSubjectTitle" class="db-h2">New subject</h2>
        <form method="post" asp-action="CreateSubject" class="lo-form">
            <div class="lo-field"><label for="sName" class="lo-label">Subject name <span aria-hidden="true">*</span></label><input id="sName" name="Name" class="lo-input" required maxlength="150" placeholder="e.g. ASP.NET Core, Calculus, Arabic" /></div>
            <div class="lo-form-grid">
                <div class="lo-field"><label for="sCat" class="lo-label">Category</label><select id="sCat" name="Category" class="lo-select">@foreach (var c in categories) { <option>@c</option> }</select></div>
                <div class="lo-field"><label for="sTarget" class="lo-label">Target hours <span class="db-muted">(0 = none)</span></label><input id="sTarget" name="TargetHours" type="number" min="0" max="100000" value="0" class="lo-input" /></div>
                <div class="lo-field"><label for="sWeekly" class="lo-label">Weekly target (h)</label><input id="sWeekly" name="WeeklyTargetHours" type="number" step="0.5" min="0" max="168" value="0" class="lo-input" /></div>
            </div>
            <div class="lo-form-grid">
                <div class="lo-field"><label for="sTopic" class="lo-label">Current topic</label><input id="sTopic" name="CurrentTopic" class="lo-input" maxlength="200" placeholder="Where are you right now?" /></div>
                <div class="lo-field"><label for="sRes" class="lo-label">Resource / link</label><input id="sRes" name="ResourceUrl" class="lo-input" maxlength="200" placeholder="Book name or https://…" /></div>
            </div>
            <div class="lo-field"><label for="sDesc" class="lo-label">Why you are studying this <span class="db-muted">(optional)</span></label><input id="sDesc" name="Description" class="lo-input" maxlength="300" /></div>
            <div class="lo-form-actions"><button type="submit" class="lo-btn lo-btn-primary">Add subject</button></div>
        </form>
    </section>
</div>
