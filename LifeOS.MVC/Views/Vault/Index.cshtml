@model List<LifeOS.Models.VaultEntry>
@{
    ViewData["Title"] = "Vault";
    string? search   = ViewBag.Search;
    string? category = ViewBag.Category;
    var cats = new[]{"Account","Social","Bank","Email","Dev","Subscription","Other"};
    bool vaultLocked = TempData["VaultLocked"] as bool? ?? false;
}

@if (TempData["Success"] != null) { <div class="los-alert los-alert-success">✓ @TempData["Success"]</div> }

<style>
.vault-card {
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 16px 18px;
    box-shadow: var(--shadow-xs);
    transition: all .15s ease;
    position: relative;
    overflow: hidden;
}
.vault-card:hover { box-shadow: var(--shadow-sm); }
.vault-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 3px; height: 100%;
    background: var(--accent);
}
.vault-card.fav::before { background: var(--amber); }
.vault-card.bank::before { background: var(--green); }
.vault-card.social::before { background: var(--violet); }

.vault-field {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.82rem;
}
.vault-field:last-child { border-bottom: none; }

.vault-field-label {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--text-disabled);
    min-width: 70px;
}

.vault-field-val {
    color: var(--text-secondary);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin: 0 8px;
}

.vault-pw {
    letter-spacing: .15em;
    color: var(--text-disabled);
    user-select: none;
}
.vault-pw.revealed {
    letter-spacing: normal;
    color: var(--text-primary);
    user-select: text;
}

.copy-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-disabled);
    padding: 2px 5px;
    border-radius: 3px;
    font-size: 0.7rem;
    transition: all .12s ease;
    flex-shrink: 0;
}
.copy-btn:hover { background: var(--surface-2); color: var(--accent); }

.cat-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px; height: 32px;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    flex-shrink: 0;
}
</style>

<div class="los-page-header">
    <div>
        <div class="los-page-title">
            🔒 Vault
        </div>
        <div class="los-page-subtitle">
            @Model.Count saved — Passwords, accounts, and credentials. Keep private.
        </div>
    </div>
    <div class="los-page-actions">
        <button class="btn-los btn-primary"
                data-bs-toggle="collapse" data-bs-target="#addVaultPanel">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            Add Entry
        </button>
    </div>
</div>

<!-- Warning -->
<div style="background:rgba(217,119,6,0.08); border:1px solid rgba(217,119,6,0.2);
            border-radius:var(--radius-md); padding:10px 16px; margin-bottom:20px;
            font-size:0.8rem; color:var(--amber); display:flex; align-items:center; gap:8px;">
    ⚠️ <span>This is a personal local system. Passwords are base64 encoded for basic privacy on a shared screen. Do not rely on this for high-security needs.</span>
</div>

<!-- Search -->
<form method="get" asp-action="Index" asp-controller="Vault" class="mb-4">
    <div style="display:flex; gap:8px;">
        <div style="position:relative; flex:1;">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
                 style="position:absolute;left:12px;top:50%;transform:translateY(-50%);
                        color:var(--text-tertiary);pointer-events:none;">
                <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5"/>
                <path d="M11 11l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <input name="search" value="@search" class="form-control"
                   placeholder="Search accounts…" style="padding-left:38px;" autocomplete="off"/>
        </div>
        <select name="category" class="form-control" style="width:150px;"
                onchange="this.form.submit()">
            <option value="">All Categories</option>
            @foreach (var c in cats)
            {
                <option value="@c" selected="@(category == c)">@c</option>
            }
        </select>
        <button type="submit" class="btn-los btn-secondary">Search</button>
        @if (!string.IsNullOrEmpty(search)||!string.IsNullOrEmpty(category))
        { <a asp-action="Index" class="btn-los btn-ghost">✕ Clear</a> }
    </div>
</form>

<!-- Add Panel -->
<div class="collapse" id="addVaultPanel">
    <div class="los-panel" style="margin-bottom:20px; border-left:3px solid var(--amber);">
        <div class="los-panel-title">Add New Account / Credential</div>
        <form method="post" asp-action="Create" asp-controller="Vault">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Name / Service *</label>
                        <input name="Name" class="form-control" required
                               placeholder="e.g. Gmail, GitHub" maxlength="150"/>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="form-label">Category</label>
                        <select name="Category" class="form-control">
                            @foreach (var c in cats)
                            { <option value="@c">@c</option> }
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Username</label>
                        <input name="Username" class="form-control"
                               placeholder="username / handle" maxlength="200"/>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <input name="Email" class="form-control" type="email"
                               placeholder="linked email" maxlength="200"/>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Password</label>
                        <div style="position:relative;">
                            <input name="PasswordPlain" class="form-control"
                                   type="password" placeholder="••••••••"
                                   id="newPw" autocomplete="new-password"/>
                            <button type="button" onclick="togglePw('newPw')"
                                    style="position:absolute;right:10px;top:50%;
                                           transform:translateY(-50%);background:none;
                                           border:none;cursor:pointer;color:var(--text-tertiary);
                                           font-size:0.75rem;">
                                👁
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Website URL</label>
                        <input name="Url" class="form-control"
                               placeholder="https://…" maxlength="500"/>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Recovery Email</label>
                        <input name="RecoveryEmail" class="form-control"
                               placeholder="recovery email" maxlength="300"/>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Phone</label>
                        <input name="PhoneNumber" class="form-control"
                               placeholder="+92…" maxlength="300"/>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Notes</label>
                        <input name="Notes" class="form-control"
                               placeholder="Security question, extra info…" maxlength="500"/>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">2FA Method</label>
                        <input name="TwoFactorMethod" class="form-control"
                               placeholder="App / SMS / Email"/>
                    </div>
                </div>
                <div class="col-md-3 d-flex align-items-end gap-3">
                    <label class="toggle-wrap">
                        <div class="toggle">
                            <input name="TwoFactorEnabled" type="checkbox" value="true"/>
                            <div class="toggle-track"></div>
                        </div>
                        <span class="toggle-label">2FA On</span>
                    </label>
                    <label class="toggle-wrap">
                        <div class="toggle">
                            <input name="IsFavorite" type="checkbox" value="true"/>
                            <div class="toggle-track"></div>
                        </div>
                        <span class="toggle-label">★</span>
                    </label>
                </div>
                <div class="col-12 d-flex justify-content-end">
                    <button type="submit" class="btn-los btn-primary">Save to Vault</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="los-kpi">
            <div class="los-kpi-icon icon-bg-indigo">🔐</div>
            <div class="los-kpi-value">@Model.Count</div>
            <div class="los-kpi-label">Accounts</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="los-kpi">
            <div class="los-kpi-icon icon-bg-green">🛡</div>
            <div class="los-kpi-value" style="color:var(--green)">
                @Model.Count(v=>v.TwoFactorEnabled)
            </div>
            <div class="los-kpi-label">2FA Enabled</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="los-kpi">
            <div class="los-kpi-icon icon-bg-amber">★</div>
            <div class="los-kpi-value" style="color:var(--amber)">
                @Model.Count(v=>v.IsFavorite)
            </div>
            <div class="los-kpi-label">Favorites</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="los-kpi">
            <div class="los-kpi-icon icon-bg-rose">⚠</div>
            <div class="los-kpi-value" style="color:@(Model.Count(v=>!v.TwoFactorEnabled)>5?"var(--rose)":"var(--text-primary)")">
                @Model.Count(v=>!v.TwoFactorEnabled)
            </div>
            <div class="los-kpi-label">No 2FA</div>
        </div>
    </div>
</div>

<!-- Vault Entries -->
@if (!Model.Any())
{
    <div class="los-card">
        <div class="empty-state">
            <div class="empty-state-icon">🔒</div>
            <div class="empty-state-title">Vault is empty</div>
            <div class="empty-state-desc">Add accounts, passwords, and credentials. All stored locally.</div>
            <button class="btn-los btn-primary"
                    data-bs-toggle="collapse" data-bs-target="#addVaultPanel">
                Add First Entry
            </button>
        </div>
    </div>
}
else
{
    @foreach (var grp in Model.GroupBy(v=>v.Category).OrderBy(g=>g.Key))
    {
        <div class="los-section-label">@grp.Key</div>
        <div class="row g-3 mb-4">
            @foreach (var v in grp)
            {
                string catClass = v.Category == "Bank"   ? "bank"
                                : v.Category == "Social" ? "social"
                                : v.IsFavorite           ? "fav" : "";
                string catEmoji = v.Category switch {
                    "Bank"   => "🏦", "Social"=> "💬", "Email"  => "📧",
                    "Dev"    => "⚙️", "Account"=> "👤","Subscription"=>"💳",
                    _        => "🔑"
                };

                <div class="col-lg-6">
                    <div class="vault-card @catClass">
                        <!-- Header -->
                        <div style="display:flex; justify-content:space-between;
                                    align-items:flex-start; margin-bottom:12px;">
                            <div style="display:flex; align-items:center; gap:10px;">
                                <div class="cat-icon" style="background:var(--surface-2);">
                                    @catEmoji
                                </div>
                                <div>
                                    <div style="font-size:0.92rem; font-weight:700;
                                                color:var(--text-primary);">@v.Name</div>
                                    <div style="display:flex; gap:5px; margin-top:3px; flex-wrap:wrap;">
                                        <span class="badge badge-neutral">@v.Category</span>
                                        @if (v.TwoFactorEnabled)
                                        { <span class="badge badge-green">🛡 2FA</span> }
                                        @if (v.IsFavorite)
                                        { <span style="color:var(--amber); font-size:0.8rem;">★</span> }
                                    </div>
                                </div>
                            </div>
                            <div style="display:flex; gap:3px;">
                                <button class="btn-los btn-ghost btn-icon-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editVault@v.Id">
                                    <svg width="12" height="12" viewBox="0 0 16 16" fill="none">
                                        <path d="M11 2l3 3-9 9H2v-3L11 2z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                                    </svg>
                                </button>
                                <form method="post" asp-action="Delete" asp-controller="Vault">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@v.Id"/>
                                    <button type="submit" class="btn-los btn-ghost btn-icon-sm"
                                            style="color:var(--rose);"
                                            data-confirm="Delete '@v.Name' from vault?">
                                        <svg width="12" height="12" viewBox="0 0 16 16" fill="none">
                                            <path d="M3 4h10M5 4l1 9h4l1-9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Fields -->
                        @if (!string.IsNullOrEmpty(v.Username))
                        {
                            <div class="vault-field">
                                <span class="vault-field-label">Username</span>
                                <span class="vault-field-val" id="un@v.Id">@v.Username</span>
                                <button class="copy-btn" onclick="copyText('@v.Username', this)"
                                        title="Copy">⎘</button>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(v.Email))
                        {
                            <div class="vault-field">
                                <span class="vault-field-label">Email</span>
                                <span class="vault-field-val">@v.Email</span>
                                <button class="copy-btn" onclick="copyText('@v.Email', this)"
                                        title="Copy">⎘</button>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(v.PasswordEncoded))
                        {
                            <div class="vault-field">
                                <span class="vault-field-label">Password</span>
                                <span class="vault-field-val vault-pw"
                                      id="pw@v.Id"
                                      data-plain="@v.PasswordPlain">
                                    ••••••••••
                                </span>
                                <button class="copy-btn" onclick="revealPw(@v.Id, this)"
                                        title="Show/Hide">👁</button>
                                <button class="copy-btn"
                                        onclick="copyText(document.getElementById('pw@v.Id').dataset.plain, this)"
                                        title="Copy">⎘</button>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(v.Url))
                        {
                            <div class="vault-field">
                                <span class="vault-field-label">URL</span>
                                <a href="@v.Url" target="_blank" rel="noopener"
                                   style="font-size:0.78rem; color:var(--accent);
                                          flex:1; margin:0 8px; overflow:hidden;
                                          text-overflow:ellipsis; white-space:nowrap;">
                                    @v.Url
                                </a>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(v.PhoneNumber))
                        {
                            <div class="vault-field">
                                <span class="vault-field-label">Phone</span>
                                <span class="vault-field-val">@v.PhoneNumber</span>
                                <button class="copy-btn" onclick="copyText('@v.PhoneNumber', this)">⎘</button>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(v.RecoveryEmail))
                        {
                            <div class="vault-field">
                                <span class="vault-field-label">Recovery</span>
                                <span class="vault-field-val">@v.RecoveryEmail</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(v.TwoFactorMethod) && v.TwoFactorEnabled)
                        {
                            <div class="vault-field">
                                <span class="vault-field-label">2FA</span>
                                <span class="vault-field-val" style="color:var(--green);">
                                    ✓ @v.TwoFactorMethod
                                </span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(v.Notes))
                        {
                            <div style="margin-top:8px; padding:8px 10px;
                                        background:var(--surface-2); border-radius:var(--radius-sm);
                                        font-size:0.75rem; color:var(--text-tertiary);">
                                📝 @v.Notes
                            </div>
                        }
                    </div>
                </div>

                <!-- Edit Modal -->
                <div class="modal fade" id="editVault@v.Id" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Edit — @v.Name</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <form method="post" asp-action="Edit" asp-controller="Vault">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Id" value="@v.Id"/>
                                <div class="modal-body">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-label">Name</label>
                                                <input name="Name" class="form-control"
                                                       value="@v.Name" required/>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-label">Category</label>
                                                <select name="Category" class="form-control">
                                                    @foreach (var c in cats)
                                                    {
                                                        <option value="@c" selected="@(v.Category == c)">@c</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-label">Username</label>
                                                <input name="Username" class="form-control" value="@v.Username"/>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-label">Email</label>
                                                <input name="Email" class="form-control" value="@v.Email"/>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-label">Password (leave blank to keep)</label>
                                                <input name="PasswordPlain" class="form-control"
                                                       type="password" placeholder="New password or leave blank"/>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-label">URL</label>
                                                <input name="Url" class="form-control" value="@v.Url"/>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-label">Recovery Email</label>
                                                <input name="RecoveryEmail" class="form-control" value="@v.RecoveryEmail"/>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="form-label">Phone</label>
                                                <input name="PhoneNumber" class="form-control" value="@v.PhoneNumber"/>
                                            </div>
                                        </div>
                                        <div class="col-md-8">
                                            <div class="form-group">
                                                <label class="form-label">Notes</label>
                                                <input name="Notes" class="form-control" value="@v.Notes"/>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label class="form-label">2FA Method</label>
                                                <input name="TwoFactorMethod" class="form-control"
                                                       value="@v.TwoFactorMethod"/>
                                            </div>
                                        </div>
                                        <div class="col-12 d-flex gap-4">
                                            <label class="toggle-wrap">
                                                <div class="toggle">
                                                    <input name="TwoFactorEnabled" type="checkbox"
                                                           value="true" @(v.TwoFactorEnabled?"checked":"")/>
                                                    <div class="toggle-track"></div>
                                                </div>
                                                <span class="toggle-label">2FA Enabled</span>
                                            </label>
                                            <label class="toggle-wrap">
                                                <div class="toggle">
                                                    <input name="IsFavorite" type="checkbox"
                                                           value="true" @(v.IsFavorite?"checked":"")/>
                                                    <div class="toggle-track"></div>
                                                </div>
                                                <span class="toggle-label">Favorite</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn-los btn-secondary"
                                            data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn-los btn-primary">Save</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

<script>
function revealPw(id, btn) {
    const el = document.getElementById('pw' + id);
    if (!el) return;
    const isHidden = el.classList.contains('vault-pw') && !el.classList.contains('revealed');
    if (isHidden) {
        el.textContent = el.dataset.plain || '(empty)';
        el.classList.add('revealed');
        btn.textContent = '🙈';
        // Auto-hide after 8 seconds
        setTimeout(() => {
            el.textContent = '••••••••••';
            el.classList.remove('revealed');
            btn.textContent = '👁';
        }, 8000);
    } else {
        el.textContent = '••••••••••';
        el.classList.remove('revealed');
        btn.textContent = '👁';
    }
}

function copyText(text, btn) {
    if (!text) return;
    navigator.clipboard.writeText(text).then(() => {
        const orig = btn.textContent;
        btn.textContent = '✓';
        btn.style.color = 'var(--green)';
        setTimeout(() => {
            btn.textContent = orig;
            btn.style.color = '';
        }, 1500);
    });
}

function togglePw(id) {
    const el = document.getElementById(id);
    if (!el) return;
    el.type = el.type === 'password' ? 'text' : 'password';
}
</script>