@model LifeOS.MVC.Models.Habit
@{
    ViewData["Title"] = "Habit History"; Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="los-page-header d-flex align-items-center gap-3">
    <a asp-action="Index" class="los-btn los-btn-outline" style="padding: 5px 12px;">← Back</a>
    <div>
        <div class="los-page-title">@Model.Name — History</div>
        <div class="los-page-subtitle">@Model.Frequency · @Model.Category · Created @Model.CreatedAt.ToString("MMM d, yyyy")</div>
    </div>
</div>

<div class="row g-4">
    <!-- Streak Summary -->
    <div class="col-lg-4">
        <div class="los-card">
            <div class="los-card-title">Streak Stats</div>
            <div style="display: flex; gap: 24px; margin-bottom: 16px;">
                <div>
                    <div style="font-family: 'Syne', sans-serif; font-size: 2rem; font-weight: 800; color: var(--accent-gold);">@(Model.Streak?.CurrentStreak ?? 0)</div>
                    <div style="font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.1em;">Current Streak</div>
                </div>
                <div>
                    <div style="font-family: 'Syne', sans-serif; font-size: 2rem; font-weight: 800; color: var(--accent-violet);">@(Model.Streak?.BestStreak ?? 0)</div>
                    <div style="font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.1em;">Best Streak</div>
                </div>
            </div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">Total completions: <strong style="color: var(--text-primary);">@Model.HabitLogs.Count</strong></div>
            @if (Model.Streak?.LastCompletedDate != null)
            {
                <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 4px;">Last done: <strong style="color: var(--text-primary);">@Model.Streak.LastCompletedDate.Value.ToString("MMM d, yyyy")</strong></div>
            }
        </div>
    </div>

    <!-- Log Table -->
    <div class="col-lg-8">
        <div class="los-card">
            <div class="los-card-title">Completion Log</div>
            @if (!Model.HabitLogs.Any())
            {
                <p style="color: var(--text-muted); font-size: 0.85rem;">No completions recorded yet.</p>
            }
            else
            {
                <table class="los-table">
                    <thead>
                        <tr><th>Date</th><th>Day</th><th>Note</th><th>Logged At</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.HabitLogs.OrderByDescending(l => l.CompletedDate))
                        {
                            <tr>
                                <td>@log.CompletedDate.ToString("MMM d, yyyy")</td>
                                <td style="color: var(--text-muted);">@log.CompletedDate.DayOfWeek</td>
                                <td style="color: var(--text-muted); font-size: 0.8rem;">@(log.Note ?? "—")</td>
                                <td style="color: var(--text-dim); font-size: 0.75rem;">@log.LoggedAt.ToString("h:mm tt")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>