@model LifeOS.MVC.Models.ProductivityScoreViewModel
@{ ViewData["Title"] = "Habits & Streaks"; }

@if (TempData["Success"] != null) { <div class="los-alert los-alert-success">✓ @TempData["Success"]</div> }
@if (TempData["Info"] != null)    { <div class="los-alert los-alert-info">@TempData["Info"]</div> }

<div class="los-page-header">
    <div>
        <div class="los-page-title">Habits & Streaks</div>
        <div class="los-page-subtitle">Build unbreakable consistency. Track every day.</div>
    </div>
    <div class="los-page-actions">
        <button class="btn-los btn-primary" data-bs-toggle="collapse" data-bs-target="#addHabitPanel">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            New Habit
        </button>
    </div>
</div>

<!-- Add Habit -->
<div class="collapse" id="addHabitPanel">
    <div class="los-panel">
        <div class="los-panel-title">Create New Habit</div>
        <form method="post" asp-action="Create" asp-controller="Habits">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Habit Name *</label>
                        <input name="Name" class="form-control" required placeholder="e.g. Morning workout" maxlength="150" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="form-label">Category</label>
                        <select name="Category" class="form-control">
                            <option>Health</option><option>Learning</option><option>Spiritual</option>
                            <option>Productivity</option><option>Mind</option><option>General</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="form-label">Frequency</label>
                        <select name="Frequency" class="form-control">
                            <option value="Daily">Daily</option>
                            <option value="Weekly">Weekly</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Description</label>
                        <input name="Description" class="form-control" placeholder="Optional detail" maxlength="300" />
                    </div>
                </div>
                <div class="col-12 d-flex justify-content-end gap-2">
                    <button type="button" class="btn-los btn-secondary" data-bs-toggle="collapse" data-bs-target="#addHabitPanel">Cancel</button>
                    <button type="submit" class="btn-los btn-primary">Save Habit</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="los-kpi">
            <div class="los-kpi-icon icon-bg-green">
                <svg width="18" height="18" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.5"/><path d="M5 8l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <div class="los-kpi-value">@Model.CompletedHabitsToday</div>
            <div class="los-kpi-label">Done Today</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="los-kpi">
            <div class="los-kpi-icon icon-bg-indigo">
                <svg width="18" height="18" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.5"/></svg>
            </div>
            <div class="los-kpi-value">@Model.TotalHabits</div>
            <div class="los-kpi-label">Total Habits</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="los-kpi">
            <div class="los-kpi-icon icon-bg-amber">🔥</div>
            <div class="los-kpi-value" style="color:var(--amber);">@(Model.HabitsWithStreaks.Any() ? Model.HabitsWithStreaks.Max(h => h.CurrentStreak) : 0)</div>
            <div class="los-kpi-label">Top Streak</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="los-kpi">
            <div class="los-kpi-icon icon-bg-violet">%</div>
            <div class="los-kpi-value" style="color:var(--violet);">@Model.ProductivityScore%</div>
            <div class="los-kpi-label">Productivity</div>
        </div>
    </div>
</div>

@if (!Model.HabitsWithStreaks.Any())
{
    <div class="los-card">
        <div class="empty-state">
            <div class="empty-state-icon">✓</div>
            <div class="empty-state-title">No habits yet</div>
            <div class="empty-state-desc">Create your first habit to start building consistency. Even one habit compounds over time.</div>
            <button class="btn-los btn-primary" data-bs-toggle="collapse" data-bs-target="#addHabitPanel">Add Your First Habit</button>
        </div>
    </div>
}
else
{
  var dailyHabits = Model.HabitsWithStreaks.Where(h => h.Habit.Frequency == "Daily").ToList(); 
    @if (dailyHabits.Any())
    {
        <div class="los-section-label">Daily Habits — @DateTime.Today.ToString("dddd, MMMM d")</div>
        <div class="row g-3 mb-4">
            @foreach (var item in dailyHabits)
            {
                <div class="col-lg-6">
                    <div class="habit-card @(item.CompletedToday ? "is-done" : "")">
                        <div class="habit-card-top">
                            <div>
                                <div class="habit-card-name">@(item.CompletedToday ? "✓ " : "")@item.Habit.Name</div>
                                <div style="display:flex; gap:5px; margin-top:4px; flex-wrap:wrap;">
                                    <span class="badge badge-neutral">@item.Habit.Category</span>
                                    <span class="badge badge-indigo">Daily</span>
                                </div>
                                @if (!string.IsNullOrEmpty(item.Habit.Description))
                                {
                                    <div class="habit-card-desc">@item.Habit.Description</div>
                                }
                            </div>
                            <div style="display:flex; gap:5px; flex-shrink:0;">
                                <a asp-action="History" asp-route-id="@item.Habit.Id" class="btn-los btn-ghost btn-xs" title="History">
                                    <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"/><path d="M8 5v3l2 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                                </a>
                                <button class="btn-los btn-ghost btn-xs" data-bs-toggle="modal" data-bs-target="#editHabit@item.Habit.Id" title="Edit">
                                    <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M11 2l3 3-9 9H2v-3L11 2z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                                </button>
                                <form method="post" asp-action="Delete" asp-controller="Habits" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Habit.Id" />
                                    <button type="submit" class="btn-los btn-ghost btn-xs" style="color:var(--rose);"
                                            data-confirm="Delete '@item.Habit.Name'? This will remove all history." title="Delete">
                                        <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M3 4h10M6 4V2h4v2M5 4l1 9h4l1-9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Streak -->
                        <div class="habit-streak-row">
                            <div class="habit-streak-item current" style="flex:1; text-align:center;">
                                <div class="habit-streak-val">@item.CurrentStreak</div>
                                <div class="habit-streak-lbl">Current</div>
                            </div>
                            <div style="width:1px; background:var(--border);"></div>
                            <div class="habit-streak-item best" style="flex:1; text-align:center;">
                                <div class="habit-streak-val">@item.BestStreak</div>
                                <div class="habit-streak-lbl">Best</div>
                            </div>
                            <div style="flex:2; padding-left:12px; align-self:center;">
                                @{ int sPercent = item.BestStreak > 0 ? Math.Min(100, (int)((double)item.CurrentStreak / item.BestStreak * 100)) : 0; }
                                <div class="los-progress">
                                    <div class="los-progress-bar @(sPercent >= 100 ? "green" : "")" data-width="@sPercent"></div>
                                </div>
                                <div style="font-size:0.65rem; color:var(--text-disabled); margin-top:3px;">@sPercent% of best</div>
                            </div>
                        </div>

                        <!-- Actions -->
                        @if (!item.CompletedToday)
                        {
                            <form method="post" asp-action="MarkComplete" asp-controller="Habits" class="d-flex gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="habitId" value="@item.Habit.Id" />
                                <input name="note" class="form-control form-control-sm" style="flex:1;" placeholder="Optional note..." />
                                <button type="submit" class="btn-los btn-primary btn-sm">✓ Done</button>
                            </form>
                        }
                        else
                        {
                            <div style="display:flex; align-items:center; justify-content:space-between;">
                                <span style="font-size:0.82rem; font-weight:500; color:var(--green);">✓ Completed today</span>
                                <form method="post" asp-action="UnmarkComplete" asp-controller="Habits">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="habitId" value="@item.Habit.Id" />
                                    <button type="submit" class="btn-los btn-ghost btn-xs" style="color:var(--text-tertiary);">Undo</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>

                <!-- Edit Modal -->
                <div class="modal fade" id="editHabit@item.Habit.Id" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Edit Habit</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <form method="post" asp-action="Edit" asp-controller="Habits">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Id" value="@item.Habit.Id" />
                                <div class="modal-body">
                                    <div class="row g-3">
                                        <div class="col-12">
                                            <div class="form-group">
                                                <label class="form-label">Name</label>
                                                <input name="Name" class="form-control" value="@item.Habit.Name" required />
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="form-group">
                                                <label class="form-label">Category</label>
                                                <select name="Category" class="form-control">
                                                    @foreach (var c in new[] { "Health", "Learning", "Spiritual", "Productivity", "Mind", "General" })
                                                    {
                                                        <option value="@c" selected="@(item.Habit.Category == c ? true : null)">@c</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="form-group">
                                                <label class="form-label">Frequency</label>
                                                <select name="Frequency" class="form-control">
                                                    <option value="Daily" selected="@(item.Habit.Frequency == "Daily" ? true : null)">Daily</option>
                                                    <option value="Weekly" selected="@(item.Habit.Frequency == "Weekly" ? true : null)">Weekly</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-group">
                                                <label class="form-label">Description</label>
                                                <input name="Description" class="form-control" value="@item.Habit.Description" />
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <label class="toggle-wrap">
                                                <div class="toggle">
                                                    <input type="checkbox" name="IsActive" value="true" @(item.Habit.IsActive ? "checked" : "") />
                                                    <div class="toggle-track"></div>
                                                </div>
                                                <span class="toggle-label">Active habit</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn-los btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn-los btn-primary">Save Changes</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    var weeklyHabits = Model.HabitsWithStreaks.Where(h => h.Habit.Frequency == "Weekly").ToList(); 
    @if (weeklyHabits.Any())
    {
        <div class="los-section-label" style="margin-top:8px;">Weekly Habits</div>
        <div class="row g-3 mb-4">
            @foreach (var item in weeklyHabits)
            {
                <div class="col-lg-6">
                    <div class="habit-card @(item.CompletedToday ? "is-done" : "")">
                        <div class="habit-card-top">
                            <div>
                                <div class="habit-card-name">@item.Habit.Name</div>
                                <div style="display:flex; gap:5px; margin-top:4px;">
                                    <span class="badge badge-neutral">@item.Habit.Category</span>
                                    <span class="badge badge-violet">Weekly</span>
                                </div>
                            </div>
                            <div style="display:flex; gap:5px;">
                                <form method="post" asp-action="Delete" asp-controller="Habits" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Habit.Id" />
                                    <button type="submit" class="btn-los btn-ghost btn-xs" style="color:var(--rose);"
                                            data-confirm="Delete this habit?">
                                        <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M3 4h10M6 4V2h4v2M5 4l1 9h4l1-9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                        <div class="habit-streak-row">
                            <div class="habit-streak-item current" style="flex:1; text-align:center;">
                                <div class="habit-streak-val">@item.CurrentStreak</div>
                                <div class="habit-streak-lbl">Streak</div>
                            </div>
                            <div style="width:1px; background:var(--border);"></div>
                            <div class="habit-streak-item best" style="flex:1; text-align:center;">
                                <div class="habit-streak-val">@item.BestStreak</div>
                                <div class="habit-streak-lbl">Best</div>
                            </div>
                        </div>
                        @if (!item.CompletedToday)
                        {
                            <form method="post" asp-action="MarkComplete" asp-controller="Habits">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="habitId" value="@item.Habit.Id" />
                                <button type="submit" class="btn-los btn-primary btn-sm">✓ Mark Done</button>
                            </form>
                        }
                        else
                        {
                            <span style="font-size:0.82rem; font-weight:500; color:var(--green);">✓ Done this week</span>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <!-- Activity -->
    @if (Model.RecentActivity.Any())
    {
        <div class="los-section-label" style="margin-top:8px;">Recent Activity</div>
        <div class="los-card">
            @foreach (var log in Model.RecentActivity)
            {
                <div class="activity-item">
                    <div class="activity-dot" style="background:@(log.Action == "Completed" ? "var(--green)" : "var(--accent)");"></div>
                    <div class="activity-text">@log.Detail</div>
                    <div class="activity-time">@log.DateTime.ToString("MMM d, h:mm tt")</div>
                </div>
            }
        </div>
    }
}