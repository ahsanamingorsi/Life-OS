@model LifeOS.MVC.Models.DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }
<div class="page-heading"><div><div class="eyebrow">YOUR PERSONAL OPERATING SYSTEM</div><h1>A little progress, every day.</h1><p>@Model.Today.ToString("dddd, MMMM d") · Welcome back, @Model.UserName</p></div><a class="btn btn-primary" href="/Planner">＋ Plan your day</a></div>
<section class="dashboard-hero"><div class="eyebrow">TODAY'S INTENTION</div><h2 class="mt-2">Build a day you feel good about.</h2><p class="mt-2">@Model.TodaysMission</p><div class="d-flex gap-3 align-items-center flex-wrap"><button class="btn btn-light" onclick="timerToggle()">Start a focus session ↗</button><span id="liveClock"></span><span>@Model.ProductivityScore.ToString("0")% daily productivity</span></div></section>
<div class="metric-grid">
<a href="/Habits" class="card card-p"><span class="eyebrow">DAILY HABITS</span><h2>@Model.TodayHabitsDone <small>/ @Model.TodayHabitsTotal</small></h2><small>Small wins that add up ↗</small></a>
<a href="/Projects" class="card card-p"><span class="eyebrow">ACTIVE PROJECTS</span><h2>@Model.ActiveProjects</h2><small>Keep your ideas moving ↗</small></a>
<a href="/PersonalTasks" class="card card-p"><span class="eyebrow">TASKS COMPLETED</span><h2>@Model.CompletedPersonalTasks <small>/ @Model.TotalPersonalTasks</small></h2><small>Tasks due today ↗</small></a>
<a href="/Habits" class="card card-p"><span class="eyebrow">CURRENT TOP STREAK</span><h2>@Model.CurrentTopStreak <small>days</small></h2><small>Best streak: @Model.BestHabitStreak ↗</small></a>
</div>
<div class="dashboard-columns"><section class="card card-p"><div class="d-flex justify-content-between"><h3>Your priorities</h3><a href="/Projects" class="eyebrow">ALL PROJECTS ↗</a></div>
@if(!Model.TopPriorities.Any()){<div class="empty-state"><h4>Space for your next big idea</h4><p>Add an active priority A project to bring it into focus.</p><a class="btn btn-secondary" href="/Projects">Explore projects</a></div>}
@{var i=0;} @foreach(var project in Model.TopPriorities){i++;<a href="/Projects/Detail/@project.Id" class="priority-row"><span class="priority-number">@i.ToString("00")</span><div class="flex-grow-1"><strong>@project.Title</strong><div class="small" style="color:var(--text-3)">@(project.NextTask ?? "Choose your next step")</div><div class="progress mt-2"><div class="progress-bar" data-width="@Math.Clamp(project.ProgressPercent,0,100)"></div></div></div><span>@project.ProgressPercent%</span></a>}
</section><section class="card card-p"><div class="d-flex justify-content-between"><h3>Money overview</h3><a href="/Money" class="eyebrow">MANAGE ↗</a></div><div class="eyebrow">THIS MONTH · PKR</div><h2 class="my-3">Rs @((Model.MonthlyIncome-Model.MonthlyExpenses).ToString("N2"))</h2><p class="small" style="color:var(--text-3)">Net balance after this month's expenses</p><div class="spend-row"><span>Income</span><strong style="color:var(--green)">Rs @Model.MonthlyIncome.ToString("N2")</strong></div><div class="spend-row"><span>Expenses</span><strong>Rs @Model.MonthlyExpenses.ToString("N2")</strong></div><a href="/Money" class="btn btn-secondary w-100 mt-3">Add income or expense</a></section></div>
<div class="module-grid"><a class="card" href="/Planner"><strong>Plan your day ↗</strong><small>Tasks, routines, and your next step</small></a><a class="card" href="/Learning"><strong>Keep learning ↗</strong><small>@Model.SkillsInProgress active skills</small></a><a class="card" href="/Spiritual"><strong>Spiritual routine ↗</strong><small>@(Model.TodaySpiritual?.PrayersDone ?? 0) / @(Model.TodaySpiritual?.PrayersTotal ?? 5) prayers today</small></a></div>
<div class="dashboard-columns"><section class="card card-p"><h3>Recent activity</h3>@if(!Model.RecentActivityLogs.Any()){<p style="color:var(--text-3)">Your activity will appear here as you complete habits and tasks.</p>}@foreach(var log in Model.RecentActivityLogs){<div class="spend-row"><span>@log.Detail</span><small>@log.DateTime.ToString("dd MMM, HH:mm")</small></div>}</section><section class="card card-p"><span class="eyebrow">A MOMENT OF PERSPECTIVE</span><p class="mt-3" style="font-size:1.1rem">@Model.DailyMotivation</p><a href="/Spiritual" class="btn btn-ghost mt-2">Write a reflection ↗</a></section></div>


