@model LifeOS.MVC.Models.DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }

<!-- Alerts -->
@if (TempData["Success"] != null)
{
    <div class="los-alert los-alert-success">✓ @TempData["Success"]</div>
}

<!-- WELCOME + MISSION ───────────────────────────────────────────── -->
<div class="row g-4 mb-4 anim-fade-up">
    <div class="col-lg-7">
        <div class="los-mission">
            <div class="los-mission-eyebrow">Today's Command Center</div>
            <div class="los-mission-title">@Model.TodaysMission</div>
            <div class="los-mission-sub">@Model.Today.ToString("dddd, MMMM d, yyyy")</div>
        </div>
    </div>
    <div class="col-lg-5 d-flex flex-column gap-3">
        <div class="los-quote flex-1" style="display:flex; align-items:center;">
            ❝ @Model.DailyMotivation ❞
        </div>
        <!-- Productivity Score Ring -->
        <div class="los-card los-card-sm d-flex align-items-center gap-4">
            <div style="position:relative; width:80px; height:80px; flex-shrink:0;" data-ring-score="@Model.ProductivityScore" data-ring-size="80">
                <div class="score-ring-text" style="inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center;">
                    <div class="score-ring-value" style="font-size:1.25rem;">@Model.ProductivityScore<span style="font-size:0.7rem;">%</span></div>
                </div>
            </div>
            <div>
                <div style="font-size:0.78rem; font-weight:600; color:var(--text-tertiary); text-transform:uppercase; letter-spacing:.08em; margin-bottom:4px;">Productivity Score</div>
                <div style="font-family:'Instrument Serif',serif; font-size:1rem; color:var(--text-primary);">
                    @(Model.ProductivityScore >= 75 ? "Excellent focus today" : Model.ProductivityScore >= 45 ? "Good momentum" : "Let's pick it up")
                </div>
                <div style="font-size:0.75rem; color:var(--text-tertiary); margin-top:3px;">
                    @Model.TodayHabitsDone habits · @Model.CompletedPersonalTasks tasks done
                </div>
            </div>
        </div>
    </div>
</div>

<!-- KPI ROW ─────────────────────────────────────────────────────── -->
<div class="row g-3 mb-4 anim-fade-up anim-delay-1">
    @{
        var kpis = new[]
        {
            (Model.ActiveProjects.ToString(), "Active Projects", "icon-bg-indigo", "<svg width='18' height='18' viewBox='0 0 16 16' fill='none'><rect x='2' y='2' width='5' height='5' rx='1' stroke='currentColor' stroke-width='1.5'/><rect x='9' y='2' width='5' height='5' rx='1' stroke='currentColor' stroke-width='1.5'/><rect x='2' y='9' width='5' height='5' rx='1' stroke='currentColor' stroke-width='1.5'/><rect x='9' y='9' width='5' height='5' rx='1' stroke='currentColor' stroke-width='1.5'/></svg>", "/Projects"),
            ($"{Model.TodayHabitsDone}/{Model.TodayHabitsTotal}", "Habits Today", "icon-bg-green", "<svg width='18' height='18' viewBox='0 0 16 16' fill='none'><circle cx='8' cy='8' r='6.5' stroke='currentColor' stroke-width='1.5'/><path d='M5 8l2 2 4-4' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/></svg>", "/Habits"),
            ($"{Model.CompletedPersonalTasks}/{Model.TotalPersonalTasks}", "Tasks Done", "icon-bg-sky", "<svg width='18' height='18' viewBox='0 0 16 16' fill='none'><path d='M3 4h10M3 8h7M3 12h5' stroke='currentColor' stroke-width='1.5' stroke-linecap='round'/></svg>", "/PersonalTasks"),
            (Model.CurrentTopStreak.ToString(), "Top Streak", "icon-bg-amber", "<svg width='18' height='18' viewBox='0 0 16 16' fill='none'><path d='M9.5 2C9.5 2 8 5 8 7c0 .828.672 1.5 1.5 1.5a1.5 1.5 0 000-3c-.276 0-.5.224-.5.5' stroke='currentColor' stroke-width='1.4' stroke-linecap='round'/><path d='M6 9c0 2.485 2.015 4.5 4.5 4.5a4.5 4.5 0 00.5-8.97' stroke='currentColor' stroke-width='1.4' stroke-linecap='round'/></svg>", "/Habits"),
            ((Model.TodaySpiritual != null ? $"{Model.TodaySpiritual.PrayersDone}/5" : "0/5"), "Prayers", "icon-bg-violet", "<svg width='18' height='18' viewBox='0 0 16 16' fill='none'><path d='M8 2l1.5 3.5L13 6l-2.5 2.5.5 3.5L8 10.5 5 12l.5-3.5L3 6l3.5-.5L8 2z' stroke='currentColor' stroke-width='1.4' stroke-linejoin='round'/></svg>", "/Spiritual"),
            (Model.SkillsInProgress.ToString(), "Skills Active", "icon-bg-teal", "<svg width='18' height='18' viewBox='0 0 16 16' fill='none'><path d='M2 12L6 7l3 3 2-2.5L14 4' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/></svg>", "/TechGrowth"),
        };
    }
    @foreach (var kpi in kpis)
    {
        <div class="col-6 col-sm-4 col-lg-2">
            <a href="@kpi.Item5" style="text-decoration:none;">
                <div class="los-kpi">
                    <div class="los-kpi-icon @kpi.Item3">@Html.Raw(kpi.Item4)</div>
                    <div class="los-kpi-value">@kpi.Item1</div>
                    <div class="los-kpi-label">@kpi.Item2</div>
                </div>
            </a>
        </div>
    }
</div>

<!-- MAIN GRID ───────────────────────────────────────────────────── -->
<div class="row g-4 mb-4">

    <!-- Top Priorities -->
    <div class="col-lg-5 anim-fade-up anim-delay-2">
        <div class="los-card h-100">
            <div class="los-card-header">
                <div class="los-card-title-lg">Top Priorities</div>
                <a href="/Projects" class="btn-los btn-ghost btn-xs" style="color:var(--accent);">See all →</a>
            </div>
            @if (!Model.TopPriorities.Any())
            {
                <div class="empty-state" style="padding:32px 0;">
                    <div class="empty-state-desc">No priority-A projects yet.</div>
                    <a href="/Projects" class="btn-los btn-primary btn-sm">Add Project</a>
                </div>
            }
            else
            {
                @foreach (var p in Model.TopPriorities)
                {
                    <div class="project-card mb-3">
                        <div class="project-card-header">
                            <div>
                                <div class="project-title">@p.Title</div>
                                <div style="display:flex; gap:5px; margin-top:4px; flex-wrap:wrap;">
                                    <span class="badge badge-priority-a">A</span>
                                    <span class="badge badge-@p.Status.ToLower()">@p.Status</span>
                                    @if (!string.IsNullOrEmpty(p.Category))
                                    {
                                        <span class="badge badge-neutral">@p.Category</span>
                                    }
                                </div>
                            </div>
                            <span style="font-size:0.8rem; font-weight:600; color:var(--accent);">@p.ProgressPercent%</span>
                        </div>
                        @if (!string.IsNullOrEmpty(p.NextTask))
                        {
                            <div class="project-next"><strong>Next:</strong> @p.NextTask</div>
                        }
                        <div class="los-progress">
                            <div class="los-progress-bar @(p.ProgressPercent >= 75 ? "green" : p.ProgressPercent >= 40 ? "" : "amber")"
                                 data-width="@p.ProgressPercent"></div>
                        </div>
                        @if (p.Deadline.HasValue)
                        {
                            <div style="font-size:0.72rem; color:var(--text-disabled); margin-top:6px;">
                                Due @p.Deadline.Value.ToString("MMM d, yyyy")
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>

    <!-- Module Progress + Current Skill -->
    <div class="col-lg-4 anim-fade-up anim-delay-3">
        <div class="los-card mb-4">
            <div class="los-card-header">
                <div class="los-card-title-lg">Life Progress</div>
            </div>
            @{
                var modules = new[]
                {
                    ("Tech Growth", Model.TechProgress, "teal", "icon-bg-teal"),
                    ("Projects", Model.ProjectsProgress, "", "icon-bg-indigo"),
                    ("Health", Model.HealthProgress, "green", "icon-bg-green"),
                    ("Mind", Model.MindProgress, "violet", "icon-bg-violet"),
                    ("Spiritual", Model.SpiritualProgress, "amber", "icon-bg-amber"),
                    ("Personal", Model.PersonalProgress, "rose", "icon-bg-rose"),
                };
            }
            @foreach (var m in modules)
            {
                <div class="module-row">
                    <div class="module-row-name">@m.Item1</div>
                    <div class="module-row-bar">
                        <div class="los-progress los-progress-sm">
                            <div class="los-progress-bar @m.Item3" data-width="@m.Item2"></div>
                        </div>
                    </div>
                    <div class="module-row-pct">@m.Item2%</div>
                </div>
            }
        </div>

        @if (Model.CurrentSkill != null)
        {
            <div class="los-card">
                <div class="los-card-title">Currently Learning</div>
                <div style="margin-top:10px;">
                    <div style="font-family:'Instrument Serif',serif; font-size:1.1rem; color:var(--text-primary); margin-bottom:4px;">@Model.CurrentSkill.Name</div>
                    <div style="font-size:0.78rem; color:var(--text-tertiary); margin-bottom:10px;">@Model.CurrentSkill.Category · @Model.CurrentSkill.HoursLogged hrs logged</div>
                    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:5px;">
                        <span style="font-size:0.75rem; color:var(--text-tertiary);">Progress</span>
                        <span style="font-size:0.78rem; font-weight:600; color:var(--teal);">@Model.CurrentSkill.ProgressPercent%</span>
                    </div>
                    <div class="los-progress"><div class="los-progress-bar teal" data-width="@Model.CurrentSkill.ProgressPercent"></div></div>
                    <a href="/TechGrowth" class="btn-los btn-ghost btn-xs" style="margin-top:10px; color:var(--accent); padding-left:0;">View roadmap →</a>
                </div>
            </div>
        }
    </div>

    <!-- Daily Snapshot -->
    <div class="col-lg-3 anim-fade-up anim-delay-4">
        <!-- Today's Health — now shows Health-category habits -->
        <div class="los-card mb-4">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:12px;">
                <div class="los-card-title">Health Today</div>
                <a href="/Health" class="btn-los btn-ghost btn-xs" style="color:var(--accent);">Manage →</a>
            </div>
            @if (Model.HealthProgress == 0 && Model.TodayHabitsTotal == 0)
            {
                <div style="font-size:0.82rem; color:var(--text-tertiary); margin-bottom:10px;">
                    No health habits set up yet.
                </div>
                <a href="/Health" class="btn-los btn-primary btn-sm w-100">Set Up Health Habits</a>
            }
            else
            {
                <div style="display:flex; align-items:center; gap:12px; margin-bottom:10px;">
                    <div style="flex:1;">
                        <div class="los-progress los-progress-lg">
                            <div class="los-progress-bar green"
                                 data-width="@Model.HealthProgress"></div>
                        </div>
                    </div>
                    <span style="font-size:0.9rem; font-weight:700;
                        color:@(Model.HealthProgress >= 75 ? "var(--green)" : Model.HealthProgress >= 40 ? "var(--amber)" : "var(--rose)")">
                        @Model.HealthProgress%
                    </span>
                </div>
                <div style="font-size:0.78rem; color:var(--text-tertiary);">
                    Daily health habits completion
                </div>
                <a href="/Health" class="btn-los btn-ghost btn-xs"
                   style="margin-top:10px; color:var(--accent); padding-left:0;">
                    View & log habits →
                </a>
            }
        </div>
 
        <!-- Prayers Today -->
        <div class="los-card">
            <div class="los-card-title" style="margin-bottom:12px;">Prayers Today</div>
            @if (Model.TodaySpiritual != null)
            {
                <div class="prayer-grid mb-2">
                    @{ string[] pNames = { "Fajr", "Dhuhr", "Asr", "Mag.", "Isha" }; }
                    @for (int i = 1; i <= 5; i++)
                    {
                        <div class="prayer-circle @(i <= Model.TodaySpiritual.PrayersDone ? "done" : "")">@pNames[i-1]</div>
                    }
                </div>
                <div style="font-size:0.78rem; color:var(--text-tertiary);">@Model.TodaySpiritual.PrayersDone of 5 completed</div>
            }
            else
            {
                <div style="font-size:0.82rem; color:var(--text-tertiary); margin-bottom:10px;">Not logged yet.</div>
                <a href="/Spiritual" class="btn-los btn-secondary btn-sm w-100">Log Prayers</a>
            }
        </div>
    </div>
</div>

<!-- BOTTOM ROW ──────────────────────────────────────────────────── -->
<div class="row g-4">
    <!-- Habits Overview -->
    <div class="col-lg-4 anim-fade-up anim-delay-3">
        <div class="los-card">
            <div class="los-card-header">
                <div class="los-card-title-lg">Today's Habits</div>
                <a href="/Habits" class="btn-los btn-ghost btn-xs" style="color:var(--accent);">Manage →</a>
            </div>
            @if (!Model.RecentActivityLogs.Any() && Model.TodayHabitsTotal == 0)
            {
                <div class="empty-state" style="padding:28px 0;">
                    <div class="empty-state-desc">Start building habits for consistency.</div>
                    <a href="/Habits" class="btn-los btn-primary btn-sm">Add Habit</a>
                </div>
            }
            else
            {
                <div style="display:flex; align-items:center; gap:16px; margin-bottom:14px; padding:12px 14px; background:var(--surface-2); border-radius:var(--radius-md);">
                    <div style="text-align:center;">
                        <div style="font-family:'Instrument Serif',serif; font-size:1.8rem; color:var(--accent); line-height:1;">@Model.TodayHabitsDone</div>
                        <div style="font-size:0.62rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:var(--text-disabled);">Done</div>
                    </div>
                    <div style="width:1px; height:40px; background:var(--border);"></div>
                    <div style="text-align:center;">
                        <div style="font-family:'Instrument Serif',serif; font-size:1.8rem; color:var(--text-tertiary); line-height:1;">@Model.TodayHabitsTotal</div>
                        <div style="font-size:0.62rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:var(--text-disabled);">Total</div>
                    </div>
                    <div style="flex:1;">
                        <div class="los-progress los-progress-lg">
                            <div class="los-progress-bar green" data-width="@(Model.TodayHabitsTotal > 0 ? (int)((double)Model.TodayHabitsDone / Model.TodayHabitsTotal * 100) : 0)"></div>
                        </div>
                        @{ int hPct = Model.TodayHabitsTotal > 0 ? (int)((double)Model.TodayHabitsDone / Model.TodayHabitsTotal * 100) : 0; }
                        <div style="font-size:0.72rem; font-weight:600; color:var(--green); margin-top:5px; text-align:right;">@hPct%</div>
                    </div>
                </div>
                <div style="display:flex; align-items:center; gap:8px;">
                    <div class="streak-flame">🔥</div>
                    <div>
                        <div class="streak-number" style="font-size:1.5rem;">@Model.CurrentTopStreak</div>
                        <div style="font-size:0.72rem; color:var(--text-tertiary);">day streak · Best: @Model.BestHabitStreak</div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Open Tasks -->
    <div class="col-lg-4 anim-fade-up anim-delay-4">
        <div class="los-card">
            <div class="los-card-header">
                <div class="los-card-title-lg">Open Tasks</div>
                <a href="/PersonalTasks" class="btn-los btn-ghost btn-xs" style="color:var(--accent);">All tasks →</a>
            </div>
            @if (Model.TotalPersonalTasks == 0)
            {
                <div class="empty-state" style="padding:28px 0;">
                    <div class="empty-state-desc">Capture your next actions here.</div>
                    <a href="/PersonalTasks" class="btn-los btn-primary btn-sm">Add Task</a>
                </div>
            }
            else
            {
               
                    int openCount = Model.TotalPersonalTasks - Model.CompletedPersonalTasks;
                    int tPct = Model.TotalPersonalTasks > 0 ? (int)((double)Model.CompletedPersonalTasks / Model.TotalPersonalTasks * 100) : 0;
               
                <div style="display:flex; align-items:center; gap:12px; margin-bottom:12px;">
                    <div style="flex:1;">
                        <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
                            <span style="font-size:0.78rem; color:var(--text-tertiary);">@Model.CompletedPersonalTasks of @Model.TotalPersonalTasks completed</span>
                            <span style="font-size:0.78rem; font-weight:600; color:var(--sky);">@tPct%</span>
                        </div>
                        <div class="los-progress">
                            <div class="los-progress-bar sky" data-width="@tPct"></div>
                        </div>
                    </div>
                </div>
                <div style="display:flex; gap:10px; flex-wrap:wrap;">
                    <div style="padding:8px 12px; background:var(--rose-soft); border-radius:var(--radius-sm); text-align:center;">
                        <div style="font-family:'Instrument Serif',serif; font-size:1.3rem; color:var(--rose);">@openCount</div>
                        <div style="font-size:0.62rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:var(--rose); opacity:.7;">Open</div>
                    </div>
                    <div style="padding:8px 12px; background:var(--green-soft); border-radius:var(--radius-sm); text-align:center;">
                        <div style="font-family:'Instrument Serif',serif; font-size:1.3rem; color:var(--green);">@Model.CompletedPersonalTasks</div>
                        <div style="font-size:0.62rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:var(--green); opacity:.7;">Done</div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Activity Feed -->
    <div class="col-lg-4 anim-fade-up anim-delay-5">
        <div class="los-card">
            <div class="los-card-header">
                <div class="los-card-title-lg">Recent Activity</div>
            </div>
            @if (!Model.RecentActivityLogs.Any())
            {
                <div class="empty-state" style="padding:28px 0;">
                    <div class="empty-state-desc">Activity will appear here as you work.</div>
                </div>
            }
            else
            {
                @foreach (var log in Model.RecentActivityLogs)
                {
                    <div class="activity-item">
                        <div class="activity-dot" style="background:@(log.Action == "Completed" ? "var(--green)" : log.Type == "Habit" ? "var(--accent)" : "var(--sky)");"></div>
                        <div class="activity-text">@log.Detail</div>
                        <div class="activity-time">@log.DateTime.ToString("h:mm tt")</div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Re-run score rings after page scripts load
    document.querySelectorAll('[data-ring-score]').forEach(wrap => {
        const score = parseFloat(wrap.dataset.ringScore);
        const size  = parseInt(wrap.dataset.ringSize || 90);
        if (wrap.querySelector('svg')) return;
        const r = size / 2 - 6;
        const c = 2 * Math.PI * r;
        const color = score >= 75 ? 'var(--green)' : score >= 45 ? 'var(--amber)' : 'var(--rose)';
        const svg = `<svg class="score-ring-svg" data-score="${score}" width="${size}" height="${size}" viewBox="0 0 ${size} ${size}" style="position:absolute;top:0;left:0;">
            <circle cx="${size/2}" cy="${size/2}" r="${r}" fill="none" stroke="var(--surface-3)" stroke-width="8"/>
            <circle class="score-ring-progress" cx="${size/2}" cy="${size/2}" r="${r}" fill="none" stroke="${color}" stroke-width="8" stroke-linecap="round" transform="rotate(-90 ${size/2} ${size/2})"/>
        </svg>`;
        wrap.insertAdjacentHTML('afterbegin', svg);
        initScoreRings();
    });
</script>
}