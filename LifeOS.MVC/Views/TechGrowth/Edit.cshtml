@model LifeOS.MVC.Models.TechSkill
@{
    ViewData["Title"] = "Edit skill";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<div class="db lo-narrow">
    <div class="db-head">
        <div>
            <a class="db-link" href="/TechGrowth">← Skills</a>
            <h1 class="db-title">Edit skill</h1>
            <div class="db-date">Added @Model.CreatedAt.ToString("d MMMM yyyy")</div>
        </div>
    </div>

    <section class="db-card">
        <form method="post" asp-action="Edit" class="lo-form">
            <input type="hidden" name="Id" value="@Model.Id" />
            <div class="lo-field"><label for="kName" class="lo-label">Skill name <span aria-hidden="true">*</span></label><input id="kName" name="Name" class="lo-input" value="@Model.Name" required maxlength="100" /></div>
            <div class="lo-form-grid">
                <div class="lo-field"><label for="kCat" class="lo-label">Category</label><select id="kCat" name="Category" class="lo-select">@foreach (var c in new[] { "Backend", "Frontend", "DevOps", "Database", "Mobile", "Tools", "Other" }) { <option value="@c" selected="@(Model.Category == c)">@c</option> }</select></div>
                <div class="lo-field"><label for="kLevel" class="lo-label">Level</label><select id="kLevel" name="Level" class="lo-select">@foreach (var l in new[] { "Beginner", "Intermediate", "Advanced", "Expert" }) { <option value="@l" selected="@(Model.Level == l)">@l</option> }</select></div>
                <div class="lo-field"><label for="kProg" class="lo-label">Progress %</label><input id="kProg" name="ProgressPercent" type="number" min="0" max="100" class="lo-input" value="@Model.ProgressPercent" /></div>
                <div class="lo-field"><label for="kWeek" class="lo-label">Weekly target (h)</label><input id="kWeek" name="WeeklyTargetHours" type="number" step="0.5" min="0" max="168" class="lo-input" value="@Model.WeeklyTargetHours.ToString(inv)" /></div>
            </div>
            <div class="lo-field"><label for="kTopic" class="lo-label">Current topic</label><input id="kTopic" name="CurrentTopic" class="lo-input" value="@Model.CurrentTopic" maxlength="200" placeholder="What are you studying right now?" /></div>
            <div class="lo-form-grid">
                <div class="lo-field"><label for="kRes" class="lo-label">Resource URL or name</label><input id="kRes" name="ResourceUrl" class="lo-input" value="@Model.ResourceUrl" maxlength="200" placeholder="https://… or book / course name" /></div>
                <div class="lo-field"><label for="kResName" class="lo-label">Resource label</label><input id="kResName" name="ResourceName" class="lo-input" value="@Model.ResourceName" maxlength="200" placeholder="e.g. Udemy, Book" /></div>
            </div>
            <div class="lo-field"><label for="kNotes" class="lo-label">Notes</label><textarea id="kNotes" name="Notes" class="lo-input lo-textarea" maxlength="500">@Model.Notes</textarea></div>
            <div class="lo-chips">
                <label class="lo-check-label"><input type="checkbox" name="IsCurrent" value="true" checked="@Model.IsCurrent" /> Currently learning</label>
                <label class="lo-check-label"><input type="checkbox" name="IsNext" value="true" checked="@Model.IsNext" /> Up next</label>
            </div>
            <div class="lo-form-actions">
                <a class="lo-btn" href="/TechGrowth">Cancel</a>
                <button type="submit" class="lo-btn lo-btn-primary">Save changes</button>
            </div>
        </form>
    </section>
</div>
