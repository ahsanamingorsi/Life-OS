@model LifeOS.MVC.Models.TechGrowthViewModel
@{
    ViewData["Title"] = "Skills";
    var todayIso = DateTime.Today.ToString("yyyy-MM-dd");
    var current = Model.CurrentSkill;
    double weekTarget = Model.Skills.Where(s => s.IsCurrent || s.WeeklyHours > 0).Sum(s => s.WeeklyTargetHours);
    bool IsLink(string? url) => Uri.TryCreate(url, UriKind.Absolute, out var u) && (u.Scheme == Uri.UriSchemeHttp || u.Scheme == Uri.UriSchemeHttps);
}

<div class="db">
    <div class="db-head">
        <div>
            <div class="db-date">Skills</div>
            <h1 class="db-title">Practice something useful.</h1>
        </div>
        <div class="db-actions">
            <a class="lo-btn" href="#newSkill">@await Html.PartialAsync("_Icon", "plus") New skill</a>
            @if (Model.Skills.Any()) { <a class="lo-btn lo-btn-primary" href="#logHours">Log hours</a> }
        </div>
    </div>

    @if (TempData["Success"] is string ok) { <div class="lo-flash" role="status">@ok</div> }
    @if (TempData["Info"] is string info) { <div class="lo-flash" role="status">@info</div> }

    <div class="db-grid-levels">
        <div class="db-level"><span class="db-muted db-tiny">This week (since Monday)</span><span class="db-level-pct lo-num">@Model.WeekHours.ToString("0.#")h</span><span class="db-muted db-tiny">@(weekTarget > 0 ? $"of {weekTarget:0.#}h target" : "no weekly target")</span></div>
        <div class="db-level"><span class="db-muted db-tiny">Sessions this week</span><span class="db-level-pct lo-num">@Model.SessionsThisWeek</span><span class="db-muted db-tiny">since Monday</span></div>
        <div class="db-level"><span class="db-muted db-tiny">All time</span><span class="db-level-pct lo-num">@Model.TotalHours.ToString("0.#")h</span><span class="db-muted db-tiny">@Model.TotalSkills skills</span></div>
        <div class="db-level"><span class="db-muted db-tiny">Average progress</span><span class="db-level-pct lo-num">@Model.AvgProgress%</span><span class="db-muted db-tiny">@Model.MasteredSkills at 80% or more</span></div>
    </div>

    @if (current != null)
    {
        double wh = Model.WeeklyHoursMap.TryGetValue(current.Id, out var w) ? w : 0;
        int wPct = current.WeeklyTargetHours > 0 ? Math.Min(100, (int)Math.Round(wh / current.WeeklyTargetHours * 100)) : 0;
        <section class="db-card lo-focus-card" aria-labelledby="currentTitle">
            <div class="db-card-head">
                <div style="min-width:0;">
                    <div class="db-muted db-tiny">Currently learning · @current.Category · @current.Level</div>
                    <h2 id="currentTitle" class="db-h2-lg lo-goal-title">@current.Name</h2>
                </div>
                <span class="db-level-pct lo-num">@current.ProgressPercent%</span>
            </div>
            @if (!string.IsNullOrEmpty(current.CurrentTopic)) { <div class="db-small">Now: @current.CurrentTopic</div> }
            <div class="db-bar" role="progressbar" aria-label="Overall progress of @current.Name" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@current.ProgressPercent"><span style="width:@current.ProgressPercent%"></span></div>
            <div class="lo-card-foot db-tiny db-muted lo-num">
                <span>This week: @wh.ToString("0.#") / @current.WeeklyTargetHours.ToString("0.#")h (@wPct%)</span>
                <span>@current.HoursLogged.ToString("0.#")h total · @current.SkillLogs.Count sessions</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(current.ResourceUrl) || !string.IsNullOrWhiteSpace(current.ResourceName))
            {
                if (IsLink(current.ResourceUrl)) { <a class="db-link" href="@current.ResourceUrl" target="_blank" rel="noopener noreferrer">@(current.ResourceName ?? current.ResourceUrl) ↗</a> }
                else { <div class="db-tiny db-muted">Resource: @(current.ResourceName ?? current.ResourceUrl)</div> }
            }
        </section>
    }

    @if (!Model.Skills.Any())
    {
        <section class="db-card"><p class="db-empty">No skills yet. Add the first skill you are learning below.</p></section>
    }

    @if (Model.Skills.Any())
    {
        <section class="db-card" id="logHours" aria-labelledby="logTitle">
            <h2 id="logTitle" class="db-h2">Log hours or update progress</h2>
            <form method="post" asp-action="LogHours" class="lo-form">
                <div class="lo-form-grid">
                    <div class="lo-field"><label for="lgSkill" class="lo-label">Skill</label><select id="lgSkill" name="skillId" class="lo-select">@foreach (var s in Model.Skills) { <option value="@s.Id" selected="@s.IsCurrent">@s.Name</option> }</select></div>
                    <div class="lo-field"><label for="lgHours" class="lo-label">Hours</label><input id="lgHours" name="hours" type="number" step="0.25" min="0" max="24" class="lo-input" placeholder="1.5" /></div>
                    <div class="lo-field"><label for="lgProg" class="lo-label">New progress % <span class="db-muted">(optional)</span></label><input id="lgProg" name="progress" type="number" min="0" max="100" class="lo-input" placeholder="Leave empty to keep" /></div>
                    <div class="lo-field"><label for="lgDate" class="lo-label">Date</label><input id="lgDate" name="logDate" type="date" class="lo-input" value="@todayIso" max="@todayIso" /></div>
                </div>
                <div class="lo-form-grid">
                    <div class="lo-field"><label for="lgTopic" class="lo-label">Topic covered</label><input id="lgTopic" name="topic" class="lo-input" maxlength="200" placeholder="What did you practice?" /></div>
                    <div class="lo-field"><label for="lgNotes" class="lo-label">Notes <span class="db-muted">(optional)</span></label><input id="lgNotes" name="notes" class="lo-input" maxlength="500" /></div>
                </div>
                <p class="db-muted db-tiny" style="margin:0;">Fill hours, a new progress %, or both.</p>
                <div class="lo-form-actions"><button type="submit" class="lo-btn lo-btn-primary">Save</button></div>
            </form>
        </section>
    }

    @foreach (var cat in Model.ByCategory)
    {
        <section class="db-section" aria-labelledby="cat-@cat.Key">
            <div class="db-section-head"><h2 id="cat-@cat.Key" class="db-h2-lg">@cat.Key</h2><span class="db-muted db-small lo-num">@cat.Value.Count</span></div>
            <div class="db-grid-2">
                @foreach (var s in cat.Value)
                {
                    double wh = Model.WeeklyHoursMap.TryGetValue(s.Id, out var x) ? x : 0;
                    int wPct = s.WeeklyTargetHours > 0 ? Math.Min(100, (int)Math.Round(wh / s.WeeklyTargetHours * 100)) : 0;
                    <article class="db-card lo-goal @(s.IsCurrent ? "is-achieved" : "")">
                        <div class="db-card-head">
                            <div style="min-width:0;">
                                <div class="db-muted db-tiny">@s.Level@(s.IsCurrent ? " · Current" : "")@(s.IsNext && !s.IsCurrent ? " · Up next" : "")</div>
                                <h3 class="db-h2 lo-goal-title">@s.Name</h3>
                            </div>
                            <span class="db-level-pct lo-num">@s.ProgressPercent%</span>
                        </div>
                        @if (!string.IsNullOrEmpty(s.CurrentTopic)) { <div class="db-tiny db-muted">Now: @s.CurrentTopic</div> }
                        <div class="db-bar" role="progressbar" aria-label="Overall progress of @s.Name" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@s.ProgressPercent"><span class="@(s.ProgressPercent < 40 ? "low" : "")" style="width:@s.ProgressPercent%"></span></div>
                        <div class="lo-card-foot db-tiny db-muted lo-num">
                            <span>This week @wh.ToString("0.#") / @s.WeeklyTargetHours.ToString("0.#")h@(wPct >= 100 ? " · target met" : "")</span>
                            <span>@s.HoursLogged.ToString("0.#")h · @s.SkillLogs.Count sessions</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(s.ResourceUrl) || !string.IsNullOrWhiteSpace(s.ResourceName))
                        {
                            if (IsLink(s.ResourceUrl)) { <a class="db-link db-tiny" href="@s.ResourceUrl" target="_blank" rel="noopener noreferrer">@(s.ResourceName ?? s.ResourceUrl) ↗</a> }
                            else { <div class="db-tiny db-muted">Resource: @(s.ResourceName ?? s.ResourceUrl)</div> }
                        }
                        <div class="lo-task-actions">
                            @if (!s.IsCurrent)
                            {
                                <form method="post" asp-action="SetCurrent"><input type="hidden" name="id" value="@s.Id" /><button type="submit" class="lo-btn lo-btn-sm">Set as current</button></form>
                            }
                            <form method="post" asp-action="ToggleNext"><input type="hidden" name="id" value="@s.Id" /><button type="submit" class="lo-btn lo-btn-sm" aria-pressed="@(s.IsNext ? "true" : "false")">@(s.IsNext ? "Remove from up next" : "Mark up next")</button></form>
                            <a class="lo-btn lo-btn-sm" href="/TechGrowth/Edit/@s.Id" aria-label="Edit @s.Name">Edit</a>
                            <form method="post" asp-action="Delete"><input type="hidden" name="id" value="@s.Id" /><button type="submit" class="lo-btn lo-btn-sm lo-btn-danger" data-confirm="Delete '@s.Name' and all its logged hours?">Delete</button></form>
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    @if (Model.RecentLogs.Any())
    {
        <section class="db-card" aria-labelledby="recentTitle">
            <h2 id="recentTitle" class="db-h2">Recent sessions</h2>
            @foreach (var log in Model.RecentLogs)
            {
                <div class="db-activity">
                    <span><strong>@log.LogDate.ToString("ddd d MMM")</strong> · @log.TechSkill?.Name · @log.Hours.ToString("0.##")h@(string.IsNullOrEmpty(log.TopicCovered) ? "" : " · " + log.TopicCovered)@(string.IsNullOrEmpty(log.Notes) ? "" : " · " + log.Notes)</span>
                    <form method="post" asp-action="DeleteLog">
                        <input type="hidden" name="logId" value="@log.Id" />
                        <button type="submit" class="lo-btn lo-btn-sm lo-btn-danger" aria-label="Delete session of @log.LogDate.ToString("d MMMM")" data-confirm="Delete this session? Its @log.Hours.ToString("0.##")h will be removed from @(log.TechSkill?.Name).">Delete</button>
                    </form>
                </div>
            }
        </section>
    }

    <section class="db-card" id="newSkill" aria-labelledby="newSkillTitle">
        <h2 id="newSkillTitle" class="db-h2">New skill</h2>
        <form method="post" asp-action="Create" class="lo-form">
            <div class="lo-field"><label for="nkName" class="lo-label">Skill name <span aria-hidden="true">*</span></label><input id="nkName" name="Name" class="lo-input" required maxlength="100" placeholder="e.g. Entity Framework Core" /></div>
            <div class="lo-form-grid">
                <div class="lo-field"><label for="nkCat" class="lo-label">Category</label><select id="nkCat" name="Category" class="lo-select"><option>Backend</option><option>Frontend</option><option>DevOps</option><option>Database</option><option>Mobile</option><option>Tools</option><option>Other</option></select></div>
                <div class="lo-field"><label for="nkLevel" class="lo-label">Level</label><select id="nkLevel" name="Level" class="lo-select"><option>Beginner</option><option>Intermediate</option><option>Advanced</option><option>Expert</option></select></div>
                <div class="lo-field"><label for="nkProg" class="lo-label">Progress %</label><input id="nkProg" name="ProgressPercent" type="number" min="0" max="100" value="0" class="lo-input" /></div>
                <div class="lo-field"><label for="nkWeek" class="lo-label">Weekly target (h)</label><input id="nkWeek" name="WeeklyTargetHours" type="number" step="0.5" min="0" max="168" value="1" class="lo-input" /></div>
            </div>
            <div class="lo-form-grid">
                <div class="lo-field"><label for="nkTopic" class="lo-label">Current topic</label><input id="nkTopic" name="CurrentTopic" class="lo-input" maxlength="200" /></div>
                <div class="lo-field"><label for="nkRes" class="lo-label">Resource URL or name</label><input id="nkRes" name="ResourceUrl" class="lo-input" maxlength="200" /></div>
                <div class="lo-field"><label for="nkResName" class="lo-label">Resource label</label><input id="nkResName" name="ResourceName" class="lo-input" maxlength="200" /></div>
            </div>
            <div class="lo-field"><label for="nkNotes" class="lo-label">Notes <span class="db-muted">(optional)</span></label><input id="nkNotes" name="Notes" class="lo-input" maxlength="500" /></div>
            <div class="lo-chips">
                <label class="lo-check-label"><input type="checkbox" name="IsCurrent" value="true" /> Currently learning</label>
                <label class="lo-check-label"><input type="checkbox" name="IsNext" value="true" /> Up next</label>
            </div>
            <div class="lo-form-actions"><button type="submit" class="lo-btn lo-btn-primary">Add skill</button></div>
        </form>
    </section>
</div>
