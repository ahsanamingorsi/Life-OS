@model List<LifeOS.Models.KnowledgeEntry>
@{
    ViewData["Title"] = "Knowledge Base";
    string? search   = ViewBag.Search;
    string? category = ViewBag.Category;
    string? type     = ViewBag.Type;
    string? tag      = ViewBag.Tag;
    var allTags      = ViewBag.AllTags as List<string> ?? new();

    var categories = new[] { "Tech","Business","Health","Philosophy","Religion","Science","Finance","General" };
    var types      = new[] { "Note","Lesson","Quote","Summary","Idea","Framework","Checklist" };

    string typeColor(string t) => t switch {
        "Note"      => "var(--accent)",
        "Lesson"    => "var(--teal)",
        "Quote"     => "var(--amber)",
        "Summary"   => "var(--sky)",
        "Idea"      => "var(--violet)",
        "Framework" => "var(--green)",
        "Checklist" => "var(--rose)",
        _           => "var(--text-tertiary)"
    };
}

@if (TempData["Success"] != null) { <div class="los-alert los-alert-success">✓ @TempData["Success"]</div> }

<style>
.kb-card {
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 18px 20px;
    box-shadow: var(--shadow-xs);
    transition: all .18s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
}
.kb-card:hover { box-shadow: var(--shadow-md); transform: translateY(-1px); }
.kb-card.pinned { border-color: rgba(217,119,6,.3); background: rgba(217,119,6,.02); }
.kb-card.fav    { border-color: rgba(239,68,68,.2); }

.kb-type-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 5px;
}

.kb-content-preview {
    font-size: 0.82rem;
    color: var(--text-tertiary);
    line-height: 1.6;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    flex: 1;
    margin: 8px 0;
    white-space: pre-wrap;
    word-break: break-word;
}

.kb-filter-btn {
    padding: 4px 12px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
    background: var(--surface-1);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all .12s ease;
    font-family: 'Geist', sans-serif;
    white-space: nowrap;
}
.kb-filter-btn:hover { background: var(--surface-2); }
.kb-filter-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
}

.kb-tag {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: var(--surface-3);
    border: 1px solid var(--border);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--text-tertiary);
    cursor: pointer;
    transition: all .12s ease;
}
.kb-tag:hover { background: var(--accent-soft); color: var(--accent); border-color: rgba(79,70,229,.2); }
.kb-tag.active { background: var(--accent-soft); color: var(--accent); border-color: rgba(79,70,229,.2); }
</style>

<!-- Header -->
<div class="los-page-header">
    <div>
        <div class="los-page-title">Knowledge Base</div>
        <div class="los-page-subtitle">
            @Model.Count entr@(Model.Count == 1 ? "y" : "ies") —
            Capture everything you learn. Build your personal library.
        </div>
    </div>
    <div class="los-page-actions">
        <button class="btn-los btn-primary"
                data-bs-toggle="collapse" data-bs-target="#addEntryPanel">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            Add Entry
        </button>
    </div>
</div>

<!-- Search Bar -->
<form method="get" asp-action="Index" asp-controller="Knowledge" class="mb-3">
    <div style="display:flex; gap:8px; align-items:center;">
        <div style="position:relative; flex:1;">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
                 style="position:absolute; left:12px; top:50%; transform:translateY(-50%);
                        color:var(--text-tertiary); pointer-events:none;">
                <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5"/>
                <path d="M11 11l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <input name="search" value="@search" class="form-control"
                   placeholder="Search knowledge base…"
                   style="padding-left:38px;"
                   autocomplete="off"/>
        </div>
        <select name="category" class="form-control" style="width:140px;"
                onchange="this.form.submit()">
            <option value="">All Categories</option>
            @foreach (var c in categories)
            {
                <option value="@c" selected="@(category == c)">@c</option>
            }
        </select>
        <select name="type" class="form-control" style="width:130px;"
                onchange="this.form.submit()">
            <option value="">All Types</option>
            @foreach (var t in types)
            {
                <option value="@t" selected="@(type == t)">@t</option>
            }
        </select>
        <button type="submit" class="btn-los btn-secondary">Search</button>
        @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(category) ||
             !string.IsNullOrEmpty(type) || !string.IsNullOrEmpty(tag))
        {
            <a asp-action="Index" class="btn-los btn-ghost">✕ Clear</a>
        }
    </div>
</form>

<!-- Tags cloud -->
@if (allTags.Any())
{
    <div style="display:flex; flex-wrap:wrap; gap:6px; margin-bottom:20px;">
        @foreach (var t in allTags)
        {
            <a href="/Knowledge?tag=@Uri.EscapeDataString(t)"
               class="kb-tag @(tag==t?"active":"")">@t</a>
        }
    </div>
}

<!-- Add Panel -->
<div class="collapse" id="addEntryPanel">
    <div class="los-panel" style="margin-bottom:20px;">
        <div class="los-panel-title">New Knowledge Entry</div>
        <form method="post" asp-action="Create" asp-controller="Knowledge">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Title *</label>
                        <input name="Title" class="form-control" required
                               placeholder="What is this about?" maxlength="200"/>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="form-label">Type</label>
                        <select name="Type" class="form-control">
                            @foreach (var t in types)
                            { <option value="@t">@t</option> }
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="form-label">Category</label>
                        <select name="Category" class="form-control">
                            @foreach (var c in categories)
                            { <option value="@c">@c</option> }
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="form-label">Source</label>
                        <input name="Source" class="form-control"
                               placeholder="Book, URL, person" maxlength="200"/>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-group">
                        <label class="form-label">Content</label>
                        <textarea name="Content" class="form-control"
                                  style="min-height:160px; font-size:0.875rem;"
                                  placeholder="Write your note, lesson, quote, summary, idea, framework, or checklist here..."></textarea>
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="form-group">
                        <label class="form-label">Tags (comma separated)</label>
                        <input name="Tags" class="form-control"
                               placeholder="e.g. habits, psychology, atomic habits"/>
                    </div>
                </div>
                <div class="col-md-2 d-flex align-items-end gap-3">
                    <label class="toggle-wrap">
                        <div class="toggle">
                            <input name="IsPinned" type="checkbox" value="true"/>
                            <div class="toggle-track"></div>
                        </div>
                        <span class="toggle-label">Pin</span>
                    </label>
                    <label class="toggle-wrap">
                        <div class="toggle">
                            <input name="IsFavorite" type="checkbox" value="true"/>
                            <div class="toggle-track"></div>
                        </div>
                        <span class="toggle-label">★</span>
                    </label>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn-los btn-primary w-100">Save</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    @{
        var typeGroups = Model.GroupBy(e => e.Type).OrderByDescending(g => g.Count()).ToList();
        var pinned     = Model.Count(e => e.IsPinned);
        var favs       = Model.Count(e => e.IsFavorite);
    }
    <div class="col-6 col-md-3">
        <div class="los-kpi">
            <div class="los-kpi-icon icon-bg-indigo">📚</div>
            <div class="los-kpi-value">@Model.Count</div>
            <div class="los-kpi-label">Total Entries</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="los-kpi">
            <div class="los-kpi-icon icon-bg-amber">📌</div>
            <div class="los-kpi-value" style="color:var(--amber)">@pinned</div>
            <div class="los-kpi-label">Pinned</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="los-kpi">
            <div class="los-kpi-icon icon-bg-rose">★</div>
            <div class="los-kpi-value" style="color:var(--rose)">@favs</div>
            <div class="los-kpi-label">Favorites</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="los-kpi">
            <div class="los-kpi-icon icon-bg-teal">🏷</div>
            <div class="los-kpi-value">@allTags.Count</div>
            <div class="los-kpi-label">Unique Tags</div>
        </div>
    </div>
</div>

<!-- Entries Grid -->
@if (!Model.Any())
{
    <div class="los-card">
        <div class="empty-state">
            <div class="empty-state-icon">📚</div>
            <div class="empty-state-title">
                @(string.IsNullOrEmpty(search) ? "Knowledge base is empty" : $"No results for \"{search}\"")
            </div>
            <div class="empty-state-desc">
                @(string.IsNullOrEmpty(search)
                    ? "Start capturing what you learn — notes, quotes, lessons, ideas, frameworks."
                    : "Try different keywords or clear filters.")
            </div>
            @if (string.IsNullOrEmpty(search))
            {
                <button class="btn-los btn-primary"
                        data-bs-toggle="collapse" data-bs-target="#addEntryPanel">
                    Add First Entry
                </button>
            }
        </div>
    </div>
}
else
{
    <!-- Pinned first -->
     var pinned2 = Model.Where(e => e.IsPinned).ToList(); 
    @if (pinned2.Any())
    {
        <div class="los-section-label">📌 Pinned</div>
        <div class="row g-3 mb-4">
            @foreach (var e in pinned2)
            {
                <div class="col-lg-4 col-md-6">
                    @await Html.PartialAsync("_KnowledgeCard", e)
                </div>
            }
        </div>
    }

    <!-- All others grouped by category -->
    @foreach (var grp in Model.Where(e => !e.IsPinned)
                              .GroupBy(e => e.Category)
                              .OrderBy(g => g.Key))
    {
        <div class="los-section-label">@grp.Key</div>
        <div class="row g-3 mb-4">
            @foreach (var e in grp)
            {
                <div class="col-lg-4 col-md-6">
                    @await Html.PartialAsync("_KnowledgeCard", e)
                </div>
            }
        </div>
    }
}

<!-- Edit Modals -->
@foreach (var e in Model)
{
    <div class="modal fade" id="editKb@e.Id" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Entry</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" asp-action="Edit" asp-controller="Knowledge">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@e.Id"/>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="form-group">
                                    <label class="form-label">Title</label>
                                    <input name="Title" class="form-control" value="@e.Title" required/>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="form-label">Type</label>
                                    <select name="Type" class="form-control">
                                        @foreach (var t in types)
                                        {
                                            <option value="@t" selected="@(e.Type == t)">@t</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="form-label">Category</label>
                                    <select name="Category" class="form-control">
                                        @foreach (var c in categories)
                                        {
                                            <option value="@c" selected="@(e.Category == c)">@c</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="form-label">Source</label>
                                    <input name="Source" class="form-control" value="@e.Source"/>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-group">
                                    <label class="form-label">Content</label>
                                    <textarea name="Content" class="form-control"
                                              style="min-height:200px;">@e.Content</textarea>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-group">
                                    <label class="form-label">Tags</label>
                                    <input name="Tags" class="form-control" value="@e.Tags"/>
                                </div>
                            </div>
                            <div class="col-12 d-flex gap-4">
                                <label class="toggle-wrap">
                                    <div class="toggle">
                                        <input name="IsPinned" type="checkbox" value="true" @(e.IsPinned?"checked":"")/>
                                        <div class="toggle-track"></div>
                                    </div>
                                    <span class="toggle-label">Pinned</span>
                                </label>
                                <label class="toggle-wrap">
                                    <div class="toggle">
                                        <input name="IsFavorite" type="checkbox" value="true" @(e.IsFavorite?"checked":"")/>
                                        <div class="toggle-track"></div>
                                    </div>
                                    <span class="toggle-label">Favorite</span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-los btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn-los btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}