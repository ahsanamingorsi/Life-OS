@model LifeOS.MVC.Models.SpiritualEntry
@using LifeOS.MVC.Models
@{
    ViewData["Title"] = "Spiritual";
    int streak = (int)(ViewBag.Streak ?? 0);
    int perfectDays = (int)(ViewBag.PerfectDays ?? 0);
    var day = (DateTime)ViewBag.Day;
    var today = (DateTime)ViewBag.Today;
    var history = ViewBag.History as List<SpiritualEntry> ?? new();
    var flags = Model.Prayers;
    int done = flags.Count(f => f);
    var byDate = history.ToDictionary(h => h.Date.Date);
}

<div class="db">
    <div class="db-head">
        <div>
            <div class="db-date">Spiritual</div>
            <h1 class="db-title">@(day == today ? "Today's prayers" : day.ToString("dddd, d MMMM"))</h1>
        </div>
        <form method="get" asp-action="Index" class="lo-inline-form">
            <label for="spiritDay" class="db-muted db-small">Day</label>
            <input id="spiritDay" name="date" type="date" class="lo-input" value="@day.ToString("yyyy-MM-dd")" max="@today.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
            <noscript><button class="lo-btn" type="submit">Open</button></noscript>
        </form>
    </div>

    @if (TempData["Success"] is string ok) { <div class="lo-flash" role="status">@ok</div> }

    <div class="db-grid-levels">
        <div class="db-level"><span class="db-muted db-tiny">@(day == today ? "Today" : day.ToString("d MMM"))</span><span class="db-level-pct lo-num">@done / 5</span><span class="db-muted db-tiny">prayers</span></div>
        <div class="db-level"><span class="db-muted db-tiny">Streak</span><span class="db-level-pct lo-num">@streak</span><span class="db-muted db-tiny">days in a row, all prayers</span></div>
        <div class="db-level"><span class="db-muted db-tiny">Perfect days</span><span class="db-level-pct lo-num">@perfectDays</span><span class="db-muted db-tiny">in total</span></div>
    </div>

    <div class="lo-two-col">
        <section class="db-card" aria-labelledby="logTitle">
            <h2 id="logTitle" class="db-h2">@(day == today ? "Log today" : "Log " + day.ToString("d MMM"))</h2>
            <form method="post" asp-action="Save" class="lo-form">
                <input type="hidden" name="Date" value="@day.ToString("yyyy-MM-dd")" />
                <fieldset class="lo-field">
                    <legend class="lo-label">Prayers</legend>
                    <div class="lo-prayers">
                        @for (int i = 0; i < 5; i++)
                        {
                            var name = SpiritualEntry.PrayerNames[i];
                            <label class="lo-prayer">
                                <input type="checkbox" name="@name" value="true" checked="@flags[i]" />
                                <span><strong>@name</strong><small>@(flags[i] ? "Done" : "Not yet")</small></span>
                            </label>
                        }
                    </div>
                    <input type="hidden" name="Fajr" value="false" />
                    <input type="hidden" name="Dhuhr" value="false" />
                    <input type="hidden" name="Asr" value="false" />
                    <input type="hidden" name="Maghrib" value="false" />
                    <input type="hidden" name="Isha" value="false" />
                </fieldset>
                <div class="lo-field">
                    <label for="gratitude" class="lo-label">Gratitude <span class="db-muted">(optional)</span></label>
                    <textarea id="gratitude" name="GratitudeNote" class="lo-input lo-textarea" maxlength="500" placeholder="Three things you are grateful for">@Model.GratitudeNote</textarea>
                </div>
                <div class="lo-field">
                    <label for="reflection" class="lo-label">Reflection <span class="db-muted">(optional)</span></label>
                    <textarea id="reflection" name="ReflectionNote" class="lo-input lo-textarea" maxlength="500" placeholder="How was the day spiritually?">@Model.ReflectionNote</textarea>
                </div>
                <div class="lo-form-actions"><button type="submit" class="lo-btn lo-btn-primary">@(day == today ? "Save today" : "Save " + day.ToString("d MMM"))</button></div>
            </form>
        </section>

        <section class="db-card" aria-labelledby="histTitle">
            <h2 id="histTitle" class="db-h2">Last 30 days</h2>
            <div class="lo-calendar" role="list">
                @for (int i = 29; i >= 0; i--)
                {
                    var d = today.AddDays(-i);
                    byDate.TryGetValue(d, out var h);
                    int n = h?.PrayersDone ?? 0;
                    string level = h == null ? "none" : n >= 5 ? "full" : n >= 3 ? "most" : n > 0 ? "some" : "zero";
                    <a role="listitem" class="lo-cal-day lo-cal-@level @(d == day ? "selected" : "")" href="/Spiritual?date=@d.ToString("yyyy-MM-dd")"
                       aria-label="@d.ToString("dddd d MMMM"): @(h == null ? "no entry" : $"{n} of 5 prayers")">
                        <span>@d.Day</span>
                    </a>
                }
            </div>
            <div class="lo-cal-legend db-muted db-tiny">
                <span><i class="lo-cal-full"></i> All 5</span><span><i class="lo-cal-most"></i> 3–4</span><span><i class="lo-cal-some"></i> 1–2</span><span><i class="lo-cal-none"></i> No entry</span>
            </div>
            <div class="db-task-list">
                @if (!history.Any()) { <p class="db-empty">No entries in the last 30 days.</p> }
                @foreach (var h in history.Take(10))
                {
                    var p = h.Prayers;
                    <a class="db-activity lo-hist-row" href="/Spiritual?date=@h.Date.ToString("yyyy-MM-dd")">
                        <span><strong>@h.Date.ToString("ddd, d MMM")</strong>@(string.IsNullOrWhiteSpace(h.GratitudeNote) ? "" : " · " + h.GratitudeNote)</span>
                        <span class="lo-dots" aria-label="@h.PrayersDone of 5 prayers">
                            @for (int i = 0; i < 5; i++) { <i class="@(p[i] ? "on" : "")" title="@SpiritualEntry.PrayerNames[i]"></i> }
                        </span>
                    </a>
                }
            </div>
        </section>
    </div>
</div>
