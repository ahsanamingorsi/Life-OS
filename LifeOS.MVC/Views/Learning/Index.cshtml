@{
    ViewData["Title"] = "Learning";
    var skills = ViewBag.Skills as List
<LifeOS.MVC.Models.TechSkill> ?? new();
    var subjects = ViewBag.Subjects as List<LifeOS.MVC.Models.StudySubject> ?? new();
    double skillHW = (double)(ViewBag.SkillHoursWeek ?? 0);
    double studyHW = (double)(ViewBag.StudyHoursWeek ?? 0);
    double totalSkill = (double)(ViewBag.TotalSkillHours ?? 0);
    double totalStudy = (double)(ViewBag.TotalStudyHours ?? 0);
    var recentSkill = ViewBag.RecentSkillLogs as List<LifeOS.MVC.Models.TechSkillLog> ?? new();
    var recentStudy = ViewBag.RecentStudySessions as List<LifeOS.MVC.Models.StudySession> ?? new();
    var currentSkill = skills.FirstOrDefault(s => s.IsCurrent);
}
@await Html.PartialAsync("_LearningNavigation")


<div class="page-header">
    <div>
        <div class="page-title">Learning</div>
        <div class="page-sub">Skills, subjects, and sessions — your knowledge engine.</div>
    </div>
    <div class="page-actions">
        <a href="/TechGrowth" class="btn btn-secondary btn-sm">⚡ Skills</a>
        <a href="/Study" class="btn btn-secondary btn-sm">📖 Study</a>
    </div>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="kpi">
            <div class="kpi-icon ic-teal">⚡</div>
            <div class="kpi-value">@skills.Count</div>
            <div class="kpi-label">Skills Tracked</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi">
            <div class="kpi-icon ic-violet">📖</div>
            <div class="kpi-value">@subjects.Count</div>
            <div class="kpi-label">Study Subjects</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi">
            <div class="kpi-icon ic-amber">h</div>
            <div class="kpi-value" style="color:var(--amber)">@((skillHW + studyHW).ToString("F1"))</div>
            <div class="kpi-label">Hours This Week</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi">
            <div class="kpi-icon ic-indigo">∑</div>
            <div class="kpi-value" style="color:var(--indigo)">@((totalSkill + totalStudy).ToString("F0"))</div>
            <div class="kpi-label">Total Hours</div>
        </div>
    </div>
</div>

<!-- Current skill banner -->
@if (currentSkill != null)
{
    <div style="background:linear-gradient(135deg,var(--indigo),var(--teal));
        border-radius:var(--r-lg); padding:20px 24px; margin-bottom:20px;
        color:white; display:flex; align-items:center; gap:20px;
        box-shadow:var(--shadow-indigo);">
        <div style="flex:1;">
            <div style="font-size:.65rem; font-weight:700; text-transform:uppercase;
                letter-spacing:.14em; opacity:.7; margin-bottom:4px;">
                Currently Learning
            </div>
            <div style="font-size:1.2rem; font-weight:800; letter-spacing:-.02em; margin-bottom:4px;">
                @currentSkill.Name
            </div>
            <div style="font-size:.78rem; opacity:.7;">
                @currentSkill.Category · @currentSkill.Level
                @if (!string.IsNullOrEmpty(currentSkill.CurrentTopic))
                {
                    <span> · 📍 @currentSkill.CurrentTopic</span>
                }
            </div>
        </div>
        <div style="text-align:center; background:rgba(255,255,255,0.12);
            padding:14px 20px; border-radius:var(--r-md);
            border:1px solid rgba(255,255,255,0.15);">
            <div style="font-size:1.8rem; font-weight:800; letter-spacing:-.04em;">
                @currentSkill.ProgressPercent%
            </div>
            <div style="font-size:.62rem; font-weight:700; text-transform:uppercase;
                letter-spacing:.1em; opacity:.6; margin-top:3px;">
                Progress
            </div>
        </div>
        <a href="/TechGrowth" style="background:rgba(255,255,255,0.2); color:white;
            padding:8px 16px; border-radius:var(--r-md); font-size:.8rem;
            font-weight:600; text-decoration:none; flex-shrink:0;
            border:1px solid rgba(255,255,255,0.3);">
            Log Session →
        </a>
    </div>
}

<div class="row g-3">
    <!-- Skills -->
    <div class="col-lg-6">
        <div class="card card-p">
            <div class="card-header">
                <div class="card-title-lg">⚡ Tech Skills</div>
                <a href="/TechGrowth" class="btn btn-ghost btn-xs" style="color:var(--indigo);">Manage →</a>
            </div>
            @if (!skills.Any())
            {
                <div class="empty-state" style="padding:24px 0;">
                    <div class="empty-state-desc">No skills yet.</div>
                    <a href="/TechGrowth" class="btn btn-primary btn-sm">Add Skills</a>
                </div>
            }
            else
            {
                <div style="display:flex; flex-direction:column; gap:10px;">
                    @foreach (var s in skills.Take(6))
                    {
                        <div style="display:flex; align-items:center; gap:12px;">
                            <div style="flex:1; min-width:0;">
                                <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
                                    <span style="font-size:.845rem; font-weight:600; color:var(--text-1);">@s.Name</span>
                                    <span style="font-size:.75rem; font-weight:700; color:var(--teal);">@s.ProgressPercent%</span>
                                </div>
                                <div class="progress progress-sm">
                                    <div class="progress-bar teal" data-width="@s.ProgressPercent"></div>
                                </div>
                                <div style="font-size:.65rem; color:var(--text-4); margin-top:2px;">
                                    @s.HoursLogged.ToString("F0")h · @s.Category
                                    @if (s.IsCurrent)
                                    {
                                        <span style="color:var(--indigo); font-weight:700;"> · current</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
                @if (skills.Count > 6)
                {
                    <div style="margin-top:12px; font-size:.75rem; color:var(--text-3);">
                        +@(skills.Count - 6) more ·
                        <a href="/TechGrowth" style="color:var(--indigo);">View all</a>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Study Subjects -->
    <div class="col-lg-6">
        <div class="card card-p">
            <div class="card-header">
                <div class="card-title-lg">📖 Study Subjects</div>
                <a href="/Study" class="btn btn-ghost btn-xs" style="color:var(--indigo);">Manage →</a>
            </div>
            @if (!subjects.Any())
            {
                <div class="empty-state" style="padding:24px 0;">
                    <div class="empty-state-desc">No study subjects yet.</div>
                    <a href="/Study" class="btn btn-primary btn-sm">Add Subject</a>
                </div>
            }
            else
            {
                <div style="display:flex; flex-direction:column; gap:10px;">
                    @foreach (var s in subjects.Take(6))
                    {
                        int spct = s.TargetHours > 0
                            ? Math.Min(100, (int)(s.HoursLogged / s.TargetHours * 100))
                            : s.ProgressPercent;
                        <a href="/Study/Subject/@s.Id" style="text-decoration:none;">
                            <div style="display:flex; align-items:center; gap:12px;
                                padding:8px 10px; border-radius:var(--r-md);
                                border:1px solid var(--border); background:var(--card);
                                transition:all var(--t1);"
                                 onmouseover="this.style.borderColor='var(--indigo)'"
                                 onmouseout="this.style.borderColor='var(--border)'">
                                <div style="flex:1; min-width:0;">
                                    <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
                                        <span style="font-size:.845rem; font-weight:600; color:var(--text-1);">@s.Name</span>
                                        <span style="font-size:.75rem; font-weight:700; color:var(--violet);">@spct%</span>
                                    </div>
                                    <div class="progress progress-sm">
                                        <div class="progress-bar violet" data-width="@spct"></div>
                                    </div>
                                    <div style="font-size:.65rem; color:var(--text-4); margin-top:2px;">
                                        @s.HoursLogged.ToString("F1")h · @s.Category
                                    </div>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Recent Sessions -->
    @if (recentSkill.Any() || recentStudy.Any())
    {
        <div class="col-12">
            <div class="card card-p">
                <div class="card-title-lg" style="margin-bottom:14px;">Recent Sessions (7 days)</div>
                <div class="row g-2">
                    @foreach (var l in recentSkill)
                    {
                        <div class="col-lg-3 col-md-4 col-6">
                            <div style="padding:10px 12px; border:1px solid var(--border);
                                border-radius:var(--r-md); background:var(--card);
                                border-left:3px solid var(--teal);">
                                <div style="font-size:.72rem; color:var(--teal); font-weight:700; margin-bottom:2px;">⚡ @l.TechSkill?.Name</div>
                                <div style="font-size:.85rem; font-weight:600; color:var(--text-1);">@l.Hours h</div>
                                <div style="font-size:.68rem; color:var(--text-3);">@l.LogDate.ToString("MMM d")</div>
                                @if (!string.IsNullOrEmpty(l.TopicCovered))
                                {
                                    <div style="font-size:.68rem; color:var(--text-4); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@l.TopicCovered</div>
                                }
                            </div>
                        </div>
                    }
                    @foreach (var s in recentStudy)
                    {
                        <div class="col-lg-3 col-md-4 col-6">
                            <div style="padding:10px 12px; border:1px solid var(--border);
                                border-radius:var(--r-md); background:var(--card);
                                border-left:3px solid var(--violet);">
                                <div style="font-size:.72rem; color:var(--violet); font-weight:700; margin-bottom:2px;">📖 @s.StudySubject?.Name</div>
                                <div style="font-size:.85rem; font-weight:600; color:var(--text-1);">@s.DurationHours h</div>
                                <div style="font-size:.68rem; color:var(--text-3);">@s.SessionDate.ToString("MMM d")</div>
                                @if (!string.IsNullOrEmpty(s.TopicCovered))
                                {
                                    <div style="font-size:.68rem; color:var(--text-4); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@s.TopicCovered</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>


