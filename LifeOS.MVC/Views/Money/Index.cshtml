@model LifeOS.MVC.Models.MoneyViewModel
@{ ViewData["Title"] = "Money"; }
@await Html.PartialAsync("_MoneyNavigation")
<div class="page-heading"><div><div class="eyebrow">YOUR FINANCIAL PICTURE</div><h1>Make room for what matters.</h1><p>Track your income, understand your spending, and plan ahead. Amounts in PKR.</p></div><form method="get"><label for="month">Month</label><input class="form-control" id="month" name="month" type="month" value="@Model.Month.ToString("yyyy-MM")" onchange="this.form.submit()" /></form></div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<div class="metric-grid">
<div class="card card-p"><span class="eyebrow">INCOME</span><h2 class="text-success">Rs @Model.Income.ToString("N2")</h2><small>This month</small></div>
<div class="card card-p"><span class="eyebrow">EXPENSES</span><h2>Rs @Model.Expenses.ToString("N2")</h2><small>This month</small></div>
<div class="card card-p"><span class="eyebrow">NET BALANCE</span><h2>Rs @Model.Balance.ToString("N2")</h2><small>Income minus expenses</small></div>
<div class="card card-p"><span class="eyebrow">BUDGET REMAINING</span><h2>@(Model.Budget > 0 ? "Rs " + (Model.Budget - Model.Expenses).ToString("N2") : "Not set")</h2><small>@(Model.Expenses > Model.Budget && Model.Budget > 0 ? "Over budget — review your spending" : "Your monthly spending plan")</small></div>
</div>
<div class="row g-4 mt-1"><div class="col-lg-4"><section class="card card-p"><h3>Add a transaction</h3><form asp-action="Create" method="post">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<label asp-for="Entry.Description">Description</label><input asp-for="Entry.Description" class="form-control mb-3" placeholder="Groceries, salary, freelance…" required maxlength="120" />
<label asp-for="Entry.Type">Type</label><select asp-for="Entry.Type" class="form-select mb-3"><option>Expense</option><option>Income</option></select>
<label asp-for="Entry.Category">Category</label><select asp-for="Entry.Category" class="form-select mb-3">@foreach(var c in new[]{"Food", "Transport", "Home", "Health", "Learning", "Shopping", "Salary", "Freelance", "Other"}){<option>@c</option>}</select>
<label asp-for="Entry.Amount">Amount (PKR)</label><input asp-for="Entry.Amount" class="form-control mb-3" type="number" min="0.01" max="999999999999.99" step="0.01" required />
<label asp-for="Entry.MoneyAccountId">Account</label><select asp-for="Entry.MoneyAccountId" class="form-select mb-3"><option value="">Unassigned</option>@foreach(var account in Model.Accounts){<option value="@account.Id">@account.Name (@account.Kind)</option>}</select>
<label asp-for="Entry.Date">Date</label><input asp-for="Entry.Date" type="date" class="form-control mb-3" required /><button class="btn btn-primary w-100">Save transaction</button></form></section>
<section class="card card-p mt-3"><h3>Monthly budget</h3><form asp-action="Budget" method="post"><input type="hidden" name="month" value="@Model.Month.ToString("yyyy-MM-dd")" /><label for="budget">Spending limit (PKR)</label><input id="budget" name="amount" type="number" min="0.01" max="999999999999.99" step="0.01" value="@Model.Budget" class="form-control mb-3" required /><button class="btn btn-secondary w-100">Update budget</button></form></section></div>
<div class="col-lg-8"><section class="card card-p"><h3>Transaction history <span class="eyebrow">@Model.Month.ToString("MMMM yyyy")</span></h3>
@if(!Model.Transactions.Any()){<div class="empty-state"><h4>A fresh start for your finances</h4><p>Add your first income or expense to see your monthly picture here.</p></div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Description</th><th>Category</th><th>Amount</th><th></th></tr></thead><tbody>@foreach(var t in Model.Transactions){<tr><td>@t.Date.ToString("dd MMM")</td><td>@t.Description<br /><small>@t.Type · @(t.MoneyAccount?.Name ?? "Unassigned")</small></td><td>@t.Category</td><td class="@(t.Type == "Income" ? "text-success" : "")">@(t.Type == "Income" ? "+" : "−") Rs @t.Amount.ToString("N2")</td><td><form asp-action="Delete" method="post"><input name="id" type="hidden" value="@t.Id" /><button class="btn btn-ghost btn-sm" data-confirm="Delete this transaction?" aria-label="Delete @t.Description">Delete</button></form></td></tr>}</tbody></table></div>}
</section><section class="card card-p mt-3"><h3>Where your money goes</h3>@foreach(var category in Model.Transactions.Where(t=>t.Type=="Expense").GroupBy(t=>t.Category).OrderByDescending(g=>g.Sum(t=>t.Amount))){<div class="spend-row"><span>@category.Key</span><strong>Rs @category.Sum(t=>t.Amount).ToString("N2")</strong></div><div class="progress mb-3"><div class="progress-bar" style="width:@((category.Sum(t=>t.Amount)/Model.Expenses*100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div></div>}</section></div></div>
