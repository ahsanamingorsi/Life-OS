@model LifeOS.MVC.Models.AccountsViewModel
@{ ViewData["Title"] = "Money accounts"; }
@await Html.PartialAsync("_MoneyNavigation")
<div class="page-heading"><div><div class="eyebrow">WHERE YOUR MONEY LIVES</div><h1>Cash & online accounts</h1><p>Track cash, Easypaisa, JazzCash, and banks separately. All amounts in PKR.</p></div></div>
@await Html.PartialAsync("_MoneyMessages")
<div class="metric-grid">
<div class="card card-p"><span class="eyebrow">ALL ACCOUNTS</span><h2>Rs @Model.Balances.Values.Sum().ToString("N2")</h2><small>Includes recorded loans and repayments</small></div>
<div class="card card-p"><span class="eyebrow">CASH</span><h2>Rs @Model.Accounts.Where(a => a.Kind == "Cash").Sum(a => Model.Balances[a.Id]).ToString("N2")</h2><small>Cash accounts</small></div>
<div class="card card-p"><span class="eyebrow">ONLINE & BANK</span><h2>Rs @Model.Accounts.Where(a => a.Kind != "Cash").Sum(a => Model.Balances[a.Id]).ToString("N2")</h2><small>Wallets and bank accounts</small></div>
</div>
<div class="row g-4 mb-4"><section class="col-lg-5"><div class="card card-p"><h3>Add an account</h3>
<form asp-action="AddAccount" method="post" class="money-form">
<label for="accountName">Account name</label><input id="accountName" name="Name" required maxlength="80" class="form-control" placeholder="My cash, Easypaisa, HBL savings…" />
<label for="accountKind">Account type</label><select id="accountKind" name="Kind" class="form-select">@foreach(var kind in new[]{"Cash","Easypaisa","JazzCash","Bank","Other"}){<option>@kind</option>}</select>
<label for="openingBalance">Opening balance (PKR)</label><input id="openingBalance" name="OpeningBalance" type="number" step="0.01" min="-999999999999.99" max="999999999999.99" value="0" required class="form-control" /><small>The starting balance before transactions recorded in Life OS.</small>
<button class="btn btn-primary">Add account</button></form></div></section>
<section class="col-lg-7"><div class="card card-p"><h3>Transfer between accounts</h3><p class="small">Record money moved between your accounts. Transfers do not count as income or spending.</p>
@if(Model.Accounts.Count < 2){<p>Add at least two accounts to record transfers.</p>}else{
<form asp-action="Transfer" method="post" class="money-form">
<label for="transferFrom">From account</label><select id="transferFrom" name="FromAccountId" class="form-select">@foreach(var a in Model.Accounts){<option value="@a.Id">@a.Name</option>}</select>
<label for="transferTo">To account</label><select id="transferTo" name="ToAccountId" class="form-select">@foreach(var a in Model.Accounts){<option value="@a.Id">@a.Name</option>}</select>
<div class="row g-3"><div class="col-sm-6"><label for="transferAmount">Amount (PKR)</label><input id="transferAmount" name="Amount" type="number" min="0.01" max="999999999999.99" step="0.01" required class="form-control" /></div><div class="col-sm-6"><label for="transferDate">Date</label><input id="transferDate" name="Date" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required class="form-control" /></div></div>
<button class="btn btn-primary">Record transfer</button></form>
}</div></section></div>
@foreach(var group in Model.Accounts.GroupBy(a => a.Kind == "Cash" ? "Cash" : "Online wallets & banks")){
<h3 class="mb-3">@group.Key</h3><div class="money-account-grid mb-4">@foreach(var a in group){
<article class="card card-p"><div class="money-account-heading"><span class="project-symbol">@await Html.PartialAsync("_Icon","money")</span><div><span class="eyebrow">@a.Kind</span><h3>@a.Name</h3></div></div><h2 class="mt-3">Rs @Model.Balances[a.Id].ToString("N2")</h2><small>Opening balance: Rs @a.OpeningBalance.ToString("N2")</small></article>
}</div>}
@if(!Model.Accounts.Any()){<div class="card card-p empty-state"><h3>Your accounts start here</h3><p>Add cash or an online wallet to track its balance.</p></div>}
<section class="card card-p"><h3>Recent transfers</h3>@foreach(var t in Model.Transfers){<div class="money-history-row"><div><strong>@t.FromAccount?.Name → @t.ToAccount?.Name</strong><small>@t.Date.ToString("dd MMM yyyy")</small></div><strong>Rs @t.Amount.ToString("N2")</strong><form asp-action="DeleteTransfer" method="post"><input type="hidden" name="id" value="@t.Id" /><button class="btn btn-ghost btn-sm" data-confirm="Remove this transfer and reverse its account balance changes?">Remove</button></form></div>}@if(!Model.Transfers.Any()){<p>No transfers recorded.</p>}</section>
<p class="small mt-3">Unassigned transactions and loans are excluded from account balances. These accounts are manual records; no bank or wallet connection is required.</p>
