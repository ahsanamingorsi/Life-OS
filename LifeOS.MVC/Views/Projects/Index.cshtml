@model List<LifeOS.MVC.Models.Project>
@{ ViewData["Title"] = "Projects Hub"; }

<div class="los-page-header">
    <div>
        <div class="los-page-title">Projects Hub</div>
        <div class="los-page-subtitle">Manage every project across all life areas.</div>
    </div>
    <div class="los-page-actions">
        <button class="btn-los btn-primary" data-bs-toggle="collapse" data-bs-target="#addProjectPanel">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            New Project
        </button>
    </div>
</div>

<div class="collapse" id="addProjectPanel">
    <div class="los-panel">
        <div class="los-panel-title">Create New Project</div>
        <form method="post" asp-action="Add" asp-controller="Projects">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Project Title *</label>
                        <input name="Title" class="form-control" required placeholder="Project name" maxlength="150" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="form-label">Category</label>
                        <select name="Category" class="form-control">
                            <option>EduBridgePath</option><option>PSC</option><option>Farming</option>
                            <option>Future Ideas</option><option>Personal</option><option>Tech</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="form-label">Priority</label>
                        <select name="Priority" class="form-control">
                            <option value="A">A — Critical</option>
                            <option value="B" selected>B — Important</option>
                            <option value="C">C — Nice to have</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="form-label">Deadline</label>
                        <input name="Deadline" type="date" class="form-control" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="form-label">Progress %</label>
                        <input name="ProgressPercent" type="number" min="0" max="100" class="form-control" value="0" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Next Task</label>
                        <input name="NextTask" class="form-control" placeholder="What is the very next action?" maxlength="300" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Notes</label>
                        <input name="Notes" class="form-control" placeholder="Optional notes" maxlength="500" />
                    </div>
                </div>
                <div class="col-12 d-flex justify-content-end gap-2">
                    <button type="button" class="btn-los btn-secondary" data-bs-toggle="collapse" data-bs-target="#addProjectPanel">Cancel</button>
                    <button type="submit" class="btn-los btn-primary">Save Project</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Stats -->
@{
    int totalP = Model.Count;
    int activeP = Model.Count(p => p.Status == "Active");
    int doneP = Model.Count(p => p.Status == "Done");
    int avgProgress = totalP > 0 ? (int)Model.Average(p => p.ProgressPercent) : 0;
}
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="los-kpi"><div class="los-kpi-icon icon-bg-indigo"><svg width="18" height="18" viewBox="0 0 16 16" fill="none"><rect x="2" y="2" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="9" y="2" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="2" y="9" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="9" y="9" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/></svg></div><div class="los-kpi-value">@totalP</div><div class="los-kpi-label">Total</div></div></div>
    <div class="col-6 col-md-3"><div class="los-kpi"><div class="los-kpi-icon icon-bg-green"></div><div class="los-kpi-value" style="color:var(--green)">@activeP</div><div class="los-kpi-label">Active</div></div></div>
    <div class="col-6 col-md-3"><div class="los-kpi"><div class="los-kpi-icon icon-bg-sky"></div><div class="los-kpi-value" style="color:var(--sky)">@doneP</div><div class="los-kpi-label">Done</div></div></div>
    <div class="col-6 col-md-3"><div class="los-kpi"><div class="los-kpi-icon icon-bg-teal">%</div><div class="los-kpi-value" style="color:var(--teal)">@avgProgress%</div><div class="los-kpi-label">Avg Progress</div></div></div>
</div>

@foreach (var cat in Model.Select(p => p.Category).Distinct().OrderBy(c => c))
{
    var catProjects = Model.Where(p => p.Category == cat).OrderBy(p => p.Priority).ThenBy(p => p.Deadline).ToList();
    <div class="los-section-label">@cat</div>
    <div class="row g-3 mb-4">
        @foreach (var p in catProjects)
        {
            <div class="col-lg-6">
                <div class="project-card">
                    <div class="project-card-header">
                        <div style="flex:1;">
                            <div class="project-title">@p.Title</div>
                            <div style="display:flex; gap:5px; margin-top:5px; flex-wrap:wrap;">
                                <span class="badge badge-priority-@p.Priority.ToLower()">@p.Priority</span>
                                <span class="badge badge-@p.Status.ToLower()">@p.Status</span>
                                @if (p.Deadline.HasValue)
                                {
                                    bool isOverdue = p.Deadline.Value.Date < DateTime.Today && p.Status != "Done";
                                    <span class="badge @(isOverdue ? "badge-rose" : "badge-neutral")">
                                        @p.Deadline.Value.ToString("MMM d")
                                    </span>
                                }
                            </div>
                        </div>
                        <form method="post" asp-action="Delete" asp-controller="Projects">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@p.Id" />
                            <button type="submit" class="btn-los btn-ghost btn-icon-sm" style="color:var(--rose);" data-confirm="Delete '@p.Title'?">
                                <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M3 4h10M5 4l1 9h4l1-9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </button>
                        </form>
                    </div>

                    @if (!string.IsNullOrEmpty(p.NextTask))
                    {
                        <div class="project-next"><strong>Next:</strong> @p.NextTask</div>
                    }

                    <div style="display:flex; align-items:center; gap:10px; margin-bottom:12px;">
                        <div class="los-progress" style="flex:1;">
                            <div class="los-progress-bar @(p.ProgressPercent >= 75 ? "green" : p.ProgressPercent >= 40 ? "" : "amber")"
                                 data-width="@p.ProgressPercent"></div>
                        </div>
                        <span style="font-size:0.8rem; font-weight:600; color:var(--accent); min-width:36px; text-align:right;">@p.ProgressPercent%</span>
                    </div>

                    @if (!string.IsNullOrEmpty(p.Notes))
                    {
                        <div style="font-size:0.78rem; color:var(--text-tertiary); margin-bottom:10px;">@p.Notes</div>
                    }

                    <form method="post" asp-action="UpdateStatus" asp-controller="Projects" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@p.Id" />
                        <select name="status" class="form-control form-control-sm" style="flex:1;">
                            <option value="Active" selected="@(p.Status == "Active" ? true : null)">Active</option>
                            <option value="Paused" selected="@(p.Status == "Paused" ? true : null)">Paused</option>
                            <option value="Done" selected="@(p.Status == "Done" ? true : null)">Done</option>
                        </select>
                        <input name="progress" type="number" min="0" max="100" value="@p.ProgressPercent" class="form-control form-control-sm" style="width:72px;" />
                        <button type="submit" class="btn-los btn-secondary btn-sm">Update</button>
                    </form>
                </div>
            </div>
        }
    </div>
}

@if (!Model.Any())
{
    <div class="los-card">
        <div class="empty-state">
            <div class="empty-state-icon">◈</div>
            <div class="empty-state-title">No projects yet</div>
            <div class="empty-state-desc">Add your first project to start building momentum on your goals.</div>
            <button class="btn-los btn-primary" data-bs-toggle="collapse" data-bs-target="#addProjectPanel">Add First Project</button>
        </div>
    </div>
}