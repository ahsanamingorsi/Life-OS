@model List<LifeOS.MVC.Models.Project>
@{
    ViewData["Title"] = "Projects";
    var taskCounts = ViewBag.TaskCounts as Dictionary<int, LifeOS.MVC.Models.ProjectTaskCount> ?? new();
    var categories = ViewBag.Categories as List<string> ?? new();
    int active = Model.Count(p => p.Status == "Active");
    int paused = Model.Count(p => p.Status == "Paused");
    int done = Model.Count(p => p.Status == "Done");
    var activeOnes = Model.Where(p => p.Status == "Active").ToList();
    int avg = activeOnes.Any() ? (int)Math.Round(activeOnes.Average(p => Math.Clamp(p.ProgressPercent, 0, 100))) : 0;
    var today = DateTime.Today;
}

<div class="db">
    <div class="db-head">
        <div>
            <div class="db-date">Projects</div>
            <h1 class="db-title">Give every idea a clear next step.</h1>
        </div>
        <div class="db-actions">
            <a class="lo-btn lo-btn-primary" href="#newProject">@await Html.PartialAsync("_Icon", "plus") New project</a>
        </div>
    </div>

    @if (TempData["Success"] is string ok) { <div class="lo-flash" role="status">@ok</div> }

    <div class="db-grid-levels">
        <div class="db-level"><span class="db-muted db-tiny">Active</span><span class="db-level-pct lo-num">@active</span><span class="db-muted db-tiny">average @avg% done</span></div>
        <div class="db-level"><span class="db-muted db-tiny">Paused</span><span class="db-level-pct lo-num">@paused</span><span class="db-muted db-tiny">waiting</span></div>
        <div class="db-level"><span class="db-muted db-tiny">Completed</span><span class="db-level-pct lo-num">@done</span><span class="db-muted db-tiny">finished</span></div>
    </div>

    @if (!Model.Any())
    {
        <section class="db-card"><p class="db-empty">No projects yet. Create your first project below and break it into tasks.</p></section>
    }

    @foreach (var status in new[] { "Active", "Paused", "Done" })
    {
        var group = Model.Where(p => p.Status == status)
            .OrderBy(p => p.Priority).ThenBy(p => p.Deadline ?? DateTime.MaxValue).ThenBy(p => p.Title).ToList();
        if (!group.Any()) { continue; }
        <section class="db-section" aria-labelledby="group-@status">
            <div class="db-section-head"><h2 id="group-@status" class="db-h2-lg">@(status == "Done" ? "Completed" : status)</h2><span class="db-muted db-small lo-num">@group.Count</span></div>
            <div class="db-grid-2">
                @foreach (var p in group)
                {
                    taskCounts.TryGetValue(p.Id, out var tc);
                    int total = tc?.Total ?? 0;
                    int doneTasks = tc?.Done ?? 0;
                    int pct = Math.Clamp(p.ProgressPercent, 0, 100);
                    bool overdue = p.Deadline.HasValue && p.Deadline.Value.Date < today && p.Status != "Done";
                    <article class="db-card lo-project-card">
                        <div class="db-card-head">
                            <div style="min-width:0;">
                                <div class="db-muted db-tiny">@(string.IsNullOrEmpty(p.Category) ? "No category" : p.Category)</div>
                                <h3 class="db-h2 lo-goal-title"><a class="lo-plain-link" href="/Projects/Detail/@p.Id">@p.Title</a></h3>
                            </div>
                            <span class="db-pri @p.Priority.ToLowerInvariant()" aria-label="Priority @p.Priority">@p.Priority</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(p.Notes)) { <p class="db-muted db-small lo-clamp-2" style="margin:0;">@p.Notes</p> }
                        <div class="db-muted db-tiny">Next: @(p.NextTask ?? "choose your next step")</div>
                        <div class="db-bar" role="progressbar" aria-label="Progress of @p.Title" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@pct"><span style="width:@pct%"></span></div>
                        <div class="lo-card-foot">
                            <span class="db-muted db-tiny lo-num">@(total == 0 ? "No tasks yet" : $"{doneTasks} of {total} tasks") · @pct%</span>
                            <span class="db-tiny @(overdue ? "db-neg" : "db-muted")">@(p.Deadline.HasValue ? (overdue ? "Overdue · " : "Due ") + p.Deadline.Value.ToString("d MMM yyyy") : "No deadline")</span>
                        </div>
                        <div class="lo-form-actions">
                            <form method="post" asp-action="Delete">
                                <input type="hidden" name="id" value="@p.Id" />
                                <button type="submit" class="lo-btn lo-btn-sm lo-btn-danger" data-confirm="Delete '@p.Title' and all its tasks?">Delete</button>
                            </form>
                            <a class="lo-btn lo-btn-sm lo-btn-primary" href="/Projects/Detail/@p.Id">Open project</a>
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    <section class="db-card" id="newProject" aria-labelledby="newProjectTitle">
        <h2 id="newProjectTitle" class="db-h2">New project</h2>
        <form method="post" asp-action="Add" class="lo-form">
            <div class="lo-field">
                <label for="pTitle" class="lo-label">Title <span aria-hidden="true">*</span></label>
                <input id="pTitle" name="Title" class="lo-input" required maxlength="150" placeholder="What are you building?" />
            </div>
            <div class="lo-form-grid">
                <div class="lo-field">
                    <label for="pCategory" class="lo-label">Category</label>
                    <input id="pCategory" name="Category" class="lo-input" maxlength="50" list="projectCategories" placeholder="Type or pick one" />
                </div>
                <div class="lo-field">
                    <label for="pPriority" class="lo-label">Priority</label>
                    <select id="pPriority" name="Priority" class="lo-select"><option value="A">A — Critical</option><option value="B" selected>B — Important</option><option value="C">C — Nice to have</option></select>
                </div>
                <div class="lo-field">
                    <label for="pStatus" class="lo-label">Status</label>
                    <select id="pStatus" name="Status" class="lo-select"><option value="Active">Active</option><option value="Paused">Paused</option></select>
                </div>
                <div class="lo-field">
                    <label for="pDeadline" class="lo-label">Deadline <span class="db-muted">(optional)</span></label>
                    <input id="pDeadline" name="Deadline" type="date" class="lo-input" />
                </div>
            </div>
            <div class="lo-field">
                <label for="pNotes" class="lo-label">Goal / notes <span class="db-muted">(optional)</span></label>
                <textarea id="pNotes" name="Notes" class="lo-input lo-textarea" maxlength="500" placeholder="What does success look like?"></textarea>
            </div>
            <div class="lo-form-actions"><button type="submit" class="lo-btn lo-btn-primary">Create project</button></div>
        </form>
    </section>
</div>

<datalist id="projectCategories">
    @foreach (var c in categories) { <option value="@c"></option> }
</datalist>
