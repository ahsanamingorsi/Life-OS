@model LifeOS.MVC.Models.ProjectDetailViewModel
@{
    var p = Model.Project;
    ViewData["Title"] = p.Title;
    var categories = ViewBag.Categories as List<string> ?? new();
    var today = DateTime.Today;
    bool overdueProject = p.Deadline.HasValue && p.Deadline.Value.Date < today && p.Status != "Done";
    string Minutes(int m) => m >= 60 ? $"{m / 60}h {m % 60}m" : $"{m}m";
    (string Key, string Label, List<LifeOS.MVC.Models.ProjectTask> Tasks, string Empty)[] columns =
    {
        ("Todo", "To do", Model.TodoTasks, "No tasks waiting."),
        ("InProgress", "In progress", Model.InProgressTasks, "Start a task to see it here."),
        ("Done", "Done", Model.DoneTasks, "Finished tasks appear here."),
    };
}

<div class="db">
    <div class="db-head">
        <div style="min-width:0;">
            <a class="db-link" href="/Projects">← Projects</a>
            <h1 class="db-title lo-goal-title">@p.Title</h1>
            <div class="lo-chips">
                <span class="db-pri @p.Priority.ToLowerInvariant()">Priority @p.Priority</span>
                <span class="db-badge">@p.Status</span>
                @if (!string.IsNullOrEmpty(p.Category)) { <span class="db-badge">@p.Category</span> }
                <span class="db-badge @(overdueProject ? "high" : "")">@(p.Deadline.HasValue ? (overdueProject ? "Overdue · " : "Due ") + p.Deadline.Value.ToString("d MMM yyyy") : "No deadline")</span>
            </div>
        </div>
        <div class="db-actions">
            <a class="lo-btn" href="#editProject">Edit project</a>
            <a class="lo-btn lo-btn-primary" href="#addTask">@await Html.PartialAsync("_Icon", "plus") Add task</a>
        </div>
    </div>

    @if (TempData["Success"] is string ok) { <div class="lo-flash" role="status">@ok</div> }

    <div class="db-grid-levels">
        <div class="db-level"><span class="db-muted db-tiny">Progress</span><span class="db-level-pct lo-num">@Math.Clamp(p.ProgressPercent, 0, 100)%</span><div class="db-bar" role="presentation"><span style="width:@Math.Clamp(p.ProgressPercent, 0, 100)%"></span></div></div>
        <div class="db-level"><span class="db-muted db-tiny">Tasks done</span><span class="db-level-pct lo-num">@Model.CompletedTasks / @Model.TotalTasks</span><span class="db-muted db-tiny">@Model.InProgressTasks.Count in progress</span></div>
        <div class="db-level"><span class="db-muted db-tiny">Overdue</span><span class="db-level-pct lo-num @(Model.OverdueTasks > 0 ? "db-neg" : "")">@Model.OverdueTasks</span><span class="db-muted db-tiny">open tasks past due</span></div>
        <div class="db-level"><span class="db-muted db-tiny">Time</span><span class="db-level-pct lo-num">@Minutes(Model.TotalActualMinutes)</span><span class="db-muted db-tiny">logged of @Minutes(Model.TotalEstimatedMinutes) planned</span></div>
    </div>

    @if (!string.IsNullOrWhiteSpace(p.Notes)) { <section class="db-card"><p class="db-small" style="margin:0; white-space:pre-line;">@p.Notes</p></section> }

    <div class="lo-kanban">
        @foreach (var col in columns)
        {
            <section class="lo-kanban-col lo-col-@col.Key.ToLowerInvariant()" aria-labelledby="col-@col.Key">
                <div class="lo-kanban-head"><h2 id="col-@col.Key" class="db-h3">@col.Label</h2><span class="db-badge lo-num">@col.Tasks.Count</span></div>
                @if (!col.Tasks.Any()) { <p class="db-empty db-small">@col.Empty</p> }
                @foreach (var t in col.Tasks)
                {
                    bool overdue = !t.IsCompleted && t.DueDate.HasValue && t.DueDate.Value.Date < today;
                    <article class="lo-task-card @(t.IsCompleted ? "is-done" : "") @(overdue ? "is-overdue" : "")">
                        <div class="lo-task-top">
                            <h3 class="lo-task-title">@t.Title</h3>
                            <span class="db-pri @t.Priority.ToLowerInvariant()" aria-label="Priority @t.Priority">@t.Priority</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(t.Description)) { <p class="db-muted db-tiny" style="margin:0;">@t.Description</p> }
                        <div class="lo-chips db-tiny">
                            @if (t.DueDate.HasValue) { <span class="@(overdue ? "db-neg" : "db-muted")">@(overdue ? "Overdue · " : "Due ")@t.DueDate.Value.ToString("d MMM")</span> }
                            @if (t.EstimatedMinutes > 0) { <span class="db-muted">~@Minutes(t.EstimatedMinutes.Value) planned</span> }
                            @if (t.ActualMinutes > 0) { <span class="db-muted">@Minutes(t.ActualMinutes.Value) logged</span> }
                            @if (t.IsCompleted && t.CompletedAt.HasValue) { <span class="db-muted">Done @t.CompletedAt.Value.ToString("d MMM")</span> }
                        </div>
                        <div class="lo-task-actions">
                            @if (t.Status == "Todo")
                            {
                                <form method="post" asp-action="MoveTask"><input type="hidden" name="taskId" value="@t.Id" /><input type="hidden" name="status" value="InProgress" /><button type="submit" class="lo-btn lo-btn-sm">Start</button></form>
                            }
                            @if (t.Status == "InProgress")
                            {
                                <form method="post" asp-action="MoveTask"><input type="hidden" name="taskId" value="@t.Id" /><input type="hidden" name="status" value="Todo" /><button type="submit" class="lo-btn lo-btn-sm">Back to To do</button></form>
                            }
                            @if (t.Status != "Done")
                            {
                                <form method="post" asp-action="MoveTask"><input type="hidden" name="taskId" value="@t.Id" /><input type="hidden" name="status" value="Done" /><button type="submit" class="lo-btn lo-btn-sm lo-btn-primary">Done</button></form>
                            }
                            else
                            {
                                <form method="post" asp-action="MoveTask"><input type="hidden" name="taskId" value="@t.Id" /><input type="hidden" name="status" value="Todo" /><button type="submit" class="lo-btn lo-btn-sm">Reopen</button></form>
                            }
                        </div>
                        <details class="lo-task-more">
                            <summary class="db-link">Edit, log time or delete</summary>
                            <form method="post" asp-action="LogTime" class="lo-inline-form">
                                <input type="hidden" name="taskId" value="@t.Id" />
                                <label for="log-@(t.Id)" class="db-small">Minutes spent</label>
                                <input id="log-@(t.Id)" name="minutes" type="number" min="1" max="1440" required class="lo-input lo-input-tiny" placeholder="45" />
                                <button type="submit" class="lo-btn lo-btn-sm">Log time</button>
                            </form>
                            <form method="post" asp-action="EditTask" class="lo-form">
                                <input type="hidden" name="Id" value="@t.Id" />
                                <input type="hidden" name="ProjectId" value="@p.Id" />
                                <div class="lo-field"><label class="lo-label" for="tTitle-@(t.Id)">Title</label><input id="tTitle-@(t.Id)" name="Title" class="lo-input" value="@t.Title" required maxlength="200" /></div>
                                <div class="lo-form-grid">
                                    <div class="lo-field"><label class="lo-label" for="tPri-@(t.Id)">Priority</label><select id="tPri-@(t.Id)" name="Priority" class="lo-select"><option value="A" selected="@(t.Priority == "A")">A — Critical</option><option value="B" selected="@(t.Priority == "B")">B — Important</option><option value="C" selected="@(t.Priority == "C")">C — Low</option></select></div>
                                    <div class="lo-field"><label class="lo-label" for="tDue-@(t.Id)">Due date</label><input id="tDue-@(t.Id)" name="DueDate" type="date" class="lo-input" value="@(t.DueDate?.ToString("yyyy-MM-dd") ?? "")" /></div>
                                    <div class="lo-field"><label class="lo-label" for="tEst-@(t.Id)">Planned min</label><input id="tEst-@(t.Id)" name="EstimatedMinutes" type="number" min="0" max="100000" class="lo-input" value="@t.EstimatedMinutes" /></div>
                                    <div class="lo-field"><label class="lo-label" for="tAct-@(t.Id)">Logged min</label><input id="tAct-@(t.Id)" name="ActualMinutes" type="number" min="0" max="100000" class="lo-input" value="@t.ActualMinutes" /></div>
                                </div>
                                <div class="lo-field"><label class="lo-label" for="tDesc-@(t.Id)">Description</label><textarea id="tDesc-@(t.Id)" name="Description" class="lo-input lo-textarea" maxlength="500">@t.Description</textarea></div>
                                <div class="lo-field"><label class="lo-label" for="tNotes-@(t.Id)">Notes</label><textarea id="tNotes-@(t.Id)" name="Notes" class="lo-input lo-textarea" maxlength="300">@t.Notes</textarea></div>
                                <div class="lo-form-actions"><button type="submit" class="lo-btn lo-btn-primary lo-btn-sm">Save task</button></div>
                            </form>
                            <form method="post" asp-action="DeleteTask" class="lo-form-actions">
                                <input type="hidden" name="taskId" value="@t.Id" />
                                <input type="hidden" name="projectId" value="@p.Id" />
                                <button type="submit" class="lo-btn lo-btn-sm lo-btn-danger" data-confirm="Delete the task '@t.Title'?">Delete task</button>
                            </form>
                        </details>
                    </article>
                }
            </section>
        }
    </div>

    <div class="db-grid-2">
        <section class="db-card" id="addTask" aria-labelledby="addTaskTitle">
            <h2 id="addTaskTitle" class="db-h2">Add a task</h2>
            <form method="post" asp-action="AddTask" class="lo-form">
                <input type="hidden" name="ProjectId" value="@p.Id" />
                <div class="lo-field"><label for="nTitle" class="lo-label">Title <span aria-hidden="true">*</span></label><input id="nTitle" name="Title" class="lo-input" required maxlength="200" placeholder="What needs to be done?" /></div>
                <div class="lo-form-grid">
                    <div class="lo-field"><label for="nPri" class="lo-label">Priority</label><select id="nPri" name="Priority" class="lo-select"><option value="A">A — Critical</option><option value="B" selected>B — Important</option><option value="C">C — Low</option></select></div>
                    <div class="lo-field"><label for="nDue" class="lo-label">Due date</label><input id="nDue" name="DueDate" type="date" class="lo-input" /></div>
                    <div class="lo-field"><label for="nEst" class="lo-label">Planned min</label><input id="nEst" name="EstimatedMinutes" type="number" min="0" max="100000" class="lo-input" placeholder="60" /></div>
                </div>
                <div class="lo-field"><label for="nDesc" class="lo-label">Description <span class="db-muted">(optional)</span></label><textarea id="nDesc" name="Description" class="lo-input lo-textarea" maxlength="500"></textarea></div>
                <div class="lo-form-actions"><button type="submit" class="lo-btn lo-btn-primary">Add task</button></div>
            </form>
        </section>

        <section class="db-card" id="editProject" aria-labelledby="editProjectTitle">
            <h2 id="editProjectTitle" class="db-h2">Edit project</h2>
            <form method="post" asp-action="UpdateStatus" class="lo-form">
                <input type="hidden" name="id" value="@p.Id" />
                <div class="lo-field"><label for="eTitle" class="lo-label">Title <span aria-hidden="true">*</span></label><input id="eTitle" name="title" class="lo-input" required maxlength="150" value="@p.Title" /></div>
                <div class="lo-form-grid">
                    <div class="lo-field"><label for="eCat" class="lo-label">Category</label><input id="eCat" name="category" class="lo-input" maxlength="50" list="projectCategories" value="@p.Category" /></div>
                    <div class="lo-field"><label for="ePri" class="lo-label">Priority</label><select id="ePri" name="priority" class="lo-select"><option value="A" selected="@(p.Priority == "A")">A — Critical</option><option value="B" selected="@(p.Priority == "B")">B — Important</option><option value="C" selected="@(p.Priority == "C")">C — Low</option></select></div>
                    <div class="lo-field"><label for="eStatus" class="lo-label">Status</label><select id="eStatus" name="status" class="lo-select"><option value="Active" selected="@(p.Status == "Active")">Active</option><option value="Paused" selected="@(p.Status == "Paused")">Paused</option><option value="Done" selected="@(p.Status == "Done")">Done</option></select></div>
                    <div class="lo-field"><label for="eDeadline" class="lo-label">Deadline</label><input id="eDeadline" name="deadline" type="date" class="lo-input" value="@(p.Deadline?.ToString("yyyy-MM-dd") ?? "")" /></div>
                    <div class="lo-field">
                        <label for="eProgress" class="lo-label">Progress %</label>
                        @if (Model.Tasks.Any()) { <input id="eProgress" class="lo-input" value="@p.ProgressPercent% (from tasks)" disabled /> }
                        else { <input id="eProgress" name="progress" type="number" min="0" max="100" class="lo-input" value="@p.ProgressPercent" /> }
                    </div>
                </div>
                <div class="lo-field"><label for="eNext" class="lo-label">Next task <span class="db-muted">(filled from tasks, or type your own)</span></label><input id="eNext" name="nextTask" class="lo-input" maxlength="300" value="@p.NextTask" /></div>
                <div class="lo-field"><label for="eNotes" class="lo-label">Goal / notes</label><textarea id="eNotes" name="notes" class="lo-input lo-textarea" maxlength="500">@p.Notes</textarea></div>
                <div class="lo-form-actions"><button type="submit" class="lo-btn lo-btn-primary">Save project</button></div>
            </form>
        </section>
    </div>
</div>

<datalist id="projectCategories">
    @foreach (var c in categories) { <option value="@c"></option> }
</datalist>
