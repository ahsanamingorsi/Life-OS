@model LifeOS.MVC.Models.ProjectDetailViewModel
@{ ViewData["Title"] = Model.Project.Title; }

@if (TempData["Success"] != null) { <div class="los-alert los-alert-success">✓ @TempData["Success"]</div> }
@if (TempData["Info"] != null)    { <div class="los-alert los-alert-info">ℹ @TempData["Info"]</div> }

<!-- Page Header -->
<div class="los-page-header">
    <div style="display:flex; align-items:flex-start; gap:14px; flex-wrap:wrap;">
        <a asp-action="Index" asp-controller="Projects" class="btn-los btn-secondary btn-sm"
           style="margin-top:6px;">← Projects</a>
        <div>
            <div class="los-page-title">@Model.Project.Title</div>
            <div style="display:flex; gap:6px; margin-top:6px; flex-wrap:wrap; align-items:center;">
                <span class="badge badge-priority-@Model.Project.Priority.ToLower()">
                    Priority @Model.Project.Priority
                </span>
                <span class="badge badge-@Model.Project.Status.ToLower()">@Model.Project.Status</span>
                @if (!string.IsNullOrEmpty(Model.Project.Category))
                {
                    <span class="badge badge-neutral">@Model.Project.Category</span>
                }
                @if (Model.Project.Deadline.HasValue)
                {
                    bool od = Model.Project.Deadline.Value.Date < DateTime.Today && Model.Project.Status != "Done";
                    <span class="badge @(od?"badge-rose":"badge-neutral")">
                        Due @Model.Project.Deadline.Value.ToString("MMM d, yyyy")
                    </span>
                }
            </div>
        </div>
    </div>
    <div class="los-page-actions">
        <button class="btn-los btn-secondary" data-bs-toggle="collapse" data-bs-target="#editProjectPanel">
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none">
                <path d="M11 2l3 3-9 9H2v-3L11 2z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
            </svg>
            Edit Project
        </button>
        <button class="btn-los btn-primary" data-bs-toggle="collapse" data-bs-target="#addTaskPanel">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            Add Task
        </button>
    </div>
</div>

<!-- Edit Project Panel -->
<div class="collapse" id="editProjectPanel">
    <div class="los-panel">
        <div class="los-panel-title">Edit Project</div>
        <form method="post" asp-action="UpdateStatus" asp-controller="Projects">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Project.Id" />
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Status</label>
                        <select name="status" class="form-control">
                            <option value="Active" selected="@(Model.Project.Status == "Active")">Active</option>
                            <option value="Paused" selected="@(Model.Project.Status == "Paused")">Paused</option>
                            <option value="Done" selected="@(Model.Project.Status == "Done")">Done</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="form-label">Progress %</label>
                        <input name="progress" type="number" min="0" max="100"
                               class="form-control" value="@Model.Project.ProgressPercent" />
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="form-group">
                        <label class="form-label">Next Task (override)</label>
                        <input name="nextTask" class="form-control"
                               value="@Model.Project.NextTask"
                               placeholder="Auto-filled from tasks, or override here" />
                    </div>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn-los btn-primary w-100">Save</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Add Task Panel -->
<div class="collapse" id="addTaskPanel">
    <div class="los-panel">
        <div class="los-panel-title">Add Task to Project</div>
        <form method="post" asp-action="AddTask" asp-controller="Projects">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ProjectId" value="@Model.Project.Id" />
            <div class="row g-3">
                <div class="col-md-5">
                    <div class="form-group">
                        <label class="form-label">Task Title *</label>
                        <input name="Title" class="form-control" required
                               placeholder="What needs to be done?" maxlength="200" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="form-label">Priority</label>
                        <select name="Priority" class="form-control">
                            <option value="A">A — Critical</option>
                            <option value="B" selected>B — Important</option>
                            <option value="C">C — Low</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="form-label">Due Date</label>
                        <input name="DueDate" type="date" class="form-control" />
                    </div>
                </div>
                <div class="col-md-1">
                    <div class="form-group">
                        <label class="form-label">Est. (min)</label>
                        <input name="EstimatedMinutes" type="number" min="0"
                               class="form-control" placeholder="60" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="form-label">Description</label>
                        <input name="Description" class="form-control"
                               placeholder="Optional" maxlength="500" />
                    </div>
                </div>
                <div class="col-12 d-flex justify-content-end gap-2">
                    <button type="button" class="btn-los btn-secondary"
                            data-bs-toggle="collapse" data-bs-target="#addTaskPanel">Cancel</button>
                    <button type="submit" class="btn-los btn-primary">Add Task</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- ── PROJECT STATS ─────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="los-kpi">
            <div class="los-kpi-icon icon-bg-indigo">@await Html.PartialAsync("_Icon", "plan")</div>
            <div class="los-kpi-value">@Model.TotalTasks</div>
            <div class="los-kpi-label">Total Tasks</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="los-kpi">
            <div class="los-kpi-icon icon-bg-green">
                <svg width="18" height="18" viewBox="0 0 16 16" fill="none">
                    <path d="M3 8l3 3 7-6" stroke="currentColor" stroke-width="1.5"
                          stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <div class="los-kpi-value" style="color:var(--green)">@Model.CompletedTasks</div>
            <div class="los-kpi-label">Done</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="los-kpi">
            <div class="los-kpi-icon icon-bg-rose">@await Html.PartialAsync("_Icon", "alert")</div>
            <div class="los-kpi-value"
                 style="color:@(Model.OverdueTasks > 0 ? "var(--rose)" : "var(--text-primary)")">
                @Model.OverdueTasks
            </div>
            <div class="los-kpi-label">Overdue</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="los-kpi">
            <div class="los-kpi-icon icon-bg-amber">%</div>
            <div class="los-kpi-value"
                 style="color:@(Model.ProgressPercent>=75?"var(--green)":Model.ProgressPercent>=40?"var(--amber)":"var(--rose)")">
                @Model.ProgressPercent%
            </div>
            <div class="los-kpi-label">Progress</div>
        </div>
    </div>
</div>

<!-- Overall progress bar -->
@if (Model.TotalTasks > 0)
{
    <div class="los-card mb-4" style="padding:14px 20px;">
        <div style="display:flex; align-items:center; gap:14px;">
            <span style="font-size:0.78rem; color:var(--text-tertiary); min-width:80px;">
                @Model.CompletedTasks / @Model.TotalTasks tasks
            </span>
            <div class="los-progress los-progress-lg" style="flex:1;">
                <div class="los-progress-bar
                            @(Model.ProgressPercent>=75?"green":Model.ProgressPercent>=40?"":"amber")"
                     data-width="@Model.ProgressPercent">
                </div>
            </div>
            <span style="font-size:0.9rem; font-weight:700; color:var(--accent); min-width:44px; text-align:right;">
                @Model.ProgressPercent%
            </span>
        </div>
        @if (Model.TotalEstimatedMinutes > 0)
        {
            <div style="font-size:0.72rem; color:var(--text-tertiary); margin-top:8px;">
                Estimated: @(Model.TotalEstimatedMinutes / 60)h @(Model.TotalEstimatedMinutes % 60)m
                @if (Model.TotalActualMinutes > 0)
                {
                    <span style="margin-left:10px;">
                        Actual: @(Model.TotalActualMinutes / 60)h @(Model.TotalActualMinutes % 60)m
                    </span>
                }
            </div>
        }
    </div>
}

<!-- ── KANBAN BOARD ──────────────────────────────────────────────── -->
@if (!Model.Tasks.Any())
{
    <div class="los-card">
        <div class="empty-state">
            <div class="empty-state-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                          stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </div>
            <div class="empty-state-title">No tasks yet</div>
            <div class="empty-state-desc">Break this project into clear, actionable tasks. Each completed task moves you forward.</div>
            <button class="btn-los btn-primary"
                    data-bs-toggle="collapse" data-bs-target="#addTaskPanel">
                Add First Task
            </button>
        </div>
    </div>
}
else
{
    <!-- KANBAN: 3 columns -->
    <div class="row g-3">

        <!-- ── TODO ───────────────────────────────────────────────── -->
        <div class="col-lg-4">
            <div style="background:var(--surface-2); border:1px solid var(--border);
                        border-radius:var(--radius-lg); overflow:hidden;">
                <!-- Column header -->
                <div style="padding:12px 16px; border-bottom:1px solid var(--border);
                            display:flex; align-items:center; gap:8px;">
                    <div style="width:10px; height:10px; border-radius:50%;
                                background:var(--text-disabled);"></div>
                    <span style="font-size:0.75rem; font-weight:700; text-transform:uppercase;
                                 letter-spacing:.1em; color:var(--text-tertiary);">
                        To Do
                    </span>
                    <span style="margin-left:auto; background:var(--surface-3);
                                 border:1px solid var(--border); border-radius:var(--radius-full);
                                 padding:1px 8px; font-size:0.7rem; font-weight:700;
                                 color:var(--text-tertiary);">
                        @Model.TodoTasks.Count
                    </span>
                </div>
                <!-- Tasks -->
                <div style="padding:10px; display:flex; flex-direction:column; gap:8px; min-height:100px;">
                    @if (!Model.TodoTasks.Any())
                    {
                        <div style="text-align:center; padding:20px 10px;
                                    font-size:0.8rem; color:var(--text-disabled);">
                            No tasks here
                        </div>
                    }
                    @foreach (var t in Model.TodoTasks)
                    {
                        @await Html.PartialAsync("_ProjectTaskCard", t,
                            new ViewDataDictionary(ViewData) { { "ProjectId", Model.Project.Id } })
                    }
                </div>
            </div>
        </div>

        <!-- ── IN PROGRESS ────────────────────────────────────────── -->
        <div class="col-lg-4">
            <div style="background:var(--accent-soft); border:1px solid rgba(79,70,229,0.15);
                        border-radius:var(--radius-lg); overflow:hidden;">
                <div style="padding:12px 16px; border-bottom:1px solid rgba(79,70,229,0.15);
                            display:flex; align-items:center; gap:8px;">
                    <div style="width:10px; height:10px; border-radius:50%;
                                background:var(--accent);"></div>
                    <span style="font-size:0.75rem; font-weight:700; text-transform:uppercase;
                                 letter-spacing:.1em; color:var(--accent);">
                        In Progress
                    </span>
                    <span style="margin-left:auto; background:var(--accent-muted);
                                 border:1px solid rgba(79,70,229,0.2); border-radius:var(--radius-full);
                                 padding:1px 8px; font-size:0.7rem; font-weight:700;
                                 color:var(--accent);">
                        @Model.InProgressTasks.Count
                    </span>
                </div>
                <div style="padding:10px; display:flex; flex-direction:column; gap:8px; min-height:100px;">
                    @if (!Model.InProgressTasks.Any())
                    {
                        <div style="text-align:center; padding:20px 10px;
                                    font-size:0.8rem; color:var(--accent); opacity:.5;">
                            Move tasks here when working
                        </div>
                    }
                    @foreach (var t in Model.InProgressTasks)
                    {
                        @await Html.PartialAsync("_ProjectTaskCard", t,
                            new ViewDataDictionary(ViewData) { { "ProjectId", Model.Project.Id } })
                    }
                </div>
            </div>
        </div>

        <!-- ── DONE ───────────────────────────────────────────────── -->
        <div class="col-lg-4">
            <div style="background:var(--green-soft); border:1px solid rgba(22,163,74,0.15);
                        border-radius:var(--radius-lg); overflow:hidden;">
                <div style="padding:12px 16px; border-bottom:1px solid rgba(22,163,74,0.15);
                            display:flex; align-items:center; gap:8px;">
                    <div style="width:10px; height:10px; border-radius:50%;
                                background:var(--green);"></div>
                    <span style="font-size:0.75rem; font-weight:700; text-transform:uppercase;
                                 letter-spacing:.1em; color:var(--green);">
                        Done
                    </span>
                    <span style="margin-left:auto; background:var(--green-muted);
                                 border:1px solid rgba(22,163,74,0.2); border-radius:var(--radius-full);
                                 padding:1px 8px; font-size:0.7rem; font-weight:700;
                                 color:var(--green);">
                        @Model.DoneTasks.Count
                    </span>
                </div>
                <div style="padding:10px; display:flex; flex-direction:column; gap:8px; min-height:100px;">
                    @if (!Model.DoneTasks.Any())
                    {
                        <div style="text-align:center; padding:20px 10px;
                                    font-size:0.8rem; color:var(--green); opacity:.5;">
                            Completed tasks appear here
                        </div>
                    }
                    @foreach (var t in Model.DoneTasks)
                    {
                        @await Html.PartialAsync("_ProjectTaskCard", t,
                            new ViewDataDictionary(ViewData) { { "ProjectId", Model.Project.Id } })
                    }
                </div>
            </div>
        </div>

    </div>
}

<!-- Edit Task Modals (one per task) -->
@foreach (var t in Model.Tasks)
{
    <div class="modal fade" id="editTask@t.Id" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Task</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" asp-action="EditTask" asp-controller="Projects">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@t.Id" />
                    <input type="hidden" name="ProjectId" value="@Model.Project.Id" />
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="form-group">
                                    <label class="form-label">Title *</label>
                                    <input name="Title" class="form-control" value="@t.Title" required />
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-group">
                                    <label class="form-label">Priority</label>
                                    <select name="Priority" class="form-control">
                                        <option value="A" selected="@(t.Priority == "A")">A — Critical</option>
                                        <option value="B" selected="@(t.Priority == "B")">B — Important</option>
                                        <option value="C" selected="@(t.Priority == "C")">C — Low</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-group">
                                    <label class="form-label">Due Date</label>
                                    <input name="DueDate" type="date" class="form-control"
                                           value="@(t.DueDate?.ToString("yyyy-MM-dd") ?? "")" />
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-group">
                                    <label class="form-label">Est. Minutes</label>
                                    <input name="EstimatedMinutes" type="number" min="0"
                                           class="form-control" value="@t.EstimatedMinutes" />
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-group">
                                    <label class="form-label">Actual Minutes</label>
                                    <input name="ActualMinutes" type="number" min="0"
                                           class="form-control" value="@t.ActualMinutes" />
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-group">
                                    <label class="form-label">Description</label>
                                    <textarea name="Description" class="form-control">@t.Description</textarea>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-group">
                                    <label class="form-label">Notes</label>
                                    <textarea name="Notes" class="form-control">@t.Notes</textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-los btn-secondary"
                                data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn-los btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}