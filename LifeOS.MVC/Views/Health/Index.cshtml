@model LifeOS.MVC.Models.HealthEntry
@{
    ViewData["Title"] = "Health & Body";
    var last7 = ViewBag.Last7 as List<LifeOS.MVC.Models.HealthEntry> ?? new();
    int totalDone = 0, totalPossible = last7.Count * 4;
    foreach (var e in last7) { if (e.WorkoutDone) totalDone++; if (e.DietClean) totalDone++; if (e.WaterLiters >= 2) totalDone++; if (e.SleepHours >= 7) totalDone++; }
    int weekHealth = totalPossible > 0 ? (int)((double)totalDone / totalPossible * 100) : 0;
}

<div class="los-page-header">
    <div>
        <div class="los-page-title">Health & Body</div>
        <div class="los-page-subtitle">Track physical discipline. Your body is your foundation.</div>
    </div>
</div>

<div class="row g-4">
    <!-- Today's Log Form -->
    <div class="col-lg-5">
        <div class="los-card">
            <div class="los-card-title-lg" style="margin-bottom:18px;">Log Today — @DateTime.Today.ToString("MMMM d, yyyy")</div>
            <form method="post" asp-action="Save" asp-controller="Health">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <div class="row g-3">
                    <div class="col-12">
                        <label class="toggle-wrap">
                            <div class="toggle"><input name="WorkoutDone" type="checkbox" value="true" @(Model.WorkoutDone ? "checked" : "") /><div class="toggle-track"></div></div>
                            <span class="toggle-label" style="font-weight:500;">Workout completed</span>
                        </label>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            <label class="form-label">Workout Note</label>
                            <input name="WorkoutNote" class="form-control" value="@Model.WorkoutNote" placeholder="e.g. 5km run, 30 push-ups" />
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">Water (Liters)</label>
                            <input name="WaterLiters" type="number" step="0.25" min="0" max="10" class="form-control" value="@Model.WaterLiters" />
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">Sleep (Hours)</label>
                            <input name="SleepHours" type="number" step="0.5" min="0" max="24" class="form-control" value="@Model.SleepHours" />
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">Weight (kg)</label>
                            <input name="WeightKg" type="number" step="0.1" class="form-control" value="@Model.WeightKg" placeholder="Optional" />
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">Energy Level (1–10)</label>
                            <input name="EnergyLevel" type="number" min="1" max="10" class="form-control" value="@(Model.EnergyLevel > 0 ? Model.EnergyLevel : 5)" />
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            <label class="form-label">Diet Note</label>
                            <input name="DietNote" class="form-control" value="@Model.DietNote" placeholder="What did you eat today?" />
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="toggle-wrap">
                            <div class="toggle"><input name="DietClean" type="checkbox" value="true" @(Model.DietClean ? "checked" : "") /><div class="toggle-track"></div></div>
                            <span class="toggle-label" style="font-weight:500;">Diet was clean today</span>
                        </label>
                    </div>
                    <div class="col-12" style="margin-top:4px;">
                        <button type="submit" class="btn-los btn-primary w-100">Save Today's Log</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Right Column -->
    <div class="col-lg-7">
        <!-- Weekly Summary -->
        <div class="los-card mb-4">
            <div class="los-card-header">
                <div class="los-card-title-lg">7-Day Overview</div>
                <div style="font-family:'Instrument Serif',serif; font-size:1.3rem; color:@(weekHealth >= 70 ? "var(--green)" : weekHealth >= 40 ? "var(--amber)" : "var(--rose)")">@weekHealth%</div>
            </div>
            <div class="los-progress los-progress-lg mb-3">
                <div class="los-progress-bar @(weekHealth >= 70 ? "green" : weekHealth >= 40 ? "" : "amber")" data-width="@weekHealth"></div>
            </div>
            @if (!last7.Any())
            {
                <div style="font-size:0.85rem; color:var(--text-tertiary); text-align:center; padding:16px;">No data yet. Start logging daily.</div>
            }
            else
            {
                <div class="los-table-wrap">
                    <table class="los-table">
                        <thead><tr><th>Date</th><th>Workout</th><th>Water</th><th>Sleep</th><th>Energy</th><th>Diet</th></tr></thead>
                        <tbody>
                            @foreach (var e in last7.OrderByDescending(x => x.Date))
                            {
                                <tr>
                                    <td style="font-weight:500;">@e.Date.ToString("MMM d")</td>
                                    <td><span class="badge @(e.WorkoutDone ? "badge-green" : "badge-rose")">@(e.WorkoutDone ? "Done" : "Miss")</span></td>
                                    <td style="color:@(e.WaterLiters >= 2 ? "var(--green)" : "var(--text-secondary)")">@e.WaterLiters L</td>
                                    <td style="color:@(e.SleepHours >= 7 ? "var(--green)" : e.SleepHours >= 6 ? "var(--amber)" : "var(--rose)")">@e.SleepHours h</td>
                                    <td>
                                        <span style="font-weight:600; color:@(e.EnergyLevel >= 7 ? "var(--green)" : e.EnergyLevel >= 4 ? "var(--amber)" : "var(--rose)")">@e.EnergyLevel/10</span>
                                    </td>
                                    <td><span class="badge @(e.DietClean ? "badge-green" : "badge-rose")">@(e.DietClean ? "Clean" : "Skip")</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Today's Status Cards -->
        @if (Model.WorkoutDone || Model.WaterLiters > 0 || Model.SleepHours > 0)
        {
            <div class="row g-3">
                <div class="col-6">
                    <div class="los-card los-card-sm" style="background:@(Model.WorkoutDone ? "var(--green-soft)" : "var(--surface-1)"); border-color:@(Model.WorkoutDone ? "rgba(22,163,74,0.2)" : "var(--border)")">
                        <div style="font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:@(Model.WorkoutDone ? "var(--green)" : "var(--text-tertiary)"); margin-bottom:4px;">Workout</div>
                        <div style="font-family:'Instrument Serif',serif; font-size:1.3rem; color:@(Model.WorkoutDone ? "var(--green)" : "var(--rose)")">@(Model.WorkoutDone ? "Done ✓" : "Missed")</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="los-card los-card-sm">
                        <div style="font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:var(--text-tertiary); margin-bottom:4px;">Water</div>
                        <div style="font-family:'Instrument Serif',serif; font-size:1.3rem; color:@(Model.WaterLiters >= 2 ? "var(--green)" : "var(--amber)")">@Model.WaterLiters L</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="los-card los-card-sm">
                        <div style="font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:var(--text-tertiary); margin-bottom:4px;">Sleep</div>
                        <div style="font-family:'Instrument Serif',serif; font-size:1.3rem; color:@(Model.SleepHours >= 7 ? "var(--green)" : Model.SleepHours >= 6 ? "var(--amber)" : "var(--rose)")">@Model.SleepHours hrs</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="los-card los-card-sm">
                        <div style="font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:var(--text-tertiary); margin-bottom:4px;">Energy</div>
                        <div style="font-family:'Instrument Serif',serif; font-size:1.3rem; color:@(Model.EnergyLevel >= 7 ? "var(--green)" : Model.EnergyLevel >= 4 ? "var(--amber)" : "var(--rose)")">@Model.EnergyLevel/10</div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>