@model LifeOS.MVC.Models.HabitEntry
@{
    ViewData["Title"] = "Mind & Habits"; var last7 = ViewBag.Last7 as List<LifeOS.MVC.Models.HabitEntry> ?? new();
}

<div class="los-page-header">
    <div>
        <div class="los-page-title">Mind & Communication</div>
        <div class="los-page-subtitle">Sharpen your mind. Build mental discipline daily.</div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="los-card">
            <div class="los-card-title-lg" style="margin-bottom:18px;">Today's Practice — @DateTime.Today.ToString("MMM d")</div>
            <form method="post" asp-action="Save" asp-controller="Mind">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <div class="row g-3">
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">Pages Read</label>
                            <input name="PagesRead" type="number" min="0" class="form-control" value="@Model.PagesRead" />
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            <label class="form-label">Reading Note</label>
                            <input name="ReadingNote" class="form-control" value="@Model.ReadingNote" placeholder="Book / article / topic" />
                        </div>
                    </div>
                    @foreach (var habit in new[] {
                        ("CommunicationPractice", "💬 Communication Practice", "Speaking, writing, or social skill"),
                        ("CreativityTask", "🎨 Creativity Task", "Anything creative or imaginative"),
                        ("LogicTask", "🧩 Logic & Problem Solving", "Chess, math, programming puzzles")
                    })
                    {
                        bool val = habit.Item1 == "CommunicationPractice" ? Model.CommunicationPractice
                                 : habit.Item1 == "CreativityTask" ? Model.CreativityTask : Model.LogicTask;
                        <div class="col-12">
                            <div style="display:flex; align-items:flex-start; justify-content:space-between; padding:10px 12px; background:var(--surface-2); border-radius:var(--radius-md); border:1px solid @(val ? "rgba(79,70,229,0.2)" : "var(--border)")">
                                <div>
                                    <div style="font-size:0.85rem; font-weight:500; color:var(--text-primary);">@habit.Item2</div>
                                    <div style="font-size:0.75rem; color:var(--text-tertiary);">@habit.Item3</div>
                                </div>
                                <label class="toggle" style="margin-top:2px;">
                                    <input name="@habit.Item1" type="checkbox" value="true" @(val ? "checked" : "") />
                                    <div class="toggle-track"></div>
                                </label>
                            </div>
                        </div>
                    }
                    <div class="col-12">
                        <div class="form-group">
                            <label class="form-label">End-of-Day Reflection</label>
                            <textarea name="ReflectionNote" class="form-control" placeholder="What did you learn today? What will you do differently?">@Model.ReflectionNote</textarea>
                        </div>
                    </div>
                    <div class="col-12" style="margin-top:4px;">
                        <button type="submit" class="btn-los btn-primary w-100">Save Today</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="los-card">
            <div class="los-card-title-lg" style="margin-bottom:14px;">7-Day Mind Tracker</div>
            @if (!last7.Any())
            {
                <div class="empty-state" style="padding:32px 0;">
                    <div class="empty-state-desc">No entries yet. Start logging your mental habits.</div>
                </div>
            }
            else
            {
                <div class="los-table-wrap">
                    <table class="los-table">
                        <thead>
                            <tr><th>Date</th><th>Pages</th><th>Comm.</th><th>Create</th><th>Logic</th><th>Score</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var e in last7.OrderByDescending(x => x.Date))
                            {
                                int dayScore = 0;
                                if (e.PagesRead > 0) dayScore++;
                                if (e.CommunicationPractice) dayScore++;
                                if (e.CreativityTask) dayScore++;
                                if (e.LogicTask) dayScore++;
                                <tr>
                                    <td style="font-weight:500;">@e.Date.ToString("MMM d")</td>
                                    <td style="color:@(e.PagesRead > 0 ? "var(--green)" : "var(--text-tertiary)")">@(e.PagesRead > 0 ? $"{e.PagesRead}p" : "—")</td>
                                    <td><span class="badge @(e.CommunicationPractice ? "badge-green" : "badge-neutral")">@(e.CommunicationPractice ? "✓" : "—")</span></td>
                                    <td><span class="badge @(e.CreativityTask ? "badge-green" : "badge-neutral")">@(e.CreativityTask ? "✓" : "—")</span></td>
                                    <td><span class="badge @(e.LogicTask ? "badge-green" : "badge-neutral")">@(e.LogicTask ? "✓" : "—")</span></td>
                                    <td>
                                        <span style="font-weight:700; color:@(dayScore >= 3 ? "var(--green)" : dayScore >= 2 ? "var(--amber)" : "var(--rose)")">@dayScore/4</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>