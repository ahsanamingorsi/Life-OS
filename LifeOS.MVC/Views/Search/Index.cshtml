@model LifeOS.Models.GlobalSearchViewModel
@{
    ViewData["Title"] = "Search";
}

<style>
    .sr-section {
        margin-bottom: 28px;
    }

    .sr-section-title {
        font-size: 0.68rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .14em;
        color: var(--text-tertiary);
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .sr-section-count {
        background: var(--surface-3);
        border-radius: 99px;
        padding: 1px 7px;
        font-size: 0.65rem;
        color: var(--text-disabled);
        font-weight: 700;
    }

    .sr-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 10px 14px;
        border-radius: var(--radius-md);
        border: 1px solid var(--border);
        background: var(--surface-1);
        transition: all .12s ease;
        margin-bottom: 6px;
        text-decoration: none;
        color: inherit;
    }

        .sr-item:hover {
            border-color: var(--accent);
            box-shadow: var(--shadow-sm);
            background: var(--accent-soft);
        }

    .sr-item-icon {
        width: 28px;
        height: 28px;
        border-radius: var(--radius-sm);
        background: var(--surface-2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        flex-shrink: 0;
    }

    .sr-item-title {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 2px;
    }

    .sr-item-sub {
        font-size: 0.75rem;
        color: var(--text-tertiary);
        line-height: 1.4;
    }

    .sr-highlight {
        background: rgba(249,115,22,0.15);
        color: var(--amber);
        border-radius: 2px;
        padding: 0 2px;
        font-weight: 700;
    }
</style>

<div class="los-page-header" style="margin-bottom:20px;">
    <div>
        <div class="los-page-title">Search</div>
        <div class="los-page-subtitle">Search across your entire Life OS</div>
    </div>
</div>

<!-- Search form -->
<form method="get" asp-action="Index" asp-controller="Search"
      style="margin-bottom:28px;">
    <div style="position:relative; max-width:600px;">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="none"
             style="position:absolute;left:14px;top:50%;transform:translateY(-50%);
            color:var(--text-tertiary);pointer-events:none;">
            <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5" />
            <path d="M11 11l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        <input name="q" value="@Model.Query" class="form-control"
               placeholder="Search everything — habits, projects, tasks, links, knowledge, vault…"
               style="padding-left:44px; height:48px; font-size:0.95rem;"
               autocomplete="off" autofocus />
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.Query))
{
    if (Model.TotalResults == 0)
    {
        <div class="los-card">
            <div class="empty-state">
                <div class="empty-state-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="1.5" />
                        <path d="M21 21l-4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                </div>
                <div class="empty-state-title">No results for "@Model.Query"</div>
                <div class="empty-state-desc">Try different keywords or add new content.</div>
            </div>
        </div>
    }
    else
    {
        <div style="font-size:0.82rem; color:var(--text-tertiary); margin-bottom:20px;">
            <strong style="color:var(--text-primary);">@Model.TotalResults</strong>
            result@(Model.TotalResults == 1 ? "" : "s") for
            "<strong style="color:var(--accent);">@Model.Query</strong>"
        </div>

        <!-- Links -->
        @if (Model.LinkResults.Any())
        {
            <div class="sr-section">
                <div class="sr-section-title">
                    🔗 Web Links
                    <span class="sr-section-count">@Model.LinkResults.Count</span>
                </div>
                @foreach (var l in Model.LinkResults)
                {
                    <a href="@l.Url" target="_blank" rel="noopener" class="sr-item">
                        <div class="sr-item-icon">
                            <img src="https://www.google.com/s2/favicons?domain=@Uri.EscapeDataString(l.Domain)&sz=28"
                                 width="18" height="18"
                                 onerror="this.style.display='none'"
                                 alt="" />
                        </div>
                        <div>
                            <div class="sr-item-title">@l.Name</div>
                            <div class="sr-item-sub">
                                @l.Domain · @l.Category
                                @if (!string.IsNullOrEmpty(l.Description))
                                {
                                    <span> · @l.Description</span>
                                }
                            </div>
                        </div>
                    </a>
                }
            </div>
        }


        <!-- Projects -->
        @if (Model.ProjectResults.Any())
        {
            <div class="sr-section">
                <div class="sr-section-title">
                    ◈ Projects
                    <span class="sr-section-count">@Model.ProjectResults.Count</span>
                </div>
                @foreach (var p in Model.ProjectResults)
                {
                    <a asp-action="Detail" asp-controller="Projects"
                       asp-route-id="@p.Id" class="sr-item">
                        <div class="sr-item-icon">◈</div>
                        <div>
                            <div class="sr-item-title">@p.Title</div>
                            <div class="sr-item-sub">
                                @p.Status · @p.Category · @p.ProgressPercent%
                                @if (!string.IsNullOrEmpty(p.NextTask))
                                {
                                    <div style="margin-top:2px;">→ @p.NextTask</div>
                                }
                            </div>
                        </div>
                    </a>
                }
            </div>
        }

        <!-- Tasks -->
        @if (Model.TaskResults.Any())
        {
            <div class="sr-section">
                <div class="sr-section-title">
                    ✦ Personal Tasks
                    <span class="sr-section-count">@Model.TaskResults.Count</span>
                </div>
                @foreach (var t in Model.TaskResults)
                {
                    <a asp-action="Index" asp-controller="PersonalTasks" class="sr-item">
                        <div class="sr-item-icon"
                             style="background:@(t.IsCompleted ? "var(--green-soft)" : "var(--surface-2)");
                            color:@(t.IsCompleted ? "var(--green)" : "var(--text-secondary)")">
                            @(t.IsCompleted ? "✓" : "○")
                        </div>
                        <div>
                            <div class="sr-item-title"
                                 style="@(t.IsCompleted ? "text-decoration:line-through;color:var(--text-tertiary);" : "")">
                                @t.Title
                            </div>
                            <div class="sr-item-sub">
                                Priority @t.Priority
                                @if (t.DueDate.HasValue)
                                {
                                    <span> · Due @t.DueDate.Value.ToString("MMM d")</span>
                                }
                            </div>
                        </div>
                    </a>
                }
            </div>
        }

        

        <!-- Skills -->
        @if (Model.SkillResults.Any())
        {
            <div class="sr-section">
                <div class="sr-section-title">
                    ⚡ Tech Skills
                    <span class="sr-section-count">@Model.SkillResults.Count</span>
                </div>
                @foreach (var s in Model.SkillResults)
                {
                    <a asp-action="Index" asp-controller="TechGrowth" class="sr-item">
                        <div class="sr-item-icon" style="background:var(--teal-soft); color:var(--teal);">⚡</div>
                        <div>
                            <div class="sr-item-title">@s.Name</div>
                            <div class="sr-item-sub">
                                @s.Category · @s.Level · @s.ProgressPercent%
                                @if (s.IsCurrent)
                                {
                                    <span class="badge badge-indigo" style="margin-left:6px;">Current</span>
                                }
                            </div>
                        </div>
                    </a>
                }
            </div>
        }

        <!-- Study -->
        @if (Model.StudyResults.Any())
        {
            <div class="sr-section">
                <div class="sr-section-title">
                    📖 Study
                    <span class="sr-section-count">@Model.StudyResults.Count</span>
                </div>
                @foreach (var s in Model.StudyResults)
                {
                    <a asp-action="Subject" asp-controller="Study"
                       asp-route-id="@s.Id" class="sr-item">
                        <div class="sr-item-icon">📖</div>
                        <div>
                            <div class="sr-item-title">@s.Name</div>
                            <div class="sr-item-sub">
                                @s.Category · @s.HoursLogged.ToString("F0")h logged
                            </div>
                        </div>
                    </a>
                }
            </div>
        }

        <!-- Project tasks -->
        @if (Model.ProjectTaskResults.Any())
        {
            <div class="sr-section">
                <div class="sr-section-title">◈ Project Tasks <span class="sr-section-count">@Model.ProjectTaskResults.Count</span></div>
                @foreach (var t in Model.ProjectTaskResults)
                {
                    <a href="/Projects/Detail/@t.ProjectId" class="sr-item">
                        <div class="sr-item-icon">@(t.IsCompleted ? "✓" : "○")</div>
                        <div>
                            <div class="sr-item-title">@t.Title</div>
                            <div class="sr-item-sub">@t.Project?.Title · @t.Status</div>
                        </div>
                    </a>
                }
            </div>
        }

        <!-- Study tasks -->
        @if (Model.StudyTaskResults.Any())
        {
            <div class="sr-section">
                <div class="sr-section-title">📖 Study Tasks <span class="sr-section-count">@Model.StudyTaskResults.Count</span></div>
                @foreach (var t in Model.StudyTaskResults)
                {
                    <a href="/Study/Subject/@t.StudySubjectId" class="sr-item">
                        <div class="sr-item-icon">@(t.IsCompleted ? "✓" : "○")</div>
                        <div>
                            <div class="sr-item-title">@t.Title</div>
                            <div class="sr-item-sub">@t.StudySubject?.Name@(t.DueDate.HasValue ? " · Due " + t.DueDate.Value.ToString("MMM d") : "")</div>
                        </div>
                    </a>
                }
            </div>
        }

        <!-- Goals -->
        @if (Model.GoalResults.Any())
        {
            <div class="sr-section">
                <div class="sr-section-title">◎ Goals <span class="sr-section-count">@Model.GoalResults.Count</span></div>
                @foreach (var g in Model.GoalResults)
                {
                    <a href="/PersonalUpgrade" class="sr-item">
                        <div class="sr-item-icon">◎</div>
                        <div>
                            <div class="sr-item-title">@g.Goal</div>
                            <div class="sr-item-sub">@g.Category@(g.IsAchieved ? " · Achieved" : "")</div>
                        </div>
                    </a>
                }
            </div>
        }


        <!-- Spiritual -->
        @if (Model.SpiritualResults.Any())
        {
            <div class="sr-section">
                <div class="sr-section-title">☾ Spiritual <span class="sr-section-count">@Model.SpiritualResults.Count</span></div>
                @foreach (var s in Model.SpiritualResults)
                {
                    <a href="/Spiritual?date=@s.Date.ToString("yyyy-MM-dd")" class="sr-item">
                        <div class="sr-item-icon">☾</div>
                        <div>
                            <div class="sr-item-title">@s.Date.ToString("dddd, MMM d")</div>
                            <div class="sr-item-sub">@(s.GratitudeNote ?? s.ReflectionNote)</div>
                        </div>
                    </a>
                }
            </div>
        }
    }
}
else
{
    <!-- Empty state — show quick tips -->
    <div class="los-card" style="max-width:580px;">
        <div style="font-size:0.75rem; font-weight:700; text-transform:uppercase;
            letter-spacing:.1em; color:var(--text-tertiary); margin-bottom:14px;">
            What you can search
        </div>
        @foreach (var tip in new[]{
            ("🔗","Web Links","Bookmarks, tools, resources"),
            ("◈","Projects","Project titles and notes"),
            ("✦","Tasks","Personal task titles and descriptions"),
            ("⚡","Skills","Tech skill names and notes"),
            ("📖","Study","Subject names, descriptions and study tasks"),
            ("◈","Project tasks","Task titles, descriptions and notes"),
            ("◎","Goals","Goal names and notes"),
            ("☾","Spiritual","Gratitude and reflection notes"),
        })
        {
            <div style="display:flex; align-items:center; gap:10px; padding:8px 0;
                border-bottom:1px solid var(--border); font-size:0.845rem;">
                <span style="width:22px; text-align:center;">@tip.Item1</span>
                <strong style="color:var(--text-primary); min-width:120px;">@tip.Item2</strong>
                <span style="color:var(--text-tertiary);">@tip.Item3</span>
            </div>
        }
    </div>
}