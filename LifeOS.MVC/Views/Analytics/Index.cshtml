@{
    ViewData["Title"] = "Analytics";
    var scores = ViewBag.Scores as List<(DateTime date, double score)> ?? new();
    var completedT = (int)(ViewBag.CompletedTasks ?? 0);
    var openT = (int)(ViewBag.OpenTasks ?? 0);
    var totalT = (int)(ViewBag.TotalTasks ?? 0);
    double skillH = (double)(ViewBag.SkillHours ?? 0);
    double studyH = (double)(ViewBag.StudyHours ?? 0);
    double avgScore = (double)(ViewBag.AvgScore ?? 0);
    var bestStreaks = ViewBag.BestStreaks as dynamic ?? new List<dynamic>();
    var activity = ViewBag.Activity as List<LifeOS.MVC.Models.ActivityLog> ?? new();
    var reviews = ViewBag.Reviews as List<LifeOS.MVC.Models.ReviewEntry> ?? new();
    int taskPct = totalT > 0 ? (int)((double)completedT / totalT * 100) : 0;
}

<div class="page-header">
    <div>
        <div class="page-title">Analytics</div>
        <div class="page-sub">Your life in numbers. Track what matters.</div>
    </div>
    <div class="page-actions">
        <a href="/Review" class="btn btn-primary btn-sm">+ Weekly Review</a>
    </div>
</div>

<!-- KPI Row -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="kpi">
            <div class="kpi-icon ic-indigo">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                    <path d="M2 14L6 8l4 4 3-5 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
            <div class="kpi-value">@avgScore.ToString("F0")%</div>
            <div class="kpi-label">Avg Productivity (7d)</div>
            <div class="kpi-trend @(avgScore >= 70 ? "up" : avgScore >= 40 ? "flat" : "down")">
                @(avgScore >= 70 ? "↑ Strong" : "→ Building")
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi">
            <div class="kpi-icon ic-green">✓</div>
            <div class="kpi-value" style="color:var(--green)">@completedT</div>
            <div class="kpi-label">Tasks Completed</div>
            <div class="kpi-trend flat">@openT open remaining</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi">
            <div class="kpi-icon ic-teal">h</div>
            <div class="kpi-value" style="color:var(--teal)">@skillH.ToString("F1")</div>
            <div class="kpi-label">Skill Hours (7d)</div>
            <div class="kpi-trend up">↑ Learning</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi">
            <div class="kpi-icon ic-violet">📖</div>
            <div class="kpi-value" style="color:var(--violet)">@studyH.ToString("F1")</div>
            <div class="kpi-label">Study Hours (7d)</div>
            <div class="kpi-trend flat">This week</div>
        </div>
    </div>
</div>

<!-- 7-Day Score Chart -->
<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="analytics-card">
            <div class="card-header" style="margin-bottom:16px;">
                <div class="card-title-lg">7-Day Productivity Score</div>
            </div>
            <div style="display:flex; align-items:flex-end; gap:8px; height:100px;">
                @foreach (var s in scores)
                {
                    int h = (int)Math.Max(8, s.score);
                    string color = s.score >= 75 ? "var(--green)"
                                 : s.score >= 45 ? "var(--indigo)"
                                 : "var(--amber)";
                    <div style="flex:1; display:flex; flex-direction:column; align-items:center; gap:4px;">
                        <div style="font-size:.6rem; font-weight:700; color:@color;">
                            @s.score.ToString("F0")%
                        </div>
                        <div style="width:100%; background:var(--bg-2); border-radius:var(--r-sm);
                            height:@h px; background:@color; border-radius:var(--r-xs) var(--r-xs) 0 0;
                            min-height:4px; transition:height .4s ease; max-height:80px;">
                        </div>
                        <div style="font-size:.6rem; color:var(--text-4);">@s.date.ToString("ddd")</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="analytics-card h-100">
            <div class="card-header" style="margin-bottom:16px;">
                <div class="card-title-lg">Task Completion</div>
            </div>
            <div style="display:flex; align-items:center; gap:20px; margin-bottom:14px;">
                <div>
                    <div class="analytics-num" style="color:var(--green);">@taskPct%</div>
                    <div style="font-size:.75rem; color:var(--text-3); margin-top:4px;">overall rate</div>
                </div>
                <div style="flex:1;">
                    <div class="progress progress-lg" style="margin-bottom:8px;">
                        <div class="progress-bar green" data-width="@taskPct"></div>
                    </div>
                    <div style="display:flex; justify-content:space-between; font-size:.72rem; color:var(--text-3);">
                        <span>@completedT done</span>
                        <span>@openT open</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Streaks + Reviews -->
<div class="row g-3 mb-4">
    <!-- Habit Streaks -->
    <div class="col-lg-6">
        <div class="analytics-card">
            @if (bestStreaks != null)
            {
                <div class="table-wrap" style="border:none;">
                    <table class="table">
                        <thead>
                            <tr><th>Habit</th><th>Current</th><th>Best</th><th>Total</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var s in bestStreaks)
                            {
                                <tr>
                                    <td style="font-weight:500;">@s.Name</td>
                                                     <!--  <td>
                                        <span style="font-weight:700; color:var(--amber);">
                                            🔥 s.Streak.CurrentStreak
                                        </span>
                                    </td>
                                    <td style="color:var(--violet); font-weight:600;">s.Streak.BestStreak</td>
                                    <td style="color:var(--text-3);">s.TotalCount</td>-->
                                    
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Recent Reviews -->
    <div class="col-lg-6">
        <div class="analytics-card">
            <div class="card-header" style="margin-bottom:14px;">
                <div class="card-title-lg">Weekly Reviews</div>
                <a href="/Review" class="btn btn-ghost btn-xs" style="color:var(--indigo);">All →</a>
            </div>
            @if (!reviews.Any())
            {
                <div style="text-align:center; padding:24px 0; color:var(--text-3); font-size:.845rem;">
                    No reviews yet. <a href="/Review" style="color:var(--indigo);">Write your first →</a>
                </div>
            }
            @foreach (var r in reviews)
            {
                string sc = r.OverallScore >= 8 ? "var(--green)" : r.OverallScore >= 5 ? "var(--amber)" : "var(--rose)";
                <div style="display:flex; align-items:center; gap:12px; padding:10px 0;
                    border-bottom:1px solid var(--border);">
                    <div style="font-family:monospace; font-size:1.4rem; font-weight:800;
                        color:@sc; min-width:36px;">
                        @r.OverallScore
                    </div>
                    <div style="flex:1;">
                        <div style="font-size:.845rem; font-weight:600; color:var(--text-1);">
                            @r.Period: @r.StartDate.ToString("MMM d")–@r.EndDate.ToString("MMM d")
                        </div>
                        @if (!string.IsNullOrEmpty(r.Wins))
                        {
                            <div style="font-size:.75rem; color:var(--text-3); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                🏆 @r.Wins
                            </div>
                        }
                    </div>
                    <span class="badge badge-@(r.Period == "Weekly" ? "indigo" : "teal")">@r.Period</span>
                </div>
            }
        </div>
    </div>
</div>

<!-- Activity Timeline -->
@if (activity.Any())
{
    <div class="analytics-card">
        <div class="card-header" style="margin-bottom:14px;">
            <div class="card-title-lg">Activity Timeline</div>
        </div>
        <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:6px;">
            @foreach (var a in activity)
            {
                string dotColor = a.Action == "Completed" ? "var(--green)"
                                : a.Type == "Habit" ? "var(--indigo)"
                                : a.Type == "Project" ? "var(--violet)"
                                : "var(--sky)";
                <div class="activity-item" style="border-bottom:none; padding:6px 10px;
                    border:1px solid var(--border); border-radius:var(--r-sm);
                    background:var(--card);">
                    <div class="activity-dot" style="background:@dotColor;"></div>
                    <div class="activity-text">@a.Detail</div>
                    <div class="activity-time">@a.DateTime.ToString("MMM d h:mm tt")</div>
                </div>
            }
        </div>
    </div>
}