@page "/projects"
@inherits OwningComponentBase
@using LifeOS.MVC.Data
@using LifeOS.MVC.Models
@using LifeOS.MVC.Services
@using Microsoft.EntityFrameworkCore
@inject LifeOS.App.Services.AppUi Ui

@if (projects == null)
{
    <p class="db-empty">Loading…</p>
}
else
{
    <div class="db">
        <div class="db-head">
            <div>
                <div class="db-date">Projects</div>
                <h1 class="db-title">Give every idea a clear next step.</h1>
            </div>
            <div class="db-actions">
                <button type="button" class="lo-btn lo-btn-primary" @onclick='() => Ui.Open("project")'><Icon Name="plus" /> New project</button>
            </div>
        </div>

        <div class="db-grid-levels">
            <div class="db-level"><span class="db-muted db-tiny">Active</span><span class="db-level-pct lo-num">@projects.Count(p => p.Status == "Active")</span><span class="db-muted db-tiny">in progress</span></div>
            <div class="db-level"><span class="db-muted db-tiny">Paused</span><span class="db-level-pct lo-num">@projects.Count(p => p.Status == "Paused")</span><span class="db-muted db-tiny">waiting</span></div>
            <div class="db-level"><span class="db-muted db-tiny">Completed</span><span class="db-level-pct lo-num">@projects.Count(p => p.Status == "Done")</span><span class="db-muted db-tiny">finished</span></div>
        </div>

        @if (!projects.Any())
        {
            <section class="db-card">
                <div class="empty-state">
                    <span class="empty-ico"><Icon Name="projects" /></span>
                    <strong>No projects yet</strong>
                    <span class="db-muted db-small">Create a project and break it into tasks. Its progress fills in as you finish them.</span>
                    <button type="button" class="lo-btn lo-btn-primary" @onclick='() => Ui.Open("project")'><Icon Name="plus" /> Create your first project</button>
                </div>
            </section>
        }

        @foreach (var status in new[] { "Active", "Paused", "Done" })
        {
            var group = projects.Where(p => p.Status == status)
                .OrderBy(p => p.Priority).ThenBy(p => p.Deadline ?? DateTime.MaxValue).ThenBy(p => p.Title).ToList();
            if (group.Any())
            {
                <section class="db-section">
                    <div class="db-section-head"><h2 class="db-h2-lg">@(status == "Done" ? "Completed" : status)</h2><span class="db-muted db-small lo-num">@group.Count</span></div>
                    <div class="db-grid-2">
                        @foreach (var p in group)
                        {
                            taskCounts.TryGetValue(p.Id, out var tc);
                            int pct = Math.Clamp(p.ProgressPercent, 0, 100);
                            bool overdue = p.Deadline.HasValue && p.Deadline.Value.Date < DateTime.Today && p.Status != "Done";
                            <article class="db-card" @key="p.Id">
                                <div class="db-card-head">
                                    <div style="min-width:0;">
                                        <div class="db-muted db-tiny">@(string.IsNullOrEmpty(p.Category) ? "No category" : p.Category)</div>
                                        <h3 class="db-h2"><a class="lo-plain-link" href="projects/@p.Id">@p.Title</a></h3>
                                    </div>
                                    <span class="db-pri @p.Priority.ToLowerInvariant()">@p.Priority</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(p.Notes)) { <p class="db-muted db-small lo-clamp-2" style="margin:0;">@p.Notes</p> }
                                <div class="db-muted db-tiny">Next: @(p.NextTask ?? "choose your next step")</div>
                                <div class="db-bar" role="progressbar" aria-label="Progress of @p.Title" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@pct"><span style="width:@pct%"></span></div>
                                <div class="lo-card-foot">
                                    <span class="db-muted db-tiny lo-num">@(tc == null || tc.Total == 0 ? "No tasks yet" : $"{tc.Done} of {tc.Total} tasks") · @pct%</span>
                                    <span class="db-tiny @(overdue ? "db-neg" : "db-muted")">@(p.Deadline.HasValue ? (overdue ? "Overdue · " : "Due ") + p.Deadline.Value.ToString("d MMM yyyy") : "No deadline")</span>
                                </div>
                                <div class="lo-form-actions">
                                    <button type="button" class="lo-btn lo-btn-sm lo-btn-danger" @onclick="() => pendingDelete = p">Delete</button>
                                    <button type="button" class="lo-btn lo-btn-sm" @onclick='() => Ui.Open("project", p.Id)'>Edit</button>
                                    <a class="lo-btn lo-btn-sm lo-btn-primary" href="projects/@p.Id">Open project</a>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        }
    </div>
}

<ConfirmModal Open="@(pendingDelete != null)" Title="Delete this project?" Message="@($"'{pendingDelete?.Title}' and all its tasks will be deleted.")"
              Detail="This cannot be undone." OnConfirm="ConfirmDelete" OnCancel="CancelDelete" />

@code {
    private List<Project>? projects;
    private Dictionary<int, ProjectTaskCount> taskCounts = new();
    private bool busy;
    private Project? pendingDelete;

    protected override async Task OnInitializedAsync()
    {
        Ui.DataChanged += OnDataChanged;
        await LoadAsync();
    }

    private void OnDataChanged() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    protected override void Dispose(bool disposing)
    {
        if (disposing) Ui.DataChanged -= OnDataChanged;
        base.Dispose(disposing);
    }

    private async Task LoadAsync()
    {
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        projects = await db.Projects.AsNoTracking().OrderBy(p => p.Priority).ThenBy(p => p.Deadline).ToListAsync();

        var ids = projects.Select(p => p.Id).ToList();
        taskCounts = (await db.ProjectTasks.AsNoTracking().Where(t => ids.Contains(t.ProjectId))
            .GroupBy(t => t.ProjectId)
            .Select(g => new { ProjectId = g.Key, Total = g.Count(), Done = g.Count(t => t.IsCompleted) })
            .ToListAsync())
            .ToDictionary(x => x.ProjectId, x => new ProjectTaskCount(x.Total, x.Done));
    }

    private void CancelDelete() => pendingDelete = null;

    private async Task ConfirmDelete()
    {
        var p = pendingDelete;
        pendingDelete = null;
        if (p == null) return;
        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            var proj = await db.Projects.FindAsync(p.Id);
            if (proj == null) return;
            db.Projects.Remove(proj);
            await db.SaveChangesAsync();
            await scope.ServiceProvider.GetRequiredService<ProductivityService>()
                .LogActivityAsync("Project", p.Id, "Deleted", $"Project '{p.Title}' deleted");
            Ui.Toast($"'{p.Title}' deleted");
            Ui.NotifyDataChanged();
        }
        finally { busy = false; }
    }
}
