@page "/spiritual"
@inherits OwningComponentBase
@using LifeOS.MVC.Data
@using LifeOS.MVC.Models
@using Microsoft.EntityFrameworkCore
@inject LifeOS.App.Services.AppUi Ui

@if (entry == null)
{
    <p class="db-empty">Loading…</p>
}
else
{
    <div class="db">
        <div class="db-head">
            <div>
                <div class="db-date">Spiritual@(day == DateTime.Today ? " · today" : "")</div>
                <h1 class="db-title">@day.ToString("dddd, d MMMM")</h1>
            </div>
            <div class="db-actions">
                <button type="button" class="lo-btn" aria-label="Previous day" @onclick="() => GoTo(day.AddDays(-1))">← Previous</button>
                <button type="button" class="lo-btn" @onclick="() => GoTo(DateTime.Today)" disabled="@(day == DateTime.Today)">Today</button>
                <button type="button" class="lo-btn" aria-label="Next day" @onclick="() => GoTo(day.AddDays(1))" disabled="@(day >= DateTime.Today)">Next →</button>
                <button type="button" class="lo-btn lo-btn-primary" @onclick='() => Ui.Open("spiritual-note", DayKey)'><Icon Name="note" /> Gratitude &amp; reflection</button>
            </div>
        </div>

        <div class="db-grid-levels">
            <div class="db-level"><span class="db-muted db-tiny">Streak</span><span class="db-level-pct lo-num"><Icon Name="flame" /> @streak</span><span class="db-muted db-tiny">days, all prayers</span></div>
            <div class="db-level"><span class="db-muted db-tiny">This day</span><span class="db-level-pct lo-num">@PrayerValues.Count(x => x)/5</span><span class="db-muted db-tiny">prayers done</span></div>
            <div class="db-level"><span class="db-muted db-tiny">Perfect days</span><span class="db-level-pct lo-num">@perfectDays</span><span class="db-muted db-tiny">all-time</span></div>
        </div>

        <section class="db-card">
            <h2 class="db-h2">Prayers</h2>
            <div class="db-prayers">
                @for (int i = 0; i < 5; i++)
                {
                    int idx = i;
                    bool done = PrayerValues[idx];
                    <button type="button" class="db-prayer @(done ? "done" : "")" style="cursor:pointer;width:100%;" aria-pressed="@(done ? "true" : "false")" disabled="@busy" @onclick="() => TogglePrayer(idx)">
                        <span>@SpiritualEntry.PrayerNames[idx]</span><span>@(done ? "Done" : "Tap to mark")</span>
                    </button>
                }
            </div>
            <div class="db-muted db-small lo-num">Each tap is saved straight away.</div>
        </section>

        @if (!string.IsNullOrWhiteSpace(entry.GratitudeNote) || !string.IsNullOrWhiteSpace(entry.ReflectionNote))
        {
            <section class="db-card">
                <div class="db-card-head"><h2 class="db-h2">Your notes for this day</h2><button type="button" class="lo-btn lo-btn-sm" @onclick='() => Ui.Open("spiritual-note", DayKey)'>Edit</button></div>
                @if (!string.IsNullOrWhiteSpace(entry.GratitudeNote)) { <p class="db-small" style="margin:0;"><strong>Grateful for:</strong> @entry.GratitudeNote</p> }
                @if (!string.IsNullOrWhiteSpace(entry.ReflectionNote)) { <p class="db-small" style="margin:0;"><strong>Reflection:</strong> @entry.ReflectionNote</p> }
            </section>
        }

        <section class="db-card">
            <h2 class="db-h2">Last 30 days</h2>
            <div class="db-task-list">
                @if (!history!.Any()) { <p class="db-empty">Your prayer history will appear here.</p> }
                @foreach (var h in history)
                {
                    <div class="db-task" @key="h.Id">
                        <div class="db-task-body">
                            <div class="db-task-title">@h.Date.ToString("dddd, d MMM")</div>
                            <div class="db-task-meta">@h.PrayersDone / @h.PrayersTotal prayers</div>
                        </div>
                        @if (h.PrayersTotal > 0 && h.PrayersDone >= h.PrayersTotal) { <span class="db-badge repeat-daily">All done</span> }
                        <button type="button" class="lo-btn lo-btn-sm" @onclick="() => GoTo(h.Date)">Open</button>
                    </div>
                }
            </div>
        </section>
    </div>
}

@code {
    private DateTime day = DateTime.Today;
    private SpiritualEntry? entry;
    private List<SpiritualEntry>? history;
    private int streak;
    private int perfectDays;
    private bool busy;

    private bool[] PrayerValues = new bool[5];
    private int DayKey => int.Parse(day.ToString("yyyyMMdd"));

    protected override async Task OnInitializedAsync()
    {
        Ui.DataChanged += OnDataChanged;
        await LoadAsync();
    }

    private void OnDataChanged() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    protected override void Dispose(bool disposing)
    {
        if (disposing) Ui.DataChanged -= OnDataChanged;
        base.Dispose(disposing);
    }

    private async Task LoadAsync()
    {
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var today = DateTime.Today;

        entry = await db.SpiritualEntries.AsNoTracking().FirstOrDefaultAsync(s => s.Date == day) ?? new SpiritualEntry { Date = day };
        PrayerValues = new[] { entry.Fajr, entry.Dhuhr, entry.Asr, entry.Maghrib, entry.Isha };

        history = await db.SpiritualEntries.AsNoTracking()
            .Where(s => s.Date >= today.AddDays(-29) && s.Date <= today)
            .OrderByDescending(s => s.Date).ToListAsync();

        var fullDays = (await db.SpiritualEntries.AsNoTracking()
            .Where(s => s.Date >= today.AddDays(-800) && s.PrayersTotal > 0 && s.PrayersDone >= s.PrayersTotal)
            .Select(s => s.Date).ToListAsync()).Select(d => d.Date).ToHashSet();
        int s2 = 0;
        var cursor = fullDays.Contains(today) ? today : today.AddDays(-1);
        while (fullDays.Contains(cursor)) { s2++; cursor = cursor.AddDays(-1); }
        streak = s2;

        perfectDays = await db.SpiritualEntries.CountAsync(x => x.PrayersTotal > 0 && x.PrayersDone >= x.PrayersTotal);
    }

    private async Task GoTo(DateTime newDay)
    {
        if (newDay.Date > DateTime.Today) return;
        day = newDay.Date;
        await LoadAsync();
    }

    private async Task TogglePrayer(int idx)
    {
        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            var existing = await db.SpiritualEntries.FirstOrDefaultAsync(x => x.Date == day);
            var target = existing ?? new SpiritualEntry { Date = day };
            bool[] flags = { target.Fajr, target.Dhuhr, target.Asr, target.Maghrib, target.Isha };
            flags[idx] = !flags[idx];
            target.Fajr = flags[0]; target.Dhuhr = flags[1]; target.Asr = flags[2]; target.Maghrib = flags[3]; target.Isha = flags[4];
            target.PrayersTotal = 5;
            target.PrayersDone = flags.Count(x => x);
            if (existing == null) db.SpiritualEntries.Add(target);
            await db.SaveChangesAsync();
            await LoadAsync();
        }
        finally { busy = false; }
    }
}
