@page "/skills"
@inherits OwningComponentBase
@using LifeOS.MVC.Data
@using LifeOS.MVC.Models
@using LifeOS.MVC.Services
@using Microsoft.EntityFrameworkCore
@inject LifeOS.App.Services.AppUi Ui

@if (skills == null)
{
    <p class="db-empty">Loading…</p>
}
else
{
    <div class="db">
        <div class="db-head">
            <div>
                <div class="db-date">Skills</div>
                <h1 class="db-title">Grow your technical edge.</h1>
            </div>
            <div class="db-actions">
                <button type="button" class="lo-btn" @onclick='() => Ui.Open("skill-log")'><Icon Name="clock" /> Log practice</button>
                <button type="button" class="lo-btn lo-btn-primary" @onclick='() => Ui.Open("skill")'><Icon Name="plus" /> New skill</button>
            </div>
        </div>

        <div class="db-grid-levels">
            <div class="db-level"><span class="db-muted db-tiny">Skills</span><span class="db-level-pct lo-num">@skills.Count</span><span class="db-muted db-tiny">tracked</span></div>
            <div class="db-level"><span class="db-muted db-tiny">This week</span><span class="db-level-pct lo-num">@sessionsThisWeek</span><span class="db-muted db-tiny">sessions logged</span></div>
            <div class="db-level"><span class="db-muted db-tiny">Hours this week</span><span class="db-level-pct lo-num">@weeklyHours.Values.Sum().ToString("0.#")h</span><span class="db-muted db-tiny">across all skills</span></div>
        </div>

        @if (!skills.Any())
        {
            <section class="db-card">
                <div class="empty-state">
                    <span class="empty-ico"><Icon Name="skills" /></span>
                    <strong>No skills yet</strong>
                    <span class="db-muted db-small">Add a skill you want to grow, then log your practice hours.</span>
                    <button type="button" class="lo-btn lo-btn-primary" @onclick='() => Ui.Open("skill")'><Icon Name="plus" /> Add your first skill</button>
                </div>
            </section>
        }
        <div class="db-grid-2">
            @foreach (var s in skills)
            {
                <section class="db-card" @key="s.Id">
                    <div class="db-card-head">
                        <div style="min-width:0;">
                            <div class="db-muted db-tiny">@s.Category · @s.Level@(s.IsNext ? " · Learn next" : "")</div>
                            <h3 class="db-h2">@s.Name @(s.IsCurrent ? "⭐" : "")</h3>
                        </div>
                        <span class="lo-num" style="font-weight:800;font-size:1.25rem;">@s.ProgressPercent%</span>
                    </div>
                    <div class="db-bar" role="progressbar" aria-label="Progress of @s.Name" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@s.ProgressPercent"><span style="width:@Math.Clamp(s.ProgressPercent, 0, 100)%"></span></div>
                    <div class="db-muted db-tiny lo-num">@s.HoursLogged.ToString("0.#")h total · @weeklyHours.GetValueOrDefault(s.Id, 0).ToString("0.#")h this week of @s.WeeklyTargetHours target</div>
                    @if (!string.IsNullOrWhiteSpace(s.CurrentTopic)) { <div class="db-muted db-small">Currently: @s.CurrentTopic</div> }
                    <div class="lo-row-actions" style="flex-wrap:wrap;">
                        <button type="button" class="lo-btn lo-btn-sm lo-btn-primary" @onclick='() => Ui.Open("skill-log", s.Id)'><Icon Name="plus" /> Log</button>
                        <button type="button" class="lo-btn lo-btn-sm" @onclick="() => SetCurrent(s.Id)" disabled="@(busy || s.IsCurrent)">Set as current</button>
                        <button type="button" class="lo-btn lo-btn-sm" @onclick="() => ToggleNext(s.Id)" disabled="@busy">@(s.IsNext ? "Unmark next" : "Mark next")</button>
                        <button type="button" class="lo-btn lo-btn-sm" @onclick='() => Ui.Open("skill", s.Id)'>Edit</button>
                        <button type="button" class="lo-btn lo-btn-sm lo-btn-danger" @onclick="() => pendingDelete = s">Delete</button>
                    </div>
                </section>
            }
        </div>
    </div>
}

<ConfirmModal Open="@(pendingDelete != null)" Title="Delete this skill?" Message="@($"'{pendingDelete?.Name}' and its practice log will be deleted.")" Detail="This cannot be undone." OnConfirm="ConfirmDelete" OnCancel="CancelDelete" />

@code {
    private List<TechSkill>? skills;
    private Dictionary<int, double> weeklyHours = new();
    private int sessionsThisWeek;
    private bool busy;
    private TechSkill? pendingDelete;

    protected override async Task OnInitializedAsync()
    {
        Ui.DataChanged += OnDataChanged;
        await LoadAsync();
    }

    private void OnDataChanged() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    protected override void Dispose(bool disposing)
    {
        if (disposing) Ui.DataChanged -= OnDataChanged;
        base.Dispose(disposing);
    }

    private async Task LoadAsync()
    {
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var weekStart = ProductivityService.WeekStart(DateTime.Today);

        skills = await db.TechSkills.AsNoTracking().Include(s => s.SkillLogs)
            .OrderByDescending(s => s.IsCurrent).ThenByDescending(s => s.IsNext).ThenBy(s => s.Category).ThenByDescending(s => s.ProgressPercent)
            .ToListAsync();
        weeklyHours = skills.ToDictionary(s => s.Id, s => s.SkillLogs.Where(l => l.LogDate >= weekStart).Sum(l => l.Hours));
        sessionsThisWeek = skills.Sum(s => s.SkillLogs.Count(l => l.LogDate >= weekStart));
    }

    private async Task SetCurrent(int id)
    {
        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            foreach (var cur in await db.TechSkills.Where(s => s.IsCurrent).ToListAsync()) cur.IsCurrent = false;
            var skill = await db.TechSkills.FindAsync(id);
            if (skill == null) return;
            skill.IsCurrent = true;
            skill.UpdatedAt = DateTime.Now;
            await db.SaveChangesAsync();
            Ui.Toast($"'{skill.Name}' is now your current skill");
            await LoadAsync();
        }
        finally { busy = false; }
    }

    private async Task ToggleNext(int id)
    {
        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            var skill = await db.TechSkills.FindAsync(id);
            if (skill == null) return;
            skill.IsNext = !skill.IsNext;
            skill.UpdatedAt = DateTime.Now;
            await db.SaveChangesAsync();
            await LoadAsync();
        }
        finally { busy = false; }
    }

    private void CancelDelete() => pendingDelete = null;

    private async Task ConfirmDelete()
    {
        var s = pendingDelete;
        pendingDelete = null;
        if (s == null) return;
        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            var skill = await db.TechSkills.FindAsync(s.Id);
            if (skill == null) return;
            db.TechSkills.Remove(skill);
            await db.SaveChangesAsync();
            await scope.ServiceProvider.GetRequiredService<ProductivityService>()
                .LogActivityAsync("TechSkill", s.Id, "Deleted", $"Skill '{s.Name}' removed");
            Ui.Toast($"'{s.Name}' removed");
            await LoadAsync();
        }
        finally { busy = false; }
    }
}
