@page "/tasks"
@inherits OwningComponentBase
@using LifeOS.MVC.Data
@using LifeOS.MVC.Models
@using LifeOS.MVC.Services
@using Microsoft.EntityFrameworkCore
@inject LifeOS.App.Services.AppUi Ui

@if (rows == null)
{
    <p class="db-empty">Loading…</p>
}
else
{
    <div class="db">
        <div class="db-head">
            <div>
                <div class="db-date">Tasks</div>
                <h1 class="db-title">Every next step, in one place.</h1>
            </div>
            <div class="db-actions">
                <a class="lo-btn" href="planner">My day</a>
                <button type="button" class="lo-btn lo-btn-primary" @onclick='() => Ui.Open("task")'><Icon Name="plus" /> New task</button>
            </div>
        </div>

        <div class="db-grid-levels">
            <div class="db-level"><span class="db-muted db-tiny">Today</span><span class="db-level-pct lo-num">@rows.Count(r => r.OccursToday && (r.Task.IsRepeated ? r.DoneToday : r.Task.IsCompleted)) / @rows.Count(r => r.OccursToday)</span><span class="db-muted db-tiny">done today</span></div>
            <div class="db-level"><span class="db-muted db-tiny">Open</span><span class="db-level-pct lo-num">@rows.Count(r => !IsFinished(r))</span><span class="db-muted db-tiny">waiting on you</span></div>
            <div class="db-level"><span class="db-muted db-tiny">Repeated</span><span class="db-level-pct lo-num">@rows.Count(r => r.Task.IsRepeated && !IsFinished(r))</span><span class="db-muted db-tiny">daily, weekly, monthly</span></div>
            <div class="db-level"><span class="db-muted db-tiny">Overdue</span><span class="db-level-pct lo-num @(rows.Count(r => r.IsOverdue) > 0 ? "db-neg" : "")">@rows.Count(r => r.IsOverdue)</span><span class="db-muted db-tiny">one-time tasks</span></div>
        </div>

        <section class="db-card" aria-labelledby="listTitle">
            <div class="db-card-head" style="flex-wrap:wrap;">
                <h2 id="listTitle" class="db-h2">Your tasks</h2>
                <select class="lo-select lo-select-sm" aria-label="Filter by goal" value="@(goalFilter?.ToString() ?? "")" @onchange="SetGoalFilter">
                    <option value="">All goals</option>
                    @foreach (var g in goals!)
                    {
                        <option value="@g.Id">@g.Goal</option>
                    }
                </select>
            </div>

            <nav class="db-filters" aria-label="Filter tasks">
                @foreach (var f in filterDefs)
                {
                    <button type="button" class="db-chip" aria-pressed="@(filter == f.Key ? "true" : "false")" @onclick="() => filter = f.Key">@f.Label@(f.Count(this) >= 0 ? $" · {f.Count(this)}" : "")</button>
                }
            </nav>

            <div class="db-task-list">
                @if (!ShownRows.Any())
                {
                    <div class="empty-state">
                        <span class="empty-ico"><Icon Name="tasks" /></span>
                        <strong>@(rows.Count == 0 ? "No tasks yet" : "Nothing in this view")</strong>
                        <span class="db-muted db-small">@(rows.Count == 0 ? "Add your first task and start with one clear step." : "Try another filter, or add a new task.")</span>
                        <button type="button" class="lo-btn lo-btn-primary" @onclick='() => Ui.Open("task")'><Icon Name="plus" /> Add a task</button>
                    </div>
                }
                @foreach (var row in ShownRows)
                {
                    var t = row.Task;
                    bool done = t.IsRepeated ? row.DoneToday : t.IsCompleted;
                    bool canToggle = !t.IsRepeated || row.OccursToday;
                    <div class="db-task @(done ? "is-done" : "") @(row.IsOverdue ? "is-overdue" : "")" @key="t.Id">
                        @if (canToggle)
                        {
                            <button type="button" class="db-check @(done ? "done" : "")" disabled="@busy"
                                    aria-label="@(done ? "Mark as not done" : "Mark as done"): @t.Title" @onclick="() => ToggleTask(t.Id)">
                                @if (done) { <Icon Name="tick" /> }
                            </button>
                        }
                        else
                        {
                            <span class="db-check lo-check-off" title="Not scheduled today" aria-hidden="true"></span>
                        }
                        <div class="db-task-body">
                            <div class="db-task-title">@t.Title</div>
                            <div class="db-task-meta">@string.Join(" · ", RowMeta(row))</div>
                            @if (!string.IsNullOrWhiteSpace(t.Description)) { <div class="db-task-meta lo-task-note">@t.Description</div> }
                        </div>
                        @if (t.IsRepeated) { <span class="db-badge repeat-@t.Repeat.ToLowerInvariant()">@t.Repeat</span> }
                        else if (t.Priority == "A") { <span class="db-badge high">High</span> }
                        else if (t.Priority == "C") { <span class="db-badge">Low</span> }
                        <div class="lo-row-actions">
                            <button type="button" class="lo-btn lo-btn-sm" aria-label="Edit @t.Title" @onclick='() => Ui.Open("task", t.Id)'>Edit</button>
                            <button type="button" class="lo-btn lo-btn-sm lo-btn-danger" aria-label="Delete @t.Title" @onclick="() => AskDelete(t)">Delete</button>
                        </div>
                    </div>
                }
            </div>
        </section>
    </div>
}

<ConfirmModal Open="@(pendingDelete != null)" Title="Delete this task?" Message="@($"'{pendingDelete?.Title}' will be removed.")"
              Detail="@(pendingDelete?.IsRepeated == true ? "Its completion history will be deleted too." : null)"
              OnConfirm="ConfirmDelete" OnCancel="CancelDelete" />

@code {
    private class TaskRow
    {
        public PersonalTask Task { get; set; } = null!;
        public string RepeatText { get; set; } = "";
        public bool OccursToday { get; set; }
        public bool DoneToday { get; set; }
        public bool IsOverdue { get; set; }
        public int Streak { get; set; }
        public DateTime? NextDate { get; set; }
    }

    private record FilterDef(string Key, string Label, Func<Tasks, int> Count);

    private readonly FilterDef[] filterDefs =
    {
        new("open", "Open", c => c.rows!.Count(r => !c.IsFinished(r))),
        new("today", "Today", c => c.rows!.Count(r => r.OccursToday)),
        new("repeated", "Repeated", c => c.rows!.Count(r => r.Task.IsRepeated)),
        new("overdue", "Overdue", c => c.rows!.Count(r => r.IsOverdue)),
        new("done", "Done", c => c.rows!.Count(r => !r.Task.IsRepeated && r.Task.IsCompleted)),
        new("all", "All", c => -1),
    };

    private List<TaskRow>? rows;
    private List<PersonalGoal>? goals;
    private string filter = "open";
    private int? goalFilter;
    private bool busy;
    private PersonalTask? pendingDelete;

    private bool IsFinished(TaskRow r) => r.Task.IsRepeated ? r.NextDate == null : r.Task.IsCompleted;

    private IEnumerable<TaskRow> ShownRows
    {
        get
        {
            IEnumerable<TaskRow> shown = filter switch
            {
                "today" => rows!.Where(r => r.OccursToday || r.IsOverdue),
                "repeated" => rows!.Where(r => r.Task.IsRepeated),
                "overdue" => rows!.Where(r => r.IsOverdue),
                "done" => rows!.Where(r => !r.Task.IsRepeated && r.Task.IsCompleted),
                "all" => rows!,
                _ => rows!.Where(r => !IsFinished(r)),
            };
            if (goalFilter.HasValue) shown = shown.Where(r => r.Task.GoalId == goalFilter);
            return shown
                .OrderBy(r => IsFinished(r))
                .ThenByDescending(r => r.IsOverdue)
                .ThenByDescending(r => r.OccursToday && !r.DoneToday && !r.Task.IsCompleted)
                .ThenBy(r => r.Task.Priority)
                .ThenBy(r => r.Task.IsRepeated ? r.NextDate : r.Task.DueDate ?? DateTime.MaxValue)
                .ThenByDescending(r => r.Task.CompletedAt);
        }
    }

    private List<string> RowMeta(TaskRow row)
    {
        var t = row.Task;
        var today = DateTime.Today;
        var meta = new List<string>();
        if (t.IsRepeated)
        {
            meta.Add(row.RepeatText);
            if (row.Streak > 0) meta.Add($"{row.Streak} streak");
            meta.Add(row.NextDate == null ? "Ended" : row.OccursToday && !row.DoneToday ? "Due today" : $"Next: {row.NextDate:ddd dd MMM}");
        }
        else if (t.IsCompleted) { meta.Add("Completed " + t.CompletedAt?.ToString("dd MMM")); }
        else if (t.DueDate == null) { meta.Add("No due date"); }
        else { meta.Add((row.IsOverdue ? "Overdue · " : t.DueDate.Value.Date == today ? "Due today · " : "Due ") + t.DueDate.Value.ToString("dd MMM")); }
        if (t.Goal != null) { meta.Add("Goal: " + t.Goal.Goal); }
        return meta;
    }

    private void SetGoalFilter(ChangeEventArgs e) => goalFilter = int.TryParse(e.Value as string, out var id) ? id : null;

    protected override async Task OnInitializedAsync()
    {
        Ui.DataChanged += OnDataChanged;
        await LoadAsync();
    }

    private void OnDataChanged() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    protected override void Dispose(bool disposing)
    {
        if (disposing) Ui.DataChanged -= OnDataChanged;
        base.Dispose(disposing);
    }

    private async Task LoadAsync()
    {
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var today = DateTime.Today;

        var all = await db.PersonalTasks.AsNoTracking().Include(t => t.Goal).Include(t => t.Completions).ToListAsync();
        goals = await db.PersonalGoals.AsNoTracking().OrderBy(g => g.Goal).ToListAsync();

        rows = all.Select(t =>
        {
            var done = t.Completions.Select(c => c.Date.Date).ToHashSet();
            var row = new TaskRow
            {
                Task = t,
                RepeatText = TaskService.RepeatText(t),
                OccursToday = TaskService.OccursOn(t, today),
                DoneToday = t.IsRepeated && done.Contains(today),
                IsOverdue = !t.IsRepeated && !t.IsCompleted && t.DueDate < today,
                Streak = TaskService.Streak(t, done, today),
            };
            if (t.IsRepeated)
            {
                for (var d = today; d <= today.AddDays(400); d = d.AddDays(1))
                    if (TaskService.OccursOn(t, d) && !(d == today && row.DoneToday)) { row.NextDate = d; break; }
            }
            return row;
        }).ToList();
    }

    private async Task ToggleTask(int id)
    {
        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var tasks = scope.ServiceProvider.GetRequiredService<TaskService>();
            var title = rows!.First(r => r.Task.Id == id).Task.Title;
            var state = await tasks.ToggleAsync(id, DateTime.Today);
            if (state != null)
            {
                string action = state.Value ? "Completed" : "Reopened";
                await scope.ServiceProvider.GetRequiredService<ProductivityService>()
                    .LogActivityAsync("PersonalTask", id, action, $"Task '{title}' {action.ToLower()}");
                Ui.Toast(state.Value ? $"Done: {title}" : $"Reopened: {title}");
            }
            await LoadAsync();
        }
        finally { busy = false; }
    }

    private void AskDelete(PersonalTask t) => pendingDelete = t;
    private void CancelDelete() => pendingDelete = null;

    private async Task ConfirmDelete()
    {
        var t = pendingDelete;
        pendingDelete = null;
        if (t == null) return;
        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            var task = await db.PersonalTasks.FindAsync(t.Id);
            if (task == null) return;
            db.PersonalTasks.Remove(task);
            await db.SaveChangesAsync();
            await scope.ServiceProvider.GetRequiredService<ProductivityService>()
                .LogActivityAsync("PersonalTask", t.Id, "Deleted", $"Task '{t.Title}' deleted");
            Ui.Toast($"Task '{t.Title}' removed");
            Ui.NotifyDataChanged();
        }
        finally { busy = false; }
    }
}
