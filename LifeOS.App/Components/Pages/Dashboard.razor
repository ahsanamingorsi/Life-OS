@page "/"
@inherits OwningComponentBase
@using LifeOS.MVC.Data
@using LifeOS.MVC.Models
@using LifeOS.MVC.Services
@using Microsoft.EntityFrameworkCore
@inject LifeOS.App.Services.FocusTimer Timer
@inject LifeOS.App.Services.AppUi Ui
@inject IJSRuntime JS

@if (vm == null)
{
    <p class="db-empty">Loading…</p>
}
else
{
    var focus = ComputeFocus();
    <div class="db">
        <div class="db-head">
            <div>
                <div class="db-date">@vm.Today.ToString("dddd, d MMMM")@if (points != null) { <a class="db-pill" href="insights" style="margin-left:8px;" title="Points and levels">Level @points.Level · @points.Points pts</a> }</div>
                <h1 class="db-title">@vm.Greeting. Here is your day.</h1>
            </div>
            <div class="db-actions">
                <button type="button" class="lo-btn" @onclick='() => Ui.Open("study-session")'><Icon Name="studies" /> Log study</button>
                <button type="button" class="lo-btn" @onclick='() => Ui.Open("skill-log")'><Icon Name="skills" /> Log skill</button>
                <button type="button" class="lo-btn lo-btn-primary" @onclick='() => Ui.Open("task")'><Icon Name="plus" /> New task</button>
            </div>
        </div>

        <div class="dx-hero">
            <section class="dx-focus" aria-labelledby="focusTitle">
                <div>
                    <span class="dx-eyebrow"><Icon Name="sparkle" /> @focus.Eyebrow</span>
                    <h2 id="focusTitle">@focus.Title</h2>
                    <p>@focus.Sub</p>
                    @if (focus.Kind == "task")
                    {
                        var upNext = vm.Tasks.Where(t => !t.IsCompleted && t.Id != focus.TaskId)
                            .OrderBy(t => t.IsOverdue ? 0 : 1).ThenBy(t => t.Priority).Take(3).ToList();
                        if (upNext.Any())
                        {
                            <div class="dx-next" aria-label="Up next">
                                <span class="dx-next-label">Then</span>
                                @foreach (var n in upNext) { <span class="dx-chip" title="@n.Title">@n.Title</span> }
                            </div>
                        }
                    }
                </div>
                <div class="dx-focus-actions">
                    @switch (focus.Kind)
                    {
                        case "task":
                            <button type="button" class="lo-btn lo-btn-primary" disabled="@busy" @onclick="() => ToggleTask(focus.TaskId, focus.Title)"><Icon Name="tick" /> Mark done</button>
                            <button type="button" class="lo-btn" @onclick="() => StartFocus(focus.Title)"><Icon Name="clock" /> Focus 25 min</button>
                            <a class="lo-btn" href="tasks">All tasks</a>
                            break;
                        case "prayer":
                            <button type="button" class="lo-btn lo-btn-primary" disabled="@busy" @onclick="() => MarkPrayer(focus.PrayerIndex)"><Icon Name="tick" /> Mark @SpiritualEntry.PrayerNames[focus.PrayerIndex] done</button>
                            <a class="lo-btn" href="spiritual">Open Spiritual</a>
                            break;
                        case "done":
                            <button type="button" class="lo-btn lo-btn-primary" @onclick='() => StartFocus("Deep work")'><Icon Name="clock" /> Start a focus session</button>
                            <button type="button" class="lo-btn" @onclick='() => Ui.Open("study-session")'>Log study</button>
                            <button type="button" class="lo-btn" @onclick='() => Ui.Open("task")'>Add another task</button>
                            break;
                        default:
                            <button type="button" class="lo-btn lo-btn-primary" @onclick='() => Ui.Open("task")'><Icon Name="plus" /> Add a task</button>
                            <button type="button" class="lo-btn" @onclick='() => Ui.Open("study-session")'>Log study</button>
                            <button type="button" class="lo-btn" @onclick='() => Ui.Open("goal")'>Set a goal</button>
                            break;
                    }
                </div>
            </section>

            <section class="db-card dx-side" aria-labelledby="scoreTitle">
                <div class="db-card-head">
                    <h2 id="scoreTitle" class="db-h2">Today's productivity</h2>
                    @if (vm.ScoreChange is int change) { <span class="db-pill @(change < 0 ? "down" : "")">@(change >= 0 ? "+" : "")@change% vs yesterday</span> }
                </div>
                <div class="db-score">
                    <svg class="db-ring" role="img" aria-label="@(vm.HasScore ? $"Productivity score {vm.Score} percent" : "No productivity data yet today")" width="128" height="128" viewBox="0 0 128 128">
                        <defs>
                            <linearGradient id="ringGrad" x1="0" y1="0" x2="1" y2="1">
                                <stop offset="0%" style="stop-color:var(--lo-accent)"></stop>
                                <stop offset="100%" style="stop-color:var(--lo-primary)"></stop>
                            </linearGradient>
                        </defs>
                        <circle class="db-ring-track" cx="64" cy="64" r="54" fill="none" stroke-width="12"></circle>
                        @if (vm.HasScore && vm.Score > 0)
                        {
                            <circle class="db-ring-value" cx="64" cy="64" r="54" fill="none" stroke-width="12" stroke-linecap="round"
                                    stroke-dasharray="@RingDash" transform="rotate(-90 64 64)"></circle>
                        }
                        <text class="db-ring-text lo-num" x="64" y="64" text-anchor="middle" font-size="28" font-weight="800">@(vm.HasScore ? vm.Score + "%" : "–")</text>
                        <text class="db-ring-sub" x="64" y="85" text-anchor="middle" font-size="12">@vm.ScoreLabel</text>
                    </svg>
                    <div class="db-parts">
                        @foreach (var part in vm.ScoreParts)
                        {
                            <div class="db-part"><span class="db-muted">@part.Name</span><strong class="lo-num">@part.Value</strong></div>
                        }
                        @if (!vm.ScoreParts.Any()) { <span class="db-muted db-small">Complete something today and your score appears here.</span> }
                    </div>
                </div>
                <div class="dx-streaks">
                    <div class="dx-stat"><strong class="lo-num">@vm.TasksDoneToday/@vm.TasksDueToday</strong><span>Tasks today</span></div>
                    <div class="dx-stat"><strong class="lo-num">@vm.PrayersDone/@vm.PrayersTotal</strong><span>Prayers</span></div>
                    <div class="dx-stat"><strong class="lo-num"><Icon Name="flame" /> @vm.PrayerStreak</strong><span>Day streak</span></div>
                </div>
                <p class="dx-quote">@Motivation</p>
            </section>
        </div>

        @if (showShutdownPrompt || showWeeklyPrompt)
        {
            <section class="db-card pl-prompt-card" aria-label="Reflection prompts">
                @if (showShutdownPrompt)
                {
                    <div class="pl-prompt">
                        <div><strong>Time to close your day.</strong><div class="db-muted db-small">Review, move what is left, and set tomorrow's top 3. Takes 2 minutes.</div></div>
                        <button type="button" class="lo-btn lo-btn-primary" @onclick='() => Ui.Open("shutdown")'><Icon Name="moon" /> Evening shutdown</button>
                    </div>
                }
                @if (showWeeklyPrompt)
                {
                    <div class="pl-prompt">
                        <div><strong>Weekly review is due.</strong><div class="db-muted db-small">Look back at the week and choose next week's focus.</div></div>
                        <button type="button" class="lo-btn lo-btn-primary" @onclick='() => Ui.Open("weekly-review")'><Icon Name="sparkle" /> Start review</button>
                    </div>
                }
            </section>
        }

        <section class="db-card" aria-labelledby="planCardTitle">
            <div class="db-card-head">
                <h2 id="planCardTitle" class="db-h2">Today's plan</h2>
                <span class="db-muted db-small">@focusToday min focused</span>
                <a class="db-link" href="plan">Open daily plan</a>
            </div>
            @if (!todayPlan.Any())
            {
                <div class="pl-prompt">
                    <div>
                        <strong>You have not planned today yet.</strong>
                        <div class="db-muted db-small">Pick your 3 most important things. It takes one minute.</div>
                    </div>
                    <button type="button" class="lo-btn lo-btn-primary" @onclick='() => Ui.Open("plan-mit", 0, TodayKey)'><Icon Name="plus" /> Plan my day</button>
                </div>
            }
            else
            {
                int nowMin = LifeOS.App.Services.PlanService.NowMinutes();
                var nowItem = todayPlan.FirstOrDefault(p => !p.IsDone && p.StartMinutes != null && p.StartMinutes <= nowMin && (p.EndMinutes ?? p.StartMinutes + 30) > nowMin);
                var nextItem = todayPlan.Where(p => !p.IsDone && p.StartMinutes != null && p.StartMinutes > nowMin).OrderBy(p => p.StartMinutes).FirstOrDefault();
                if (nowItem != null || nextItem != null)
                {
                    <div class="pl-nownext">
                        @if (nowItem != null) { <span class="db-badge high">Now</span> <strong>@nowItem.Title</strong> <span class="db-muted db-small">@LifeOS.App.Services.PlanService.RangeText(nowItem)</span> }
                        @if (nextItem != null) { <span class="db-badge">Next</span> <span>@nextItem.Title</span> <span class="db-muted db-small">@LifeOS.App.Services.PlanService.TimeText(nextItem.StartMinutes!.Value)</span> }
                    </div>
                }
                <div class="db-task-list">
                    @foreach (var p in todayPlan.OrderByDescending(p => p.IsMit).ThenBy(p => p.IsDone).ThenBy(p => p.StartMinutes ?? 9999).Take(5))
                    {
                        <div class="db-task @(p.IsDone ? "is-done" : "")" @key="p.Id">
                            <button type="button" class="db-check @(p.IsDone ? "done" : "")" disabled="@busy"
                                    aria-label="@(p.IsDone ? "Mark as not done" : "Mark as done"): @p.Title" @onclick="() => TogglePlan(p.Id)">
                                @if (p.IsDone) { <Icon Name="tick" /> }
                            </button>
                            <div class="db-task-body">
                                <div class="db-task-title">@p.Title@(p.IsMit ? " ★" : "")</div>
                                <div class="db-task-meta">@LifeOS.App.Services.PlanService.RangeText(p)</div>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        @if (ShowChecklist)
        {
            <section class="db-card cl-card" aria-labelledby="clTitle">
                <div class="cl-head">
                    <div>
                        <h2 id="clTitle" class="db-h2">Get started with Life OS</h2>
                        <div class="db-muted db-small">@checklistDone of @checklist.Length done — each step takes under a minute.</div>
                    </div>
                    <button type="button" class="lo-btn lo-btn-sm" @onclick="HideChecklist">Hide</button>
                </div>
                <div class="db-bar" role="progressbar" aria-valuemin="0" aria-valuemax="@checklist.Length" aria-valuenow="@checklistDone"><span style="width:@(checklistDone * 100 / checklist.Length)%"></span></div>
                <div class="cl-list">
                    @foreach (var step in checklist)
                    {
                        <div class="cl-item @(step.Done ? "is-done" : "")">
                            <span class="cl-dot">@if (step.Done) { <Icon Name="tick" /> }</span>
                            <div><strong>@step.Title</strong><small>@step.Hint</small></div>
                            @if (!step.Done)
                            {
                                if (step.Href != null) { <a class="lo-btn lo-btn-sm" href="@step.Href">Open</a> }
                                else { <button type="button" class="lo-btn lo-btn-sm" @onclick="() => Ui.Open(step.Kind!)">Start</button> }
                            }
                        </div>
                    }
                </div>
            </section>
        }

        <div class="db-grid-2">
            <section class="db-card" aria-labelledby="tasksTitle">
                <div class="db-card-head">
                    <h2 id="tasksTitle" class="db-h2">Today's tasks <span class="db-muted lo-num">@vm.TasksDoneToday / @vm.TasksDueToday</span></h2>
                    <a class="db-link" href="tasks">All tasks</a>
                </div>
                <div class="db-filters" role="group" aria-label="Filter tasks">
                    @foreach (var f in new[] { ("all", "All"), ("today", "Today"), ("repeated", "Repeated"), ("overdue", "Overdue"), ("done", "Done") })
                    {
                        <button type="button" class="db-chip" aria-pressed="@(filter == f.Item1 ? "true" : "false")" @onclick="() => filter = f.Item1">@f.Item2</button>
                    }
                </div>
                <div class="db-task-list">
                    @if (!vm.Tasks.Any()) { <p class="db-empty">Nothing due today. Add one meaningful task below.</p> }
                    else if (!ShownTasks.Any()) { <p class="db-empty">No tasks in this view.</p> }
                    @foreach (var task in ShownTasks)
                    {
                        <div class="db-task @(task.IsCompleted ? "is-done" : "") @(task.IsOverdue ? "is-overdue" : "")">
                            <button type="button" class="db-check @(task.IsCompleted ? "done" : "")" disabled="@busy"
                                    aria-label="@(task.IsCompleted ? "Mark as not done" : "Mark as done"): @task.Title" @onclick="() => ToggleTask(task.Id, task.Title)">
                                @if (task.IsCompleted) { <Icon Name="tick" /> }
                            </button>
                            <div class="db-task-body">
                                <div class="db-task-title">@task.Title</div>
                                <div class="db-task-meta">@task.Meta</div>
                            </div>
                            @if (task.IsRepeated) { <span class="db-badge repeat-@task.Repeat.ToLowerInvariant()">@task.Repeat</span> }
                            else if (task.Priority == "A") { <span class="db-badge high">High</span> }
                            else if (task.Priority == "C") { <span class="db-badge">Low</span> }
                        </div>
                    }
                </div>
                <form class="db-task-add" @onsubmit="AddTask" @onsubmit:preventDefault>
                    <label for="quickTask" class="lo-visually-hidden">New task for today</label>
                    <input id="quickTask" maxlength="200" placeholder="Add a task for today" @bind="newTask" />
                    <button type="submit" class="lo-btn lo-btn-primary" disabled="@busy">Add</button>
                </form>
            </section>

            <section class="db-card" aria-labelledby="prayTitle">
                <div class="db-card-head">
                    <h2 id="prayTitle" class="db-h2">Spiritual today</h2>
                    <a class="db-link" href="spiritual">Open</a>
                </div>
                <div class="db-prayers">
                    @for (int i = 0; i < 5; i++)
                    {
                        int idx = i;
                        var done = vm.PrayerFlags[i];
                        <div class="db-prayer @(done ? "done" : "")"><span>@SpiritualEntry.PrayerNames[idx]</span><span>@(done ? "Done" : "Pending")</span></div>
                    }
                </div>
                <div class="db-muted db-small lo-num">@vm.PrayersDone of @vm.PrayersTotal prayers · @vm.PrayerStreak-day streak</div>
                <div class="db-attention">
                    <h3 class="db-h3">Needs attention</h3>
                    @if (!vm.Alerts.Any()) { <div class="db-clear"><Icon Name="check" /> All clear</div> }
                    @foreach (var alert in vm.Alerts)
                    {
                        <a class="db-alert" href="@AppHref(alert.Url)"><Icon Name="alert" /> @alert.Text</a>
                    }
                </div>
            </section>
        </div>

        <section class="db-section" aria-labelledby="levelsTitle">
            <div class="db-section-head">
                <h2 id="levelsTitle" class="db-h2-lg">Productivity by area</h2>
                <span class="db-muted db-small">This week · since Monday</span>
            </div>
            <div class="db-grid-levels">
                @foreach (var level in vm.Levels)
                {
                    <a class="db-level" href="@AppHref(level.Url)">
                        <div class="db-level-top">
                            <span class="db-level-icon"><Icon Name="@level.Icon" /></span>
                            <span class="db-level-name">@level.Name</span>
                        </div>
                        <span class="db-level-pct lo-num">@(level.Percent.HasValue ? level.Percent + "%" : "–")</span>
                        <div class="db-bar" role="presentation"><span class="@(level.Percent < 40 ? "low" : "")" style="width:@(level.Percent ?? 0)%"></span></div>
                        <div class="db-muted db-tiny lo-num">@level.Detail</div>
                    </a>
                }
            </div>
        </section>

        <div class="db-grid-2">
            <section class="db-card" aria-labelledby="projTitle">
                <div class="db-card-head">
                    <h2 id="projTitle" class="db-h2">Projects in focus</h2>
                    <a class="db-link" href="projects">All projects</a>
                </div>
                @if (!vm.FocusProjects.Any()) { <p class="db-empty">Your active projects will appear here.</p> }
                @foreach (var project in vm.FocusProjects)
                {
                    var pct = Math.Clamp(project.ProgressPercent, 0, 100);
                    <a class="db-project" href="projects/@project.Id">
                        <div class="db-project-top">
                            <span class="db-pri @project.Priority.ToLowerInvariant()" aria-label="Priority @project.Priority">@project.Priority</span>
                            <span class="db-project-name">@project.Title</span>
                            <span class="lo-num" style="font-weight:700;">@pct%</span>
                        </div>
                        <div class="db-muted db-tiny">Next: @(project.NextTask ?? "set your next step") · @(project.Deadline.HasValue ? "due " + project.Deadline.Value.ToString("dd MMM") : "no deadline")</div>
                        <div class="db-bar thin" role="presentation"><span style="width:@pct%"></span></div>
                    </a>
                }
            </section>

            <section class="db-card" aria-labelledby="chartTitle">
                <div class="db-card-head">
                    <h2 id="chartTitle" class="db-h2">Last 7 days</h2>
                    <span class="db-muted db-small lo-num">@(Scored.Any() ? $"Average {Math.Round(Scored.Average(d => d.Score!.Value))}%" : "No data yet")</span>
                </div>
                <div class="db-chart" role="img" aria-label="Daily productivity, last 7 days: @string.Join(", ", vm.Week.Select(d => $"{d.Date:ddd} {(d.Score.HasValue ? d.Score + " percent" : "no data")}"))">
                    @foreach (var d in vm.Week)
                    {
                        bool isToday = d.Date == vm.Today;
                        <div class="db-chart-col">
                            <span class="db-chart-val lo-num">@(d.Score.HasValue ? d.Score.ToString() : "–")</span>
                            <div class="db-chart-bar @(isToday ? "today" : "") @(d.Score.HasValue ? "" : "empty")" style="height:@((d.Score ?? 0) * 1.4 + 4)px"></div>
                            <span class="db-chart-day">@(isToday ? "Today" : d.Date.ToString("ddd"))</span>
                        </div>
                    }
                </div>
            </section>
        </div>

        <div class="db-grid-2">
            <section class="db-card" aria-labelledby="libTitle">
                <h2 id="libTitle" class="db-h2">Library</h2>
                <div class="db-tiles db-tiles-1">
                    <a class="db-tile" href="links"><span class="db-muted db-tiny">Links</span><strong class="lo-num">@vm.LinkCount</strong><span class="db-muted db-tiny">@vm.LinksPinned pinned</span></a>
                </div>
            </section>
            <section class="db-card" aria-labelledby="actTitle">
                <div class="db-card-head">
                    <h2 id="actTitle" class="db-h2">Recent activity</h2>
                    <a class="db-link" href="analytics">Analytics</a>
                </div>
                @if (!vm.RecentActivity.Any()) { <p class="db-empty">Your activity will appear here as you complete tasks and log time.</p> }
                @foreach (var log in vm.RecentActivity)
                {
                    <div class="db-activity">
                        <span>@log.Detail</span>
                        <span class="db-muted lo-num">@(log.DateTime.Date == vm.Today ? log.DateTime.ToString("HH:mm") : log.DateTime.Date == vm.Today.AddDays(-1) ? "Yesterday" : log.DateTime.ToString("dd MMM"))</span>
                    </div>
                }
            </section>
        </div>
    </div>
}

@code {
    private record Focus(string Kind, string Eyebrow, string Title, string Sub, int TaskId = 0, int PrayerIndex = -1);
    private record Step(string Title, string Hint, bool Done, string? Kind, string? Href);

    private DashboardViewModel? vm;
    private List<PlanItem> todayPlan = new();
    private int focusToday;
    private LifeOS.App.Services.PointsResult? points;
    private bool showShutdownPrompt, showWeeklyPrompt;
    private static int TodayKey => DateTime.Today.Year * 10000 + DateTime.Today.Month * 100 + DateTime.Today.Day;

    private async Task TogglePlan(int id)
    {
        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            await LifeOS.App.Services.PlanService.ToggleAsync(scope.ServiceProvider, id);
            Ui.NotifyDataChanged();
        }
        finally { busy = false; }
    }
    private string filter = "all";
    private string newTask = "";
    private bool busy;
    private bool checklistHidden;
    private Step[] checklist = Array.Empty<Step>();
    private int checklistDone;

    // Rough prayer times (hour of day) used only to decide when to nudge you.
    private static readonly double[] PrayerHours = { 5, 12.5, 15.5, 18, 20 };

    private const double RingCirc = 2 * Math.PI * 54;
    private string RingDash => $"{((vm!.HasScore ? vm.Score : 0) / 100.0 * RingCirc).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)} {RingCirc.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}";
    private List<DayScore> Scored => vm!.Week.Where(d => d.Score.HasValue).ToList();
    private bool ShowChecklist => !checklistHidden && checklist.Length > 0 && checklistDone < checklist.Length;

    private IEnumerable<DashboardTask> ShownTasks => filter switch
    {
        "today" => vm!.Tasks.Where(t => !t.IsOverdue),
        "repeated" => vm!.Tasks.Where(t => t.IsRepeated),
        "overdue" => vm!.Tasks.Where(t => t.IsOverdue && !t.IsCompleted),
        "done" => vm!.Tasks.Where(t => t.IsCompleted),
        _ => vm!.Tasks,
    };

    private string Motivation
    {
        get
        {
            if (vm!.TasksDueToday == 0 && !vm.HasScore) return "A clear day. Add one meaningful task and begin.";
            if (vm.HasScore && vm.Score >= 80) return "You are on fire. Keep the momentum going.";
            if (vm.HasScore && vm.Score >= 40) return "Good progress. One more win lifts your score.";
            if (vm.TasksDoneToday > 0) return "You have started. Small steps compound.";
            return "Start with the smallest next step. The rest follows.";
        }
    }

    private Focus ComputeFocus()
    {
        var open = vm!.Tasks.Where(t => !t.IsCompleted).OrderBy(t => t.Priority).ToList();
        var overdue = open.FirstOrDefault(t => t.IsOverdue);
        if (overdue != null) return new("task", "Overdue — do this first", overdue.Title, overdue.Meta, overdue.Id);

        var top = open.FirstOrDefault();
        if (top != null && top.Priority == "A") return new("task", "Top priority today", top.Title, top.Meta, top.Id);

        double hour = DateTime.Now.TimeOfDay.TotalHours;
        for (int i = 0; i < 5; i++)
            if (!vm.PrayerFlags[i] && hour >= PrayerHours[i])
                return new("prayer", "Prayer reminder", $"Log your {SpiritualEntry.PrayerNames[i]} prayer", "A quick tick keeps your streak alive.", 0, i);

        if (top != null) return new("task", "Next up", top.Title, top.Meta, top.Id);
        if (vm.Tasks.Count == 0) return new("add", "Plan your day", "Nothing is scheduled yet", "Add one meaningful task, then start with it. You can also log study or set a goal.");
        return new("done", "All done", "Everything for today is finished", "Great work. Use the time for a focus session, a study log or tomorrow's plan.");
    }

    protected override async Task OnInitializedAsync()
    {
        Ui.DataChanged += OnDataChanged;
        try { checklistHidden = await JS.InvokeAsync<string?>("lifeosUi.getFlag", "checklist") == "hidden"; }
        catch (JSException) { }
        await LoadAsync();
    }

    private void OnDataChanged() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    protected override void Dispose(bool disposing)
    {
        if (disposing) Ui.DataChanged -= OnDataChanged;
        base.Dispose(disposing);
    }

    // Dashboard links were written for the website ("/PersonalTasks", "/Study" …); map them to app pages.
    private static string AppHref(string url) => url switch
    {
        "/PersonalTasks" => "tasks",
        "/Projects" => "projects",
        "/Study" => "studies",
        "/TechGrowth" => "skills",
        "/Spiritual" => "spiritual",
        "/PersonalUpgrade" => "goals",
        "/Review" => "review",
        _ => url.TrimStart('/').ToLowerInvariant(),
    };

    private async Task LoadAsync()
    {
        // A fresh scope (and DbContext) for every load, so the numbers are never stale.
        using var scope = ScopedServices.CreateScope();
        vm = await scope.ServiceProvider.GetRequiredService<DashboardService>().BuildAsync(DateTime.Now);

        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var planDay = DateTime.Today;
        todayPlan = await db.PlanItems.AsNoTracking().Where(p => p.Date == planDay).ToListAsync();
        var planNext = planDay.AddDays(1);
        points = await LifeOS.App.Services.Points.ComputeAsync(db);
        showShutdownPrompt = DateTime.Now.Hour >= 18 && !await db.DayReflections.AnyAsync(r => r.Date == planDay);
        showWeeklyPrompt = DateTime.Today.DayOfWeek == DayOfWeek.Sunday
            && !await db.ReviewEntries.AnyAsync(r => r.Period == "Weekly" && r.CreatedAt >= planDay.AddDays(-5));
        focusToday = await db.FocusSessions.Where(f => f.StartedAt >= planDay && f.StartedAt < planNext).SumAsync(f => (int?)f.Minutes) ?? 0;

        // Study subject tasks that are due (or overdue) join today's task list.
        var todayDate = DateTime.Today;
        foreach (var s in (await LifeOS.App.Services.StudyTaskItems.LoadAllAsync(db)).Where(s => s.DueDate.HasValue && s.DueDate.Value.Date <= todayDate && (!s.IsCompleted || s.CompletedAt?.Date == todayDate)))
        {
            bool overdue = !s.IsCompleted && s.DueDate!.Value.Date < todayDate;
            vm.Tasks.Add(new DashboardTask
            {
                Id = LifeOS.App.Services.StudyTaskItems.ToMixedId(s.Id), Title = s.Title, IsCompleted = s.IsCompleted, IsOverdue = overdue,
                Priority = "B", Repeat = "None",
                Meta = $"Study: {s.StudySubject?.Name} · " + (overdue ? "Overdue · " : "Due today · ") + s.DueDate!.Value.ToString("dd MMM"),
            });
            if (s.DueDate.Value.Date == todayDate) { vm.TasksDueToday++; if (s.IsCompleted) vm.TasksDoneToday++; }
        }

        checklist = new[]
        {
            new Step("Add your first task", "One clear next step for today.", await db.PersonalTasks.AnyAsync(), "task", null),
            new Step("Set a goal", "Something to work toward.", await db.PersonalGoals.AnyAsync(), "goal", null),
            new Step("Start a project", "Break a bigger idea into tasks.", await db.Projects.AnyAsync(), "project", null),
            new Step("Log a study session", "Needs a study subject first.", await db.StudySessions.AnyAsync(), null, "studies"),
            new Step("Track today's prayers", "Tick each prayer as you pray.", await db.SpiritualEntries.AnyAsync(), null, "spiritual"),
        };
        checklistDone = checklist.Count(s => s.Done);
    }

    private async Task HideChecklist()
    {
        checklistHidden = true;
        try { await JS.InvokeVoidAsync("lifeosUi.setFlag", "checklist", "hidden"); }
        catch (JSException) { }
    }

    private void StartFocus(string label)
    {
        if (Timer.IsRunning) { if (!Timer.IsOpen) Timer.Toggle(); return; }
        Timer.SetTarget("Free", null, label);
        Timer.SetMinutes(25);
        Timer.Start();
        if (!Timer.IsOpen) Timer.Toggle();
    }

    private async Task ToggleTask(int id, string title)
    {
        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            if (id < 0)
            {
                var result = await LifeOS.App.Services.StudyTaskItems.ToggleAsync(scope.ServiceProvider.GetRequiredService<AppDbContext>(), -id);
                if (result != null) Ui.Toast(result.Value.Done ? $"Done: {title}" : $"Reopened: {title}");
                await LoadAsync();
                return;
            }
            var tasks = scope.ServiceProvider.GetRequiredService<TaskService>();
            var state = await tasks.ToggleAsync(id, DateTime.Today);
            if (state != null)
            {
                string action = state.Value ? "Completed" : "Reopened";
                await scope.ServiceProvider.GetRequiredService<ProductivityService>()
                    .LogActivityAsync("PersonalTask", id, action, $"Task '{title}' {action.ToLower()}");
                Ui.Toast(state.Value ? $"Done: {title}" : $"Reopened: {title}");
            }
            await LoadAsync();
        }
        finally { busy = false; }
    }

    private async Task MarkPrayer(int index)
    {
        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            var today = DateTime.Today;
            var entry = await db.SpiritualEntries.FirstOrDefaultAsync(s => s.Date == today);
            bool created = entry == null;
            entry ??= new SpiritualEntry { Date = today };
            switch (index)
            {
                case 0: entry.Fajr = true; break;
                case 1: entry.Dhuhr = true; break;
                case 2: entry.Asr = true; break;
                case 3: entry.Maghrib = true; break;
                case 4: entry.Isha = true; break;
            }
            entry.PrayersTotal = 5;
            entry.PrayersDone = entry.Prayers.Count(p => p);
            if (created) db.SpiritualEntries.Add(entry);
            await db.SaveChangesAsync();
            Ui.Toast($"{SpiritualEntry.PrayerNames[index]} marked done");
            await LoadAsync();
        }
        finally { busy = false; }
    }

    private async Task AddTask()
    {
        var title = newTask.Trim();
        if (title.Length == 0) return;
        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            var task = new PersonalTask { Title = title.Length > 200 ? title[..200] : title, DueDate = DateTime.Today, Priority = "B", Repeat = "None", CreatedAt = DateTime.Now };
            db.PersonalTasks.Add(task);
            await db.SaveChangesAsync();
            await scope.ServiceProvider.GetRequiredService<ProductivityService>()
                .LogActivityAsync("PersonalTask", task.Id, "Created", $"Task '{task.Title}' created");
            Ui.Toast($"Task '{task.Title}' added");
            newTask = "";
            await LoadAsync();
        }
        finally { busy = false; }
    }
}
