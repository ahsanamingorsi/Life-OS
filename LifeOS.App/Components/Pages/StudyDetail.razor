@page "/studies/{Id:int}"
@inherits OwningComponentBase
@using LifeOS.MVC.Data
@using LifeOS.MVC.Models
@using LifeOS.MVC.Services
@using LifeOS.App.Services
@using Microsoft.EntityFrameworkCore
@inject LifeOS.App.Services.AppUi Ui
@inject NavigationManager Nav

@if (notFound)
{
    <div class="db"><section class="db-card"><div class="empty-state"><strong>This subject no longer exists</strong><a class="lo-btn lo-btn-primary" href="studies">Back to studies</a></div></section></div>
}
else if (subject == null)
{
    <p class="db-empty">Loading…</p>
}
else
{
    var s = subject;
    <div class="db">
        <div class="db-head">
            <div style="min-width:0;">
                <a class="db-link" href="studies">← Studies</a>
                <h1 class="db-title">@s.Name</h1>
                <div class="lo-chips">
                    <span class="db-badge">@s.Category</span>
                    <span class="db-badge">@s.Status</span>
                    @if (!string.IsNullOrWhiteSpace(s.CurrentTopic)) { <span class="db-badge">Now: @s.CurrentTopic</span> }
                </div>
            </div>
            <div class="db-actions">
                <button type="button" class="lo-btn" @onclick='() => Ui.Open("study-subject", Id)'>Edit subject</button>
                <button type="button" class="lo-btn lo-btn-danger" @onclick="() => confirmSubject = true">Delete</button>
                <button type="button" class="lo-btn lo-btn-primary" @onclick='() => Ui.Open("study-session", Id)'><Icon Name="clock" /> Log session</button>
            </div>
        </div>

        <div class="db-grid-levels">
            <div class="db-level"><span class="db-muted db-tiny">Progress</span><span class="db-level-pct lo-num">@s.ProgressPercent%</span><div class="db-bar" role="presentation"><span style="width:@Math.Clamp(s.ProgressPercent, 0, 100)%"></span></div></div>
            <div class="db-level"><span class="db-muted db-tiny">Hours</span><span class="db-level-pct lo-num">@s.HoursLogged.ToString("0.#")h</span><span class="db-muted db-tiny">@(s.TargetHours > 0 ? $"of {s.TargetHours}h target" : "no target")</span></div>
            <div class="db-level"><span class="db-muted db-tiny">Tasks done</span><span class="db-level-pct lo-num">@tasks!.Count(t => t.IsCompleted) / @tasks.Count</span><span class="db-muted db-tiny">subject tasks</span></div>
            <div class="db-level"><span class="db-muted db-tiny">Last 7 days</span><span class="db-level-pct lo-num">@Last7.Sum().ToString("0.#")h</span>
                <div class="mini-bars" role="img" aria-label="Hours per day, last 7 days">@foreach (var h in Last7) { <span style="height:@(Math.Clamp(h / MaxLast7 * 100, h > 0 ? 12 : 4, 100))%" class="@(h > 0 ? "on" : "")"></span> }</div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(s.Description)) { <section class="db-card"><p class="db-small" style="margin:0;">@s.Description</p></section> }

        <div class="db-grid-2">
            <section class="db-card">
                <div class="db-card-head">
                    <h2 class="db-h2">Sessions</h2>
                    <button type="button" class="lo-btn lo-btn-sm" @onclick='() => Ui.Open("study-session", Id)'><Icon Name="plus" /> Log</button>
                </div>
                <div class="db-task-list">
                    @if (!sessions!.Any()) { <p class="db-empty">No sessions yet. Log your first one.</p> }
                    @foreach (var sess in sessions.Take(8))
                    {
                        <div class="db-task" @key="sess.Id">
                            <div class="db-task-body">
                                <div class="db-task-title">@sess.DurationHours.ToString("0.#")h @(string.IsNullOrEmpty(sess.TopicCovered) ? "" : "— " + sess.TopicCovered)</div>
                                <div class="db-task-meta">@sess.SessionDate.ToString("dd MMM yyyy")</div>
                            </div>
                            <button type="button" class="lo-btn lo-btn-sm lo-btn-danger" aria-label="Delete session" @onclick="() => pendingSession = sess">Delete</button>
                        </div>
                    }
                </div>
            </section>

            <section class="db-card">
                <div class="db-card-head">
                    <h2 class="db-h2">Tasks</h2>
                    <button type="button" class="lo-btn lo-btn-sm" @onclick='() => Ui.Open("study-task", Id)'><Icon Name="plus" /> Add</button>
                </div>
                <div class="db-task-list">
                    @if (!tasks.Any()) { <p class="db-empty">No tasks yet. Break the subject into small tasks.</p> }
                    @foreach (var t in tasks)
                    {
                        <div class="db-task @(t.IsCompleted ? "is-done" : "")" @key="t.Id">
                            <button type="button" class="db-check @(t.IsCompleted ? "done" : "")" aria-label="@(t.IsCompleted ? "Mark as not done" : "Mark as done"): @t.Title" @onclick="() => ToggleTask(t.Id)">@if (t.IsCompleted) { <Icon Name="tick" /> }</button>
                            <div class="db-task-body">
                                <div class="db-task-title">@t.Title</div>
                                @if (t.DueDate.HasValue) { <div class="db-task-meta">Due @t.DueDate.Value.ToString("dd MMM")</div> }
                            </div>
                            <button type="button" class="lo-btn lo-btn-sm" @onclick='() => Ui.Open("study-task-edit", t.Id)'>Edit</button>
                            <button type="button" class="lo-btn lo-btn-sm lo-btn-danger" @onclick="() => pendingTask = t">Delete</button>
                        </div>
                    }
                </div>
            </section>
        </div>

        <section class="db-card">
            <div class="db-card-head">
                <h2 class="db-h2">Notes</h2>
                <button type="button" class="lo-btn lo-btn-sm" @onclick='() => Ui.Open("study-note", Id)'><Icon Name="plus" /> New note</button>
            </div>
            <div class="db-task-list">
                @if (!notes!.Any()) { <p class="db-empty">No notes yet. Capture an idea before you forget it.</p> }
                @foreach (var n in notes)
                {
                    <div class="db-task" @key="n.Id">
                        <div class="db-task-body">
                            <div class="db-task-title">@n.Title @(n.IsPinned ? "📌" : "")</div>
                            @if (!string.IsNullOrWhiteSpace(n.Content)) { <div class="db-task-meta lo-task-note">@n.Content</div> }
                        </div>
                        <button type="button" class="lo-btn lo-btn-sm" @onclick="() => TogglePin(n.Id)">@(n.IsPinned ? "Unpin" : "Pin")</button>
                        <button type="button" class="lo-btn lo-btn-sm lo-btn-danger" @onclick="() => pendingNote = n">Delete</button>
                    </div>
                }
            </div>
        </section>
    </div>
}

<ConfirmModal Open="@confirmSubject" Title="Delete this subject?" Message="@($"'{subject?.Name}' with all its sessions, tasks and notes will be deleted.")" Detail="This cannot be undone." OnConfirm="DeleteSubject" OnCancel="CancelSubject" />
<ConfirmModal Open="@(pendingSession != null)" Title="Delete this session?" Message="@($"{pendingSession?.DurationHours:0.##}h on {pendingSession?.SessionDate:dd MMM yyyy} will be removed.")" OnConfirm="ConfirmSession" OnCancel="CancelSession" />
<ConfirmModal Open="@(pendingTask != null)" Title="Delete this task?" Message="@($"'{pendingTask?.Title}' will be removed.")" OnConfirm="ConfirmTask" OnCancel="CancelTask" />
<ConfirmModal Open="@(pendingNote != null)" Title="Delete this note?" Message="@($"'{pendingNote?.Title}' will be removed.")" OnConfirm="ConfirmNote" OnCancel="CancelNote" />

@code {
    [Parameter] public int Id { get; set; }

    private StudySubject? subject;
    private List<StudySession>? sessions;
    private List<StudyTask>? tasks;
    private List<StudyNote>? notes;
    private bool notFound, confirmSubject;
    private StudySession? pendingSession;
    private StudyTask? pendingTask;
    private StudyNote? pendingNote;

    private double[] Last7 => Enumerable.Range(0, 7).Select(i => DateTime.Today.AddDays(i - 6))
        .Select(d => sessions!.Where(x => x.SessionDate.Date == d).Sum(x => x.DurationHours)).ToArray();
    private double MaxLast7 => Math.Max(1, Last7.Max());

    protected override async Task OnInitializedAsync()
    {
        Ui.DataChanged += OnDataChanged;
        await LoadAsync();
    }

    private void OnDataChanged() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    protected override void Dispose(bool disposing)
    {
        if (disposing) Ui.DataChanged -= OnDataChanged;
        base.Dispose(disposing);
    }

    private async Task LoadAsync()
    {
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        subject = await db.StudySubjects.AsNoTracking().Include(x => x.StudySessions).Include(x => x.StudyNotes).Include(x => x.Tasks)
            .FirstOrDefaultAsync(x => x.Id == Id);
        notFound = subject == null;
        if (subject == null) return;
        sessions = subject.StudySessions.OrderByDescending(x => x.SessionDate).ToList();
        notes = subject.StudyNotes.OrderByDescending(x => x.IsPinned).ThenByDescending(x => x.CreatedAt).ToList();
        tasks = subject.Tasks.OrderBy(x => x.IsCompleted).ThenBy(x => x.Title).ToList();
    }

    private void CancelSubject() => confirmSubject = false;
    private void CancelSession() => pendingSession = null;
    private void CancelTask() => pendingTask = null;
    private void CancelNote() => pendingNote = null;

    private async Task DeleteSubject()
    {
        confirmSubject = false;
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var subj = await db.StudySubjects.FindAsync(Id);
        if (subj == null) return;
        var name = subj.Name;
        db.StudySubjects.Remove(subj);
        await db.SaveChangesAsync();
        Ui.Toast($"'{name}' deleted");
        Nav.NavigateTo("studies");
    }

    private async Task ConfirmSession()
    {
        var sess = pendingSession; pendingSession = null;
        if (sess == null) return;
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var row = await db.StudySessions.FindAsync(sess.Id);
        if (row == null) return;
        db.StudySessions.Remove(row);
        await db.SaveChangesAsync();
        await StudyProgress.RecalculateAsync(db, Id);
        Ui.Toast("Session removed");
        await LoadAsync();
    }

    private async Task ToggleTask(int id)
    {
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var t = await db.StudyTasks.FindAsync(id);
        if (t == null) return;
        t.IsCompleted = !t.IsCompleted;
        t.CompletedAt = t.IsCompleted ? DateTime.Now : null;
        await db.SaveChangesAsync();
        await StudyProgress.RecalculateAsync(db, Id);
        await LoadAsync();
    }

    private async Task ConfirmTask()
    {
        var t = pendingTask; pendingTask = null;
        if (t == null) return;
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var row = await db.StudyTasks.FindAsync(t.Id);
        if (row == null) return;
        db.StudyTasks.Remove(row);
        await db.SaveChangesAsync();
        await StudyProgress.RecalculateAsync(db, Id);
        Ui.Toast("Task removed");
        await LoadAsync();
    }

    private async Task TogglePin(int id)
    {
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var n = await db.StudyNotes.FindAsync(id);
        if (n == null) return;
        n.IsPinned = !n.IsPinned;
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task ConfirmNote()
    {
        var n = pendingNote; pendingNote = null;
        if (n == null) return;
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var row = await db.StudyNotes.FindAsync(n.Id);
        if (row == null) return;
        db.StudyNotes.Remove(row);
        await db.SaveChangesAsync();
        Ui.Toast("Note deleted");
        await LoadAsync();
    }
}
