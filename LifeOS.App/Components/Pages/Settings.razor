@page "/settings"
@inherits OwningComponentBase
@using LifeOS.Data.Sqlite
@using LifeOS.MVC.Data
@using Microsoft.Data.Sqlite
@inject IJSRuntime JS
@inject LifeOS.App.Services.AppUi Ui

<div class="db">
    <div class="db-head">
        <div>
            <div class="db-date">Settings</div>
            <h1 class="db-title">Your data, backed up and in your control.</h1>
        </div>
    </div>

    @if (message != null) { <div class="lo-flash" role="status">@message</div> }
    @if (error != null) { <div class="lo-flash lo-flash-error" role="alert">@error</div> }

    <div class="db-grid-2">
        <section class="db-card">
            <h2 class="db-h2">Appearance</h2>
            <p class="db-muted db-small" style="margin:0;">Life OS uses frosted-glass effects. Turn them off if the app feels slow on this PC. Light and dark themes are switched from the top bar.</p>
            <div class="db-small" style="display:flex;gap:14px;flex-wrap:wrap;align-items:center;"><span><kbd class="kbd" style="margin:0;">N</kbd> new task</span><span><kbd class="kbd" style="margin:0;">/</kbd> search</span><span><kbd class="kbd" style="margin:0;">Esc</kbd> close a popup</span><span><kbd class="kbd" style="margin:0;">Enter</kbd> save</span></div>
            <div class="lo-form-actions" style="justify-content:flex-start;">
                <button type="button" class="lo-btn @(reduced ? "lo-btn-primary" : "")" aria-pressed="@(reduced ? "true" : "false")" @onclick="ToggleEffects">@(reduced ? "Glass effects: off" : "Glass effects: on")</button>
            </div>
        </section>

        <section class="db-card">
            <h2 class="db-h2">Database</h2>
            <div class="db-muted db-small">Location</div>
            <div class="lo-num db-small" style="word-break:break-all;">@dbPath</div>
            <div class="db-muted db-small">Size: @FileSizeMb</div>
            <p class="db-muted db-tiny" style="margin:0;">Everything stays on this PC only — nothing is sent anywhere. Back up regularly, especially before reinstalling Windows or moving to a new PC.</p>
        </section>
    </div>

    <SyncSettings />

    <ReminderSettings />

    <section class="db-card">
        <div class="db-card-head">
            <h2 class="db-h2">Backups</h2>
            <button type="button" class="lo-btn lo-btn-primary" @onclick="Export" disabled="@busy">Export backup now</button>
        </div>
        <p class="db-muted db-small" style="margin:0;">Backups are saved in <span class="lo-num">@BackupDir</span>. Restoring replaces all current data (a safety copy of it is saved first).</p>
        <div class="db-task-list">
            @if (!backups.Any()) { <p class="db-empty">No backups yet. Export one to see it here.</p> }
            @foreach (var b in backups)
            {
                <div class="db-task" @key="b.FullName">
                    <div class="db-task-body">
                        <div class="db-task-title">@b.Name</div>
                        <div class="db-task-meta">@b.LastWriteTime.ToString("dd MMM yyyy, HH:mm") · @($"{b.Length / 1024.0:0} KB")</div>
                    </div>
                    <button type="button" class="lo-btn lo-btn-sm lo-btn-danger" disabled="@busy" @onclick="() => pendingRestore = b.FullName">Restore</button>
                </div>
            }
        </div>
        <div class="lo-form" style="margin-top:6px;">
            <div class="lo-field">
                <label for="importPath" class="lo-label">Restore from a file somewhere else</label>
                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                    <input id="importPath" class="lo-input" style="flex:1;min-width:260px;" @bind="importPath" placeholder="Full path to a Life OS backup (.db) file" />
                    <button type="button" class="lo-btn lo-btn-danger" disabled="@(busy || string.IsNullOrWhiteSpace(importPath))" @onclick="() => pendingRestore = importPath">Restore from this file</button>
                </div>
            </div>
        </div>
    </section>

    <div class="db-grid-2">
        <section class="db-card">
            <h2 class="db-h2">About Life OS</h2>
            <div class="db-muted db-small">Life OS for Windows — version 1.0</div>
            <p class="db-small" style="margin:0;">Life OS is a personal planner that keeps your tasks, projects, studies, skills, goals and daily prayers in one place, and shows how productive your day and week have been. No account, no login, no cloud — everything stays on this PC.</p>
        </section>

        <section class="db-card">
            <h2 class="db-h2">Developer</h2>
            <div class="db-muted db-small">Ahsan Amin Gorsi</div>
            <p class="db-small" style="margin:0;">Life OS was designed and built by Ahsan Amin Gorsi as a personal productivity tool, then shared for anyone who wants a private, offline planner on their own PC.</p>
            <div class="lo-chips">
                <a class="lo-btn lo-btn-sm" href="https://ahsanamingorsi.com" target="_blank" rel="noopener">Website</a>
                <a class="lo-btn lo-btn-sm" href="https://github.com/ahsanamingorsi" target="_blank" rel="noopener">GitHub</a>
                <a class="lo-btn lo-btn-sm" href="https://linkedin.com/in/ahsanamingorsi" target="_blank" rel="noopener">LinkedIn</a>
                <a class="lo-btn lo-btn-sm" href="https://instagram.com/ahsanamingorsi" target="_blank" rel="noopener">Instagram</a>
                <a class="lo-btn lo-btn-sm" href="https://x.com/ahsanamingorsi" target="_blank" rel="noopener">Twitter / X</a>
            </div>
        </section>
    </div>
</div>

<ConfirmModal Open="@(pendingRestore != null)" Title="Restore this backup?" Message="All current data will be replaced with the data in this backup."
              Detail="A safety copy of your current data is saved first, so you can undo this." ConfirmText="Restore"
              OnConfirm="ConfirmRestore" OnCancel="CancelRestore" />

@code {
    private string dbPath = Path.Combine(LifeOS.App.Services.AppPaths.DataDirectory, SqliteDatabase.FileName);
    private static string BackupDir => LifeOS.App.Services.AppPaths.BackupDirectory;
    private string? message, error, importPath, pendingRestore;
    private bool busy, reduced;
    private List<FileInfo> backups = new();

    private string FileSizeMb => File.Exists(dbPath) ? $"{new FileInfo(dbPath).Length / 1024.0 / 1024.0:0.##} MB (plus recent changes not yet merged into the file)" : "not created yet";

    protected override void OnInitialized() => LoadBackups();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { reduced = await JS.InvokeAsync<bool>("lifeosUi.getEffects"); StateHasChanged(); }
        catch (JSException) { }
    }

    private async Task ToggleEffects()
    {
        reduced = !reduced;
        await JS.InvokeVoidAsync("lifeosUi.setEffects", reduced);
    }

    private void LoadBackups()
    {
        backups = Directory.Exists(BackupDir)
            ? new DirectoryInfo(BackupDir).GetFiles("*.db").OrderByDescending(f => f.LastWriteTime).Take(12).ToList()
            : new List<FileInfo>();
    }

    /// <summary>Copies a database with SQLite's own backup, which is safe while the app is running.</summary>
    private static void CopyDatabase(string from, string to, bool fromReadOnly)
    {
        using var src = new SqliteConnection(new SqliteConnectionStringBuilder { DataSource = from, Mode = fromReadOnly ? SqliteOpenMode.ReadOnly : SqliteOpenMode.ReadWriteCreate }.ToString());
        using var dst = new SqliteConnection(new SqliteConnectionStringBuilder { DataSource = to, Mode = SqliteOpenMode.ReadWriteCreate, Pooling = false }.ToString());
        src.Open();
        dst.Open();
        src.BackupDatabase(dst);
    }

    private async Task Export()
    {
        busy = true; message = null; error = null;
        try
        {
            Directory.CreateDirectory(BackupDir);
            var dest = Path.Combine(BackupDir, $"lifeos-backup-{DateTime.Now:yyyyMMdd-HHmmss}.db");
            await Task.Run(() => CopyDatabase(dbPath, dest, fromReadOnly: false));
            message = $"Backup saved: {Path.GetFileName(dest)}";
            Ui.Toast("Backup saved");
            LoadBackups();
        }
        catch (Exception ex) { error = $"Export failed: {ex.Message}"; }
        finally { busy = false; }
    }

    private void CancelRestore() => pendingRestore = null;

    private async Task ConfirmRestore()
    {
        var file = pendingRestore;
        pendingRestore = null;
        if (string.IsNullOrWhiteSpace(file)) return;
        busy = true; message = null; error = null;
        try
        {
            if (!File.Exists(file)) { error = "That file does not exist."; return; }

            // A valid Life OS backup is a SQLite file that contains the task table.
            bool valid;
            try
            {
                using var check = new SqliteConnection(new SqliteConnectionStringBuilder { DataSource = file, Mode = SqliteOpenMode.ReadOnly, Pooling = false }.ToString());
                check.Open();
                using var cmd = check.CreateCommand();
                cmd.CommandText = "select count(*) from sqlite_master where name = 'PersonalTasks'";
                valid = Convert.ToInt32(cmd.ExecuteScalar()) > 0;
            }
            catch { valid = false; }
            if (!valid) { error = "That file is not a valid Life OS backup."; return; }

            Directory.CreateDirectory(BackupDir);
            var safety = Path.Combine(BackupDir, $"lifeos-before-restore-{DateTime.Now:yyyyMMdd-HHmmss}.db");
            await Task.Run(() => CopyDatabase(dbPath, safety, fromReadOnly: false));
            await Task.Run(() => CopyDatabase(file, dbPath, fromReadOnly: true));

            using (var scope = ScopedServices.CreateScope())
                SqliteDatabase.Migrate(scope.ServiceProvider.GetRequiredService<AppDbContext>());

            message = "Data restored. Your previous data was saved as " + Path.GetFileName(safety) + ".";
            Ui.Toast("Backup restored");
            Ui.NotifyDataChanged();
            LoadBackups();
        }
        catch (Exception ex) { error = $"Restore failed: {ex.Message}"; }
        finally { busy = false; }
    }
}
