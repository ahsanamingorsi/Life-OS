@page "/goals"
@inherits OwningComponentBase
@using LifeOS.MVC.Data
@using LifeOS.MVC.Models
@using LifeOS.MVC.Services
@using Microsoft.EntityFrameworkCore
@inject LifeOS.App.Services.AppUi Ui

@if (cards == null)
{
    <p class="db-empty">Loading…</p>
}
else
{
    <div class="db">
        <div class="db-head">
            <div>
                <div class="db-date">Goals</div>
                <h1 class="db-title">What you're working toward.</h1>
            </div>
            <div class="db-actions">
                <button type="button" class="lo-btn lo-btn-primary" @onclick='() => Ui.Open("goal")'><Icon Name="plus" /> New goal</button>
            </div>
        </div>

        @if (!cards.Any())
        {
            <section class="db-card">
                <div class="empty-state">
                    <span class="empty-ico"><Icon Name="goals" /></span>
                    <strong>No goals yet</strong>
                    <span class="db-muted db-small">Set a goal, link tasks to it, and watch the progress fill by itself.</span>
                    <button type="button" class="lo-btn lo-btn-primary" @onclick='() => Ui.Open("goal")'><Icon Name="plus" /> Set your first goal</button>
                </div>
            </section>
        }
        <div class="db-grid-2">
            @foreach (var card in cards)
            {
                var g = card.Goal;
                <section class="db-card @(g.IsAchieved ? "is-done" : "")" @key="g.Id">
                    <div class="db-card-head">
                        <div style="min-width:0;">
                            @if (!string.IsNullOrEmpty(g.Category)) { <div class="db-muted db-tiny">@g.Category</div> }
                            <h2 class="db-h2">@g.Goal @(g.IsAchieved ? "✓" : "")</h2>
                        </div>
                        <span class="lo-num" style="font-weight:800;font-size:1.25rem;">@card.Progress%</span>
                    </div>
                    <div class="db-bar" role="progressbar" aria-label="Progress of @g.Goal" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@card.Progress"><span style="width:@card.Progress%"></span></div>
                    <div class="db-muted db-tiny lo-num">
                        @if (card.IsAuto)
                        {
                            @if (card.OneTimeTotal > 0) { @($"{card.OneTimeDone}/{card.OneTimeTotal} one-time tasks done") }
                            @if (card.RepeatedCount > 0) { @($"{(card.OneTimeTotal > 0 ? " · " : "")}{card.Completions} completions" + (g.TargetCount.HasValue ? $" / {g.TargetCount}" : "")) }
                        }
                        else
                        {
                            @("Manual progress — link a task to calculate it automatically")
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(g.Notes)) { <p class="db-muted db-small" style="margin:0;">@g.Notes</p> }

                    @if (card.Tasks.Any())
                    {
                        <div class="db-task-list">
                            @foreach (var line in card.Tasks.Take(5))
                            {
                                <div class="db-task @(line.IsDone ? "is-done" : "")">
                                    <span class="db-check @(line.IsDone ? "done" : "")" style="width:22px;height:22px;">@if (line.IsDone) { <Icon Name="tick" /> }</span>
                                    <div class="db-task-body">
                                        <div class="db-task-title">@line.Task.Title</div>
                                        <div class="db-task-meta">@line.Text</div>
                                    </div>
                                </div>
                            }
                            @if (card.Tasks.Count > 5) { <a class="db-link" href="tasks">+ @(card.Tasks.Count - 5) more in Tasks</a> }
                        </div>
                    }

                    <div class="lo-row-actions" style="flex-wrap:wrap;">
                        <button type="button" class="lo-btn lo-btn-sm" @onclick='() => Ui.Open("task", 0, g.Id)'><Icon Name="plus" /> Add task</button>
                        <button type="button" class="lo-btn lo-btn-sm" @onclick="() => ToggleAchieved(g.Id, !g.IsAchieved)" disabled="@busy">@(g.IsAchieved ? "Reopen" : "Mark achieved")</button>
                        <button type="button" class="lo-btn lo-btn-sm" @onclick='() => Ui.Open("goal", g.Id)'>Edit</button>
                        <button type="button" class="lo-btn lo-btn-sm lo-btn-danger" @onclick="() => pendingDelete = g">Delete</button>
                    </div>
                </section>
            }
        </div>
    </div>
}

<ConfirmModal Open="@(pendingDelete != null)" Title="Delete this goal?" Message="@($"'{pendingDelete?.Goal}' will be deleted.")"
              Detail="Its tasks are kept; only the link to the goal is removed." OnConfirm="ConfirmDelete" OnCancel="() => pendingDelete = null" />

@code {
    private List<GoalCard>? cards;
    private bool busy;
    private PersonalGoal? pendingDelete;

    protected override async Task OnInitializedAsync()
    {
        Ui.DataChanged += OnDataChanged;
        await LoadAsync();
    }

    private void OnDataChanged() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    protected override void Dispose(bool disposing)
    {
        if (disposing) Ui.DataChanged -= OnDataChanged;
        base.Dispose(disposing);
    }

    private async Task LoadAsync()
    {
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();

        var goals = await db.PersonalGoals.AsNoTracking()
            .Include(g => g.Tasks).ThenInclude(t => t.Completions)
            .OrderBy(g => g.IsAchieved).ThenBy(g => g.Category).ThenBy(g => g.Goal)
            .ToListAsync();

        var today = DateTime.Today;
        cards = goals.Select(g =>
        {
            var oneTime = g.Tasks.Where(t => !t.IsRepeated).ToList();
            return new GoalCard
            {
                Goal = g,
                Progress = TaskService.GoalProgress(g),
                IsAuto = g.Tasks.Any(),
                OneTimeDone = oneTime.Count(t => t.IsCompleted),
                OneTimeTotal = oneTime.Count,
                RepeatedCount = g.Tasks.Count(t => t.IsRepeated),
                Completions = TaskService.GoalCompletions(g),
                Tasks = g.Tasks
                    .OrderBy(t => t.IsRepeated ? 0 : 1).ThenBy(t => t.IsCompleted).ThenBy(t => t.Title)
                    .Select(t => new GoalTaskLine
                    {
                        Task = t,
                        Text = t.IsRepeated
                            ? $"{TaskService.RepeatText(t)} · done {t.Completions.Count}×"
                            : t.IsCompleted ? "Done" : t.DueDate.HasValue ? (t.DueDate < today ? "Overdue · " : "Due ") + t.DueDate.Value.ToString("dd MMM") : "No due date",
                        IsDone = t.IsRepeated ? t.Completions.Any(c => c.Date == today) : t.IsCompleted,
                    }).ToList(),
            };
        }).ToList();
    }

    private async Task ToggleAchieved(int id, bool achieved)
    {
        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            var goal = await db.PersonalGoals.Include(g => g.Tasks).FirstOrDefaultAsync(g => g.Id == id);
            if (goal == null) return;
            bool newlyAchieved = achieved && !goal.IsAchieved;
            goal.IsAchieved = achieved;
            await db.SaveChangesAsync();
            if (newlyAchieved)
                await scope.ServiceProvider.GetRequiredService<ProductivityService>()
                    .LogActivityAsync("Goal", goal.Id, "Completed", $"Goal '{goal.Goal}' achieved");
            Ui.Toast(achieved ? $"Goal achieved: {goal.Goal}" : $"Goal reopened: {goal.Goal}");
            await LoadAsync();
        }
        finally { busy = false; }
    }

    private async Task ConfirmDelete()
    {
        var g = pendingDelete;
        pendingDelete = null;
        if (g == null) return;
        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            var goal = await db.PersonalGoals.FindAsync(g.Id);
            if (goal == null) return;
            db.PersonalGoals.Remove(goal);
            await db.SaveChangesAsync();
            await scope.ServiceProvider.GetRequiredService<ProductivityService>()
                .LogActivityAsync("Goal", g.Id, "Deleted", $"Goal '{g.Goal}' deleted");
            Ui.Toast($"Goal '{g.Goal}' deleted");
            Ui.NotifyDataChanged();
        }
        finally { busy = false; }
    }
}
