@page "/studies"
@inherits OwningComponentBase
@using LifeOS.MVC.Data
@using LifeOS.MVC.Models
@using LifeOS.MVC.Services
@using Microsoft.EntityFrameworkCore
@inject LifeOS.App.Services.AppUi Ui

@if (subjects == null)
{
    <p class="db-empty">Loading…</p>
}
else
{
    <div class="db">
        <div class="db-head">
            <div>
                <div class="db-date">Studies</div>
                <h1 class="db-title">Keep learning, one session at a time.</h1>
            </div>
            <div class="db-actions">
                <button type="button" class="lo-btn" @onclick='() => Ui.Open("study-session")'><Icon Name="clock" /> Log session</button>
                <button type="button" class="lo-btn lo-btn-primary" @onclick='() => Ui.Open("study-subject")'><Icon Name="plus" /> New subject</button>
            </div>
        </div>

        <div class="db-grid-levels">
            <div class="db-level"><span class="db-muted db-tiny">Subjects</span><span class="db-level-pct lo-num">@subjects.Count</span><span class="db-muted db-tiny">tracked</span></div>
            <div class="db-level"><span class="db-muted db-tiny">This week</span><span class="db-level-pct lo-num">@thisWeekSessions!.Count</span><span class="db-muted db-tiny">sessions logged</span></div>
            <div class="db-level"><span class="db-muted db-tiny">Today</span><span class="db-level-pct lo-num">@todaySessions!.Sum(s => s.DurationHours).ToString("0.#")h</span><span class="db-muted db-tiny">studied</span></div>
        </div>

        @if (!subjects.Any())
        {
            <section class="db-card">
                <div class="empty-state">
                    <span class="empty-ico"><Icon Name="studies" /></span>
                    <strong>No subjects yet</strong>
                    <span class="db-muted db-small">Add a subject, then log study sessions and tasks against it.</span>
                    <button type="button" class="lo-btn lo-btn-primary" @onclick='() => Ui.Open("study-subject")'><Icon Name="plus" /> Add your first subject</button>
                </div>
            </section>
        }
        <div class="db-grid-2">
            @foreach (var s in subjects)
            {
                <a class="db-card lo-plain-link" href="studies/@s.Id" @key="s.Id">
                    <div class="db-card-head">
                        <div style="min-width:0;">
                            <div class="db-muted db-tiny">@s.Category · @s.Status</div>
                            <h3 class="db-h2">@s.Name</h3>
                        </div>
                        <span class="lo-num" style="font-weight:800;font-size:1.25rem;">@s.ProgressPercent%</span>
                    </div>
                    <div class="db-bar" role="progressbar" aria-label="Progress of @s.Name" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@s.ProgressPercent"><span style="width:@Math.Clamp(s.ProgressPercent, 0, 100)%"></span></div>
                    <div class="db-muted db-tiny lo-num">@s.HoursLogged.ToString("0.#")h logged@(s.TargetHours > 0 ? $" of {s.TargetHours}h target" : "")</div>
                    @if (!string.IsNullOrWhiteSpace(s.CurrentTopic)) { <div class="db-muted db-small">Currently: @s.CurrentTopic</div> }
                </a>
            }
        </div>
    </div>
}

@code {
    private List<StudySubject>? subjects;
    private List<StudySession>? thisWeekSessions;
    private List<StudySession>? todaySessions;

    protected override async Task OnInitializedAsync()
    {
        Ui.DataChanged += OnDataChanged;
        await LoadAsync();
    }

    private void OnDataChanged() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    protected override void Dispose(bool disposing)
    {
        if (disposing) Ui.DataChanged -= OnDataChanged;
        base.Dispose(disposing);
    }

    private async Task LoadAsync()
    {
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var today = DateTime.Today;
        var weekStart = ProductivityService.WeekStart(today);

        subjects = await db.StudySubjects.AsNoTracking().OrderBy(s => s.Status).ThenBy(s => s.Name).ToListAsync();
        thisWeekSessions = await db.StudySessions.AsNoTracking().Where(s => s.SessionDate >= weekStart).ToListAsync();
        todaySessions = thisWeekSessions.Where(s => s.SessionDate.Date == today).ToList();
    }
}
