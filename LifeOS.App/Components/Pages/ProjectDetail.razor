@page "/projects/{Id:int}"
@inherits OwningComponentBase
@using LifeOS.MVC.Data
@using LifeOS.MVC.Models
@using LifeOS.MVC.Services
@using Microsoft.EntityFrameworkCore
@inject LifeOS.App.Services.AppUi Ui

@if (notFound)
{
    <div class="db"><section class="db-card"><div class="empty-state"><strong>This project no longer exists</strong><a class="lo-btn lo-btn-primary" href="projects">Back to projects</a></div></section></div>
}
else if (project == null)
{
    <p class="db-empty">Loading…</p>
}
else
{
    var p = project;
    bool overdueProject = p.Deadline.HasValue && p.Deadline.Value.Date < DateTime.Today && p.Status != "Done";
    <div class="db">
        <div class="db-head">
            <div style="min-width:0;">
                <a class="db-link" href="projects">← Projects</a>
                <h1 class="db-title">@p.Title</h1>
                <div class="lo-chips">
                    <span class="db-pri @p.Priority.ToLowerInvariant()">Priority @p.Priority</span>
                    <span class="db-badge">@p.Status</span>
                    @if (!string.IsNullOrEmpty(p.Category)) { <span class="db-badge">@p.Category</span> }
                    <span class="db-badge @(overdueProject ? "high" : "")">@(p.Deadline.HasValue ? (overdueProject ? "Overdue · " : "Due ") + p.Deadline.Value.ToString("d MMM yyyy") : "No deadline")</span>
                </div>
            </div>
            <div class="db-actions">
                <button type="button" class="lo-btn" @onclick='() => Ui.Open("project", Id)'>Edit project</button>
                <button type="button" class="lo-btn lo-btn-primary" @onclick='() => Ui.Open("project-task", Id)'><Icon Name="plus" /> Add task</button>
            </div>
        </div>

        <div class="db-grid-levels">
            <div class="db-level"><span class="db-muted db-tiny">Progress</span><span class="db-level-pct lo-num">@Math.Clamp(p.ProgressPercent, 0, 100)%</span><div class="db-bar" role="presentation"><span style="width:@Math.Clamp(p.ProgressPercent, 0, 100)%"></span></div></div>
            <div class="db-level"><span class="db-muted db-tiny">Tasks done</span><span class="db-level-pct lo-num">@tasks!.Count(t => t.IsCompleted) / @tasks.Count</span><span class="db-muted db-tiny">@tasks.Count(t => t.Status == "InProgress") in progress</span></div>
            <div class="db-level"><span class="db-muted db-tiny">Overdue</span><span class="db-level-pct lo-num @(OverdueTaskCount > 0 ? "db-neg" : "")">@OverdueTaskCount</span><span class="db-muted db-tiny">open tasks past due</span></div>
            <div class="db-level"><span class="db-muted db-tiny">Time</span><span class="db-level-pct lo-num">@Minutes(tasks.Sum(t => t.ActualMinutes ?? 0))</span><span class="db-muted db-tiny">logged of @Minutes(tasks.Sum(t => t.EstimatedMinutes ?? 0)) planned</span></div>
        </div>

        @if (!string.IsNullOrWhiteSpace(p.Notes)) { <section class="db-card"><p class="db-small" style="margin:0; white-space:pre-line;">@p.Notes</p></section> }

        @if (!tasks.Any())
        {
            <section class="db-card">
                <div class="empty-state">
                    <span class="empty-ico"><Icon Name="tasks" /></span>
                    <strong>No tasks yet</strong>
                    <span class="db-muted db-small">Break this project into small tasks. Progress and the next step update automatically.</span>
                    <button type="button" class="lo-btn lo-btn-primary" @onclick='() => Ui.Open("project-task", Id)'><Icon Name="plus" /> Add the first task</button>
                </div>
            </section>
        }

        <div class="lo-kanban">
            @foreach (var col in Columns)
            {
                <section class="lo-kanban-col lo-col-@col.Key.ToLowerInvariant()">
                    <div class="lo-kanban-head"><h2 class="db-h3">@col.Label</h2><span class="db-badge lo-num">@col.Tasks.Count</span></div>
                    @if (!col.Tasks.Any()) { <p class="db-empty db-small">@col.Empty</p> }
                    @foreach (var t in col.Tasks)
                    {
                        bool overdue = !t.IsCompleted && t.DueDate.HasValue && t.DueDate.Value.Date < DateTime.Today;
                        <article class="lo-task-card @(t.IsCompleted ? "is-done" : "") @(overdue ? "is-overdue" : "")" @key="t.Id">
                            <div class="lo-task-top">
                                <h3 class="lo-task-title">@t.Title</h3>
                                <span class="db-pri @t.Priority.ToLowerInvariant()">@t.Priority</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(t.Description)) { <p class="db-muted db-tiny" style="margin:0;">@t.Description</p> }
                            <div class="lo-chips db-tiny">
                                @if (t.DueDate.HasValue) { <span class="@(overdue ? "db-neg" : "db-muted")">@(overdue ? "Overdue · " : "Due ")@t.DueDate.Value.ToString("d MMM")</span> }
                                @if (t.EstimatedMinutes > 0) { <span class="db-muted">~@Minutes(t.EstimatedMinutes.Value) planned</span> }
                                @if (t.ActualMinutes > 0) { <span class="db-muted">@Minutes(t.ActualMinutes.Value) logged</span> }
                            </div>
                            <div class="lo-task-actions">
                                @if (t.Status == "Todo") { <button type="button" class="lo-btn lo-btn-sm" @onclick='() => MoveTask(t.Id, "InProgress")'>Start</button> }
                                @if (t.Status == "InProgress") { <button type="button" class="lo-btn lo-btn-sm" @onclick='() => MoveTask(t.Id, "Todo")'>Back to To do</button> }
                                @if (t.Status != "Done") { <button type="button" class="lo-btn lo-btn-sm lo-btn-primary" @onclick='() => MoveTask(t.Id, "Done")'>Done</button> }
                                else { <button type="button" class="lo-btn lo-btn-sm" @onclick='() => MoveTask(t.Id, "Todo")'>Reopen</button> }
                                <button type="button" class="lo-btn lo-btn-sm" aria-label="Edit @t.Title" @onclick='() => Ui.Open("project-task-edit", t.Id)'>Edit</button>
                                <button type="button" class="lo-btn lo-btn-sm lo-btn-danger" aria-label="Delete @t.Title" @onclick="() => pendingDelete = t">Delete</button>
                            </div>
                        </article>
                    }
                </section>
            }
        </div>
    </div>
}

<ConfirmModal Open="@(pendingDelete != null)" Title="Delete this task?" Message="@($"'{pendingDelete?.Title}' will be removed from the project.")"
              OnConfirm="ConfirmDelete" OnCancel="CancelDelete" />

@code {
    [Parameter] public int Id { get; set; }

    private record Column(string Key, string Label, List<ProjectTask> Tasks, string Empty);

    private Project? project;
    private List<ProjectTask>? tasks;
    private bool notFound, busy;
    private ProjectTask? pendingDelete;

    private int OverdueTaskCount => tasks!.Count(t => !t.IsCompleted && t.DueDate.HasValue && t.DueDate.Value.Date < DateTime.Today);
    private IEnumerable<Column> Columns => new[]
    {
        new Column("Todo", "To do", tasks!.Where(t => t.Status == "Todo").ToList(), "No tasks waiting."),
        new Column("InProgress", "In progress", tasks!.Where(t => t.Status == "InProgress").ToList(), "Start a task to see it here."),
        new Column("Done", "Done", tasks!.Where(t => t.Status == "Done").ToList(), "Finished tasks appear here."),
    };

    private static string Minutes(int m) => m >= 60 ? $"{m / 60}h {m % 60}m" : $"{m}m";

    protected override async Task OnInitializedAsync()
    {
        Ui.DataChanged += OnDataChanged;
        await LoadAsync();
    }

    private void OnDataChanged() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    protected override void Dispose(bool disposing)
    {
        if (disposing) Ui.DataChanged -= OnDataChanged;
        base.Dispose(disposing);
    }

    private async Task LoadAsync()
    {
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        project = await db.Projects.AsNoTracking().FirstOrDefaultAsync(x => x.Id == Id);
        notFound = project == null;
        if (project == null) return;
        tasks = await db.ProjectTasks.AsNoTracking().Where(t => t.ProjectId == Id)
            .OrderBy(t => t.Status).ThenBy(t => t.SortOrder).ThenBy(t => t.Priority).ThenBy(t => t.DueDate)
            .ToListAsync();
    }

    private async Task MoveTask(int taskId, string status)
    {
        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            var task = await db.ProjectTasks.FindAsync(taskId);
            if (task == null) return;
            task.Status = status;
            task.IsCompleted = status == "Done";
            task.CompletedAt = status == "Done" ? DateTime.Now : null;
            await db.SaveChangesAsync();
            await LifeOS.App.Services.ProjectProgress.RecalculateAsync(db, Id);
            await scope.ServiceProvider.GetRequiredService<ProductivityService>()
                .LogActivityAsync("ProjectTask", taskId, status == "Done" ? "Completed" : "Updated", $"Task '{task.Title}' moved to {status}");
            Ui.Toast(status == "Done" ? $"Done: {task.Title}" : $"'{task.Title}' → {status}");
            await LoadAsync();
        }
        finally { busy = false; }
    }

    private void CancelDelete() => pendingDelete = null;

    private async Task ConfirmDelete()
    {
        var t = pendingDelete;
        pendingDelete = null;
        if (t == null) return;
        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            var task = await db.ProjectTasks.FindAsync(t.Id);
            if (task == null) return;
            db.ProjectTasks.Remove(task);
            await db.SaveChangesAsync();
            await LifeOS.App.Services.ProjectProgress.RecalculateAsync(db, Id);
            await scope.ServiceProvider.GetRequiredService<ProductivityService>()
                .LogActivityAsync("ProjectTask", t.Id, "Deleted", $"Task '{t.Title}' deleted");
            Ui.Toast($"Task '{t.Title}' removed");
            await LoadAsync();
        }
        finally { busy = false; }
    }
}
