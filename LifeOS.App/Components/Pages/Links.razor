@page "/links"
@inherits OwningComponentBase
@using LifeOS.MVC.Data
@using LifeOS.Models
@using Microsoft.EntityFrameworkCore
@inject LifeOS.App.Services.AppUi Ui

@if (links == null)
{
    <p class="db-empty">Loading…</p>
}
else
{
    <div class="db">
        <div class="db-head">
            <div>
                <div class="db-date">Links</div>
                <h1 class="db-title">Your saved web library.</h1>
            </div>
            <div class="db-actions">
                <button type="button" class="lo-btn lo-btn-primary" @onclick='() => Ui.Open("link")'><Icon Name="plus" /> New link</button>
            </div>
        </div>

        <div class="links-bar">
            <div class="los-search-wrap" style="flex:1;max-width:420px;">
                <Icon Name="search" />
                <label for="linkSearch" class="lo-visually-hidden">Search links</label>
                <input id="linkSearch" type="search" class="los-search" style="width:100%!important;" placeholder="Search links…" autocomplete="off" @bind="search" @bind:event="oninput" />
            </div>
            <div class="db-filters" role="group" aria-label="Filter by category">
                <button type="button" class="db-chip" aria-pressed="@(category == null ? "true" : "false")" @onclick="() => category = null">All</button>
                @foreach (var c in Categories)
                {
                    var cat = c;
                    <button type="button" class="db-chip" aria-pressed="@(category == cat ? "true" : "false")" @onclick="() => category = cat">@cat</button>
                }
            </div>
        </div>

        @if (!Shown.Any())
        {
            <section class="db-card">
                <div class="empty-state">
                    <span class="empty-ico"><Icon Name="links" /></span>
                    <strong>@(links.Count == 0 ? "No links yet" : "No links match")</strong>
                    <span class="db-muted db-small">@(links.Count == 0 ? "Save the sites you use often so they are one click away." : "Try a different search or category.")</span>
                    @if (links.Count == 0) { <button type="button" class="lo-btn lo-btn-primary" @onclick='() => Ui.Open("link")'><Icon Name="plus" /> Save your first link</button> }
                </div>
            </section>
        }
        <div class="db-grid-2">
            @foreach (var l in Shown)
            {
                <article class="db-card" @key="l.Id">
                    <div class="db-card-head">
                        <div style="min-width:0;">
                            <div class="db-muted db-tiny">@l.Domain · @l.Category</div>
                            <h3 class="db-h2"><a class="lo-plain-link" href="@l.Url" target="_blank" rel="noopener" @onclick="() => Visit(l.Id)">@l.Name @(l.IsPinned ? "📌" : "")</a></h3>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(l.Description)) { <p class="db-muted db-small" style="margin:0;">@l.Description</p> }
                    @if (l.TagList.Any())
                    {
                        <div class="lo-chips db-tiny">
                            @foreach (var t in l.TagList) { <span class="db-badge">@t</span> }
                        </div>
                    }
                    <div class="lo-row-actions" style="flex-wrap:wrap;">
                        <button type="button" class="lo-btn lo-btn-sm" aria-pressed="@(l.IsFavorite ? "true" : "false")" @onclick="() => ToggleFavorite(l.Id)">@(l.IsFavorite ? "★ Favorite" : "☆ Favorite")</button>
                        <button type="button" class="lo-btn lo-btn-sm" @onclick='() => Ui.Open("link", l.Id)'>Edit</button>
                        <button type="button" class="lo-btn lo-btn-sm lo-btn-danger" @onclick="() => pendingDelete = l">Delete</button>
                    </div>
                </article>
            }
        </div>
    </div>
}

<ConfirmModal Open="@(pendingDelete != null)" Title="Delete this link?" Message="@($"'{pendingDelete?.Name}' will be removed from your library.")" OnConfirm="ConfirmDelete" OnCancel="CancelDelete" />

@code {
    private List<WebLink>? links;
    private string search = "";
    private string? category;
    private WebLink? pendingDelete;

    private IEnumerable<string> Categories => links!.Select(l => l.Category).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct().OrderBy(c => c);

    private IEnumerable<WebLink> Shown
    {
        get
        {
            IEnumerable<WebLink> q = links!;
            if (category != null) q = q.Where(l => l.Category == category);
            if (!string.IsNullOrWhiteSpace(search))
                q = q.Where(l => l.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
                    || l.Url.Contains(search, StringComparison.OrdinalIgnoreCase)
                    || (l.Description?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (l.Tags?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false));
            return q;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Ui.DataChanged += OnDataChanged;
        await LoadAsync();
    }

    private void OnDataChanged() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    protected override void Dispose(bool disposing)
    {
        if (disposing) Ui.DataChanged -= OnDataChanged;
        base.Dispose(disposing);
    }

    private async Task LoadAsync()
    {
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        links = await db.WebLinks.AsNoTracking()
            .OrderByDescending(l => l.IsPinned).ThenByDescending(l => l.IsFavorite).ThenByDescending(l => l.CreatedAt)
            .ToListAsync();
    }

    private async Task Visit(int id)
    {
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var l = await db.WebLinks.FindAsync(id);
        if (l == null) return;
        l.VisitCount++;
        l.LastVisited = DateTime.Now;
        await db.SaveChangesAsync();
    }

    private async Task ToggleFavorite(int id)
    {
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var l = await db.WebLinks.FindAsync(id);
        if (l == null) return;
        l.IsFavorite = !l.IsFavorite;
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private void CancelDelete() => pendingDelete = null;

    private async Task ConfirmDelete()
    {
        var l = pendingDelete;
        pendingDelete = null;
        if (l == null) return;
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var row = await db.WebLinks.FindAsync(l.Id);
        if (row == null) return;
        db.WebLinks.Remove(row);
        await db.SaveChangesAsync();
        Ui.Toast("Link deleted");
        await LoadAsync();
    }
}
