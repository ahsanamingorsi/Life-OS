@page "/review"
@inherits OwningComponentBase
@using LifeOS.MVC.Data
@using LifeOS.MVC.Models
@using Microsoft.EntityFrameworkCore
@inject LifeOS.App.Services.AppUi Ui

@if (reviews == null)
{
    <p class="db-empty">Loading…</p>
}
else
{
    <div class="db">
        <div class="db-head">
            <div>
                <div class="db-date">Review</div>
                <h1 class="db-title">Look back, then plan ahead.</h1>
            </div>
            <div class="db-actions">
                <button type="button" class="lo-btn lo-btn-primary" @onclick='() => Ui.Open("weekly-review")'><Icon Name="sparkle" /> Guided weekly review</button>
                <button type="button" class="lo-btn" @onclick='() => Ui.Open("review")'><Icon Name="plus" /> New review</button>
            </div>
        </div>

        @if (!reviews.Any())
        {
            <section class="db-card">
                <div class="empty-state">
                    <span class="empty-ico"><Icon Name="review" /></span>
                    <strong>No reviews yet</strong>
                    <span class="db-muted db-small">A short weekly review keeps you honest: wins, misses and what to improve.</span>
                    <button type="button" class="lo-btn lo-btn-primary" @onclick='() => Ui.Open("review")'><Icon Name="plus" /> Start your first review</button>
                </div>
            </section>
        }
        <div class="db-grid-2">
            @foreach (var r in reviews)
            {
                <section class="db-card" @key="r.Id">
                    <div class="db-card-head">
                        <div style="min-width:0;">
                            <div class="db-muted db-tiny">@r.Period review</div>
                            <h3 class="db-h2">@r.StartDate.ToString("d MMM") – @r.EndDate.ToString("d MMM yyyy")</h3>
                        </div>
                        <span class="lo-num" style="font-weight:800;font-size:1.25rem;">@r.OverallScore/10</span>
                    </div>
                    <div class="db-bar" role="presentation"><span style="width:@(r.OverallScore * 10)%"></span></div>
                    @if (!string.IsNullOrWhiteSpace(r.Wins)) { <div class="db-small"><strong>Wins:</strong> <span class="db-muted">@r.Wins</span></div> }
                    @if (!string.IsNullOrWhiteSpace(r.MissedGoals)) { <div class="db-small"><strong>Missed:</strong> <span class="db-muted">@r.MissedGoals</span></div> }
                    @if (!string.IsNullOrWhiteSpace(r.Notes)) { <div class="db-small"><strong>Notes:</strong> <span class="db-muted">@r.Notes</span></div> }
                    @if (!string.IsNullOrWhiteSpace(r.ImprovementSuggestions)) { <div class="db-small"><strong>Improve:</strong> <span class="db-muted">@r.ImprovementSuggestions</span></div> }
                    <div class="lo-row-actions">
                        <button type="button" class="lo-btn lo-btn-sm" @onclick='() => Ui.Open("review", r.Id)'>Edit</button>
                        <button type="button" class="lo-btn lo-btn-sm lo-btn-danger" @onclick="() => pendingDelete = r">Delete</button>
                    </div>
                </section>
            }
        </div>
    </div>
}

<ConfirmModal Open="@(pendingDelete != null)" Title="Delete this review?" Message="@($"The review for {pendingDelete?.StartDate:d MMM} – {pendingDelete?.EndDate:d MMM yyyy} will be deleted.")" OnConfirm="ConfirmDelete" OnCancel="CancelDelete" />

@code {
    private List<ReviewEntry>? reviews;
    private ReviewEntry? pendingDelete;

    protected override async Task OnInitializedAsync()
    {
        Ui.DataChanged += OnDataChanged;
        await LoadAsync();
    }

    private void OnDataChanged() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    protected override void Dispose(bool disposing)
    {
        if (disposing) Ui.DataChanged -= OnDataChanged;
        base.Dispose(disposing);
    }

    private async Task LoadAsync()
    {
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        reviews = await db.ReviewEntries.AsNoTracking().OrderByDescending(r => r.CreatedAt).Take(20).ToListAsync();
    }

    private void CancelDelete() => pendingDelete = null;

    private async Task ConfirmDelete()
    {
        var r = pendingDelete;
        pendingDelete = null;
        if (r == null) return;
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var row = await db.ReviewEntries.FindAsync(r.Id);
        if (row == null) return;
        db.ReviewEntries.Remove(row);
        await db.SaveChangesAsync();
        Ui.Toast("Review deleted");
        await LoadAsync();
    }
}
