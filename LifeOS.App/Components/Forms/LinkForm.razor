@inherits OwningComponentBase
@using LifeOS.MVC.Data
@using LifeOS.Models
@using Microsoft.EntityFrameworkCore
@inject LifeOS.App.Services.AppUi Ui

<GlassModal Open="Open" Title="@(LinkId == 0 ? "New link" : "Edit link")" Subtitle="Your saved web library." OnClose="Close">
    <ChildContent>
        @if (error != null) { <div class="lo-flash lo-flash-error" role="alert">@error</div> }
        <div class="lo-form">
            <div class="lo-field">
                <label for="lf-name" class="lo-label">Name <span aria-hidden="true">*</span></label>
                <input id="lf-name" class="lo-input" @bind="link.Name" @bind:event="oninput" maxlength="200" />
            </div>
            <div class="lo-field">
                <label for="lf-url" class="lo-label">Web address <span aria-hidden="true">*</span></label>
                <input id="lf-url" class="lo-input" @bind="link.Url" maxlength="500" placeholder="example.com" />
            </div>
            <div class="lo-form-grid">
                <div class="lo-field">
                    <label for="lf-cat" class="lo-label">Category</label>
                    <input id="lf-cat" class="lo-input" @bind="link.Category" maxlength="50" />
                </div>
                <div class="lo-field">
                    <label for="lf-tags" class="lo-label">Tags</label>
                    <input id="lf-tags" class="lo-input" @bind="link.Tags" maxlength="200" placeholder="comma, separated" />
                </div>
            </div>
            <div class="lo-field">
                <label for="lf-desc" class="lo-label">Description <span class="db-muted">(optional)</span></label>
                <textarea id="lf-desc" class="lo-input lo-textarea" maxlength="400" @bind="link.Description"></textarea>
            </div>
            <div class="lo-form-grid">
                <label class="lo-check-label"><input type="checkbox" @bind="link.IsFavorite" /> Favorite</label>
                <label class="lo-check-label"><input type="checkbox" @bind="link.IsPinned" /> Pinned</label>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="lo-btn" @onclick="Close" disabled="@busy">Cancel</button>
        <button type="button" class="lo-btn lo-btn-primary" @onclick="Save" disabled="@busy">@(LinkId == 0 ? "Save link" : "Save changes")</button>
    </Footer>
</GlassModal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public int LinkId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool wasOpen, busy;
    private string? error;
    private WebLink link = new() { Category = "General" };

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !wasOpen) await LoadAsync();
        wasOpen = Open;
    }

    private async Task LoadAsync()
    {
        error = null;
        link = new WebLink { Category = "General" };
        if (LinkId == 0) return;
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var l = await db.WebLinks.AsNoTracking().FirstOrDefaultAsync(x => x.Id == LinkId);
        if (l == null) return;
        link = new WebLink
        {
            Id = l.Id, Name = l.Name, Url = l.Url, Description = l.Description, Category = l.Category,
            Tags = l.Tags, IsFavorite = l.IsFavorite, IsPinned = l.IsPinned,
        };
    }

    /// <summary>Adds https:// when missing and accepts only http/https addresses.</summary>
    private static string? CleanUrl(string? url)
    {
        url = url?.Trim();
        if (string.IsNullOrEmpty(url)) return null;
        if (!url.Contains("://")) url = "https://" + url;
        return Uri.TryCreate(url, UriKind.Absolute, out var uri) && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps) && !string.IsNullOrEmpty(uri.Host)
            ? uri.AbsoluteUri : null;
    }

    private Task Close() => OnClose.InvokeAsync();

    private async Task Save()
    {
        link.Name = (link.Name ?? "").Trim();
        if (link.Name.Length == 0) { error = "Enter a name."; return; }
        var url = CleanUrl(link.Url);
        if (url == null) { error = "Enter a valid web address (http or https)."; return; }
        link.Url = url;

        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            if (link.Id == 0)
            {
                link.CreatedAt = DateTime.Now;
                db.WebLinks.Add(link);
            }
            else
            {
                var row = await db.WebLinks.FindAsync(link.Id);
                if (row == null) { error = "This link no longer exists."; return; }
                row.Name = link.Name; row.Url = link.Url; row.Description = link.Description; row.Category = link.Category;
                row.Tags = link.Tags; row.IsFavorite = link.IsFavorite; row.IsPinned = link.IsPinned;
            }
            await db.SaveChangesAsync();
            Ui.Toast(LinkId == 0 ? $"'{link.Name}' saved" : "Link updated");
            Ui.NotifyDataChanged();
            await OnSaved.InvokeAsync();
        }
        finally { busy = false; }
    }
}
