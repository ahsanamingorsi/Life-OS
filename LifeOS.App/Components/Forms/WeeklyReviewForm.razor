@inherits OwningComponentBase
@using LifeOS.MVC.Data
@using LifeOS.MVC.Models
@using LifeOS.App.Services
@using Microsoft.EntityFrameworkCore
@inject LifeOS.App.Services.AppUi Ui

<GlassModal Open="Open" Title="Weekly review" Subtitle="@(from.ToString("d MMM") + " – " + to.ToString("d MMM"))" Size="lg" OnClose="Close">
    <ChildContent>
        @if (error != null) { <div class="lo-flash lo-flash-error" role="alert">@error</div> }
        @if (stats != null)
        {
            <div class="wz-stats wz-stats-6">
                <div class="dx-stat"><strong class="lo-num">@stats.TasksDone/@stats.TasksTotal</strong><span>Tasks</span></div>
                <div class="dx-stat"><strong class="lo-num">@stats.MitsDone/@stats.MitsTotal</strong><span>Top 3 done</span></div>
                <div class="dx-stat"><strong class="lo-num">@((stats.FocusMinutes / 60.0).ToString("0.#"))h</strong><span>Focus</span></div>
                <div class="dx-stat"><strong class="lo-num">@stats.HabitsDone/@stats.HabitsTotal</strong><span>Habits</span></div>
                <div class="dx-stat"><strong class="lo-num">@(stats.StudyHours + stats.SkillHours)h</strong><span>Study + skills</span></div>
                <div class="dx-stat"><strong class="lo-num">@(stats.MoodDays > 0 ? stats.AvgMood.ToString("0.#") + "/5" : "–")</strong><span>Avg mood</span></div>
            </div>
            <p class="db-muted db-small">Average productivity this week: <strong class="lo-num">@stats.AvgScore%</strong> · Prayers: @stats.PrayersDone/@stats.PrayersTotal</p>
        }
        <div class="lo-form">
            <div class="lo-form-grid">
                <div class="lo-field"><label for="wr-wins" class="lo-label">What were this week's wins?</label><textarea id="wr-wins" class="lo-input lo-textarea" maxlength="1000" @bind="review.Wins" @bind:event="oninput"></textarea></div>
                <div class="lo-field"><label for="wr-missed" class="lo-label">What did not go as planned?</label><textarea id="wr-missed" class="lo-input lo-textarea" maxlength="1000" @bind="review.MissedGoals" @bind:event="oninput"></textarea></div>
            </div>
            <div class="lo-form-grid">
                <div class="lo-field"><label for="wr-improve" class="lo-label">What will you change next week?</label><textarea id="wr-improve" class="lo-input lo-textarea" maxlength="1000" @bind="review.ImprovementSuggestions" @bind:event="oninput"></textarea></div>
                <div class="lo-field"><label for="wr-notes" class="lo-label">Main focus for next week</label><textarea id="wr-notes" class="lo-input lo-textarea" maxlength="1000" @bind="review.Notes" @bind:event="oninput"></textarea></div>
            </div>
            <div class="lo-field">
                <label for="wr-score" class="lo-label">Rate your week: <strong class="lo-num">@review.OverallScore</strong> / 10</label>
                <input id="wr-score" type="range" min="1" max="10" class="wz-range" @bind="review.OverallScore" @bind:event="oninput" />
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="lo-btn" @onclick="Close" disabled="@busy">Cancel</button>
        <button type="button" class="lo-btn lo-btn-primary" @onclick="Save" disabled="@busy">Save review</button>
    </Footer>
</GlassModal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool wasOpen, busy;
    private string? error;
    private DateTime from = DateTime.Today.AddDays(-6), to = DateTime.Today;
    private PeriodStats? stats;
    private ReviewEntry review = new() { Period = "Weekly", OverallScore = 7 };

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !wasOpen) await LoadAsync();
        wasOpen = Open;
    }

    private async Task LoadAsync()
    {
        error = null; busy = false;
        to = DateTime.Today; from = to.AddDays(-6);
        review = new ReviewEntry { Period = "Weekly", StartDate = from, EndDate = to, OverallScore = 7 };
        using var scope = ScopedServices.CreateScope();
        stats = await DayStats.LoadAsync(scope.ServiceProvider, from, to);
    }

    private Task Close() => OnClose.InvokeAsync();

    private async Task Save()
    {
        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            review.CreatedAt = DateTime.Now;
            review.StartDate = from; review.EndDate = to;
            db.ReviewEntries.Add(review);
            await db.SaveChangesAsync();
            Ui.Toast("Weekly review saved");
            Ui.NotifyDataChanged();
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex) { error = "Could not save: " + ex.Message; }
        finally { busy = false; }
    }
}
