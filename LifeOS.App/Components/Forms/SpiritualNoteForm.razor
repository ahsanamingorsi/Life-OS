@inherits OwningComponentBase
@using LifeOS.MVC.Data
@using LifeOS.MVC.Models
@using Microsoft.EntityFrameworkCore
@inject LifeOS.App.Services.AppUi Ui

<GlassModal Open="Open" Title="Gratitude &amp; reflection" Subtitle="@DayText" OnClose="Close">
    <ChildContent>
        @if (error != null) { <div class="lo-flash lo-flash-error" role="alert">@error</div> }
        <div class="lo-form">
            <div class="lo-field">
                <label for="sn-grat" class="lo-label">What are you grateful for?</label>
                <textarea id="sn-grat" class="lo-input lo-textarea" maxlength="500" @bind="gratitude"></textarea>
            </div>
            <div class="lo-field">
                <label for="sn-refl" class="lo-label">Reflection</label>
                <textarea id="sn-refl" class="lo-input lo-textarea" maxlength="500" @bind="reflection"></textarea>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="lo-btn" @onclick="Close" disabled="@busy">Cancel</button>
        <button type="button" class="lo-btn lo-btn-primary" @onclick="Save" disabled="@busy">Save</button>
    </Footer>
</GlassModal>

@code {
    /// <summary>The day as yyyyMMdd (for example 20261121).</summary>
    [Parameter] public bool Open { get; set; }
    [Parameter] public int DayKey { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool wasOpen, busy;
    private string? error, gratitude, reflection;
    private DateTime day = DateTime.Today;
    private string DayText => day.ToString("dddd, d MMMM");

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !wasOpen) await LoadAsync();
        wasOpen = Open;
    }

    private async Task LoadAsync()
    {
        error = null;
        day = DateTime.TryParseExact(DayKey.ToString(), "yyyyMMdd", null, System.Globalization.DateTimeStyles.None, out var d) ? d : DateTime.Today;
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var e = await db.SpiritualEntries.AsNoTracking().FirstOrDefaultAsync(x => x.Date == day);
        gratitude = e?.GratitudeNote;
        reflection = e?.ReflectionNote;
    }

    private Task Close() => OnClose.InvokeAsync();

    private async Task Save()
    {
        if (day > DateTime.Today) { error = "Choose today or a past day."; return; }
        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            var entry = await db.SpiritualEntries.FirstOrDefaultAsync(x => x.Date == day);
            bool created = entry == null;
            entry ??= new SpiritualEntry { Date = day, PrayersTotal = 5 };
            entry.GratitudeNote = string.IsNullOrWhiteSpace(gratitude) ? null : gratitude.Trim();
            entry.ReflectionNote = string.IsNullOrWhiteSpace(reflection) ? null : reflection.Trim();
            if (created) db.SpiritualEntries.Add(entry);
            await db.SaveChangesAsync();
            Ui.Toast("Notes saved");
            Ui.NotifyDataChanged();
            await OnSaved.InvokeAsync();
        }
        finally { busy = false; }
    }
}
