@inherits OwningComponentBase
@using LifeOS.MVC.Data
@using LifeOS.MVC.Models
@using LifeOS.MVC.Services
@using Microsoft.EntityFrameworkCore
@inject LifeOS.App.Services.AppUi Ui

<GlassModal Open="Open" Title="@(SkillId == 0 ? "New skill" : "Edit skill")" Subtitle="Grow your technical edge." OnClose="Close">
    <ChildContent>
        @if (error != null) { <div class="lo-flash lo-flash-error" role="alert">@error</div> }
        <div class="lo-form">
            <div class="lo-field">
                <label for="skf-name" class="lo-label">Name <span aria-hidden="true">*</span></label>
                <input id="skf-name" class="lo-input" @bind="skill.Name" @bind:event="oninput" maxlength="100" placeholder="e.g. React, PostgreSQL" />
            </div>
            <div class="lo-form-grid">
                <div class="lo-field">
                    <label for="skf-cat" class="lo-label">Category</label>
                    <input id="skf-cat" class="lo-input" @bind="skill.Category" maxlength="50" />
                </div>
                <div class="lo-field">
                    <label for="skf-level" class="lo-label">Level</label>
                    <select id="skf-level" class="lo-select" @bind="skill.Level"><option>Beginner</option><option>Intermediate</option><option>Advanced</option><option>Expert</option></select>
                </div>
                <div class="lo-field">
                    <label for="skf-weekly" class="lo-label">Weekly target (hours)</label>
                    <input id="skf-weekly" type="number" min="0" max="168" step="0.5" class="lo-input" @bind="skill.WeeklyTargetHours" />
                </div>
                <div class="lo-field">
                    <label for="skf-progress" class="lo-label">Progress (%)</label>
                    <input id="skf-progress" type="number" min="0" max="100" class="lo-input" @bind="skill.ProgressPercent" />
                </div>
            </div>
            <div class="lo-form-grid">
                <label class="lo-check-label"><input type="checkbox" @bind="skill.IsCurrent" /> Current skill</label>
                <label class="lo-check-label"><input type="checkbox" @bind="skill.IsNext" /> Learn next</label>
            </div>
            <div class="lo-field">
                <label for="skf-notes" class="lo-label">Notes <span class="db-muted">(optional)</span></label>
                <textarea id="skf-notes" class="lo-input lo-textarea" maxlength="500" @bind="skill.Notes"></textarea>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="lo-btn" @onclick="Close" disabled="@busy">Cancel</button>
        <button type="button" class="lo-btn lo-btn-primary" @onclick="Save" disabled="@busy">@(SkillId == 0 ? "Add skill" : "Save changes")</button>
    </Footer>
</GlassModal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public int SkillId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool wasOpen, busy;
    private string? error;
    private TechSkill skill = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !wasOpen) await LoadAsync();
        wasOpen = Open;
    }

    private async Task LoadAsync()
    {
        error = null;
        skill = new TechSkill();
        if (SkillId == 0) return;
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var s = await db.TechSkills.AsNoTracking().FirstOrDefaultAsync(x => x.Id == SkillId);
        if (s == null) return;
        skill = new TechSkill
        {
            Id = s.Id, Name = s.Name, Category = s.Category, Level = s.Level, ProgressPercent = s.ProgressPercent,
            WeeklyTargetHours = s.WeeklyTargetHours, IsCurrent = s.IsCurrent, IsNext = s.IsNext, Notes = s.Notes,
        };
    }

    private Task Close() => OnClose.InvokeAsync();

    private async Task Save()
    {
        skill.Name = (skill.Name ?? "").Trim();
        if (skill.Name.Length == 0) { error = "Enter a skill name."; return; }
        skill.ProgressPercent = Math.Clamp(skill.ProgressPercent, 0, 100);
        if (skill.WeeklyTargetHours < 0 || skill.WeeklyTargetHours > 168) { error = "Weekly target must be between 0 and 168 hours."; return; }

        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            var productivity = scope.ServiceProvider.GetRequiredService<ProductivityService>();

            if (skill.IsCurrent)
                foreach (var cur in await db.TechSkills.Where(s => s.IsCurrent && s.Id != skill.Id).ToListAsync()) cur.IsCurrent = false;

            string message;
            if (skill.Id == 0)
            {
                skill.CreatedAt = DateTime.Now; skill.UpdatedAt = DateTime.Now;
                db.TechSkills.Add(skill);
                await db.SaveChangesAsync();
                await productivity.LogActivityAsync("TechSkill", skill.Id, "Created", $"Skill '{skill.Name}' added to roadmap");
                message = $"'{skill.Name}' added";
            }
            else
            {
                var row = await db.TechSkills.FindAsync(skill.Id);
                if (row == null) { error = "This skill no longer exists."; return; }
                row.Name = skill.Name; row.Category = skill.Category; row.Level = skill.Level; row.ProgressPercent = skill.ProgressPercent;
                row.WeeklyTargetHours = skill.WeeklyTargetHours; row.IsCurrent = skill.IsCurrent; row.IsNext = skill.IsNext; row.Notes = skill.Notes;
                row.UpdatedAt = DateTime.Now;
                await db.SaveChangesAsync();
                await productivity.LogActivityAsync("TechSkill", row.Id, "Updated", $"Skill '{row.Name}' updated");
                message = $"'{row.Name}' updated";
            }
            Ui.Toast(message);
            Ui.NotifyDataChanged();
            await OnSaved.InvokeAsync();
        }
        finally { busy = false; }
    }
}
