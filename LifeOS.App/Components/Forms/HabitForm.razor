@inherits OwningComponentBase
@using LifeOS.MVC.Data
@using LifeOS.MVC.Models
@using LifeOS.MVC.Services
@using Microsoft.EntityFrameworkCore
@inject LifeOS.App.Services.AppUi Ui

<GlassModal Open="Open" Title="@(HabitId == 0 ? "New habit" : "Edit habit")" Subtitle="A small thing you want to do again and again." OnClose="Close">
    <ChildContent>
        @if (error != null) { <div class="lo-flash lo-flash-error" role="alert">@error</div> }
        <div class="lo-form">
            <div class="lo-field">
                <label for="hb-name" class="lo-label">Name <span aria-hidden="true">*</span></label>
                <input id="hb-name" class="lo-input" @bind="name" @bind:event="oninput" maxlength="100" placeholder="e.g. Read Quran" />
            </div>
            <div class="lo-form-grid">
                <div class="lo-field">
                    <label for="hb-kind" class="lo-label">Type</label>
                    <select id="hb-kind" class="lo-input" @bind="kind">
                        <option value="Check">Done / not done</option>
                        <option value="Count">Count (reach a number)</option>
                    </select>
                </div>
                @if (kind == "Count")
                {
                    <div class="lo-field">
                        <label for="hb-target" class="lo-label">Daily target</label>
                        <input id="hb-target" type="number" min="1" max="1000" class="lo-input" @bind="target" />
                    </div>
                }
            </div>
            @if (kind == "Count")
            {
                <div class="lo-field">
                    <label for="hb-unit" class="lo-label">Unit <span class="db-muted">(optional)</span></label>
                    <input id="hb-unit" class="lo-input" @bind="unit" maxlength="20" placeholder="glasses, pages, minutes…" />
                </div>
            }
            <div class="lo-field">
                <span class="lo-label">Which days?</span>
                <div class="hb-days">
                    @for (int i = 0; i < 7; i++)
                    {
                        int bit = 1 << i;
                        <button type="button" class="hb-day @((mask & bit) != 0 ? "on" : "")" aria-pressed="@((mask & bit) != 0)" @onclick="() => mask ^= bit">@DayNames[i]</button>
                    }
                </div>
            </div>
        </div>
    </ChildContent>
    <Footer>
        @if (HabitId != 0)
        {
            <button type="button" class="lo-btn" @onclick="ToggleArchive" disabled="@busy">@(archived ? "Restore" : "Archive")</button>
            <button type="button" class="lo-btn lo-btn-danger-solid" @onclick="Delete" disabled="@busy">@(confirmDel ? "Click again: delete forever" : "Delete")</button>
        }
        <button type="button" class="lo-btn" @onclick="Close" disabled="@busy">Cancel</button>
        <button type="button" class="lo-btn lo-btn-primary" @onclick="Save" disabled="@busy">@(HabitId == 0 ? "Add habit" : "Save changes")</button>
    </Footer>
</GlassModal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public int HabitId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private static readonly string[] DayNames = { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };

    private bool wasOpen, busy, archived, confirmDel;
    private string? error;
    private string name = "", kind = "Check", unit = "";
    private int target = 1, mask = 127;

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !wasOpen) await LoadAsync();
        wasOpen = Open;
    }

    private async Task LoadAsync()
    {
        error = null; confirmDel = false; name = ""; kind = "Check"; unit = ""; target = 1; mask = 127; archived = false;
        if (HabitId == 0) return;
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var h = await db.Habits.AsNoTracking().FirstOrDefaultAsync(x => x.Id == HabitId);
        if (h == null) return;
        name = h.Name; kind = h.Kind; unit = h.Unit ?? ""; target = h.Target; mask = h.DaysMask; archived = h.IsArchived;
    }

    private Task Close() => OnClose.InvokeAsync();

    private async Task Save()
    {
        name = (name ?? "").Trim();
        if (name.Length == 0) { error = "Enter a name."; return; }
        if (mask == 0) { error = "Choose at least one day."; return; }
        if (kind == "Count" && (target < 1 || target > 1000)) { error = "Target must be between 1 and 1000."; return; }

        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            Habit? row;
            if (HabitId == 0)
            {
                row = new Habit { CreatedAt = DateTime.Now, SortOrder = (await db.Habits.MaxAsync(h => (int?)h.SortOrder) ?? 0) + 1 };
                db.Habits.Add(row);
            }
            else
            {
                row = await db.Habits.FindAsync(HabitId);
                if (row == null) { error = "This habit no longer exists."; return; }
            }
            row.Name = name; row.Kind = kind; row.DaysMask = mask;
            row.Target = kind == "Count" ? target : 1;
            row.Unit = kind == "Count" && !string.IsNullOrWhiteSpace(unit) ? unit.Trim() : null;
            await db.SaveChangesAsync();
            Ui.Toast(HabitId == 0 ? $"Habit '{name}' added" : "Habit updated");
            Ui.NotifyDataChanged();
            await OnSaved.InvokeAsync();
        }
        finally { busy = false; }
    }

    private async Task ToggleArchive()
    {
        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            var row = await db.Habits.FindAsync(HabitId);
            if (row != null) { row.IsArchived = !row.IsArchived; await db.SaveChangesAsync(); }
            Ui.Toast(row?.IsArchived == true ? "Habit archived" : "Habit restored");
            Ui.NotifyDataChanged();
            await OnSaved.InvokeAsync();
        }
        finally { busy = false; }
    }

    private async Task Delete()
    {
        if (!confirmDel) { confirmDel = true; return; }
        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            var row = await db.Habits.FindAsync(HabitId);
            if (row != null) { db.Habits.Remove(row); await db.SaveChangesAsync(); }
            Ui.Toast("Habit deleted");
            Ui.NotifyDataChanged();
            await OnSaved.InvokeAsync();
        }
        finally { busy = false; }
    }
}
