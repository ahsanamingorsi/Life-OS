@inherits OwningComponentBase
@using LifeOS.MVC.Data
@using LifeOS.MVC.Models
@using Microsoft.EntityFrameworkCore
@inject LifeOS.App.Services.AppUi Ui

<GlassModal Open="Open" Title="@(TaskId == 0 ? "New subject task" : "Edit task")" Subtitle="@subjectName" Size="sm" OnClose="Close">
    <ChildContent>
        @if (error != null) { <div class="lo-flash lo-flash-error" role="alert">@error</div> }
        <div class="lo-form">
            <div class="lo-field">
                <label for="stf-title" class="lo-label">Task <span aria-hidden="true">*</span></label>
                <input id="stf-title" class="lo-input" @bind="task.Title" @bind:event="oninput" maxlength="200" placeholder="e.g. Finish chapter 3 exercises" />
            </div>
            <div class="lo-field">
                <label for="stf-due" class="lo-label">Due date <span class="db-muted">(optional)</span></label>
                <input id="stf-due" type="date" class="lo-input" value="@(task.DueDate?.ToString("yyyy-MM-dd") ?? "")" @onchange="SetDue" />
            </div>
            <div class="lo-field">
                <label for="stf-notes" class="lo-label">Notes <span class="db-muted">(optional)</span></label>
                <textarea id="stf-notes" class="lo-input lo-textarea" maxlength="1000" @bind="task.Notes"></textarea>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="lo-btn" @onclick="Close" disabled="@busy">Cancel</button>
        <button type="button" class="lo-btn lo-btn-primary" @onclick="Save" disabled="@busy">@(TaskId == 0 ? "Add task" : "Save task")</button>
    </Footer>
</GlassModal>

@code {
    /// <summary>New task: the subject. Existing task: leave 0.</summary>
    [Parameter] public bool Open { get; set; }
    [Parameter] public int SubjectId { get; set; }
    [Parameter] public int TaskId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool wasOpen, busy;
    private string? error, subjectName;
    private int subjectId;
    private StudyTask task = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !wasOpen) await LoadAsync();
        wasOpen = Open;
    }

    private async Task LoadAsync()
    {
        error = null;
        task = new StudyTask();
        subjectId = SubjectId;
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        if (TaskId != 0)
        {
            var t = await db.StudyTasks.AsNoTracking().FirstOrDefaultAsync(x => x.Id == TaskId);
            if (t != null) { subjectId = t.StudySubjectId; task = new StudyTask { Id = t.Id, StudySubjectId = t.StudySubjectId, Title = t.Title, Notes = t.Notes, DueDate = t.DueDate }; }
        }
        subjectName = await db.StudySubjects.AsNoTracking().Where(s => s.Id == subjectId).Select(s => s.Name).FirstOrDefaultAsync();
    }

    private void SetDue(ChangeEventArgs e) => task.DueDate = DateTime.TryParse(e.Value as string, out var d) ? d : null;
    private Task Close() => OnClose.InvokeAsync();

    private async Task Save()
    {
        task.Title = (task.Title ?? "").Trim();
        if (task.Title.Length == 0) { error = "Enter a task name."; return; }
        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            if (!await db.StudySubjects.AnyAsync(s => s.Id == subjectId)) { error = "This subject no longer exists."; return; }
            if (task.Id == 0)
            {
                task.StudySubjectId = subjectId;
                task.CreatedAt = DateTime.Now;
                db.StudyTasks.Add(task);
            }
            else
            {
                var row = await db.StudyTasks.FindAsync(task.Id);
                if (row == null) { error = "This task no longer exists."; return; }
                row.Title = task.Title; row.Notes = task.Notes; row.DueDate = task.DueDate;
            }
            await db.SaveChangesAsync();
            await LifeOS.App.Services.StudyProgress.RecalculateAsync(db, subjectId);
            Ui.Toast(TaskId == 0 ? "Subject task added" : "Task updated");
            Ui.NotifyDataChanged();
            await OnSaved.InvokeAsync();
        }
        finally { busy = false; }
    }
}
