@inherits OwningComponentBase
@using LifeOS.MVC.Data
@using LifeOS.MVC.Models
@using LifeOS.MVC.Services
@using Microsoft.EntityFrameworkCore
@inject LifeOS.App.Services.AppUi Ui

<GlassModal Open="Open" Title="Log skill practice" Subtitle="Hours and progress, in one place." Size="sm" OnClose="Close">
    <ChildContent>
        @if (error != null) { <div class="lo-flash lo-flash-error" role="alert">@error</div> }
        @if (skills.Count == 0)
        {
            <p class="db-empty">You have no skills yet. Add a skill on the Skills page first.</p>
        }
        else
        {
            <div class="lo-form">
                <div class="lo-field">
                    <label for="kf-skill" class="lo-label">Skill <span aria-hidden="true">*</span></label>
                    <select id="kf-skill" class="lo-select" value="@skillId" @onchange="SetSkill">
                        @foreach (var s in skills) { <option value="@s.Id">@s.Name</option> }
                    </select>
                </div>
                <div class="lo-form-grid">
                    <div class="lo-field">
                        <label for="kf-hours" class="lo-label">Hours</label>
                        <input id="kf-hours" type="number" min="0" max="24" step="0.25" class="lo-input" value="@hours" @onchange="SetHours" placeholder="1" />
                    </div>
                    <div class="lo-field">
                        <label for="kf-progress" class="lo-label">Set progress % <span class="db-muted">(optional)</span></label>
                        <input id="kf-progress" type="number" min="0" max="100" class="lo-input" value="@progress" @onchange="SetProgress" />
                    </div>
                </div>
                <div class="lo-field">
                    <label for="kf-topic" class="lo-label">Topic <span class="db-muted">(optional)</span></label>
                    <input id="kf-topic" class="lo-input" @bind="topic" maxlength="200" />
                </div>
            </div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="lo-btn" @onclick="Close" disabled="@busy">Cancel</button>
        @if (skills.Count > 0) { <button type="button" class="lo-btn lo-btn-primary" @onclick="Save" disabled="@busy">Save</button> }
    </Footer>
</GlassModal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public int SkillId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool wasOpen, busy;
    private string? error;
    private List<TechSkill> skills = new();
    private int skillId;
    private double? hours;
    private int? progress;
    private string? topic;

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !wasOpen) await LoadAsync();
        wasOpen = Open;
    }

    private async Task LoadAsync()
    {
        error = null; hours = null; progress = null; topic = null;
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        skills = await db.TechSkills.AsNoTracking().OrderByDescending(s => s.IsCurrent).ThenBy(s => s.Name).ToListAsync();
        skillId = skills.Any(s => s.Id == SkillId) ? SkillId : skills.FirstOrDefault()?.Id ?? 0;
    }

    private void SetSkill(ChangeEventArgs e) => skillId = int.TryParse(e.Value as string, out var id) ? id : 0;
    private void SetHours(ChangeEventArgs e) => hours = double.TryParse(e.Value as string, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var h) ? h : null;
    private void SetProgress(ChangeEventArgs e) => progress = int.TryParse(e.Value as string, out var p) ? p : null;
    private Task Close() => OnClose.InvokeAsync();

    private async Task Save()
    {
        double h = hours ?? 0;
        int p = progress ?? -1;
        if (skillId == 0) { error = "Choose a skill."; return; }
        if (h < 0 || h > 24 || p < -1 || p > 100 || (h == 0 && p < 0)) { error = "Enter hours (0–24) or a progress update (0–100)."; return; }

        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            var skill = await db.TechSkills.FindAsync(skillId);
            if (skill == null) { error = "This skill no longer exists."; return; }

            if (h > 0)
            {
                db.TechSkillLogs.Add(new TechSkillLog { TechSkillId = skillId, LogDate = DateTime.Today, Hours = h, TopicCovered = topic, LoggedAt = DateTime.Now });
                skill.HoursLogged = await db.TechSkillLogs.Where(l => l.TechSkillId == skillId).SumAsync(l => l.Hours) + h;
                if (!string.IsNullOrEmpty(topic)) skill.CurrentTopic = topic;
            }
            if (p >= 0) skill.ProgressPercent = p;
            skill.UpdatedAt = DateTime.Now;
            await db.SaveChangesAsync();

            var productivity = scope.ServiceProvider.GetRequiredService<ProductivityService>();
            if (h > 0)
                await productivity.LogActivityAsync("TechSkill", skillId, "HoursLogged", $"{h}h logged on '{skill.Name}'" + (topic != null ? $" — {topic}" : ""));
            else
                await productivity.LogActivityAsync("TechSkill", skillId, "Updated", $"Progress of '{skill.Name}' set to {skill.ProgressPercent}%");

            Ui.Toast(h > 0 ? $"{h:0.##}h logged on {skill.Name}" : $"{skill.Name} progress set to {skill.ProgressPercent}%");
            Ui.NotifyDataChanged();
            await OnSaved.InvokeAsync();
        }
        finally { busy = false; }
    }
}
