@inherits OwningComponentBase
@using LifeOS.MVC.Data
@using LifeOS.MVC.Models
@using Microsoft.EntityFrameworkCore
@inject LifeOS.App.Services.AppUi Ui

<GlassModal Open="Open" Title="New study note" Subtitle="Capture it before you forget." OnClose="Close">
    <ChildContent>
        @if (error != null) { <div class="lo-flash lo-flash-error" role="alert">@error</div> }
        @if (subjects.Count == 0)
        {
            <p class="db-empty">You have no study subjects yet. Add a subject on the Studies page first.</p>
        }
        else
        {
            <div class="lo-form">
                <div class="lo-field">
                    <label for="nf-subject" class="lo-label">Subject <span aria-hidden="true">*</span></label>
                    <select id="nf-subject" class="lo-select" value="@subjectId" @onchange="SetSubject">
                        @foreach (var s in subjects) { <option value="@s.Id">@s.Name</option> }
                    </select>
                </div>
                <div class="lo-field">
                    <label for="nf-title" class="lo-label">Title <span aria-hidden="true">*</span></label>
                    <input id="nf-title" class="lo-input" @bind="title" @bind:event="oninput" maxlength="200" />
                </div>
                <div class="lo-field">
                    <label for="nf-content" class="lo-label">Note</label>
                    <textarea id="nf-content" class="lo-input lo-textarea" maxlength="4000" @bind="content"></textarea>
                </div>
            </div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="lo-btn" @onclick="Close" disabled="@busy">Cancel</button>
        @if (subjects.Count > 0) { <button type="button" class="lo-btn lo-btn-primary" @onclick="Save" disabled="@busy">Save note</button> }
    </Footer>
</GlassModal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public int SubjectId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool wasOpen, busy;
    private string? error, title, content;
    private List<StudySubject> subjects = new();
    private int subjectId;

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !wasOpen) await LoadAsync();
        wasOpen = Open;
    }

    private async Task LoadAsync()
    {
        error = null; title = null; content = null;
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        subjects = await db.StudySubjects.AsNoTracking().OrderBy(s => s.Name).ToListAsync();
        subjectId = subjects.Any(s => s.Id == SubjectId) ? SubjectId : subjects.FirstOrDefault()?.Id ?? 0;
    }

    private void SetSubject(ChangeEventArgs e) => subjectId = int.TryParse(e.Value as string, out var id) ? id : 0;
    private Task Close() => OnClose.InvokeAsync();

    private async Task Save()
    {
        var t = (title ?? "").Trim();
        if (subjectId == 0) { error = "Choose a subject."; return; }
        if (t.Length == 0) { error = "Enter a note title."; return; }

        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            db.StudyNotes.Add(new StudyNote { StudySubjectId = subjectId, Title = t, Content = content, CreatedAt = DateTime.Now, UpdatedAt = DateTime.Now });
            await db.SaveChangesAsync();
            Ui.Toast($"Note '{t}' saved");
            Ui.NotifyDataChanged();
            await OnSaved.InvokeAsync();
        }
        finally { busy = false; }
    }
}
