@inherits OwningComponentBase
@using LifeOS.MVC.Data
@using LifeOS.MVC.Models
@using LifeOS.MVC.Services
@using LifeOS.App.Services
@using Microsoft.EntityFrameworkCore
@inject LifeOS.App.Services.AppUi Ui

<GlassModal Open="Open" Title="@(SubjectId == 0 ? "New study subject" : "Edit subject")" Subtitle="Hours and tasks decide the progress." OnClose="Close">
    <ChildContent>
        @if (error != null) { <div class="lo-flash lo-flash-error" role="alert">@error</div> }
        <div class="lo-form">
            <div class="lo-field">
                <label for="ssf-name" class="lo-label">Name <span aria-hidden="true">*</span></label>
                <input id="ssf-name" class="lo-input" @bind="subject.Name" @bind:event="oninput" maxlength="150" placeholder="e.g. Calculus, Arabic" />
            </div>
            <div class="lo-form-grid">
                <div class="lo-field">
                    <label for="ssf-cat" class="lo-label">Category</label>
                    <input id="ssf-cat" class="lo-input" @bind="subject.Category" maxlength="50" />
                </div>
                @if (SubjectId != 0)
                {
                    <div class="lo-field">
                        <label for="ssf-status" class="lo-label">Status</label>
                        <select id="ssf-status" class="lo-select" @bind="subject.Status"><option>Active</option><option>Paused</option><option>Completed</option></select>
                    </div>
                }
                <div class="lo-field">
                    <label for="ssf-target" class="lo-label">Target hours <span class="db-muted">(optional)</span></label>
                    <input id="ssf-target" type="number" min="0" max="100000" class="lo-input" @bind="subject.TargetHours" />
                </div>
                <div class="lo-field">
                    <label for="ssf-weekly" class="lo-label">Weekly target hours</label>
                    <input id="ssf-weekly" type="number" min="0" max="168" step="0.5" class="lo-input" @bind="subject.WeeklyTargetHours" />
                </div>
            </div>
            @if (SubjectId != 0 && !autoProgress)
            {
                <div class="lo-field">
                    <label for="ssf-progress" class="lo-label">Manual progress (%)</label>
                    <input id="ssf-progress" type="number" min="0" max="100" class="lo-input lo-input-short" @bind="subject.ProgressPercent" />
                    <div class="db-muted db-tiny">Used only while there is no target and no task to calculate from.</div>
                </div>
            }
            <div class="lo-field">
                <label for="ssf-desc" class="lo-label">Description <span class="db-muted">(optional)</span></label>
                <textarea id="ssf-desc" class="lo-input lo-textarea" maxlength="300" @bind="subject.Description"></textarea>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="lo-btn" @onclick="Close" disabled="@busy">Cancel</button>
        <button type="button" class="lo-btn lo-btn-primary" @onclick="Save" disabled="@busy">@(SubjectId == 0 ? "Add subject" : "Save changes")</button>
    </Footer>
</GlassModal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public int SubjectId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool wasOpen, busy, autoProgress;
    private string? error;
    private StudySubject subject = new() { Category = "General" };

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !wasOpen) await LoadAsync();
        wasOpen = Open;
    }

    private async Task LoadAsync()
    {
        error = null; autoProgress = false;
        subject = new StudySubject { Category = "General" };
        if (SubjectId == 0) return;
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var s = await db.StudySubjects.AsNoTracking().FirstOrDefaultAsync(x => x.Id == SubjectId);
        if (s == null) return;
        int taskCount = await db.StudyTasks.CountAsync(t => t.StudySubjectId == SubjectId);
        autoProgress = s.TargetHours > 0 || taskCount > 0;
        subject = new StudySubject
        {
            Id = s.Id, Name = s.Name, Category = s.Category, Status = s.Status, TargetHours = s.TargetHours,
            WeeklyTargetHours = s.WeeklyTargetHours, ProgressPercent = s.ProgressPercent, Description = s.Description,
        };
    }

    private Task Close() => OnClose.InvokeAsync();

    private async Task Save()
    {
        subject.Name = (subject.Name ?? "").Trim();
        if (subject.Name.Length == 0) { error = "Enter a subject name."; return; }
        if (subject.TargetHours < 0 || subject.TargetHours > 100000 || subject.WeeklyTargetHours < 0 || subject.WeeklyTargetHours > 168)
        { error = "Check the target hours."; return; }

        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            var productivity = scope.ServiceProvider.GetRequiredService<ProductivityService>();
            string message;
            int savedId;
            if (subject.Id == 0)
            {
                subject.CreatedAt = DateTime.Now;
                db.StudySubjects.Add(subject);
                await db.SaveChangesAsync();
                savedId = subject.Id;
                await productivity.LogActivityAsync("Study", subject.Id, "Created", $"Subject '{subject.Name}' created");
                message = $"'{subject.Name}' added";
            }
            else
            {
                var row = await db.StudySubjects.FindAsync(subject.Id);
                if (row == null) { error = "This subject no longer exists."; return; }
                row.Name = subject.Name; row.Category = subject.Category; row.Status = subject.Status;
                row.TargetHours = subject.TargetHours; row.WeeklyTargetHours = subject.WeeklyTargetHours; row.Description = subject.Description;
                int taskCount = await db.StudyTasks.CountAsync(t => t.StudySubjectId == row.Id);
                if (row.TargetHours <= 0 && taskCount == 0) row.ProgressPercent = Math.Clamp(subject.ProgressPercent, 0, 100);
                await db.SaveChangesAsync();
                savedId = row.Id;
                message = $"'{row.Name}' updated";
            }
            await StudyProgress.RecalculateAsync(db, savedId);
            Ui.Toast(message);
            Ui.NotifyDataChanged();
            await OnSaved.InvokeAsync();
        }
        finally { busy = false; }
    }
}
