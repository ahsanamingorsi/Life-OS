@inherits OwningComponentBase
@using LifeOS.MVC.Data
@using LifeOS.MVC.Models
@using LifeOS.MVC.Services
@using Microsoft.EntityFrameworkCore
@inject LifeOS.App.Services.AppUi Ui

<GlassModal Open="Open" Title="@(TaskId == 0 ? "New task" : "Edit task")" Subtitle="One clear next step." OnClose="Close">
    <ChildContent>
        @if (error != null) { <div class="lo-flash lo-flash-error" role="alert">@error</div> }
        <div class="lo-form">
            <div class="lo-field">
                <label for="tf-title" class="lo-label">Task name <span aria-hidden="true">*</span></label>
                <input id="tf-title" class="lo-input" @bind="task.Title" @bind:event="oninput" maxlength="200" placeholder="What is your next step?" />
            </div>
            <div class="lo-form-grid">
                <div class="lo-field">
                    <label for="tf-repeat" class="lo-label">Repeat</label>
                    <select id="tf-repeat" class="lo-select" @bind="task.Repeat">
                        <option value="None">Does not repeat</option>
                        <option value="Daily">Daily</option>
                        <option value="Weekly">Weekly</option>
                        <option value="Monthly">Monthly</option>
                    </select>
                </div>
                <div class="lo-field">
                    <label for="tf-due" class="lo-label">@(task.Repeat == "None" ? "Due date" : "Starts on")</label>
                    <input id="tf-due" type="date" class="lo-input" value="@(dueDate?.ToString("yyyy-MM-dd") ?? "")" @onchange="SetDue" />
                </div>
                <div class="lo-field">
                    <label for="tf-priority" class="lo-label">Priority</label>
                    <select id="tf-priority" class="lo-select" @bind="task.Priority">
                        <option value="A">High</option>
                        <option value="B">Normal</option>
                        <option value="C">Low</option>
                    </select>
                </div>
            </div>

            @if (task.Repeat == "Weekly")
            {
                <fieldset class="lo-field">
                    <legend class="lo-label">Repeat on</legend>
                    <div class="lo-days">
                        @foreach (var w in TaskService.WeekDays)
                        {
                            var bit = w.Bit;
                            <label class="lo-day">
                                <input type="checkbox" checked="@weekDays.Contains(bit)" @onchange="e => ToggleDay(bit, e)" />
                                <span title="@w.Long">@w.Short</span>
                            </label>
                        }
                    </div>
                </fieldset>
            }
            @if (task.Repeat == "Monthly")
            {
                <div class="lo-field">
                    <label for="tf-dom" class="lo-label">Day of the month</label>
                    <input id="tf-dom" type="number" min="1" max="31" class="lo-input lo-input-short" @bind="task.RepeatDayOfMonth" />
                    <div class="db-muted db-tiny">Months without this day use their last day.</div>
                </div>
            }
            @if (task.Repeat != "None")
            {
                <div class="lo-field">
                    <label for="tf-end" class="lo-label">Ends on <span class="db-muted">(optional)</span></label>
                    <input id="tf-end" type="date" class="lo-input lo-input-short" value="@(endDate?.ToString("yyyy-MM-dd") ?? "")" @onchange="SetEnd" />
                </div>
            }

            <div class="lo-field">
                <label for="tf-goal" class="lo-label">Goal <span class="db-muted">(optional)</span></label>
                <select id="tf-goal" class="lo-select" value="@(task.GoalId?.ToString() ?? "")" @onchange="SetGoal">
                    <option value="">No goal</option>
                    @foreach (var g in goals)
                    {
                        <option value="@g.Id">@g.Goal@(g.IsAchieved ? " (achieved)" : "")</option>
                    }
                </select>
            </div>

            <div class="lo-field">
                <label for="tf-desc" class="lo-label">Notes <span class="db-muted">(optional)</span></label>
                <textarea id="tf-desc" class="lo-input lo-textarea" maxlength="500" @bind="task.Description"></textarea>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="lo-btn" @onclick="Close" disabled="@busy">Cancel</button>
        <button type="button" class="lo-btn lo-btn-primary" @onclick="Save" disabled="@busy">@(TaskId == 0 ? "Add task" : "Save changes")</button>
    </Footer>
</GlassModal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public int TaskId { get; set; }
    [Parameter] public int? DefaultGoalId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool wasOpen, busy;
    private string? error;
    private PersonalTask task = new();
    private List<PersonalGoal> goals = new();
    private DateTime? dueDate, endDate;
    private HashSet<int> weekDays = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !wasOpen) await LoadAsync();
        wasOpen = Open;
    }

    private async Task LoadAsync()
    {
        error = null;
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        goals = await db.PersonalGoals.AsNoTracking().OrderBy(g => g.IsAchieved).ThenBy(g => g.Goal).ToListAsync();

        var existing = TaskId == 0 ? null : await db.PersonalTasks.AsNoTracking().FirstOrDefaultAsync(t => t.Id == TaskId);
        if (existing == null)
        {
            task = new PersonalTask { DueDate = DateTime.Today, GoalId = DefaultGoalId };
            dueDate = DateTime.Today;
            endDate = null;
            weekDays = new HashSet<int> { TaskService.DayBit(DateTime.Today.DayOfWeek) };
            return;
        }
        task = new PersonalTask
        {
            Id = existing.Id, Title = existing.Title, Description = existing.Description, Priority = existing.Priority,
            Repeat = existing.Repeat, RepeatDays = existing.RepeatDays, RepeatDayOfMonth = existing.RepeatDayOfMonth,
            GoalId = existing.GoalId, CreatedAt = existing.CreatedAt,
        };
        dueDate = existing.DueDate;
        endDate = existing.RepeatEndDate;
        var start = (existing.DueDate ?? DateTime.Today).Date;
        int days = existing.RepeatDays != 0 ? existing.RepeatDays : TaskService.DayBit(start.DayOfWeek);
        weekDays = TaskService.WeekDays.Where(w => (days & w.Bit) != 0).Select(w => w.Bit).ToHashSet();
    }

    private static DateTime? ParseDate(ChangeEventArgs e) => DateTime.TryParse(e.Value as string, out var d) ? d : null;
    private void SetDue(ChangeEventArgs e) => dueDate = ParseDate(e);
    private void SetEnd(ChangeEventArgs e) => endDate = ParseDate(e);
    private void SetGoal(ChangeEventArgs e) => task.GoalId = int.TryParse(e.Value as string, out var id) ? id : null;
    private void ToggleDay(int bit, ChangeEventArgs e)
    {
        if (e.Value is true) weekDays.Add(bit); else weekDays.Remove(bit);
    }

    private Task Close() => OnClose.InvokeAsync();

    private async Task Save()
    {
        task.Title = (task.Title ?? "").Trim();
        if (task.Title.Length == 0) { error = "Enter a task name."; return; }

        switch (task.Repeat)
        {
            case "None":
                task.RepeatDays = 0; task.RepeatDayOfMonth = null; task.RepeatEndDate = null;
                task.DueDate = dueDate;
                break;
            default:
                task.DueDate = (dueDate ?? DateTime.Today).Date;
                task.RepeatEndDate = endDate;
                if (task.RepeatEndDate.HasValue && task.RepeatEndDate.Value.Date < task.DueDate)
                { error = "The end date must be on or after the start date."; return; }
                task.RepeatDays = 0;
                if (task.Repeat == "Weekly")
                {
                    task.RepeatDays = weekDays.Aggregate(0, (sum, b) => sum | b);
                    if (task.RepeatDays == 0) { error = "Choose at least one day of the week."; return; }
                }
                if (task.Repeat == "Monthly")
                {
                    task.RepeatDayOfMonth ??= task.DueDate.Value.Day;
                    if (task.RepeatDayOfMonth is < 1 or > 31) { error = "Choose a day of the month between 1 and 31."; return; }
                }
                else task.RepeatDayOfMonth = null;
                break;
        }

        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            var productivity = scope.ServiceProvider.GetRequiredService<ProductivityService>();

            if (task.GoalId.HasValue && !await db.PersonalGoals.AnyAsync(g => g.Id == task.GoalId))
            { error = "The chosen goal no longer exists."; return; }

            string message;
            if (task.Id == 0)
            {
                task.CreatedAt = DateTime.Now;
                db.PersonalTasks.Add(task);
                await db.SaveChangesAsync();
                await productivity.LogActivityAsync("PersonalTask", task.Id, "Created", $"Task '{task.Title}' created");
                message = $"Task '{task.Title}' added";
            }
            else
            {
                var row = await db.PersonalTasks.FindAsync(task.Id);
                if (row == null) { error = "This task no longer exists."; return; }
                bool wasRepeated = row.IsRepeated;
                row.Title = task.Title; row.Description = task.Description; row.DueDate = task.DueDate;
                row.Priority = task.Priority; row.Repeat = task.Repeat; row.RepeatDays = task.RepeatDays;
                row.RepeatDayOfMonth = task.RepeatDayOfMonth; row.RepeatEndDate = task.RepeatEndDate; row.GoalId = task.GoalId;
                if (wasRepeated && !row.IsRepeated)
                    db.TaskCompletions.RemoveRange(db.TaskCompletions.Where(c => c.PersonalTaskId == row.Id));
                if (!wasRepeated && row.IsRepeated) { row.IsCompleted = false; row.CompletedAt = null; }
                await db.SaveChangesAsync();
                await productivity.LogActivityAsync("PersonalTask", row.Id, "Updated", $"Task '{row.Title}' updated");
                message = $"Task '{row.Title}' updated";
            }

            Ui.Toast(message);
            Ui.NotifyDataChanged();
            await OnSaved.InvokeAsync();
        }
        finally { busy = false; }
    }
}
