@inherits OwningComponentBase
@using LifeOS.MVC.Data
@using LifeOS.MVC.Models
@using LifeOS.MVC.Services
@using Microsoft.EntityFrameworkCore
@inject LifeOS.App.Services.AppUi Ui

<GlassModal Open="Open" Title="Log a study session" Subtitle="Every hour counts." Size="sm" OnClose="Close">
    <ChildContent>
        @if (error != null) { <div class="lo-flash lo-flash-error" role="alert">@error</div> }
        @if (subjects.Count == 0)
        {
            <p class="db-empty">You have no study subjects yet. Add a subject on the Studies page first.</p>
        }
        else
        {
            <div class="lo-form">
                <div class="lo-field">
                    <label for="sf-subject" class="lo-label">Subject <span aria-hidden="true">*</span></label>
                    <select id="sf-subject" class="lo-select" value="@subjectId" @onchange="SetSubject">
                        @foreach (var s in subjects) { <option value="@s.Id">@s.Name</option> }
                    </select>
                </div>
                <div class="lo-form-grid">
                    <div class="lo-field">
                        <label for="sf-hours" class="lo-label">Hours <span aria-hidden="true">*</span></label>
                        <input id="sf-hours" type="number" min="0.25" max="24" step="0.25" class="lo-input" value="@hours" @onchange="SetHours" placeholder="1.5" />
                    </div>
                    <div class="lo-field">
                        <label for="sf-date" class="lo-label">Date</label>
                        <input id="sf-date" type="date" class="lo-input" max="@DateTime.Today.ToString("yyyy-MM-dd")" value="@date.ToString("yyyy-MM-dd")" @onchange="SetDate" />
                    </div>
                </div>
                <div class="lo-field">
                    <label for="sf-topic" class="lo-label">Topic covered <span class="db-muted">(optional)</span></label>
                    <input id="sf-topic" class="lo-input" @bind="topic" maxlength="200" />
                </div>
            </div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="lo-btn" @onclick="Close" disabled="@busy">Cancel</button>
        @if (subjects.Count > 0) { <button type="button" class="lo-btn lo-btn-primary" @onclick="Save" disabled="@busy">Log session</button> }
    </Footer>
</GlassModal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public int SubjectId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool wasOpen, busy;
    private string? error;
    private List<StudySubject> subjects = new();
    private int subjectId;
    private double? hours;
    private string? topic;
    private DateTime date = DateTime.Today;

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !wasOpen) await LoadAsync();
        wasOpen = Open;
    }

    private async Task LoadAsync()
    {
        error = null; hours = null; topic = null; date = DateTime.Today;
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        subjects = await db.StudySubjects.AsNoTracking().Where(s => s.Status != "Completed").OrderBy(s => s.Name).ToListAsync();
        subjectId = subjects.Any(s => s.Id == SubjectId) ? SubjectId : subjects.FirstOrDefault()?.Id ?? 0;
    }

    private void SetSubject(ChangeEventArgs e) => subjectId = int.TryParse(e.Value as string, out var id) ? id : 0;
    private void SetHours(ChangeEventArgs e) => hours = double.TryParse(e.Value as string, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var h) ? h : null;
    private void SetDate(ChangeEventArgs e) => date = DateTime.TryParse(e.Value as string, out var d) ? d.Date : DateTime.Today;
    private Task Close() => OnClose.InvokeAsync();

    private async Task Save()
    {
        double h = hours ?? 0;
        if (subjectId == 0) { error = "Choose a subject."; return; }
        if (h <= 0 || h > 24) { error = "Enter study hours between 0 and 24."; return; }
        if (date > DateTime.Today) { error = "You cannot log a session for a future date."; return; }

        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            var subject = await db.StudySubjects.FindAsync(subjectId);
            if (subject == null) { error = "This subject no longer exists."; return; }

            db.StudySessions.Add(new StudySession { StudySubjectId = subjectId, SessionDate = date, DurationHours = h, TopicCovered = topic, LoggedAt = DateTime.Now });
            if (!string.IsNullOrEmpty(topic)) subject.CurrentTopic = topic;
            await db.SaveChangesAsync();

            // Same progress rule as the Studies page: average of hours-vs-target and tasks done.
            subject.HoursLogged = await db.StudySessions.Where(x => x.StudySubjectId == subjectId).SumAsync(x => x.DurationHours);
            var done = await db.StudyTasks.Where(t => t.StudySubjectId == subjectId).Select(t => t.IsCompleted).ToListAsync();
            var parts = new List<double>();
            if (subject.TargetHours > 0) parts.Add(Math.Min(1.0, subject.HoursLogged / subject.TargetHours));
            if (done.Any()) parts.Add((double)done.Count(d => d) / done.Count);
            if (parts.Any()) subject.ProgressPercent = Math.Clamp((int)Math.Round(parts.Average() * 100), 0, 100);
            await db.SaveChangesAsync();

            await scope.ServiceProvider.GetRequiredService<ProductivityService>()
                .LogActivityAsync("Study", subjectId, "SessionLogged", $"{h}h study session logged — {topic}");
            Ui.Toast($"{h:0.##}h logged on {subject.Name}");
            Ui.NotifyDataChanged();
            await OnSaved.InvokeAsync();
        }
        finally { busy = false; }
    }
}
