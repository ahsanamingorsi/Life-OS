@inherits OwningComponentBase
@using LifeOS.MVC.Data
@using LifeOS.MVC.Models
@using LifeOS.MVC.Services
@using Microsoft.EntityFrameworkCore
@inject LifeOS.App.Services.AppUi Ui

<GlassModal Open="Open" Title="@(TaskId == 0 ? "Add a task" : "Edit task")" Subtitle="@projectName" OnClose="Close">
    <ChildContent>
        @if (error != null) { <div class="lo-flash lo-flash-error" role="alert">@error</div> }
        <div class="lo-form">
            <div class="lo-field">
                <label for="ptf-title" class="lo-label">Title <span aria-hidden="true">*</span></label>
                <input id="ptf-title" class="lo-input" @bind="task.Title" @bind:event="oninput" maxlength="200" placeholder="What needs to be done?" />
            </div>
            <div class="lo-form-grid">
                <div class="lo-field">
                    <label for="ptf-pri" class="lo-label">Priority</label>
                    <select id="ptf-pri" class="lo-select" @bind="task.Priority">
                        <option value="A">A — Critical</option>
                        <option value="B">B — Important</option>
                        <option value="C">C — Low</option>
                    </select>
                </div>
                <div class="lo-field">
                    <label for="ptf-due" class="lo-label">Due date</label>
                    <input id="ptf-due" type="date" class="lo-input" value="@(task.DueDate?.ToString("yyyy-MM-dd") ?? "")" @onchange="SetDue" />
                </div>
                <div class="lo-field">
                    <label for="ptf-est" class="lo-label">Planned minutes</label>
                    <input id="ptf-est" type="number" min="0" max="100000" class="lo-input" value="@task.EstimatedMinutes" @onchange="SetEst" />
                </div>
                @if (TaskId != 0)
                {
                    <div class="lo-field">
                        <label for="ptf-act" class="lo-label">Logged minutes</label>
                        <input id="ptf-act" type="number" min="0" max="100000" class="lo-input" value="@task.ActualMinutes" @onchange="SetAct" />
                    </div>
                }
            </div>
            <div class="lo-field">
                <label for="ptf-desc" class="lo-label">Description <span class="db-muted">(optional)</span></label>
                <textarea id="ptf-desc" class="lo-input lo-textarea" maxlength="500" @bind="task.Description"></textarea>
            </div>
            @if (TaskId != 0)
            {
                <div class="lo-field">
                    <label for="ptf-notes" class="lo-label">Notes <span class="db-muted">(optional)</span></label>
                    <textarea id="ptf-notes" class="lo-input lo-textarea" maxlength="300" @bind="task.Notes"></textarea>
                </div>
            }
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="lo-btn" @onclick="Close" disabled="@busy">Cancel</button>
        <button type="button" class="lo-btn lo-btn-primary" @onclick="Save" disabled="@busy">@(TaskId == 0 ? "Add task" : "Save task")</button>
    </Footer>
</GlassModal>

@code {
    /// <summary>For a new task: the project. For an existing task: leave 0, the project comes from the task.</summary>
    [Parameter] public bool Open { get; set; }
    [Parameter] public int ProjectId { get; set; }
    [Parameter] public int TaskId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool wasOpen, busy;
    private string? error, projectName;
    private int projectId;
    private ProjectTask task = new() { Priority = "B" };

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !wasOpen) await LoadAsync();
        wasOpen = Open;
    }

    private async Task LoadAsync()
    {
        error = null;
        using var scope = ScopedServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        task = new ProjectTask { Priority = "B" };
        projectId = ProjectId;
        if (TaskId != 0)
        {
            var t = await db.ProjectTasks.AsNoTracking().FirstOrDefaultAsync(x => x.Id == TaskId);
            if (t != null)
            {
                projectId = t.ProjectId;
                task = new ProjectTask
                {
                    Id = t.Id, ProjectId = t.ProjectId, Title = t.Title, Description = t.Description, Priority = t.Priority,
                    DueDate = t.DueDate, EstimatedMinutes = t.EstimatedMinutes, ActualMinutes = t.ActualMinutes, Notes = t.Notes,
                };
            }
        }
        projectName = await db.Projects.AsNoTracking().Where(p => p.Id == projectId).Select(p => p.Title).FirstOrDefaultAsync();
    }

    private void SetDue(ChangeEventArgs e) => task.DueDate = DateTime.TryParse(e.Value as string, out var d) ? d : null;
    private void SetEst(ChangeEventArgs e) => task.EstimatedMinutes = int.TryParse(e.Value as string, out var n) ? n : null;
    private void SetAct(ChangeEventArgs e) => task.ActualMinutes = int.TryParse(e.Value as string, out var n) ? n : null;
    private Task Close() => OnClose.InvokeAsync();

    private async Task Save()
    {
        task.Title = (task.Title ?? "").Trim();
        if (task.Title.Length == 0) { error = "Enter a task title."; return; }
        if (task.EstimatedMinutes is < 0 or > 100000 || task.ActualMinutes is < 0 or > 100000) { error = "Minutes must be between 0 and 100000."; return; }

        busy = true;
        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            var productivity = scope.ServiceProvider.GetRequiredService<ProductivityService>();
            if (!await db.Projects.AnyAsync(p => p.Id == projectId)) { error = "This project no longer exists."; return; }

            string message;
            if (task.Id == 0)
            {
                task.ProjectId = projectId;
                task.CreatedAt = DateTime.Now;
                task.Status = "Todo";
                db.ProjectTasks.Add(task);
                await db.SaveChangesAsync();
                await productivity.LogActivityAsync("ProjectTask", task.Id, "Created", $"Task '{task.Title}' added to project");
                message = $"Task '{task.Title}' added";
            }
            else
            {
                var row = await db.ProjectTasks.FindAsync(task.Id);
                if (row == null) { error = "This task no longer exists."; return; }
                row.Title = task.Title; row.Description = task.Description; row.Priority = task.Priority; row.DueDate = task.DueDate;
                row.EstimatedMinutes = task.EstimatedMinutes; row.ActualMinutes = task.ActualMinutes; row.Notes = task.Notes;
                await db.SaveChangesAsync();
                await productivity.LogActivityAsync("ProjectTask", row.Id, "Updated", $"Task '{row.Title}' updated");
                message = $"Task '{row.Title}' updated";
            }
            await LifeOS.App.Services.ProjectProgress.RecalculateAsync(db, projectId);
            Ui.Toast(message);
            Ui.NotifyDataChanged();
            await OnSaved.InvokeAsync();
        }
        finally { busy = false; }
    }
}
